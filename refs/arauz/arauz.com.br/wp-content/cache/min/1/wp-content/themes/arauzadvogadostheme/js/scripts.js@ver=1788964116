jQuery(document).ready(function(){function bgMPScroll(){var scrollTopWindow=jQuery(window).scrollTop();if(scrollTopWindow>0){jQuery('.cabecalho-infos').addClass('scrolled');jQuery('.logo_e_menu').addClass('scrolled')}else{jQuery('.cabecalho-infos').removeClass('scrolled');jQuery('.logo_e_menu').removeClass('scrolled')}}
