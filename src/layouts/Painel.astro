---
/**
 * Layout do painel de conteúdos.
 *
 * Separado do `Base.astro` de propósito: o painel não leva o cabeçalho
 * público, rodapé, cortina de entrada, aviso de cookies nem acessibilidade
 * flutuante. Quem está aqui veio trabalhar.
 *
 * Do site ele leva a identidade: `v3.css` traz os tokens (azul-noite,
 * petróleo, azul acinzentado) e a Roboto local; `painel.css` monta as peças
 * do painel em cima deles, com classes `pnl-*` que não colidem com as do
 * site. As cores e fontes do CMS de origem (site da Isabella) não vieram.
 *
 * `noindex, nofollow` sempre. A mesma rota está fora do sitemap
 * (astro.config.mjs) e proibida no robots.txt: três camadas.
 */
import '~/styles/v3.css';
import '~/styles/painel.css';
import { site } from '~/lib/site';

interface Props {
  /** Título da aba. */
  titulo: string;
  /** Nome de quem está logado. Ausente nas telas de entrada. */
  editor?: string;
  /** Página de tela estreita e centrada (entrar, senha). */
  estreita?: boolean;
}

const { titulo, editor, estreita = false } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>{titulo} | Painel</title>
  </head>
  <body class="pnl">
    <a class="pnl-pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="pnl-topo">
      <div class="pnl-topo__dentro">
        <a class="pnl-topo__marca" href="/painel/">
          <img src="/media/marca/lockup-creme-tela.svg" alt={site.nome} width="550" height="196" />
          <span class="pnl-topo__secao">Painel</span>
        </a>
        {editor && (
          <div class="pnl-topo__acoes">
            <span class="pnl-topo__quem">{editor}</span>
            <form method="post" action="/api/painel/sair">
              <button class="pnl-btn pnl-btn--claro" type="submit">Sair</button>
            </form>
          </div>
        )}
      </div>
    </header>

    <main id="conteudo" class:list={['pnl-pagina', { 'pnl-pagina--estreita': estreita }]}>
      <slot />
    </main>
  </body>
</html>
