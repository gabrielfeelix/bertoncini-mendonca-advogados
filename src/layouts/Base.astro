---
/**
 * Layout base da v3: <head> com SEO, cabeçalho, conteúdo, chamada opcional
 * e rodapé. Sem camada de movimento, sem rolagem suave, sem GSAP: a v3 é
 * um site institucional estático, como um tema WordPress corporativo. A
 * única animação de abertura é a cortina de entrada da v1 (Entrada.astro).
 */
import '../styles/tokens.css';
import '../styles/v3.css';
import Topo from '../components/Topo.astro';
import Rodape from '../components/Rodape.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import Acessibilidade from '../components/Acessibilidade.astro';
import Entrada from '../components/Entrada.astro';
import { site } from '../lib/site';
import { t, type Idioma } from '../lib/i18n';

interface Props {
  /** Título da página (o layout não concatena sufixo). */
  titulo: string;
  /** Meta description específica da página. */
  descricao: string;
  /** href da página atual no menu, para aria-current. */
  paginaAtual?: string;
  /** true para páginas fora do índice. */
  noindex?: boolean;
  /**
   * true (padrão) quando a página abre com foto escura (capa ou banner):
   * o cabeçalho nasce transparente por cima dela. As páginas que abrem
   * com texto (políticas) passam false e o conteúdo reserva o espaço.
   */
  sobreposto?: boolean;
  /** Idioma da página. O inglês mora em /en/. */
  lang?: Idioma;
  /**
   * Endereço desta mesma página no outro idioma. Vai para o seletor
   * PT · EN e para as tags hreflang. Sem ele (blog), o seletor leva à
   * home do outro idioma e não há hreflang.
   */
  alternativa?: string;
}

const { titulo, descricao, paginaAtual, noindex = false, sobreposto = true, lang = 'pt', alternativa } = Astro.props;
const tx = t(lang);
const urlAlternativa = alternativa ? new URL(alternativa, site.url).toString() : undefined;

/* Dados estruturados (schema.org) só na home: dizem ao Google que é um
   escritório de advocacia em Maringá/PR que atende todo o Brasil, o que
   ajuda nas buscas locais ("advogado em Maringá"). */
const dadosEstruturados =
  paginaAtual === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'LegalService',
        name: site.nome,
        url: new URL(lang === 'en' ? '/en/' : '/', site.url).toString(),
        logo: new URL('/media/marca/lockup-azul.png', site.url).toString(),
        image: new URL('/media/hero/socios-1600.jpg', site.url).toString(),
        description: tx.descricao,
        telephone: site.telefoneE164.valor,
        email: site.email.valor,
        address: { '@type': 'PostalAddress', addressLocality: site.cidade, addressRegion: site.estado, addressCountry: 'BR' },
        areaServed: { '@type': 'Country', name: 'Brasil' },
        knowsLanguage: ['pt-BR', 'en'],
        sameAs: [site.redes.instagram.valor],
      }
    : undefined;
const urlCanonica = new URL(Astro.url.pathname, site.url);
---

<!doctype html>
<html lang={tx.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={urlCanonica.toString()} />
    {urlAlternativa && (
      <>
        <link rel="alternate" hreflang={tx.htmlLang} href={urlCanonica.toString()} />
        <link rel="alternate" hreflang={lang === 'pt' ? 'en' : 'pt-BR'} href={urlAlternativa} />
        <link rel="alternate" hreflang="x-default" href={lang === 'pt' ? urlCanonica.toString() : urlAlternativa} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={urlCanonica.toString()} />
    <meta property="og:image" content={new URL(site.imagemPadrao.valor, site.url).toString()} />
    <meta property="og:locale" content={tx.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    {dadosEstruturados && <script is:inline type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} />}

    <!-- Favicon BM (o mesmo da v2): .ico para navegadores antigos, PNG 32px e ícone do iPhone. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Marca que há JavaScript antes da primeira pintura: o cabeçalho só
         fica transparente sobre a foto quando o script de rolagem existe.
         A cortina de entrada (Entrada.astro) só passa na primeira página da
         sessão; nas seguintes, `entrada-vista` a esconde antes de pintar. -->
    <script is:inline>
      document.documentElement.classList.add('com-js');
      try {
        if (sessionStorage.getItem('bm-entrada') === '1') document.documentElement.classList.add('entrada-vista');
        else sessionStorage.setItem('bm-entrada', '1');
      } catch (e) {}
    </script>
    <!-- Preferências de acessibilidade salvas (Acessibilidade.astro), aplicadas
         antes da primeira pintura para a página não "piscar". -->
    <script is:inline>
      try {
        var a = JSON.parse(localStorage.getItem('bm-a11y') || '{}'), h = document.documentElement;
        if (a.texto) h.dataset.a11yTexto = String(a.texto);
        if (a.contraste) h.setAttribute('data-a11y-contraste', '');
        if (a.sublinhar) h.setAttribute('data-a11y-sublinhar', '');
      } catch (e) {}
    </script>
    <link rel="preload" href="/fonts/roboto-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Entrada />
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Topo paginaAtual={paginaAtual} sobreposto={sobreposto} lang={lang} alternativa={alternativa} />
    <main id="conteudo" tabindex="-1" class:list={{ reserva: !sobreposto }}>
      <slot />
    </main>
    {/* Conteúdo que a página quer DENTRO do rodapé, no mesmo fundo (ex.: a
        newsletter da home): <section slot="rodape">. */}
    <Rodape lang={lang}><slot name="rodape" /></Rodape>
    <Acessibilidade lang={lang} />
    {tx.cookies ? <AvisoCookies {...tx.cookies} /> : <AvisoCookies />}
  </body>
  <style>
    .reserva { padding-top: var(--altura-topo); }
  </style>
</html>
