---
/**
 * Layout base da v3: <head> com SEO, cabeçalho, conteúdo, chamada opcional
 * e rodapé. Sem camada de movimento, sem rolagem suave, sem GSAP: a v3 é
 * um site institucional estático, como um tema WordPress corporativo.
 */
import '../styles/tokens.css';
import '../styles/v3.css';
import Topo from '../components/Topo.astro';
import Rodape from '../components/Rodape.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import { site } from '../lib/site';

interface Props {
  /** Título da página (o layout não concatena sufixo). */
  titulo: string;
  /** Meta description específica da página. */
  descricao: string;
  /** href da página atual no menu, para aria-current. */
  paginaAtual?: string;
  /** true para páginas fora do índice. */
  noindex?: boolean;
}

const { titulo, descricao, paginaAtual, noindex = false } = Astro.props;
const urlCanonica = new URL(Astro.url.pathname, site.url);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={urlCanonica.toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={urlCanonica.toString()} />
    <meta property="og:image" content={new URL(site.imagemPadrao.valor, site.url).toString()} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/roboto-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Topo paginaAtual={paginaAtual} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Rodape />
    <AvisoCookies />
  </body>
</html>
