---
/**
 * Layout base: todo `<head>`, o link "pular para o conteúdo", o filtro SVG
 * de grão (assinatura visual do site, precisa existir em toda página), a
 * Navbar nova e o Rodapé. Cada página fornece seu próprio título e
 * descrição — nada de texto de SEO fixo aqui.
 */
import '../styles/tokens.css';
import '../styles/fontes.css';
import '../styles/base.css';
import '../styles/movimento.css';
import Navbar from '../components/Navbar.astro';
import Rodape from '../components/Rodape.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import { site } from '../lib/site';

interface Props {
  /** Título da página (sem o nome do site — este layout não concatena sufixo). */
  titulo: string;
  /** Meta description específica da página. */
  descricao: string;
  /** href da página atual no menu, para aria-current e destaque visual. */
  paginaAtual?: string;
  /** true para páginas fora do índice (ex.: /painel/). */
  noindex?: boolean;
  /**
   * true quando a página abre com um hero escuro de tela cheia e a navbar
   * deve ficar SOBRE ele, sem reservar espaço no fluxo.
   *
   * Só a home usa hoje. Em página sem hero a barra continua opaca e o
   * conteúdo continua reservando o espaço dela — do contrário o texto
   * nasceria atrás da barra.
   */
  heroSobreposto?: boolean;
}

const {
  titulo,
  descricao,
  paginaAtual,
  noindex = false,
  heroSobreposto = false,
} = Astro.props;

const urlCanonica = new URL(Astro.url.pathname, site.url);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={urlCanonica.toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={urlCanonica.toString()} />
    <!-- placeholder: og:image ainda é arte genérica, não aprovada pelo cliente (ver src/lib/site.ts) -->
    <meta property="og:image" content={new URL(site.imagemPadrao.valor, site.url).toString()} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Preload das duas fontes críticas do primeiro paint (protótipo, linhas 7-8). -->
    <link rel="preload" href="/fonts/newsreader-200.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-sobreposta={heroSobreposto ? '1' : undefined}>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <!-- Filtro de grão: assinatura visual do site. Usado só sobre azul
         escuro (rodapé, chapas) — nunca sobre branco, para não sujar a
         leitura. Precisa existir em toda página que o referencie. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="grao"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" />
      <feColorMatrix type="saturate" values="0" /></filter>
    </svg>

    <Navbar paginaAtual={paginaAtual} />

    <!-- tabindex="-1" é obrigatório aqui: o navegador só move o foco real
         para elementos nativamente focáveis ao seguir uma âncora, e
         <main> fica de fora dessa lista (mesmo problema que o protótipo
         resolve em tempo de execução nas linhas 903-918 — ali via JS,
         porque o alvo variava por seção; aqui o alvo é sempre este mesmo
         elemento, então o atributo pode ir direto no HTML, funcionando
         sem depender de nenhum script). Sem isso, o Enter no link "Pular
         para o conteúdo" rola a página mas o foco real fica no <body>,
         que é o defeito que a revisão anterior encontrou. -->
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>

    <Rodape />

    <!-- Aviso de cookies: precisa existir em TODA página, não numa seção de
         uma página só, porque o consentimento é pedido na primeira visita,
         seja ela qual for. Antes ele só era importado por uma página de
         rascunho não versionada, então nenhum visitante chegava a vê-lo,
         enquanto a política de cookies publicada afirmava que ele aparece.
         Nasce com `hidden` e só se mostra via JS quando ainda não houver
         escolha guardada: sem JS não há medição nenhuma para consentir. -->
    <AvisoCookies />

    <style define:vars={{ reservaBarra: heroSobreposto ? '0px' : '88px' }}>
      /*
        A barra é fixa (Navbar.astro). Em página comum o conteúdo reserva o
        espaço dela para não nascer atrás — 72px é a altura mínima de
        `.barra-env`, e a folga cobre o wrap do menu em telas médias.

        Em página com hero sobreposto a reserva é ZERO, de propósito: o
        padding era branco e produzia a faixa entre o cabeçalho e o vídeo
        que o cliente apontou, além de empurrar o hero para baixo e fazer a
        primeira dobra passar de uma tela (`100svh` + 88px). O hero desenha
        o próprio respiro no topo, por dentro, onde ele é escuro.
      */
      #conteudo {
        padding-top: var(--reservaBarra);
      }
    </style>

    {/* Camada de movimento (Tarefa 5). Carregada em todas as páginas: os
        reveals, as âncoras com correção de foco e o controle de vídeo não
        são exclusivos da home. O próprio script decide o que ligar, e sob
        `prefers-reduced-motion` quase nada liga — Lenis e GSAP nem são
        baixados. */}
    <script>
      import '~/scripts/movimento';
    </script>
  </body>
</html>
