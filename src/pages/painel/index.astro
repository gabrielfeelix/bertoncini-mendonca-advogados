---
/**
 * `/painel/` — a lista dos textos da Central de Conteúdos.
 *
 * Veio do CMS de origem: tabela com uma coluna por campo, busca, filtro de
 * estado, ordem invertível e seleção em massa (publicar, voltar a rascunho,
 * apagar). O que mudou na vinda:
 *
 * - a lista é montada no servidor, com a sessão do cookie, e funciona sem
 *   JavaScript (busca e filtros por GET, ações em lote por POST). O script
 *   no fim só filtra enquanto se digita e confirma antes de apagar;
 * - a edição abre em /painel/artigo/ em vez da gaveta lateral: o
 *   formulário é renderizado no servidor e precisa de página própria para
 *   funcionar sem JavaScript (o próprio CMS de origem já mantinha essa
 *   página "para links diretos e para o celular");
 * - as colunas são as deste site (formato, autores, leitura) e não as de lá
 *   (palavras-chave, que o site não usa).
 *
 * Sem sessão de editor, manda para a entrada.
 */
export const prerender = false;

import Painel from '~/layouts/Painel.astro';
import { editorAtual } from '~/lib/painel-auth';
import { ERROS, FEITOS } from '~/lib/painel-artigo';
import { FORMATOS, ROTA_CONTEUDOS, NOME_CONTEUDOS, autoresDoArtigo, type Formato } from '~/lib/artigos';

const editor = await editorAtual(Astro.cookies);
if (!editor) return Astro.redirect('/painel/entrar/', 303);

const params = Astro.url.searchParams;
const erro = params.get('erro');
const feito = params.get('feito');
const aviso = params.get('aviso');
const busca = (params.get('q') ?? '').trim().slice(0, 80);
const filtroEstado = params.get('estado') ?? '';
const filtroFormato = params.get('formato') ?? '';
const antigosPrimeiro = params.get('ordem') === 'antigos';

interface Linha {
  slug: string;
  titulo: string;
  estado: string;
  formato: string | null;
  categoria: string;
  autor: string;
  capa: string | null;
  capa_alt: string | null;
  tempo_leitura: number | null;
  publicado_em: string;
  atualizado_em: string | null;
}

const { data, error } = await editor.cliente
  .from('artigos')
  .select('slug, titulo, estado, formato, categoria, autor, capa, capa_alt, tempo_leitura, publicado_em, atualizado_em')
  .order('publicado_em', { ascending: antigosPrimeiro });

const todos = (data ?? []) as Linha[];
if (error) console.error('[painel] falha ao listar', error.message);

const normaliza = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const termo = normaliza(busca);
const visiveis = todos.filter(
  (a) =>
    (!filtroEstado || a.estado === filtroEstado) &&
    (!filtroFormato || (a.formato ?? 'artigo') === filtroFormato) &&
    (!termo || normaliza(`${a.titulo} ${a.slug} ${a.categoria}`).includes(termo)),
);

/* `publicado_em` é gravado ao meio-dia UTC (o dia digitado no painel);
   formatar no fuso local poderia jogar a data para o dia anterior. */
const dataCurta = (iso: string | null) =>
  iso
    ? new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso))
    : '—';

const rotuloFormato = (f: string | null) => FORMATOS[(f ?? 'artigo') as Formato]?.singular ?? 'Artigo';
const nomesAutores = (autor: string) =>
  autoresDoArtigo(autor).map((s) => s.nome.split(' ')[0]).join(', ') || 'Escritório';
const contagem = (n: number) => `${n} ${n === 1 ? 'texto' : 'textos'}`;
---

<Painel titulo={NOME_CONTEUDOS} editor={editor.nome}>
  <div class="pnl-cabeca">
    <h1 class="pnl-titulo">{NOME_CONTEUDOS}</h1>
    <div class="pnl-cabeca__acoes">
      <a class="pnl-btn" href={ROTA_CONTEUDOS} target="_blank" rel="noopener">Ver no site</a>
      <form method="post" action="/api/painel/publica">
        <button class="pnl-btn" type="submit" title="Pede à Vercel um build novo do site">Atualizar o site</button>
      </form>
      <a class="pnl-btn pnl-btn--principal" href="/painel/artigo/">Escrever novo texto</a>
    </div>
  </div>

  {feito && FEITOS[feito] && <p class="pnl-recado pnl-recado--ok" role="status">{FEITOS[feito]}</p>}
  {aviso && ERROS[aviso] && <p class="pnl-recado pnl-recado--erro" role="alert">{ERROS[aviso]}</p>}
  {erro && <p class="pnl-recado pnl-recado--erro" role="alert">{ERROS[erro] ?? ERROS.salvar}</p>}
  {error && <p class="pnl-recado pnl-recado--erro" role="alert">Não consegui ler a lista: {error.message}</p>}

  <div class="pnl-cartao" style="padding: 0">
    <form class="pnl-fer" method="get" action="/painel/" id="filtros">
      <label class="pnl-fer__busca">
        Buscar
        <input class="pnl-campo" type="search" name="q" value={busca} placeholder="Título, endereço ou área" id="busca" />
      </label>
      <label>
        Estado
        <select class="pnl-campo" name="estado" id="filtro-estado">
          <option value="">Todos</option>
          <option value="publicado" selected={filtroEstado === 'publicado'}>No site</option>
          <option value="rascunho" selected={filtroEstado === 'rascunho'}>Rascunhos</option>
        </select>
      </label>
      <label>
        Formato
        <select class="pnl-campo" name="formato" id="filtro-formato">
          <option value="">Todos</option>
          {Object.entries(FORMATOS).map(([valor, f]) => (
            <option value={valor} selected={filtroFormato === valor}>{f.plural}</option>
          ))}
        </select>
      </label>
      <label>
        Ordem
        <select class="pnl-campo" name="ordem" id="filtro-ordem">
          <option value="">Mais novos primeiro</option>
          <option value="antigos" selected={antigosPrimeiro}>Mais antigos primeiro</option>
        </select>
      </label>
      <noscript><button class="pnl-btn" type="submit">Filtrar</button></noscript>
      <span class="pnl-fer__conta" id="mostrando" aria-live="polite">
        {visiveis.length === todos.length ? contagem(todos.length) : `${visiveis.length} de ${contagem(todos.length)}`}
      </span>
    </form>

    <form method="post" action="/api/painel/lote" id="lote">
      <div class="pnl-lote" id="barra-lote">
        <span class="pnl-lote__quantos" id="quantos">Marque textos para agir em vários de uma vez.</span>
        <button class="pnl-btn" type="submit" name="acao" value="publicar">Publicar</button>
        <button class="pnl-btn" type="submit" name="acao" value="rascunho">Voltar a rascunho</button>
        <label class="pnl-marca" id="confirma-rotulo"><input type="checkbox" name="confirma" value="1" id="confirma" /> confirmo</label>
        <button class="pnl-btn pnl-btn--perigo" type="submit" name="acao" value="apagar" id="apagar-lote">Apagar</button>
      </div>

      <div class="pnl-rolagem">
        <table class="pnl-tabela">
          <thead>
            <tr>
              <th class="pnl-tabela__check"><input type="checkbox" id="marca-todos" aria-label="Marcar todos" hidden /></th>
              <th>Título</th>
              <th>Estado</th>
              <th class="pnl-col-media">Formato</th>
              <th class="pnl-col-media">Categoria</th>
              <th class="pnl-col-media">Autores</th>
              <th>Data</th>
              <th class="pnl-col-media">Capa</th>
              <th class="pnl-col-media">Leitura</th>
              <th class="pnl-col-media">Editado</th>
            </tr>
          </thead>
          <tbody id="linhas">
            {visiveis.length === 0 && (
              <tr><td class="pnl-tabela__vazio" colspan="10">{todos.length ? 'Nenhum texto com esse filtro.' : 'Nenhum texto ainda. O primeiro começa em "Escrever novo texto".'}</td></tr>
            )}
            {visiveis.map((a) => (
              <tr
                data-texto={normaliza(`${a.titulo} ${a.slug} ${a.categoria}`)}
                data-estado={a.estado}
                data-formato={a.formato ?? 'artigo'}
              >
                <td class="pnl-tabela__check">
                  <input type="checkbox" name="slugs" value={a.slug} aria-label={`Marcar "${a.titulo}"`} />
                </td>
                <td><a class="pnl-tabela__titulo" href={`/painel/artigo/?slug=${encodeURIComponent(a.slug)}`}>{a.titulo}</a></td>
                <td>
                  <span class:list={['pnl-estado', `pnl-estado--${a.estado}`]}>{a.estado === 'publicado' ? 'No site' : 'Rascunho'}</span>
                </td>
                <td class="pnl-col-media">{rotuloFormato(a.formato)}</td>
                <td class="pnl-col-media">{a.categoria}</td>
                <td class="pnl-col-media">{nomesAutores(a.autor)}</td>
                <td class="pnl-tabela__num">{dataCurta(a.publicado_em)}</td>
                <td class="pnl-col-media">
                  {a.capa ? <img class="pnl-tabela__capa" src={a.capa} alt={a.capa_alt ?? ''} loading="lazy" width="64" height="44" /> : <span class="pnl-tabela__num">—</span>}
                </td>
                <td class="pnl-col-media pnl-tabela__num">{a.tempo_leitura ? `${a.tempo_leitura} min` : '—'}</td>
                <td class="pnl-col-media pnl-tabela__num">{dataCurta(a.atualizado_em)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </form>
  </div>
</Painel>

<script>
  /* Melhorias com JavaScript. Sem ele, os filtros são um formulário GET e
     o lote exige a caixa "confirmo" para apagar. */
  const $ = <T extends HTMLElement>(s: string) => document.querySelector(s) as T;
  const linhas = [...document.querySelectorAll<HTMLTableRowElement>('#linhas tr[data-texto]')];
  const busca = $<HTMLInputElement>('#busca');
  const estado = $<HTMLSelectElement>('#filtro-estado');
  const formato = $<HTMLSelectElement>('#filtro-formato');
  const ordem = $<HTMLSelectElement>('#filtro-ordem');
  const mostrando = $('#mostrando');
  const marcaTodos = $<HTMLInputElement>('#marca-todos');
  const quantos = $('#quantos');
  const lote = $<HTMLFormElement>('#lote');
  const barra = $('#barra-lote');

  const normaliza = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const caixas = () => linhas.filter((l) => !l.hidden).map((l) => l.querySelector<HTMLInputElement>('input[name=slugs]')!);
  const contagem = (n: number) => `${n} ${n === 1 ? 'texto' : 'textos'}`;

  // Filtra na hora, sem recarregar. A URL acompanha, para o voltar funcionar.
  function filtra() {
    const termo = normaliza(busca.value.trim());
    let n = 0;
    for (const l of linhas) {
      const ok =
        (!estado.value || l.dataset.estado === estado.value) &&
        (!formato.value || l.dataset.formato === formato.value) &&
        (!termo || l.dataset.texto!.includes(termo));
      l.hidden = !ok;
      if (ok) n++;
    }
    const total = Number(mostrando.dataset.total ?? linhas.length);
    mostrando.textContent = n === total ? contagem(total) : `${n} de ${contagem(total)}`;
    atualizaLote();
  }
  mostrando.dataset.total = String(linhas.length);
  busca.addEventListener('input', filtra);
  estado.addEventListener('change', filtra);
  formato.addEventListener('change', filtra);
  // A ordem vem do banco: trocar recarrega a página com o parâmetro.
  ordem.addEventListener('change', () => ($('#filtros') as HTMLFormElement).submit());

  // Seleção em massa.
  function atualizaLote() {
    const visiveis = caixas();
    const marcadas = visiveis.filter((c) => c.checked).length;
    barra.querySelectorAll<HTMLButtonElement>('button').forEach((b) => { b.disabled = marcadas === 0; });
    quantos.textContent = marcadas
      ? `${marcadas} ${marcadas === 1 ? 'texto marcado' : 'textos marcados'}`
      : 'Marque textos para agir em vários de uma vez.';
    marcaTodos.checked = visiveis.length > 0 && marcadas === visiveis.length;
    marcaTodos.indeterminate = marcadas > 0 && marcadas < visiveis.length;
    for (const l of linhas) {
      l.setAttribute('aria-selected', String(l.querySelector<HTMLInputElement>('input[name=slugs]')!.checked));
    }
  }
  marcaTodos.hidden = false;
  marcaTodos.addEventListener('change', () => {
    caixas().forEach((c) => { c.checked = marcaTodos.checked; });
    atualizaLote();
  });
  lote.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name === 'slugs') atualizaLote();
  });

  // Com JavaScript, "confirmo" vira uma pergunta na hora de apagar.
  $('#confirma-rotulo').hidden = true;
  lote.addEventListener('submit', (e) => {
    const acao = (e.submitter as HTMLButtonElement | null)?.value;
    if (acao !== 'apagar') return;
    const n = caixas().filter((c) => c.checked).length;
    if (!confirm(`Apagar ${n === 1 ? 'o texto marcado' : `os ${n} textos marcados`}? Isso não tem volta.`)) {
      e.preventDefault();
      return;
    }
    $<HTMLInputElement>('#confirma').checked = true;
  });
  // Caixas escondidas pelo filtro não entram na ação.
  lote.addEventListener('submit', () => {
    linhas.filter((l) => l.hidden).forEach((l) => { l.querySelector<HTMLInputElement>('input[name=slugs]')!.checked = false; });
  });

  filtra();
</script>
