---
/**
 * Contato (v3): formulário à esquerda, dados do escritório à direita.
 *
 * O formulário é o mesmo das versões anteriores, ligado a /api/contato:
 * funciona sem JavaScript (POST normal, volta por 303 com ?envio-contato=)
 * e, com JavaScript, envia sem sair da página. Por isso a página é
 * renderizada a cada pedido (prerender = false): a mensagem de resultado
 * precisa existir no HTML de quem volta do 303.
 */
import Base from '~/layouts/Base.astro';
import BannerPagina from '~/components/BannerPagina.astro';
import { CAMPOS_ISCA } from '~/lib/antispam';
import { site } from '~/lib/site';
import { listarAreasConfirmadas } from '~/lib/areas';

export const prerender = false;

const envio = Astro.url.searchParams.get('envio-contato');
const motivo = Astro.url.searchParams.get('motivo-contato');

const ERROS: Record<string, string> = {
  faltando: 'Faltou o nome ou a mensagem. Preencha os dois campos e envie de novo.',
  email: 'O e-mail informado não parece completo. Confira e envie de novo.',
  limite: 'Recebemos vários envios seguidos deste aparelho. Aguarde alguns minutos e tente de novo.',
  envio: 'Não foi possível enviar a mensagem agora. Tente de novo em instantes.',
  formato: 'O formulário não chegou completo. Recarregue a página e tente de novo.',
};
const mensagemErro = ERROS[motivo ?? ''] ?? ERROS.envio;

const valores = { nome: '', email: '', telefone: '', assunto: '', perfil: '', conheceu: '', mensagem: '' };

const areas = await listarAreasConfirmadas();
const ASSUNTOS = [...areas.map((a) => a.data.nome), 'Outro assunto', 'Ainda não sei'];
const ORIGENS = ['Indicação de alguém', 'Instagram', 'Google', 'YouTube', 'LinkedIn', 'Outro'];

/* A página da área manda ?assunto=<slug>: quem vem de lá chega com o assunto escolhido. */
const areaDoLink = areas.find((a) => a.data.slug === Astro.url.searchParams.get('assunto'));
if (areaDoLink) valores.assunto = areaDoLink.data.nome;

/* Sem JavaScript, quem erra volta com o que digitou (a API devolve em v-<campo>). */
if (envio === 'erro') {
  for (const campo of Object.keys(valores) as (keyof typeof valores)[]) {
    valores[campo] = Astro.url.searchParams.get(`v-${campo}`) ?? '';
  }
}
const houveCorte = envio === 'erro' && Astro.url.searchParams.get('corte-contato') === '1';
const campoComErro =
  motivo === 'email' ? 'email' : motivo === 'faltando' ? (valores.nome ? 'mensagem' : 'nome') : null;
const erroEm = (campo: string) =>
  campoComErro === campo ? ({ 'aria-invalid': 'true', 'aria-describedby': 'resultado-contato' } as const) : {};
---

<Base
  titulo={`Contato | ${site.nome}`}
  descricao="Fale com Bertoncini & Mendonça Advogados. Atendimento online para todo o país e presencial em Maringá/PR."
  paginaAtual="/contato/"
>
  <BannerPagina html="Fale <strong>Conosco</strong>" foto="/media/novas/contato-lateral.jpg" migalhas={[{ rotulo: 'Contato' }]} />

  <section class="secao">
    <div class="container com-lateral">
      <div>
        <h2>Envie sua mensagem</h2>
        <p>Preencha o formulário. Um dos sócios lê e responde pelo e-mail que você informar.</p>

        <p
          id="resultado-contato"
          class:list={['resultado', { falhou: envio === 'erro' }]}
          role="status"
          aria-live="polite"
          tabindex="-1"
          hidden={envio !== 'ok' && envio !== 'erro'}
        >
          {envio === 'ok' ? 'Recebemos a sua mensagem. A resposta vai para o e-mail que você informou.' : envio === 'erro' ? mensagemErro : ''}
        </p>
        {houveCorte && (
          <p class="resultado falhou"><strong>Atenção:</strong> o seu relato era longo demais para voltar inteiro e aparece cortado abaixo. Confira antes de enviar de novo.</p>
        )}

        <form class="form" action="/api/contato" method="post">
          <div class="linha-2">
            <div>
              <label for="nome">Nome *</label>
              <input id="nome" name="nome" type="text" autocomplete="name" required maxlength="120" value={valores.nome} {...erroEm('nome')} />
            </div>
            <div>
              <label for="telefone">Telefone</label>
              <input id="telefone" name="telefone" type="tel" autocomplete="tel" maxlength="40" value={valores.telefone} />
            </div>
          </div>
          <div>
            <label for="email">E-mail *</label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" value={valores.email} {...erroEm('email')} />
          </div>
          <div class="linha-2">
            <div>
              <label for="assunto">Assunto</label>
              <select id="assunto" name="assunto">
                <option value="">Selecione</option>
                {ASSUNTOS.map((a) => <option value={a} selected={valores.assunto === a}>{a}</option>)}
              </select>
            </div>
            <div>
              <label for="perfil">Quem está escrevendo</label>
              <select id="perfil" name="perfil">
                <option value="">Selecione</option>
                {['Pessoa física', 'Empresa'].map((o) => <option value={o} selected={valores.perfil === o}>{o}</option>)}
              </select>
            </div>
          </div>
          <div>
            <label for="mensagem">Mensagem *</label>
            <textarea id="mensagem" name="mensagem" required maxlength="5000" {...erroEm('mensagem')}>{valores.mensagem}</textarea>
          </div>
          <div>
            <label for="conheceu">Como conheceu o escritório</label>
            <select id="conheceu" name="conheceu">
              <option value="">Selecione</option>
              {ORIGENS.map((o) => <option value={o} selected={valores.conheceu === o}>{o}</option>)}
            </select>
          </div>

          <div class="isca" aria-hidden="true">
            {CAMPOS_ISCA.map((campo) => <input type="text" name={campo} tabindex="-1" autocomplete="off" />)}
          </div>

          <div><button type="submit" class="botao">Enviar mensagem</button></div>
          <p class="nota">
            Enviar esta mensagem não estabelece relação de patrocínio nem substitui uma consulta. Os dados
            são tratados como descreve a <a href="/politica-de-privacidade/">política de privacidade</a>.
          </p>
        </form>
      </div>

      <aside class="lateral">
        <div class="widget">
          <h2>Contato</h2>
          <dl class="dados">
            <dt>E-mail</dt>
            <dd><a href={`mailto:${site.email.valor}`}>{site.email.valor}</a></dd>
            <dt>Telefone e WhatsApp</dt>
            <dd>
              <a href={`tel:${site.telefoneE164.valor}`}>{site.telefone.valor}</a><br />
              <a href={site.whatsapp.valor} rel="noopener" target="_blank">Conversar pelo WhatsApp</a>
            </dd>
            <dt>Instagram</dt>
            <dd><a href={site.redes.instagram.valor} rel="noopener" target="_blank">{site.redes.instagramArroba}</a></dd>
            <dt>Horário</dt>
            <dd>{site.horario}</dd>
            <dt>Atendimento</dt>
            <dd>{site.atendimentoRodape} e presencial em {site.cidade}/{site.estado}</dd>
          </dl>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  /* Melhoria progressiva: com JS o envio acontece sem sair da página. */
  const forma = document.querySelector<HTMLFormElement>('form[action="/api/contato"]');
  const resultado = document.getElementById('resultado-contato');
  const botao = forma?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (forma && resultado && botao) {
    forma.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      botao.disabled = true;
      resultado.hidden = false;
      resultado.classList.remove('falhou');
      resultado.textContent = 'Enviando a mensagem.';
      try {
        const resposta = await fetch('/api/contato', {
          method: 'POST',
          body: new FormData(forma),
          headers: { accept: 'application/json' },
        });
        const dados = (await resposta.json().catch(() => ({}))) as { erro?: string };
        if (resposta.ok) {
          forma.reset();
          resultado.textContent = 'Recebemos a sua mensagem. A resposta vai para o e-mail que você informou.';
        } else {
          resultado.classList.add('falhou');
          resultado.textContent = dados.erro ?? 'Não foi possível enviar a mensagem agora. Tente de novo em instantes.';
        }
      } catch {
        resultado.classList.add('falhou');
        resultado.textContent = 'Sem conexão no momento. Tente de novo em instantes.';
      } finally {
        botao.disabled = false;
        resultado.focus();
      }
    });
  }
</script>

<style>
  .dados { margin: 0; font-size: 15px; }
  .dados dt { font-weight: 700; color: var(--azul); margin-top: 12px; }
  .dados dt:first-child { margin-top: 0; }
  .dados dd { margin: 2px 0 0; overflow-wrap: anywhere; }
  .resultado { margin-bottom: 18px; }
</style>
