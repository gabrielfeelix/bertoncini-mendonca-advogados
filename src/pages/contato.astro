---
/**
 * /contato/ — o caminho de conversão do site.
 *
 * Três formas de falar com o escritório, na ordem em que o cliente pediu:
 * o WhatsApp (canal principal), o formulário e os dados diretos.
 *
 * O FORMULÁRIO FUNCIONA SEM JAVASCRIPT. É um `<form method="post">` de
 * verdade, apontando para `/api/contato`, que responde 303 de volta para cá
 * com `?envio=ok|erro` quando o pedido não veio de um `fetch`. A mensagem de
 * resultado é renderizada no servidor a partir desse parâmetro, então ela
 * existe na primeira pintura, sem depender de script nenhum. O script no fim
 * do arquivo só evita que a pessoa perca a página.
 *
 * O que NÃO está escrito aqui, deliberadamente:
 *
 * - Nenhum prazo de resposta. O protótipo promete "resposta em até um dia
 *   útil" e marca esse prazo como placeholder a confirmar com os sócios
 *   (linha 674). Enquanto não for confirmado, prometer prazo é inventar
 *   dado. A página diz que a mensagem é lida por um dos sócios, o que é
 *   verdade sem prazo.
 * - Nada de "consulta gratuita", "avaliação sem compromisso", "fale agora"
 *   ou qualquer variação. O Provimento 205/2021 da OAB proíbe oferta de
 *   gratuidade, urgência e captação. Um formulário de contato é justamente
 *   onde essas frases costumam entrar sozinhas.
 * - Nenhuma antecipação de análise do caso. O aviso abaixo do botão diz o
 *   contrário: a mensagem não cria relação de patrocínio.
 *
 * Endereço: o escritório ainda não forneceu um endereço de atendimento
 * presencial. A página diz a cidade e a forma de atendimento, que são os
 * fatos que existem, e marca a linha do endereço como placeholder. Inventar
 * uma rua seria pior do que admitir que ela falta.
 */
import Base from '~/layouts/Base.astro';
import Marca from '~/components/Marca.astro';
import Newsletter from '~/components/Newsletter.astro';
import { CAMPOS_ISCA } from '~/lib/antispam';
import { site } from '~/lib/site';
import Zap from '../components/Zap.astro';

/*
  Esta página é renderizada a cada pedido, e não pré-gerada no build.
  A razão é o `?envio=` abaixo: quem envia o formulário SEM JavaScript volta
  para cá por um 303 com esse parâmetro, e um HTML pré-gerado no build
  serviria sempre a mesma página, com a mensagem de resultado vazia. Ou seja,
  a pessoa preencheria, enviaria, voltaria e não veria confirmação nenhuma.
  Com `prerender = false` a mensagem é montada no servidor, no pedido, e
  existe na primeira pintura.
*/
export const prerender = false;

/* Volta de quem enviou sem JavaScript. A rota redireciona para cá com
   `?envio-contato=` e, no erro, `?motivo-contato=`. O parâmetro é nomeado por
   formulário de propósito: esta página pode um dia conter também a
   newsletter, e um `?envio=` genérico faria as duas seções anunciarem o
   resultado uma da outra. Lido no servidor para que a mensagem apareça mesmo
   com o script desligado. */
const envio = Astro.url.searchParams.get('envio-contato');
const motivo = Astro.url.searchParams.get('motivo-contato');

/* O texto de cada erro mora aqui, não na resposta da API: assim a página
   sem JavaScript consegue renderizá-lo, e a API não precisa devolver texto
   de interface num redirecionamento. */
const ERROS: Record<string, string> = {
  faltando: 'Faltou o nome ou a mensagem. Preencha os dois campos e envie de novo.',
  email: 'O e-mail informado não parece completo. Confira e envie de novo.',
  limite: 'Recebemos vários envios seguidos deste aparelho. Aguarde alguns minutos e tente de novo.',
  envio: 'Não foi possível enviar a mensagem agora. Tente de novo em instantes, ou use o WhatsApp.',
  formato: 'O formulário não chegou completo. Recarregue a página e tente de novo.',
};

const mensagemErro = ERROS[motivo ?? ''] ?? ERROS.envio;

/*
  Campo a que o erro se refere. Serve para dois fins:

  - `aria-invalid` e `aria-describedby` no campo certo, para quem usa leitor
    de tela saber DE QUAL campo a mensagem fala, em vez de ouvir "confira o
    e-mail informado" solto;
  - o foco inicial, logo abaixo.

  `faltando` pode ser nome ou mensagem. Apontamos o primeiro que voltou vazio.
*/
const valores = {
  nome: '', email: '', telefone: '', assunto: '', mensagem: '',
};

/*
  IMPORTANTE 6: sem JavaScript, um 303 devolve a página do zero e o navegador
  não tem como repreencher nada. Sem isto, quem erra o e-mail redigita a
  mensagem inteira, num campo de até 5000 caracteres. Então a rota devolve o
  que a pessoa escreveu e cada campo volta preenchido.

  Só acontece no caminho de erro, e os valores vêm da própria pessoa, no
  mesmo pedido. O Astro escapa o atributo `value` na renderização, então o
  conteúdo não vira marcação.
*/
if (envio === 'erro') {
  for (const campo of Object.keys(valores) as (keyof typeof valores)[]) {
    valores[campo] = Astro.url.searchParams.get(`v-${campo}`) ?? '';
  }
}

/* O servidor avisa quando teve de cortar algum campo para caber na URL da
   volta. Sem JavaScript é a única forma de a pessoa saber que o que ela
   relê na tela não é tudo o que escreveu. */
const houveCorte = envio === 'erro' && Astro.url.searchParams.get('corte-contato') === '1';

const campoComErro =
  motivo === 'email' ? 'email' : motivo === 'faltando' ? (valores.nome ? 'mensagem' : 'nome') : null;
---

<Base
  titulo="Contato | Bertoncini & Mendonça Advogados"
  descricao="Fale com o escritório Bertoncini & Mendonça. Formulário, WhatsApp, telefone e e-mail. Atendimento online para todo o país e presencial em Maringá, PR."
  paginaAtual="/contato/"
>
  <section class="abertura">
    <div class="env">
      {/* A abertura ocupava só a metade esquerda da tela. A marca fecha a
          composição à direita sem acrescentar palavra nenhuma — a página
          já diz em texto tudo o que precisa. */}
      <Marca tipo="conversa" class="selo" />
      <p class="chapeu">Contato</p>
      <h1 class="display">Conte o que está acontecendo.</h1>
      <p class="linha-fina">
        Escreva com suas palavras. Não é preciso usar termo técnico nem organizar a
        história antes. Quem lê a sua mensagem é um dos sócios.
      </p>
    </div>
  </section>

  <section class="canais">
    <div class="env">
      <a
        class="botao zap"
        href={site.whatsapp.valor}
        target="_blank"
        rel="noopener"
        data-placeholder={site.whatsapp.placeholder ? '1' : undefined}
      >
        Abrir conversa no WhatsApp
        <span class="disco" aria-hidden="true">
          <Zap tamanho={15} />
        </span>
      </a>
      <p class="horario">{site.horario}. Fora do horário a mensagem fica registrada.</p>
    </div>
  </section>

  <section class="corpo">
    <div class="env">
      <div class="coluna-forma">
        <h2>Ou escreva por aqui</h2>

        {/* A mensagem de resultado vem antes do formulário e é o alvo da
            âncora `#resultado-contato` que a rota usa no 303: quem voltou sem
            JavaScript chega com a mensagem na altura dos olhos, não precisa
            procurar. */}
        <p
          id="resultado-contato"
          class:list={['resultado', { visto: envio === 'ok' || envio === 'erro', falhou: envio === 'erro' }]}
          role="status"
          aria-live="polite"
          tabindex="-1"
        >
          {envio === 'ok'
            ? 'Recebemos a sua mensagem. A resposta vai para o e-mail que você informou.'
            : envio === 'erro'
              ? mensagemErro
              : ''}
        </p>

        {houveCorte && (
          <p class="aviso-corte" role="status">
            <strong>Atenção:</strong> o seu relato era longo demais para voltar inteiro
            nesta tela e aparece cortado abaixo. Confira o texto antes de enviar de novo.
          </p>
        )}

        <form class="forma" method="post" action="/api/contato">
          <div class="campo">
            <label for="nome">Seu nome</label>
            <input
              id="nome"
              name="nome"
              type="text"
              required
              autocomplete="name"
              maxlength="120"
              value={valores.nome}
              aria-invalid={campoComErro === 'nome' ? 'true' : undefined}
              aria-describedby={campoComErro === 'nome' ? 'resultado-contato' : undefined}
            />
          </div>

          <div class="campo">
            <label for="email">Seu e-mail</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              maxlength="254"
              value={valores.email}
              aria-invalid={campoComErro === 'email' ? 'true' : undefined}
              aria-describedby={campoComErro === 'email' ? 'ajuda-email resultado-contato' : 'ajuda-email'}
            />
            <p class="ajuda" id="ajuda-email">É por aqui que respondemos.</p>
          </div>

          <div class="campo">
            <label for="telefone">Telefone <span class="opcional">(opcional)</span></label>
            <input
              id="telefone"
              name="telefone"
              type="tel"
              autocomplete="tel"
              maxlength="40"
              value={valores.telefone}
            />
          </div>

          {/* Texto livre, não lista de áreas: a lista de áreas do escritório
              ainda está sendo fechada, e uma lista incompleta induz a pessoa
              a enquadrar o caso na caixa errada. */}
          <div class="campo">
            <label for="assunto">Sobre o que é <span class="opcional">(opcional)</span></label>
            <input id="assunto" name="assunto" type="text" maxlength="120" value={valores.assunto} />
          </div>

          <div class="campo">
            <label for="mensagem">O que está acontecendo</label>
            <textarea
              id="mensagem"
              name="mensagem"
              required
              rows="7"
              maxlength="5000"
              aria-invalid={campoComErro === 'mensagem' ? 'true' : undefined}
              aria-describedby={campoComErro === 'mensagem' ? 'resultado-contato' : undefined}
            >{valores.mensagem}</textarea>
          </div>

          {/* Iscas: fora da vista e fora do foco por teclado. Nunca
              `display:none`, para que a isca continue sendo enviada por um
              robô e continue ignorada por um leitor de tela. */}
          <div class="iscas" aria-hidden="true">
            {CAMPOS_ISCA.map((campo) => (
              <input type="text" name={campo} tabindex="-1" autocomplete="off" />
            ))}
          </div>

          <button type="submit" class="botao enviar">Enviar mensagem</button>

          <p class="aviso-legal">
            Enviar esta mensagem não estabelece relação de patrocínio nem substitui
            uma consulta. O que você escrever é tratado como descreve a
            <a href="/politica-de-privacidade/">política de privacidade</a>.
          </p>
        </form>
      </div>

      <aside class="coluna-dados" aria-label="Dados de contato">
        <h2>Os dados diretos</h2>
        <dl class="dados">
          <div class="dado">
            <dt>Telefone</dt>
            <dd>
              <a href={`tel:${site.telefoneE164.valor}`} data-placeholder={site.telefone.placeholder ? '1' : undefined}>
                {site.telefone.valor}
              </a>
            </dd>
          </div>
          <div class="dado">
            <dt>E-mail</dt>
            <dd>
              <a href={`mailto:${site.email.valor}`} data-placeholder={site.email.placeholder ? '1' : undefined}>
                {site.email.valor}
              </a>
            </dd>
          </div>
          <div class="dado">
            <dt>Horário</dt>
            <dd>{site.horario}</dd>
          </div>
          <div class="dado">
            <dt>Atendimento</dt>
            <dd>{site.atendimento}</dd>
          </div>
          <div class="dado">
            <dt>Base</dt>
            <dd>{site.cidade}, {site.estado}</dd>
          </div>
          {/* Briefing q2_6: o escritório ainda não tem sede própria, e a
              maior parte do atendimento é online. A reunião presencial
              acontece em coworking, em Maringá. O endereço do coworking não
              é publicado: quem precisa de reunião presencial combina antes,
              e anunciar como sede um espaço compartilhado sugeriria uma
              estrutura que não existe. */}
          <div class="dado">
            <dt>Atendimento presencial</dt>
            <dd>Em Maringá, com hora marcada. O endereço é combinado na confirmação da reunião.</dd>
          </div>
        </dl>

        <div class="registro">
          <p>{site.nomeSociedade}</p>
          <p data-placeholder={site.registro.oabSociedade.placeholder ? '1' : undefined}>
            {site.registro.oabSociedade.valor}
          </p>
          <p data-placeholder={site.registro.cnpj.placeholder ? '1' : undefined}>
            CNPJ {site.registro.cnpj.valor}
          </p>
        </div>
      </aside>
    </div>
  </section>

  {/* A newsletter vive aqui, e não numa página de rascunho: é a página onde
      quem já decidiu falar conosco está, e é uma das poucas renderizadas a
      cada pedido, o que a seção precisa para confirmar a inscrição de quem
      está sem JavaScript. O caminho `/contato/` está em `VOLTAS_PERMITIDAS`,
      em `src/pages/api/newsletter.ts`, e as duas seções leem parâmetros
      diferentes (`envio-contato` e `envio-newsletter`), então uma não
      anuncia o resultado da outra. */}
  <Newsletter />
</Base>

<script>
  /*
    Melhoria progressiva, e só isso. Sem este script o formulário envia por
    POST normal, a rota responde 303 com `?envio=` e a página renderiza a
    mensagem no servidor. Com ele, a pessoa não perde a página nem o que
    digitou quando dá erro.
  */
  const forma = document.querySelector<HTMLFormElement>('form[action="/api/contato"]');
  const resultado = document.getElementById('resultado-contato');
  const botao = forma?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (forma && resultado && botao) {
    forma.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      botao.disabled = true;
      resultado.classList.remove('falhou');
      resultado.classList.add('visto');
      resultado.textContent = 'Enviando a mensagem.';

      try {
        const resposta = await fetch('/api/contato', {
          method: 'POST',
          body: new FormData(forma),
          headers: { accept: 'application/json' },
        });
        const dados = (await resposta.json().catch(() => ({}))) as { erro?: string };

        if (resposta.ok) {
          forma.reset();
          resultado.textContent =
            'Recebemos a sua mensagem. A resposta vai para o e-mail que você informou.';
        } else {
          resultado.classList.add('falhou');
          resultado.textContent =
            dados.erro ?? 'Não foi possível enviar a mensagem agora. Tente de novo em instantes.';
        }
      } catch {
        resultado.classList.add('falhou');
        resultado.textContent = 'Sem conexão no momento. Tente de novo, ou use o WhatsApp.';
      } finally {
        botao.disabled = false;
        /* Move o foco para a mensagem: quem navega por teclado ou leitor de
           tela estava no botão e precisa saber o que aconteceu. */
        resultado.focus();
      }
    });
  }
</script>

<style>
  .abertura {
    padding-block: clamp(56px, 7vw, 104px) clamp(28px, 4vw, 48px);
  }
  .chapeu {
    font-size: 16px;
    color: var(--secundario);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .abertura h1 {
    font-size: clamp(36px, 6vw, 82px);
    max-width: 14ch;
  }
  .linha-fina {
    margin-top: 24px;
    max-width: 52ch;
    font-size: 19px;
    color: var(--secundario);
  }

  .canais {
    padding-block: 0 clamp(40px, 5vw, 72px);
  }
  .canais :global(.env) {
    display: flex;
    align-items: center;
    gap: 16px 28px;
    flex-wrap: wrap;
  }
  .horario {
    font-size: 16px;
    color: var(--secundario);
  }

  .abertura :global(.env) {
    position: relative;
  }
  .abertura :global(.selo) {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(150px, 16vw, 230px);
  }
  /* Abaixo de 1000px a marca encostaria no título: some, e a abertura
     volta a ser só texto, que é como ela já funcionava. */
  @media (max-width: 1000px) {
    .abertura :global(.selo) {
      display: none;
    }
  }

  .corpo {
    padding-block: 0 clamp(64px, 8vw, 128px);
  }
  .corpo :global(.env) {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(24px, 3vw, 44px);
    align-items: start;
  }

  /*
    As duas colunas viram placas (decisão 1), em vez de conteúdo solto
    sobre o branco da página: a forma sobre papel, que é o material de
    componente do projeto, e os dados sobre branco com contorno. Assim a
    página para de ser uma folha só e passa a ter as duas peças que ela
    de fato tem — escrever e ligar.
  */
  .coluna-forma,
  .coluna-dados {
    border-radius: clamp(16px, 2vw, 26px);
    padding: clamp(24px, 3.2vw, 48px);
  }
  .coluna-forma {
    background: var(--papel);
  }
  .coluna-dados {
    background: var(--branco);
    border: 1px solid var(--linha);
    /* Os dados são mais curtos que o formulário e sobrava um vão grande
       embaixo deles. Grudando no topo, a placa acompanha quem rola
       preenchendo o formulário — que é exatamente quando alguém pode
       decidir ligar em vez de escrever. */
    position: sticky;
    top: calc(var(--reservaBarra, 88px) + 16px);
  }
  /* Sticky só faz sentido com as duas colunas lado a lado. */
  @media (max-width: 900px) {
    .coluna-dados {
      position: static;
    }
  }
  /* Campo sobre papel precisa de fundo branco para o contorno do input
     não sumir dentro da placa. */
  .coluna-forma :global(input),
  .coluna-forma :global(textarea) {
    background: var(--branco);
  }
  @media (max-width: 900px) {
    .corpo :global(.env) {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  .corpo h2 {
    font-family: var(--serif);
    font-weight: 200;
    font-size: clamp(28px, 3.6vw, 44px);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 28px;
  }

  /* Mensagem de resultado. Fora de um envio ela não ocupa espaço nenhum, e
     por isso `display:none`: um parágrafo vazio com `role="status"` já é
     anunciado corretamente quando ganha texto. */
  .resultado {
    display: none;
    margin-bottom: 24px;
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid var(--linha);
    background: #fff;
    font-size: 17px;
    line-height: 1.5;
  }
  .resultado.visto {
    display: block;
  }
  /* O erro se distingue por texto, não só por cor: a mensagem descreve o
     que houve, e o prefixo abaixo reforça sem ser a única pista. */
  .resultado.falhou {
    border-color: var(--imperial);
    color: var(--imperial);
    font-weight: 500;
  }
  .resultado.falhou::before {
    content: "Atenção: ";
    font-weight: 600;
  }

  .aviso-corte {
    margin-bottom: 20px;
    padding: 16px 18px;
    border: 1px solid var(--imperial);
    border-radius: 12px;
    color: var(--imperial);
    font-size: 17px;
    line-height: 1.5;
    max-width: 620px;
  }

  .forma {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 620px;
  }
  .campo {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  /* Rótulo visível e associado por `for`. Nunca só placeholder: o
     placeholder some ao digitar, e quem volta ao campo depois de uma
     interrupção perde a referência do que estava preenchendo. */
  .campo label {
    font-size: 17px;
    font-weight: 500;
    color: var(--tinta);
  }
  .campo .opcional {
    font-weight: 400;
    color: var(--secundario);
  }
  .campo :is(input, textarea) {
    font: 400 18px/1.5 var(--sans);
    color: var(--tinta);
    background: #fff;
    border: 1px solid var(--secundario);
    border-radius: 10px;
    /* 14px de padding sobre 18px/1.5 dá 55px de altura: acima dos 44px
       exigidos, sem depender só do `min-height`. */
    padding: 14px 16px;
    min-height: 52px;
    width: 100%;
  }
  .campo textarea {
    min-height: 168px;
    resize: vertical;
  }
  .campo :is(input, textarea):focus-visible {
    outline: 2px solid var(--imperial);
    outline-offset: 2px;
    border-color: var(--tinta);
  }
  .ajuda {
    font-size: 15px;
    color: var(--secundario);
  }

  .iscas {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .enviar {
    align-self: flex-start;
    justify-content: center;
    padding: 16px 28px;
    min-height: 52px;
    font: 500 17px/1 var(--sans);
    cursor: pointer;
  }
  .enviar[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .aviso-legal {
    font-size: 15px;
    line-height: 1.55;
    color: var(--secundario);
    max-width: 52ch;
  }
  /* Mesmo tratamento de `src/styles/politica.css`: o alvo de 44px vale
     também para um link no meio de um parágrafo. `inline-flex` dá a altura
     sem tirar o link do fluxo da linha, e o `margin-block` negativo impede
     que o espaçamento entre as linhas do parágrafo aumente. */
  .aviso-legal a {
    color: var(--apoio);
    text-decoration: underline;
    text-underline-offset: 3px;
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    min-height: 44px;
    margin-block: -11px;
    vertical-align: middle;
  }

  .dados {
    border-top: 1px solid var(--linha);
    margin: 0;
  }
  .dado {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 12px 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--linha);
    font-size: 17px;
  }
  @media (max-width: 420px) {
    .dado {
      grid-template-columns: 1fr;
      gap: 4px;
