---
/**
 * Contato, em português. Conteúdo em src/views/Contato.astro.
 * Renderizada a cada pedido: a volta do formulário sem JavaScript (303 com
 * ?envio-contato=) precisa da mensagem de resultado no HTML.
 */
import Contato from '~/views/Contato.astro';

/* Renderizada a cada pedido. Na prévia montada em /v3 do site publicado
   (PREVIA_ESTATICA=1), astro.config.mjs a marca como estática: lá não há
   função de servidor desta versão. Não trocar este `false` por uma
   expressão: o Astro não a avalia e cai no padrão (estático). */
export const prerender = false;
---

<Contato lang="pt" />
