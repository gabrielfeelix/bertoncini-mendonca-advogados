---
/**
 * A home (Tarefa 6).
 *
 * Monta as seções migradas na Tarefa 4, na ordem do protótipo aprovado
 * (`prototipo/index.html`): entrada, hero, declaração, áreas, sócios,
 * faixa, método, newsletter, perguntas, contato.
 *
 * O que esta página decide, e as seções não:
 *
 * 1. **O conteúdo real.** As áreas vêm da coleção `areas`, não das
 *    constantes de `Areas.astro`: a home não pode discordar de `/areas/`
 *    sobre o que o escritório faz. Foi assim que Família e Compliance
 *    sobreviveram tanto tempo depois do briefing.
 *
 * 2. **Os links de saída.** Cada seção ganha um "saiba mais" apontando para
 *    a página interna correspondente (`SaibaMais.astro`). As seções são
 *    reusadas em `/areas/` e `/escritorio/`, onde esse link apontaria para a
 *    própria página — por isso ele mora aqui, e não dentro delas.
 *
 * A OAB aparece com rótulo e em 19px (ver `Socios.astro`): o protótipo a
 * trazia em 14px, o menor corpo do site, na página mais vista. O Provimento
 * 205/2021 exige exibi-la, e o levantamento que originou o projeto mostrou
 * que nenhum dos 44 escritórios a exibe. Era a tese do projeto no menor tipo
 * da página.
 */
import Base from '~/layouts/Base.astro';
import Entrada from '~/components/Entrada.astro';
import Hero from '~/components/Hero.astro';
import Declaracao from '~/components/Declaracao.astro';
import Letreiro from '~/components/Letreiro.astro';
import Servicos from '~/components/Servicos.astro';
import SociosPilha from '~/components/SociosPilha.astro';
import Metodo from '~/components/Metodo.astro';
import Newsletter from '~/components/Newsletter.astro';
import Perguntas from '~/components/Perguntas.astro';
import AvisoCookies from '~/components/AvisoCookies.astro';
import BlogHome from '~/components/BlogHome.astro';
import Situacoes from '~/components/Situacoes.astro';
import { listarAreas } from '~/lib/areas';
import { listarArtigos } from '~/lib/artigos';

/* As áreas vêm da coleção, como em `/areas/`: as perguntas de
   `Situacoes` apontam para as respostas na página de cada uma. */
const areas = await listarAreas();

/* "O que as pessoas nos perguntam": seis perguntas por área, escolhidas
   entre as que o briefing listou (q7.4) e que já têm resposta no JSON da
   área. Escolhidas pelo texto, e não pela posição, para que reordenar o
   JSON não troque a pergunta da home em silêncio. */
const perguntasEscolhidas: Record<string, string[]> = {
  'planejamento-patrimonial-e-sucessorio': [
    'Holding realmente protege o patrimônio?',
    'Posso doar um imóvel e continuar morando nele?',
    'Posso impedir que meu filho venda o imóvel que recebeu?',
    'Preciso fazer testamento mesmo tendo filhos?',
    'O inventário precisa ser feito na Justiça?',
    'O que acontece com as minhas contas e arquivos digitais quando eu morrer?',
  ],
  'direito-digital': [
    'Alguém criou um perfil falso com meu nome e minha foto. O que posso fazer?',
    'Minha conta foi banida ou restringida. Dá para recuperar pela Justiça?',
    'Recebi uma proposta de parceria com uma marca. O que verificar antes de aceitar?',
    'Preciso registrar minha marca?',
    'Posso colocar dados de clientes no ChatGPT?',
    'A LGPD se aplica à minha empresa, mesmo sendo pequena?',
  ],
};
const gruposDePerguntas = areas
  .filter((area) => !area.data.aConfirmar && perguntasEscolhidas[area.data.slug])
  .map((area) => ({
    nome: area.data.nome,
    slug: area.data.slug,
    perguntas: perguntasEscolhidas[area.data.slug]
      .map((texto) => ({ texto, indice: area.data.perguntas.findIndex((p) => p.pergunta === texto) }))
      .filter((p) => p.indice >= 0),
  }));

/* Os três textos mais recentes: um em destaque e dois em cartão
   (`BlogHome.astro`). Lista vazia não renderiza a seção. */
const ultimosTextos = (await listarArtigos()).slice(0, 3);

/* As perguntas da home são as gerais, sobre atendimento. As específicas de
   cada matéria ficam na página da área. Duas foram reescritas depois do
   briefing: eles atendem todo o país (q2_5), e ainda não têm escritório
   físico (q2_6) — a home não pode sugerir sede nem limitar ao Paraná. */
const perguntasDaHome = [
  {
    pergunta: 'A primeira conversa é cobrada?',
    resposta:
      'Depende do caso. Antes de marcar, dizemos se a conversa inicial é cobrada e qual o valor, para você decidir sem surpresa.',
  },
  {
    pergunta: 'Como funciona do primeiro contato até o caso andar?',
    resposta:
      'Você escreve pelo formulário do site, pelo WhatsApp ou por e-mail contando o que aconteceu. Respondemos para marcar uma conversa, por vídeo ou presencial em Maringá. Nela você recebe as opções, os prazos e o custo. Se decidir seguir, assumimos o caso e informamos cada movimentação, inclusive quando a notícia é que nada mudou.',
  },
  {
    pergunta: 'Vocês atendem empresas ou pessoas físicas?',
    resposta:
      'Os dois. A maior parte do trabalho é com empresas e empresários, e atendemos também pessoas e famílias nas duas áreas.',
  },
  {
    pergunta: 'Vocês atendem fora de Maringá?',
    resposta:
      'Sim, em todo o país. O atendimento é online, por mensagem e por chamada de vídeo, e cobre todas as etapas. Quando um encontro presencial for necessário, combinamos em Maringá, com hora marcada.',
  },
  {
    pergunta: 'E se o meu assunto não for de nenhuma das duas áreas?',
    resposta:
      'Escreva mesmo assim. Também atuamos em questões de direito imobiliário, tributário e cível. Se o caso não for para nós, dizemos isso na primeira conversa.',
  },
  {
    pergunta: 'Quanto tempo demora um processo?',
    resposta:
      'Varia com a vara e com a complexidade. Você recebe uma estimativa realista, com a ressalva de que prazo de tribunal não depende de advogado.',
  },
];
---

<Base
  titulo="Bertoncini & Mendonça Advogados"
  descricao="Advocacia com atuação em Planejamento Patrimonial e Sucessório e em Direito Digital. Online para todo o país, presencial em Maringá, PR."
  paginaAtual="/"
  heroSobreposto={true}
>
  <Entrada />
  <Hero />
  <Letreiro />
  <Declaracao />
  <Servicos />

  <Metodo />
  <SociosPilha />

  {gruposDePerguntas.length > 0 && <Situacoes grupos={gruposDePerguntas} />}

  {ultimosTextos.length > 0 && <BlogHome artigos={ultimosTextos} />}

  <Newsletter />

  <Perguntas perguntas={perguntasDaHome} />
  {/* O bloco de contato ("Conte o que está acontecendo") saiu daqui a
      pedido do cliente: a home fecha nas publicações e nas perguntas.
      Continua nas OUTRAS seis páginas que o usam, e de propósito — lá ele
      é fim de leitura: quem terminou de ler sobre uma área precisa de um
      caminho para falar com o escritório, e cartão de blog não substitui
      isso. Na home o caminho já existe no cabeçalho, no hero e no rodapé. */}
  <AvisoCookies />
</Base>
