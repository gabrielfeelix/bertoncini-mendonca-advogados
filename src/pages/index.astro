---
/**
 * Home da v3. Ordem de site institucional de escritório, sem efeito:
 * capa em slides → áreas de atuação → o escritório → sócios → publicações → chamada.
 */
import Base from '~/layouts/Base.astro';
import Chamada from '~/components/Chamada.astro';
import HeroSlides from '~/components/HeroSlides.astro';
import IconeArea from '~/components/IconeArea.astro';
import CartaoSocio from '~/components/CartaoSocio.astro';
import CartaoArtigo from '~/components/CartaoArtigo.astro';
import { site } from '~/lib/site';
import { listarAreasConfirmadas, FOTO_DA_AREA } from '~/lib/areas';
import { listarArtigos } from '~/lib/artigos';

const areas = await listarAreasConfirmadas();
const artigos = (await listarArtigos()).slice(0, 3);
---

<Base
  titulo={`${site.nome} | Maringá/PR`}
  descricao={site.descricao}
  paginaAtual="/"
>
  <HeroSlides />

  <section class="secao">
    <div class="container">
      <div class="titulo-secao">
        <h2>Áreas de <strong>Atuação</strong></h2>
        <p>Conheça abaixo as áreas em que o escritório atua.</p>
      </div>
      <div class="grade grade-2">
        {areas.map((area) => (
          <article class="cartao">
            <img class="cartao-foto" src={FOTO_DA_AREA[area.data.slug]} alt="" width="1600" height="900" loading="lazy" />
            <div class="cartao-corpo">
              <IconeArea slug={area.data.slug} />
              <h3>{area.data.nome}</h3>
              <p>{area.data.resumo}</p>
              {area.data.publicoCurto && <p class="publico"><strong>Para quem:</strong> {area.data.publicoCurto}</p>}
              <a class="ver-mais" href={`/areas/${area.data.slug}/`}>Ver mais →</a>
            </div>
          </article>
        ))}
      </div>
      <div class="outras">
        <h3>Também atuamos em</h3>
        <ul>{site.outrasAreas.map((a) => <li>{a}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="secao secao-cinza">
    <div class="container duas-colunas">
      <img class="foto-escritorio" src="/media/hero/socios-1600.jpg" alt="Juscelino Bertoncini e Beatriz Mendonça, sócios do escritório." width="1600" height="900" loading="lazy" />
      <div>
        <p class="rotulo">O escritório</p>
        <h2 class="titulo-bloco">Sobre <strong>nós</strong></h2>
        <p>
          Bertoncini &amp; Mendonça é um escritório de advocacia de {site.cidade}/{site.estado}. Os
          sócios, Juscelino Bertoncini e Beatriz Mendonça, atuam juntos nas duas áreas do escritório.
        </p>
        <p>
          Nossa missão é ajudar pessoas, famílias e empresas a construir, proteger e transmitir o seu
          patrimônio com segurança, planejamento e tranquilidade.
        </p>
        <p>{site.atendimentoRodape}, e presencial em {site.cidade}.</p>
        <a class="botao botao-contorno" href="/escritorio/">Saiba mais</a>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="titulo-secao">
        <h2>Nossos <strong>Sócios</strong></h2>
      </div>
      <div class="grade grade-2 socios">
        {site.socios.map((socio, i) => <CartaoSocio socio={socio} genero={i === 1 ? 'a' : 'o'} />)}
      </div>
    </div>
  </section>

  {artigos.length > 0 && (
    <section class="secao secao-cinza">
      <div class="container">
        <div class="titulo-secao">
          <h2>Últimas <strong>Publicações</strong></h2>
          <p>Textos do escritório sobre as dúvidas mais comuns em cada área.</p>
        </div>
        <div class="grade grade-3">
          {artigos.map((artigo) => <CartaoArtigo artigo={artigo} />)}
        </div>
        <p class="ver-todas"><a class="botao botao-contorno" href="/blog/">Ver todas as publicações</a></p>
      </div>
    </section>
  )}

  <Chamada />
</Base>

<style>
  .cartao-foto { width: 100%; aspect-ratio: 16 / 7; object-fit: cover; }
  .publico { font-size: 15px; }
  .publico strong { color: var(--azul); }

  .foto-escritorio { border-radius: 6px; box-shadow: var(--sombra); }
  .titulo-bloco { font-size: 34px; font-weight: 300; }
  .titulo-bloco strong { font-weight: 700; }

  .outras { margin-top: 30px; padding: 24px 28px; background: var(--fundo-cinza); border-radius: 6px; display: flex; align-items: center; gap: 12px 28px; flex-wrap: wrap; }
  .outras h3 { font-size: 17px; margin: 0; }
  .outras ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .outras li { background: #fff; border: 1px solid var(--linha); border-radius: 4px; padding: 4px 12px; font-size: 15px; }

  .socios { max-width: 780px; margin: 0 auto; }
  .ver-todas { text-align: center; margin: 40px 0 0; }

  @media (max-width: 680px) {
    .titulo-bloco { font-size: 28px; }
  }
</style>
