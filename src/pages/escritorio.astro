---
/**
 * /escritorio/ — a página que responde "quem são vocês".
 *
 * Quatro blocos, cada um com a sua superfície:
 *
 * 1. ABERTURA (branco): a foto dos dois e a frase que define a sociedade.
 * 2. O ENCONTRO (azul-tinta, tela cheia): o memorável da página. Os dois
 *    sobrenomes entram cada um por um lado e se encontram no "&" enquanto
 *    a pessoa rola; três frases curtas contam a história. Substitui os
 *    parágrafos de história, que o cliente leu como "texto carregado com
 *    cara de IA".
 * 3. OS SÓCIOS (meio a meio): a tela partida em duas metades — o
 *    consultivo, antes do processo, em papel; o contencioso, dentro dele,
 *    em tinta. É a divisão do escritório virando a própria forma da seção,
 *    e junta num lugar só o que antes era cartão de área + perfil.
 * 4. REGISTRO e CONTATO.
 *
 * O MOVIMENTO é CSS puro, por linha do tempo de rolagem
 * (`animation-timeline: view()`), sem biblioteca. Onde o navegador não
 * suporta, ou com `prefers-reduced-motion`, a seção aparece parada e
 * completa — os nomes já juntos, as três frases visíveis.
 *
 * O QUE NÃO ENTRA, por decisão do cliente: a trajetória de cada um
 * (estágios, nomes de escritórios, órgãos e lugares). De experiência,
 * fica só o tempo de prática. A formação continua: é ela que sustenta o
 * título de especialista, que o Provimento 205/2021 só permite com o
 * título existente.
 *
 * Nenhum fato sobre as pessoas é inventado; o que falta está marcado com
 * `data-placeholder="1"`. A OAB de cada sócio fica em 22px — o portão
 * confere o piso nesta rota.
 */
import Base from '../layouts/Base.astro';
import Contato from '../components/Contato.astro';
import Ficha from '../components/Ficha.astro';
import { site } from '../lib/site';
import { listarAreasConfirmadas } from '../lib/areas';

const areas = await listarAreasConfirmadas();
const nomeDaArea = (slug: string) => areas.find((a) => a.data.slug === slug)?.data.nome ?? '';

/* A formação vem do briefing (q1.7a e q1.7b). "Mais de quatro anos" é o
   tempo de prática que eles contam lado a lado (q1.3) — o único número de
   experiência que o briefing sustenta. */
const pratica = 'Mais de quatro anos de prática jurídica';

const perfis = [
  {
    nome: 'Juscelino',
    sobrenome: 'Bertoncini',
    base: '/media/socios/juscelino',
    largura: 840,
    altura: 1119,
    enquadra: '50% 30%',
    socio: site.socios[0],
    lado: 'Antes do processo',
    bio: 'Especialista em direito empresarial e em advocacia consultiva. Trabalha na fase que antecede o processo (contratos, pareceres, estruturação de operações, LGPD e compliance) para que o problema não se consolide.',
    porque:
      'Sempre gostei de ler, e estudar história, filosofia e sociologia me deu um senso de justiça mais ativo. Morar sozinho para fazer a faculdade me mostrou que sou resolutivo: diante de um problema, vou atrás da saída. Na advocacia juntei as duas coisas, estudar e ajudar alguém a garantir um direito.',
    fora: 'Ler, ver filmes e séries (MasterChef incluído), jogar vôlei, viajar e conhecer cafés e restaurantes novos.',
    formacao: [
      'Bacharel em Direito pela UEM',
      'Especialista em Direito Empresarial pela PUC/RS',
      'Especialista em Advocacia Consultiva pela Legale',
      'Pós-graduando em Direito Imobiliário pela i9',
    ],
  },
  {
    nome: 'Beatriz',
    sobrenome: 'Mendonça',
    base: '/media/socios/beatriz',
    largura: 840,
    altura: 1278,
    enquadra: '50% 24%',
    socio: site.socios[1],
    lado: 'Quando há processo',
    bio: 'Especialista em processo civil, com experiência em processos judiciais estratégicos em todas as instâncias e em due diligence de operações de fusão e aquisição. Atende quem trabalha e ganha dinheiro na internet.',
    porque:
      'Na adolescência comecei a me interessar por política e por assuntos sociais. Meu pai percebeu e passou a me desafiar em debates, e eu fui gostando de argumentar e de encontrar furos nas premissas dele. Dali o Direito virou possibilidade, e na faculdade tive certeza de que queria advogar.',
    fora: 'Ler romances e histórias de investigação criminal, ir ao cinema, a cafés e restaurantes, e viajar com a família e os amigos.',
    formacao: [
      'Bacharel em Direito pela UEM',
      'Especialista em Direito Processual Civil pela PUC/RS',
      'Pós-graduanda em Direito Digital pela i9',
    ],
  },
];

/* A história em três frases, do briefing (q1.3), sem nomes de lugar de
   trabalho e sem estágio. */
const batidas = [
  'Entraram no curso de Direito da UEM no mesmo ano, ela de manhã e ele à noite, e quase não se falavam.',
  'Trabalharam mais de quatro anos no mesmo escritório, de estagiários a advogados, cada um firmando a própria área.',
  'A sociedade junta as duas: ele trabalha antes do processo, ela quando o processo existe.',
];

/* Missão e valores: texto dos sócios (briefing q3.1 e q3.2), com ajuste
   mínimo de forma. A linha de recusa (q3.5) entra em tom sóbrio, como eles
   pediram, e sem adjetivo. */
const missao =
  'Ajudar pessoas, famílias e empresas a construir, proteger e transmitir o seu patrimônio com segurança, planejamento e tranquilidade.';
const valoresFundamentais = [
  { nome: 'Respeito', texto: 'Tratamos cada pessoa, a sua história, as suas escolhas e os seus interesses com consideração, escuta e seriedade.' },
  { nome: 'Igualdade', texto: 'Toda pessoa merece o mesmo respeito e a mesma dedicação, qualquer que seja a sua origem, condição ou posição social.' },
  { nome: 'Dignidade', texto: 'Por trás de cada patrimônio, conflito ou decisão jurídica existe uma pessoa, uma família e uma história, e é assim que as tratamos.' },
];
const valoresDeAtuacao = [
  { nome: 'Clareza', texto: 'Conhecimento jurídico não deve criar distância entre o advogado e o cliente.' },
  { nome: 'Proximidade', texto: 'Conhecer a realidade do cliente para além do problema jurídico.' },
  { nome: 'Segurança', texto: 'Mais do que resolver problemas, buscar evitar que eles aconteçam.' },
  { nome: 'Planejamento', texto: 'Decisões importantes pensadas antes de se tornarem urgências.' },
  { nome: 'Responsabilidade', texto: 'Cada patrimônio tem uma história, e cada decisão tem consequências.' },
  { nome: 'Estratégia', texto: 'A melhor solução é a que faz sentido para o contexto de quem a recebe.' },
];
---

<Base
  titulo="O escritório | Bertoncini & Mendonça Advogados"
  descricao="Quem somos: os dois sócios de Bertoncini & Mendonça, em Maringá, com inscrição na OAB do Paraná, formação, áreas de atuação e contato direto."
  paginaAtual="/escritorio/"
>
  <!-- 1. ABERTURA -->
  <section class="abertura">
    <div class="env">
      <div class="placa-abre">
        <picture class="retrato">
          {/* No celular entra o recorte 4:5 já gerado para o hero da home:
              ampliar o panorâmico 21:9 numa tela estreita sobrava só um
              rosto e cortava o outro sócio fora. */}
          <source media="(max-width: 820px)" type="image/avif" srcset="/media/hero/socios-vert-600.avif 600w, /media/hero/socios-vert-800.avif 800w" sizes="100vw" />
          <source media="(max-width: 820px)" type="image/webp" srcset="/media/hero/socios-vert-600.webp 600w, /media/hero/socios-vert-800.webp 800w" sizes="100vw" />
          <source type="image/avif" srcset="/media/hero/escritorio-1200.avif 1200w, /media/hero/escritorio-1600.avif 1600w" sizes="100vw" />
          <source type="image/webp" srcset="/media/hero/escritorio-1200.webp 1200w, /media/hero/escritorio-1600.webp 1600w" sizes="100vw" />
          <img
            src="/media/hero/escritorio-1600.jpg"
            alt="Juscelino Bertoncini e Beatriz Mendonça, os dois sócios do escritório"
            width="1672"
            height="717"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <div class="dizer" data-contraste="externo">
          <p class="chapeu">O escritório</p>
          <h1 class="display">Somos dois advogados, e é com um de nós que você fala.</h1>
        </div>
      </div>

      <p class="linha-fina">
        Uma sociedade nova, com base em Maringá e atendimento online para todo o país. Quem
        recebe o caso na primeira conversa é quem responde por ele até o fim, e a conversa é
        em português claro, sem distância entre quem advoga e quem é atendido.
      </p>
    </div>
  </section>

  <!-- 2. O ENCONTRO. A seção é alta (a rolagem dentro dela é a linha do
       tempo da animação) e o conteúdo fica preso na tela enquanto isso.
       Sem suporte, a altura volta ao normal e tudo aparece parado. -->
  <section class="encontro" aria-labelledby="encontro-titulo">
    <div class="encontro-tela">
      <span class="fio" aria-hidden="true"></span>
      <h2 class="encontro-nomes" id="encontro-titulo">
        <span class="nome nome-b">Bertoncini</span>
        <span class="e" aria-hidden="true">&amp;</span>
        <span class="visualmente-oculto"> e </span>
        <span class="nome nome-m">Mendonça</span>
      </h2>
      <ol class="batidas">
        {batidas.map((frase, n) => <li style={`--n:${n}`}>{frase}</li>)}
      </ol>
      <p class="encontro-nota" data-placeholder="1">Data de constituição da sociedade a confirmar com os sócios.</p>
    </div>
  </section>

  <!-- 3. OS SÓCIOS. Meio a meio, sem a coluna do `.env`: a divisão vai de
       borda a borda. A ordem no HTML é a de leitura, e em celular as duas
       metades empilham. -->
  <section class="socios-meio" id="socios" aria-labelledby="socios-titulo">
    <h2 class="visualmente-oculto" id="socios-titulo">Os sócios</h2>
    {perfis.map((perfil, n) => (
      <article class:list={['metade', n === 0 ? 'clara' : 'escura']}>
        <div class="metade-dentro">
          <p class="lado">{perfil.lado}</p>

          <div class="foto">
            <picture>
              <source type="image/avif" srcset={`${perfil.base}-560.avif 560w, ${perfil.base}-840.avif 840w`} sizes="(max-width: 900px) 70vw, 24vw" />
              <source type="image/webp" srcset={`${perfil.base}-560.webp 560w, ${perfil.base}-840.webp 840w`} sizes="(max-width: 900px) 70vw, 24vw" />
              <img
                src={`${perfil.base}-840.jpg`}
                alt={`Retrato de ${perfil.nome} ${perfil.sobrenome}`}
                width={perfil.largura}
                height={perfil.altura}
                loading="lazy"
                decoding="async"
                style={`object-position:${perfil.enquadra}`}
              />
            </picture>
          </div>

          <h3 class="nome-socio">{perfil.nome}<br />{perfil.sobrenome}</h3>

          <a class="area" href={`/areas/${perfil.socio.area}/`}>
            {nomeDaArea(perfil.socio.area)}
            <span class="seta" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          </a>

          <p class="bio">{perfil.bio}</p>

          <figure class="porque">
            <blockquote><p>{perfil.porque}</p></blockquote>
            <figcaption>Por que o Direito, nas palavras de {perfil.nome}</figcaption>
          </figure>

          <p class="oab" data-placeholder={perfil.socio.oab.placeholder ? '1' : undefined}>
            <span class="oab-rotulo">Inscrição na Ordem</span>
            <span class="oab-numero">{perfil.socio.oab.valor}</span>
          </p>

          <dl class="dados">
            <div>
              <dt>Prática</dt>
              <dd>{pratica}</dd>
            </div>
            <div>
              <dt>Formação</dt>
              <dd>
                <ul>{perfil.formacao.map((item) => <li>{item}</li>)}</ul>
              </dd>
            </div>
            <div>
              <dt>Fora daqui</dt>
              <dd>{perfil.fora}</dd>
            </div>
            <div>
              <dt>Contato</dt>
              <dd class="contato">
                <a href={`mailto:${site.email.valor}`} data-placeholder={site.email.placeholder ? '1' : undefined}>{site.email.valor}</a>
                <a href={`tel:${site.telefoneE164.valor}`} data-placeholder={site.telefone.placeholder ? '1' : undefined}>{site.telefone.valor}</a>
              </dd>
            </div>
          </dl>
        </div>
      </article>
    ))}
  </section>

  <!-- 3b. O QUE ORIENTA O TRABALHO: missão, valores e a linha de recusa. -->
  <section class="valores" aria-labelledby="valores-titulo">
    <div class="env">
      <div class="missao">
        <p class="chapeu-valores">Missão</p>
        <h2 id="valores-titulo" class="missao-texto">{missao}</h2>
        <p class="missao-apoio">
          Estamos ao lado dos nossos clientes nas decisões que estruturam o patrimônio e o futuro
          deles, com orientação clara, próxima e estratégica, para que escolhas importantes sejam
          feitas com consciência.
        </p>
      </div>

      <div class="fundamentais">
        <h3 class="rotulo-valores">Valores fundamentais</h3>
        <ol>
          {valoresFundamentais.map((valor, n) => (
            <li>
              <span class="num" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
              <h4>{valor.nome}</h4>
              <p>{valor.texto}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="atuacao">
        <h3 class="rotulo-valores">Como isso aparece no trabalho</h3>
        <dl>
          {valoresDeAtuacao.map((valor) => (
            <div>
              <dt>{valor.nome}</dt>
              <dd>{valor.texto}</dd>
            </div>
          ))}
        </dl>
      </div>

      <p class="recusa">
        <strong>O que não aceitamos.</strong> Não atuamos em casos que favoreçam a propagação do
        machismo, do racismo ou da homofobia.
      </p>
    </div>
  </section>

  <!-- 4. REGISTRO: exigência do Provimento 205/2021, em ficha, visível e
       não no rodapé. -->
  <section class="registro-secao">
    <div class="env">
      <div class="registro-cabeca">
        <h2 class="titulo-registro">Registro da sociedade</h2>
        <p class="apoio-registro">
          Inscrita na Ordem dos Advogados do Brasil, Seccional do Paraná. Dados exigidos pelo
          Provimento 205/2021.
        </p>
      </div>
      <Ficha
        rotulo="Dados de registro da sociedade"
        itens={[
          { rotulo: 'Registro na OAB/PR', valor: site.registro.oabSociedade.valor, placeholder: site.registro.oabSociedade.placeholder, destaque: true },
          { rotulo: 'Sociedade', valor: site.nomeSociedade },
          { rotulo: 'CNPJ', valor: site.registro.cnpj.valor, placeholder: site.registro.cnpj.placeholder },
          { rotulo: 'Base', valor: `${site.cidade}, ${site.estado}` },
        ]}
      />
    </div>
  </section>

  <Contato
    titulo="Fale com um dos dois."
    horario="Segunda a sexta, das 9h às 18h. Fora do horário a mensagem fica registrada."
  />
</Base>

<style>
  /* ── 3b. valores ──────────────────────────────────────────────────── */
  .valores {
    padding-block: clamp(72px, 9vw, 150px) clamp(40px, 5vw, 72px);
  }
  .missao {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    max-width: 1100px;
    margin-bottom: clamp(48px, 6vw, 96px);
  }
  .chapeu-valores,
  .rotulo-valores {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--imperial);
  }
  .missao-texto {
    font-family: var(--serif);
    font-weight: 200;
    font-size: clamp(30px, 4.2vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .missao-apoio {
    max-width: 60ch;
    font-size: 19px;
    color: var(--secundario);
  }
  .fundamentais ol {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .fundamentais li {
    background: var(--tinta);
    color: #fff;
    border-radius: clamp(16px, 2vw, 24px);
    padding: clamp(24px, 2.8vw, 40px);
    min-height: 260px;
    display: flex;
    flex-direction: column;
  }
  .fundamentais .num {
    font-family: var(--serif);
    font-size: 20px;
    color: #ef7a8d;
  }
  .fundamentais h4 {
    margin: 0 0 12px;
    padding-top: clamp(40px, 5vw, 72px);
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(30px, 3vw, 42px);
    letter-spacing: -0.02em;
  }
  .fundamentais li p {
    font-size: 17px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.84);
  }
  .atuacao {
    margin-top: clamp(40px, 5vw, 72px);
  }
  .atuacao dl {
    margin: 18px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--linha);
  }
  .atuacao dl > div {
    padding: 22px 24px 26px 0;
    border-bottom: 1px solid var(--linha);
  }
  .atuacao dt {
    font-family: var(--serif);
    font-size: 24px;
    margin-bottom: 6px;
  }
  .atuacao dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--secundario);
    max-width: 34ch;
  }
  .recusa {
    margin-top: clamp(36px, 4vw, 56px);
    padding: 20px 24px;
    border-radius: 14px;
    background: var(--papel);
    border-left: 3px solid var(--tinta);
    font-size: 18px;
    max-width: 80ch;
  }
  @media (max-width: 980px) {
    .fundamentais ol,
    .atuacao dl {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .fundamentais ol,
    .atuacao dl {
      grid-template-columns: 1fr;
    }
    .fundamentais li {
      min-height: 0;
    }
  }

  /* ── por que o Direito ─────────────────────────────────────────────── */
  .porque {
    margin: 22px 0 0;
    padding: 18px 0 0 20px;
    border-left: 2px solid var(--imperial);
  }
  .porque blockquote {
    margin: 0;
  }
  .porque blockquote p {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 19px;
    line-height: 1.5;
  }
  .porque figcaption {
    margin-top: 10px;
    font-size: 16px;
    opacity: 0.8;
  }

  .visualmente-oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── 1. abertura ──────────────────────────────────────────────────── */

  .abertura {
    padding-block: clamp(20px, 3vw, 36px) clamp(48px, 6vw, 96px);
  }
  .placa-abre {
    position: relative;
    border-radius: clamp(16px, 2vw, 28px);
    overflow: hidden;
    background: var(--tinta);
    isolation: isolate;
  }
  .retrato,
  .retrato img {
    display: block;
    width: 100%;
  }
  .retrato img {
    aspect-ratio: 21 / 9;
    object-fit: cover;
    object-position: 58% 30%;
  }
  /* Escurecimento NEUTRO apenas onde há texto: a foto mantém a cor. */
  .placa-abre::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.68) 0%, rgba(0, 0, 0, 0.4) 34%, transparent 56%);
    pointer-events: none;
  }
  .dizer {
    position: absolute;
    z-index: 2;
    inset-block: 0;
    inset-inline-start: 0;
    width: min(56%, 46ch);
    padding: clamp(24px, 3.4vw, 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #fff;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.6), 0 1px 3px rgba(0, 0, 0, 0.45);
  }
  .chapeu {
    font-size: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
    opacity: 0.88;
  }
  .abertura h1 {
    font-size: clamp(30px, 3.9vw, 62px);
    max-width: 15ch;
  }
  .linha-fina {
    margin: clamp(28px, 3.4vw, 48px) 0 0;
    max-width: 44ch;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.38;
    color: var(--tinta);
  }
  @media (max-width: 820px) {
    .retrato img {
      aspect-ratio: 4 / 5;
      object-position: 50% 18%;
      max-height: 58svh;
    }
    .placa-abre::after {
      background: linear-gradient(0deg, rgba(0, 0, 0, 0.55) 0%, transparent 45%);
    }
    .dizer {
      position: static;
      width: auto;
      background: var(--tinta);
      padding-block: clamp(24px, 5vw, 34px);
    }
    .abertura h1 {
      font-size: clamp(28px, 7vw, 40px);
      max-width: 18ch;
    }
  }

  /* ── 2. o encontro ────────────────────────────────────────────────── */

  /*
    Estado PARADO (sem suporte ou com movimento reduzido): uma seção
    escura comum, nomes juntos, frases visíveis. Tudo o que se move está
    no @supports mais abaixo.
  */
  .encontro {
    position: relative;
    background: var(--tinta);
    color: #fff;
    overflow: clip;
  }
  .encontro-tela {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(36px, 5vw, 64px);
    min-height: min(100svh, 860px);
