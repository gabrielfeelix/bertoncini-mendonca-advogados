---
/**
 * /escritorio/ — a página que responde "quem são vocês".
 *
 * Quatro blocos, cada um com a sua superfície:
 *
 * 1. ABERTURA (branco): a foto dos dois e a frase que define a sociedade.
 * 2. O ENCONTRO (azul-tinta, tela cheia): o memorável da página. Os dois
 *    sobrenomes entram cada um por um lado e se encontram no "&" enquanto
 *    a pessoa rola; três frases curtas contam a história. Substitui os
 *    parágrafos de história, que o cliente leu como "texto carregado com
 *    cara de IA".
 * 3. OS SÓCIOS (meio a meio): a tela partida em duas metades — o
 *    consultivo, antes do processo, em papel; o contencioso, dentro dele,
 *    em tinta. É a divisão do escritório virando a própria forma da seção,
 *    e junta num lugar só o que antes era cartão de área + perfil.
 * 4. REGISTRO e CONTATO.
 *
 * O MOVIMENTO é CSS puro, por linha do tempo de rolagem
 * (`animation-timeline: view()`), sem biblioteca. Onde o navegador não
 * suporta, ou com `prefers-reduced-motion`, a seção aparece parada e
 * completa — os nomes já juntos, as três frases visíveis.
 *
 * O QUE NÃO ENTRA, por decisão do cliente: a trajetória de cada um
 * (estágios, nomes de escritórios, órgãos e lugares). De experiência,
 * fica só o tempo de prática. A formação continua: é ela que sustenta o
 * título de especialista, que o Provimento 205/2021 só permite com o
 * título existente.
 *
 * Nenhum fato sobre as pessoas é inventado; o que falta está marcado com
 * `data-placeholder="1"`. A OAB de cada sócio fica em 22px — o portão
 * confere o piso nesta rota.
 */
import Base from '../layouts/Base.astro';
import Contato from '../components/Contato.astro';
import Ficha from '../components/Ficha.astro';
import { site } from '../lib/site';
import { listarAreasConfirmadas } from '../lib/areas';

const areas = await listarAreasConfirmadas();
const nomeDaArea = (slug: string) => areas.find((a) => a.data.slug === slug)?.data.nome ?? '';

/* A formação vem do briefing (q1.7a e q1.7b). "Mais de quatro anos" é o
   tempo de prática que eles contam lado a lado (q1.3) — o único número de
   experiência que o briefing sustenta. */
const pratica = 'Mais de quatro anos de prática jurídica';

const perfis = [
  {
    nome: 'Juscelino',
    sobrenome: 'Bertoncini',
    base: '/media/socios/juscelino',
    largura: 840,
    altura: 1119,
    enquadra: '50% 30%',
    socio: site.socios[0],
    lado: 'Antes do processo',
    bio: 'Especialista em direito empresarial e em advocacia consultiva. Trabalha na fase que antecede o processo (contratos, pareceres, estruturação de operações, LGPD e compliance) para que o problema não se consolide.',
    porque:
      'Sempre gostei de ler, e estudar história, filosofia e sociologia me deu um senso de justiça mais ativo. Morar sozinho para fazer a faculdade me mostrou que sou resolutivo: diante de um problema, vou atrás da saída. Na advocacia juntei as duas coisas, estudar e ajudar alguém a garantir um direito.',
    fora: 'Ler, ver filmes e séries (MasterChef incluído), jogar vôlei, viajar e conhecer cafés e restaurantes novos.',
    formacao: [
      'Bacharel em Direito pela UEM',
      'Especialista em Direito Empresarial pela PUC/RS',
      'Especialista em Advocacia Consultiva pela Legale',
      'Pós-graduando em Direito Imobiliário pela i9',
    ],
  },
  {
    nome: 'Beatriz',
    sobrenome: 'Mendonça',
    base: '/media/socios/beatriz',
    largura: 840,
    altura: 1278,
    enquadra: '50% 24%',
    socio: site.socios[1],
    lado: 'Quando há processo',
    bio: 'Especialista em processo civil, com experiência em processos judiciais estratégicos em todas as instâncias e em due diligence de operações de fusão e aquisição. Atende quem trabalha e ganha dinheiro na internet.',
    porque:
      'Na adolescência comecei a me interessar por política e por assuntos sociais. Meu pai percebeu e passou a me desafiar em debates, e eu fui gostando de argumentar e de encontrar furos nas premissas dele. Dali o Direito virou possibilidade, e na faculdade tive certeza de que queria advogar.',
    fora: 'Ler romances e histórias de investigação criminal, ir ao cinema, a cafés e restaurantes, e viajar com a família e os amigos.',
    formacao: [
      'Bacharel em Direito pela UEM',
      'Especialista em Direito Processual Civil pela PUC/RS',
      'Pós-graduanda em Direito Digital pela i9',
    ],
  },
];

/* A história em três frases, do briefing (q1.3), sem nomes de lugar de
   trabalho e sem estágio. */
const batidas = [
  'Entraram no curso de Direito da UEM no mesmo ano, ela de manhã e ele à noite, e quase não se falavam.',
  'Trabalharam mais de quatro anos no mesmo escritório, de estagiários a advogados, cada um firmando a própria área.',
  'A sociedade junta as duas: ele trabalha antes do processo, ela quando o processo existe.',
];

/* Missão e valores: texto dos sócios (briefing q3.1 e q3.2), com ajuste
   mínimo de forma. A linha de recusa (q3.5) entra em tom sóbrio, como eles
   pediram, e sem adjetivo. */
const missao =
  'Ajudar pessoas, famílias e empresas a construir, proteger e transmitir o seu patrimônio com segurança, planejamento e tranquilidade.';
const valoresFundamentais = [
  { nome: 'Respeito', texto: 'Tratamos cada pessoa, a sua história, as suas escolhas e os seus interesses com consideração, escuta e seriedade.' },
  { nome: 'Igualdade', texto: 'Toda pessoa merece o mesmo respeito e a mesma dedicação, qualquer que seja a sua origem, condição ou posição social.' },
  { nome: 'Dignidade', texto: 'Por trás de cada patrimônio, conflito ou decisão jurídica existe uma pessoa, uma família e uma história, e é assim que as tratamos.' },
];
const valoresDeAtuacao = [
  { nome: 'Clareza', texto: 'Conhecimento jurídico não deve criar distância entre o advogado e o cliente.' },
  { nome: 'Proximidade', texto: 'Conhecer a realidade do cliente para além do problema jurídico.' },
  { nome: 'Segurança', texto: 'Mais do que resolver problemas, buscar evitar que eles aconteçam.' },
  { nome: 'Planejamento', texto: 'Decisões importantes pensadas antes de se tornarem urgências.' },
  { nome: 'Responsabilidade', texto: 'Cada patrimônio tem uma história, e cada decisão tem consequências.' },
  { nome: 'Estratégia', texto: 'A melhor solução é a que faz sentido para o contexto de quem a recebe.' },
];
---

<Base
  titulo="O escritório | Bertoncini & Mendonça Advogados"
  descricao="Quem somos: os dois sócios de Bertoncini & Mendonça, em Maringá, com inscrição na OAB do Paraná, formação, áreas de atuação e contato direto."
  paginaAtual="/escritorio/"
>
  {/* Redesenho de 21/10/2026, a partir da página "About" de
      marketinglab.framer.ai: declaração que se acende na rolagem, fatos em
      cartões, a história sobre um fundo parado, as pessoas, os valores e o
      registro. O conteúdo é o mesmo de antes (briefing de 23/09). */}

  <!-- 1. ABERTURA -->
  <section class="abertura">
    <div class="env">
      <p class="rotulo-pagina">O escritório</p>
      <h1 class="grande">
        <b>Somos dois advogados, e é com um de nós que você fala.</b>{' '}
        <span data-palavras>
          Juscelino trabalha antes do processo, para que o problema não se consolide. Beatriz, quando o
          processo existe. Entre os dois, o mesmo cuidado com o que é seu.
        </span>
      </h1>
    </div>
  </section>

  <!-- 2. FATOS -->
  <section class="fatos" aria-labelledby="fatos-titulo">
    <div class="env">
      <header class="cab-centro">
        <h2 id="fatos-titulo" class="sobe">Em poucas linhas</h2>
        <p class="sobe">O que dá para dizer sobre o escritório sem prometer resultado, que é o que a Ordem permite e o que nós preferimos.</p>
      </header>
      <div class="grade-fatos">
        <figure class="fato missao-cartao sobe">
          <svg class="aspas" width="34" height="26" viewBox="0 0 34 26" fill="currentColor" aria-hidden="true"><path d="M0 26V15.6Q0 7.8 4.3 3.9 8.5 0 15 0v5.2q-4 0-6.2 2.1-2.1 2.1-2.1 6h7.8V26H0Zm19 0V15.6q0-7.8 4.3-11.7Q27.5 0 34 0v5.2q-4 0-6.2 2.1-2.1 2.1-2.1 6h7.8V26H19Z"/></svg>
          <blockquote><p>{missao}</p></blockquote>
          <figcaption>
            <span class="avatares" aria-hidden="true">
              <img src="/media/socios/juscelino-560.webp" alt="" width="36" height="36" loading="lazy" />
              <img src="/media/socios/beatriz-560.webp" alt="" width="36" height="36" loading="lazy" style="object-position:50% 20%" />
            </span>
            A missão do escritório
          </figcaption>
        </figure>
        <div class="fato sobe"><strong>4+</strong><span>anos de prática jurídica</span></div>
        <div class="fato sobe"><strong>2</strong><span>sócios, uma área cada</span></div>
        <div class="fato sobe"><strong>UEM</strong><span>onde os dois se formaram</span></div>
        <div class="fato sobe"><strong>Brasil</strong><span>atendimento online em todo o país</span></div>
      </div>
    </div>
  </section>

  <!-- 3. A HISTÓRIA, sobre um fundo parado -->
  <section class="historia" aria-labelledby="historia-titulo">
    <div class="historia-fundo" aria-hidden="true">
<picture>
            <source type="image/avif" srcset="/media/novas/escritorio-historia.avif" />
            <source type="image/webp" srcset="/media/novas/escritorio-historia.webp" />
            <img src="/media/novas/escritorio-historia.jpg" alt="" width="1664" height="936" loading="lazy" decoding="async" />
          </picture>
    </div>
    <div class="env historia-corpo">
      <header>
        <h2 id="historia-titulo">Como chegamos aqui</h2>
        <p>Da mesma turma de faculdade à mesma sociedade.</p>
      </header>
      <ol class="linhas-historia">
        {batidas.map((frase, n) => (
          <li class="sobe">
            <span class="num">({String(n + 1).padStart(2, '0')})</span>
            <span class="marco">{['UEM', 'O mesmo escritório', 'A sociedade'][n]}</span>
            <p>{frase}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. AS PESSOAS -->
  <section class="pessoas" id="socios" aria-labelledby="pessoas-titulo">
    <div class="env">
      <header class="cab-centro">
        <h2 id="pessoas-titulo" class="sobe">Quem atende você</h2>
        <p class="sobe">Do primeiro contato ao fim do caso, um dos dois. Sem repasse.</p>
      </header>
      <div class="duas">
        {perfis.map((perfil) => (
          <article class="perfil sobe">
            <div class="retrato">
              <picture>
                <source type="image/avif" srcset={`${perfil.base}-560.avif 560w, ${perfil.base}-840.avif 840w`} sizes="(max-width: 900px) 92vw, 46vw" />
                <source type="image/webp" srcset={`${perfil.base}-560.webp 560w, ${perfil.base}-840.webp 840w`} sizes="(max-width: 900px) 92vw, 46vw" />
                <img src={`${perfil.base}-840.jpg`} alt={`Retrato de ${perfil.nome} ${perfil.sobrenome}`} width={perfil.largura} height={perfil.altura} loading="lazy" style={`object-position:${perfil.enquadra}`} />
              </picture>
              <span class="lado">{perfil.lado}</span>
            </div>
            <div class="sobre">
              <h3>{perfil.nome} {perfil.sobrenome}</h3>
              <p class="oab" data-placeholder={perfil.socio.oab.placeholder ? '1' : undefined}>
                <span>Inscrição na Ordem</span> {perfil.socio.oab.valor}
              </p>
              <p class="bio">{perfil.bio}</p>
              <figure class="porque">
                <blockquote><p>“{perfil.porque}”</p></blockquote>
                <figcaption>Por que o Direito, nas palavras de {perfil.nome}</figcaption>
              </figure>
              <dl>
                <div>
                  <dt>Formação</dt>
                  <dd><ul>{perfil.formacao.map((item) => <li>{item}</li>)}</ul></dd>
                </div>
                <div>
                  <dt>Fora do escritório</dt>
                  <dd>{perfil.fora}</dd>
                </div>
              </dl>
              <a class="botao contorno" href={`/areas/${perfil.socio.area}/`}>
                {nomeDaArea(perfil.socio.area)}
                <span class="disco" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="#fff" stroke-width="1.6" stroke-linecap="round" /></svg></span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. VALORES -->
  <section class="valores" aria-labelledby="valores-titulo">
    <div class="env">
      <header class="cab-lado">
        <h2 id="valores-titulo" class="sobe">Nossos valores</h2>
        <p class="sobe">
          Estamos ao lado dos nossos clientes nas decisões que estruturam o patrimônio e o futuro deles,
          com orientação clara, próxima e estratégica.
        </p>
      </header>
      <div class="grade-valores">
        <figure class="foto-valores sobe">
<picture>
            <source type="image/avif" srcset="/media/novas/escritorio-valores.avif" />
            <source type="image/webp" srcset="/media/novas/escritorio-valores.webp" />
            <img src="/media/novas/escritorio-valores.jpg" alt="" width="1200" height="900" loading="lazy" decoding="async" />
          </picture>
        </figure>
        {valoresFundamentais.map((valor, n) => (
          <div class="valor sobe">
            <span class="icone" aria-hidden="true">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                {n === 0 && (<><path d="M7 15.5c-1.6-1-2.5-2.7-2.5-4.6a7.5 7.5 0 0 1 15 0c0 3-1.7 4.3-3 5.3-.9.7-1.5 1.3-1.5 2.5a2.5 2.5 0 0 1-5 0" /><path d="M9.5 11a2.5 2.5 0 0 1 5 0" /></>)}
                {n === 1 && (<><circle cx="12" cy="12" r="8.5" /><path d="M8 10h8M8 14h8" /></>)}
                {n === 2 && (<><path d="M4 11 12 4.5l8 6.5" /><path d="M6 9.5V19.5h12V9.5" /><circle cx="12" cy="13" r="2" /><path d="M9 19.5c0-1.7 1.3-3 3-3s3 1.3 3 3" /></>)}
              </svg>
            </span>
            <h3>{valor.nome}</h3>
            <p>{valor.texto}</p>
          </div>
        ))}
      </div>

      <h3 class="rotulo-atuacao sobe">Como isso aparece no trabalho</h3>
      <ol class="atuacao">
        {valoresDeAtuacao.map((valor, n) => (
          <li class="sobe">
            <span class="num">{String(n + 1).padStart(2, '0')}</span>
            <h4>{valor.nome}</h4>
            <p>{valor.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. REGISTRO -->
  <section class="registro-secao">
    <div class="env">
      <h2 class="titulo-registro">Registro da sociedade</h2>
      <Ficha
        rotulo="Dados de registro da sociedade"
        itens={[
          { rotulo: 'Registro na OAB/PR', valor: site.registro.oabSociedade.valor, placeholder: site.registro.oabSociedade.placeholder, destaque: true },
          { rotulo: 'Sociedade', valor: site.nomeSociedade },
          { rotulo: 'CNPJ', valor: site.registro.cnpj.valor, placeholder: site.registro.cnpj.placeholder },
          { rotulo: 'Base', valor: `${site.cidade}, ${site.estado}` },
        ]}
      />
    </div>
  </section>

  <Contato
    titulo="Fale com um dos dois."
    horario="Segunda a sexta, das 9h às 18h. Fora do horário a mensagem fica registrada."
  />
</Base>

<style>
  /* ── comuns ─────────────────────────────────────────────────────── */
  .cab-centro {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 14px;
    margin-bottom: clamp(36px, 4.4vw, 60px);
  }
  .cab-centro h2,
  .cab-lado h2,
  .historia h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .cab-centro h2,
  .cab-lado h2 {
    color: var(--tinta);
  }
  .cab-centro p,
  .cab-lado p {
    max-width: 50ch;
    font-size: 18px;
    color: var(--secundario);
  }

  /* ── 1. abertura ────────────────────────────────────────────────── */
  .abertura {
    padding-block: clamp(140px, 16vw, 220px) clamp(64px, 8vw, 120px);
  }
  .abertura .env {
    display: grid;
    grid-template-columns: minmax(160px, 1fr) 3fr;
    gap: clamp(24px, 5vw, 96px);
  }
  .rotulo-pagina {
    padding-top: 0.7em;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secundario);
  }
  .grande {
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(28px, 3.2vw, 46px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--tinta);
    max-width: 30ch;
  }
  .grande b {
    font-weight: 600;
  }
  :global(.js) [data-palavras] :global(.w) {
    display: inline-block;
    opacity: 0.62;
  }

  /* ── 2. fatos ───────────────────────────────────────────────────── */
  .fatos {
    padding-block: clamp(40px, 5vw, 80px) clamp(72px, 9vw, 130px);
  }
  .grade-fatos {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 14px;
  }
  .fato {
    margin: 0;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 26px;
    border-radius: 20px;
    background: var(--papel);
    box-shadow: inset 0 0 0 1px var(--linha);
    color: var(--tinta);
  }
  .fato strong {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .fato span {
    font-size: 17px;
    color: var(--secundario);
  }
  .missao-cartao {
    grid-row: span 2;
    justify-content: space-between;
    background:
      radial-gradient(120% 80% at 100% 100%, rgba(155, 28, 46, 0.55), transparent 60%),
      linear-gradient(160deg, #173a6e, var(--tinta));
    color: #fff;
    box-shadow: none;
  }
  .missao-cartao blockquote {
    margin: 24px 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(24px, 2.3vw, 32px);
    line-height: 1.22;
    letter-spacing: -0.015em;
  }
  .missao-cartao figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.8);
  }
  .avatares {
    display: flex;
  }
  .avatares img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--tinta);
  }
  .avatares img + img {
    margin-left: -10px;
  }

  /* ── 3. história ────────────────────────────────────────────────── */
  .historia {
    position: relative;
    background: #050e22;
    color: #fff;
  }
  .historia-fundo {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .historia-fundo picture,
  .foto-valores picture {
    display: contents;
  }
  .historia-fundo img {
    width: 100%;
    height: 100%;
    object-fit: cover;

  }
  .historia-fundo::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Vinheta preta, por contraste: a foto não é tingida. */
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.2) 45%, rgba(0, 0, 0, 0.7));
  }
  .historia-corpo {
    position: relative;
    margin-top: -100vh;
    min-height: 100vh;
    padding-block: clamp(80px, 10vw, 140px);
  }
  .historia header p {
    margin-top: 12px;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
  }
  .linhas-historia {
    list-style: none;
    margin: clamp(48px, 10vh, 120px) 0 0 auto;
    padding: 0;
    max-width: 880px;
  }
  .linhas-historia li {
    display: grid;
    grid-template-columns: 70px 1fr 1.4fr;
    gap: 24px;
    align-items: baseline;
    padding-block: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .linhas-historia li:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }
  .linhas-historia .num {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.55);
  }
  .marco {
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(20px, 2vw, 26px);
    letter-spacing: -0.02em;
  }
  .linhas-historia p {
    font-size: 17px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
  }

  /* ── 4. pessoas ─────────────────────────────────────────────────── */
  .pessoas {
    padding-block: clamp(80px, 10vw, 140px);
  }
  .duas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3vw, 44px);
    align-items: start;
  }
  .retrato {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 22px;
    overflow: hidden;
