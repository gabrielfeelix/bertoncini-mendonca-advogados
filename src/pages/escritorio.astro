---
/**
 * /escritorio/ — a página que responde "quem são vocês".
 *
 * Quatro blocos, cada um com a sua superfície:
 *
 * 1. ABERTURA (branco): a foto dos dois e a frase que define a sociedade.
 * 2. O ENCONTRO (azul-tinta, tela cheia): o memorável da página. Os dois
 *    sobrenomes entram cada um por um lado e se encontram no "&" enquanto
 *    a pessoa rola; três frases curtas contam a história. Substitui os
 *    parágrafos de história, que o cliente leu como "texto carregado com
 *    cara de IA".
 * 3. OS SÓCIOS (meio a meio): a tela partida em duas metades — o
 *    consultivo, antes do processo, em papel; o contencioso, dentro dele,
 *    em tinta. É a divisão do escritório virando a própria forma da seção,
 *    e junta num lugar só o que antes era cartão de área + perfil.
 * 4. REGISTRO e CONTATO.
 *
 * O MOVIMENTO é CSS puro, por linha do tempo de rolagem
 * (`animation-timeline: view()`), sem biblioteca. Onde o navegador não
 * suporta, ou com `prefers-reduced-motion`, a seção aparece parada e
 * completa — os nomes já juntos, as três frases visíveis.
 *
 * O QUE NÃO ENTRA, por decisão do cliente: a trajetória de cada um
 * (estágios, nomes de escritórios, órgãos e lugares). De experiência,
 * fica só o tempo de prática. A formação continua: é ela que sustenta o
 * título de especialista, que o Provimento 205/2021 só permite com o
 * título existente.
 *
 * Nenhum fato sobre as pessoas é inventado; o que falta está marcado com
 * `data-placeholder="1"`. A OAB de cada sócio fica em 22px — o portão
 * confere o piso nesta rota.
 */
import Base from '../layouts/Base.astro';
import Contato from '../components/Contato.astro';
import Ficha from '../components/Ficha.astro';
import { site } from '../lib/site';
import { listarAreasConfirmadas } from '../lib/areas';

const areas = await listarAreasConfirmadas();
const nomeDaArea = (slug: string) => areas.find((a) => a.data.slug === slug)?.data.nome ?? '';

/* A formação vem do briefing (q1.7a e q1.7b). "Mais de quatro anos" é o
   tempo de prática que eles contam lado a lado (q1.3) — o único número de
   experiência que o briefing sustenta. */
const pratica = 'Mais de quatro anos de prática jurídica';

const perfis = [
  {
    nome: 'Juscelino',
    sobrenome: 'Bertoncini',
    base: '/media/socios/juscelino',
    largura: 840,
    altura: 1119,
    enquadra: '50% 30%',
    socio: site.socios[0],
    lado: 'Antes do processo',
    bio: 'Especialista em direito empresarial e em advocacia consultiva. Trabalha na fase que antecede o processo (contratos, pareceres, estruturação de operações, LGPD e compliance) para que o problema não se consolide.',
    porque:
      'Sempre gostei de ler, e estudar história, filosofia e sociologia me deu um senso de justiça mais ativo. Morar sozinho para fazer a faculdade me mostrou que sou resolutivo: diante de um problema, vou atrás da saída. Na advocacia juntei as duas coisas, estudar e ajudar alguém a garantir um direito.',
    fora: 'Ler, ver filmes e séries (MasterChef incluído), jogar vôlei, viajar e conhecer cafés e restaurantes novos.',
    formacao: [
      'Bacharel em Direito pela UEM',
      'Especialista em Direito Empresarial pela PUC/RS',
      'Especialista em Advocacia Consultiva pela Legale',
      'Pós-graduando em Direito Imobiliário pela i9',
    ],
  },
  {
    nome: 'Beatriz',
    sobrenome: 'Mendonça',
    base: '/media/socios/beatriz',
    largura: 840,
    altura: 1278,
    enquadra: '50% 24%',
    socio: site.socios[1],
    lado: 'Quando há processo',
    bio: 'Especialista em processo civil, com experiência em processos judiciais estratégicos em todas as instâncias e em due diligence de operações de fusão e aquisição. Atende quem trabalha e ganha dinheiro na internet.',
    porque:
      'Na adolescência comecei a me interessar por política e por assuntos sociais. Meu pai percebeu e passou a me desafiar em debates, e eu fui gostando de argumentar e de encontrar furos nas premissas dele. Dali o Direito virou possibilidade, e na faculdade tive certeza de que queria advogar.',
    fora: 'Ler romances e histórias de investigação criminal, ir ao cinema, a cafés e restaurantes, e viajar com a família e os amigos.',
    formacao: [
      'Bacharel em Direito pela UEM',
      'Especialista em Direito Processual Civil pela PUC/RS',
      'Pós-graduanda em Direito Digital pela i9',
    ],
  },
];

/* A história em três frases, do briefing (q1.3), sem nomes de lugar de
   trabalho e sem estágio. */
const batidas = [
  'Entraram no curso de Direito da UEM no mesmo ano, ela de manhã e ele à noite, e quase não se falavam.',
  'Trabalharam mais de quatro anos no mesmo escritório, de estagiários a advogados, cada um firmando a própria área.',
  'A sociedade junta as duas: ele trabalha antes do processo, ela quando o processo existe.',
];

/* Missão e valores: texto dos sócios (briefing q3.1 e q3.2), com ajuste
   mínimo de forma. A linha de recusa (q3.5) entra em tom sóbrio, como eles
   pediram, e sem adjetivo. */
const missao =
  'Ajudar pessoas, famílias e empresas a construir, proteger e transmitir o seu patrimônio com segurança, planejamento e tranquilidade.';
const valoresFundamentais = [
  { nome: 'Respeito', texto: 'Tratamos cada pessoa, a sua história, as suas escolhas e os seus interesses com consideração, escuta e seriedade.' },
  { nome: 'Igualdade', texto: 'Toda pessoa merece o mesmo respeito e a mesma dedicação, qualquer que seja a sua origem, condição ou posição social.' },
  { nome: 'Dignidade', texto: 'Por trás de cada patrimônio, conflito ou decisão jurídica existe uma pessoa, uma família e uma história, e é assim que as tratamos.' },
];
const valoresDeAtuacao = [
  { nome: 'Clareza', texto: 'Conhecimento jurídico não deve criar distância entre o advogado e o cliente.' },
  { nome: 'Proximidade', texto: 'Conhecer a realidade do cliente para além do problema jurídico.' },
  { nome: 'Segurança', texto: 'Mais do que resolver problemas, buscar evitar que eles aconteçam.' },
  { nome: 'Planejamento', texto: 'Decisões importantes pensadas antes de se tornarem urgências.' },
  { nome: 'Responsabilidade', texto: 'Cada patrimônio tem uma história, e cada decisão tem consequências.' },
  { nome: 'Estratégia', texto: 'A melhor solução é a que faz sentido para o contexto de quem a recebe.' },
];
---

<Base
  titulo="O escritório | Bertoncini & Mendonça Advogados"
  descricao="Quem somos: os dois sócios de Bertoncini & Mendonça, em Maringá, com inscrição na OAB do Paraná, formação, áreas de atuação e contato direto."
  paginaAtual="/escritorio/"
>
  {/* Versão cinematográfica (26/10/2026), a partir da página "About" de
      quadro-template.framer.website. Plano em docs/PLANO-ESCRITORIO.md e
      mecânica medida em docs/refs/REFERENCIAS-ESCRITORIO.md. O movimento
      mora em scripts/escritorio.ts; sem ele (ou com menos movimento pedido)
      a página é um documento comum, tudo visível. */}
  <div class="escritorio">

  <!-- 1–3. ABERTURA, MARCA-D'ÁGUA E MANIFESTO -->
  <section class="topo">
    <div class="marca-dagua" aria-hidden="true"><span data-desliza>Bertoncini &amp; Mendonça /&nbsp;Bertoncini &amp; Mendonça /</span></div>
    <div class="env abertura">
      <p class="pilula" data-sobe>O escritório</p>
      <h1 class="titulo-caixa" data-sobe>Advocacia que pensa <em>antes.</em></h1>
      <p class="apoio" data-sobe>
        Bertoncini &amp; Mendonça é uma sociedade de advogados de Maringá, dedicada ao planejamento
        patrimonial e sucessório e ao direito digital, com atendimento em todo o país.
      </p>
    </div>
    <div class="env manifesto">
      <p class="titulo-caixa grande" data-acende>{missao}</p>
      <div class="manifesto-apoio" data-sobe>
        <p>
          Estamos ao lado dos nossos clientes nas decisões que estruturam o patrimônio e o futuro deles,
          com orientação clara, próxima e estratégica.
        </p>
        <p>Para que escolhas importantes sejam feitas com consciência, e não na urgência.</p>
      </div>
    </div>
  </section>

  <!-- 4. OS SÓCIOS -->
  {perfis.map((perfil, n) => (
    <section class:list={['socio', { invertido: n % 2 === 1 }]} id={n === 0 ? 'socios' : undefined} aria-labelledby={`socio-${n}`}>
      <div class="env socio-grade">
        <div class="socio-texto" data-sobe>
          <p class="rotulo">{perfil.lado}</p>
          <h2 id={`socio-${n}`} class="socio-nome"><em>{perfil.nome}</em><br />{perfil.sobrenome}</h2>
          <p class="oab" data-placeholder={perfil.socio.oab.placeholder ? '1' : undefined}>
            <span>Inscrição na Ordem</span> {perfil.socio.oab.valor}
          </p>
          <p class="bio">{perfil.bio}</p>
          <blockquote class="porque">
            <p>{perfil.porque}</p>
            <cite>Por que o Direito, nas palavras de {perfil.nome}</cite>
          </blockquote>
          <dl class="formacao">
            <dt>Formação</dt>
            <dd><ul>{perfil.formacao.map((item) => <li>{item}</li>)}</ul></dd>
            <dt>Fora do escritório</dt>
            <dd>{perfil.fora}</dd>
          </dl>
          <a class="botao contorno" href={`/areas/${perfil.socio.area}/`}>
            {nomeDaArea(perfil.socio.area)}
            <span class="disco" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="#fff" stroke-width="1.6" stroke-linecap="round" /></svg></span>
          </a>
        </div>
        <div class="socio-foto">
          <figure class="pilha-fotos">
            <picture>
              <source type="image/avif" srcset={`${perfil.base}-560.avif 560w, ${perfil.base}-840.avif 840w`} sizes="(max-width: 900px) 92vw, 40vw" />
              <source type="image/webp" srcset={`${perfil.base}-560.webp 560w, ${perfil.base}-840.webp 840w`} sizes="(max-width: 900px) 92vw, 40vw" />
              <img src={`${perfil.base}-840.jpg`} alt={`Retrato de ${perfil.nome} ${perfil.sobrenome}`} width={perfil.largura} height={perfil.altura} loading="lazy" style={`object-position:${perfil.enquadra}`} />
            </picture>
          </figure>
        </div>
      </div>
    </section>
  ))}

  <!-- 5–6. A HISTÓRIA E OS NÚMEROS -->
  <section class="historia" aria-labelledby="historia-titulo">
    <div class="marca-dagua pequena" aria-hidden="true"><span>A história</span></div>
    <div class="env">
      <h2 id="historia-titulo" class="titulo-caixa centro" data-sobe>Da mesma turma <em>à mesma sociedade.</em></h2>
      <ol class="pilares">
        {batidas.map((frase, n) => (
          <li data-sobe>
            <span class="pilar-num">{String(n + 1).padStart(2, '0')}</span>
            <h3>{['UEM', 'O mesmo escritório', 'A sociedade'][n]}</h3>
            <p>{frase}</p>
          </li>
        ))}
      </ol>
      <ul class="numeros" aria-label="O escritório em números">
        <li data-sobe><strong data-conta="4">4</strong><span>+ anos de prática jurídica</span></li>
        <li data-sobe><strong data-conta="2">2</strong><span>sócios, uma área cada</span></li>
        <li data-sobe><strong data-conta="2">2</strong><span>áreas de atuação</span></li>
        <li data-sobe><strong data-conta={String(perfis.reduce((t, p) => t + p.formacao.length, 0))}>{perfis.reduce((t, p) => t + p.formacao.length, 0)}</strong><span>títulos de formação somados</span></li>
      </ul>
    </div>
  </section>

  <!-- 7. A CENA -->
  <section class="cena" aria-labelledby="cena-titulo">
    <div class="palco-cena">
      <div class="cena-fundo" aria-hidden="true">
        <picture>
          <source type="image/avif" srcset="/media/hero/escritorio-1600.avif" />
          <source type="image/webp" srcset="/media/hero/escritorio-1200.webp" />
          <img src="/media/hero/escritorio-1600.jpg" alt="" loading="lazy" />
        </picture>
      </div>
      <div class="grade-linhas" aria-hidden="true">{[0, 1, 2, 3, 4, 5].map(() => <span />)}</div>

      <h2 id="cena-titulo" class="visualmente-oculto">Nossos valores</h2>
      <div class="valores-cena">
        {valoresFundamentais.map((valor, n) => (
          <article class="valor-cena" data-valor={n}>
            <p class="tags"><span>Valor fundamental</span><span>{String(n + 1).padStart(2, '0')} / 03</span></p>
            <div class="valor-corpo">
              <h3 class="titulo-caixa">{valor.nome}.</h3>
              <p class="valor-frase" data-acende-claro>{valor.texto}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="escada-cena">
        <h3 class="titulo-caixa centro">Como isso aparece <mark>no trabalho.</mark></h3>
        <div class="escada">
          {[0, 1, 2].map((col) => (
            <div class="degrau" data-degrau={col}>
              {valoresDeAtuacao.slice(col * 2, col * 2 + 2).map((valor, k) => (
                <div class="cartao-vidro">
                  <span class="cartao-num">{String(col * 2 + k + 1).padStart(2, '0')}</span>
                  <h4>{valor.nome}</h4>
                  <p>{valor.texto}</p>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>

      <div class="faixas-saida" aria-hidden="true">{[0, 1, 2, 3, 4, 5].map(() => <span />)}</div>
    </div>
  </section>

  <!-- 8. REGISTRO -->
  <section class="registro-secao">
    <div class="env">
      <h2 class="titulo-caixa centro titulo-cresce" data-cresce>Registro da <em>sociedade.</em></h2>
      <Ficha
        rotulo="Dados de registro da sociedade"
        itens={[
          { rotulo: 'Registro na OAB/PR', valor: site.registro.oabSociedade.valor, placeholder: site.registro.oabSociedade.placeholder, destaque: true },
          { rotulo: 'Sociedade', valor: site.nomeSociedade },
          { rotulo: 'CNPJ', valor: site.registro.cnpj.valor, placeholder: site.registro.cnpj.placeholder },
          { rotulo: 'Base', valor: `${site.cidade}, ${site.estado}` },
        ]}
      />
    </div>
  </section>

  </div>

  <Contato
    titulo="Fale com um dos dois."
    horario="Segunda a sexta, das 9h às 18h. Fora do horário a mensagem fica registrada."
  />
</Base>

<script>
  import '~/scripts/escritorio';
</script>

<style>
  .escritorio {
    --destaque: #2a62ad;
    --gelo: #eaf0f6;
    overflow-x: clip;
  }
  .titulo-caixa {
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(34px, 4.6vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--tinta);
  }
  .titulo-caixa em {
    font-style: normal;
    color: var(--destaque);
  }
  .centro {
    text-align: center;
  }
  .pilula {
    display: inline-block;
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--gelo);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinta);
  }
  .rotulo {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secundario);
  }

  /* ── 1–3 ─────────────────────────────────────────────────────────── */
  .topo {
    position: relative;
    padding-top: clamp(150px, 16vw, 220px);
    background: linear-gradient(180deg, var(--branco) 0%, var(--branco) 30%, #f1f5fa 100%);
  }
  .marca-dagua {
    position: absolute;
    inset: 32vh 0 auto;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .marca-dagua span {
    display: block;
    white-space: nowrap;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(140px, 24vw, 380px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--gelo);
    will-change: transform;
  }
  .abertura,
  .manifesto {
    position: relative;
    z-index: 1;
  }
  .abertura {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 22px;
  }
  .abertura h1 {
    font-size: clamp(40px, 6.2vw, 92px);
    max-width: 12ch;
  }
  .apoio {
    max-width: 52ch;
    font-size: 18px;
    color: var(--secundario);
  }
  .manifesto {
    padding-block: clamp(120px, 22vh, 260px) clamp(90px, 12vw, 160px);
  }
  .grande {
    font-size: clamp(30px, 4vw, 58px);
    line-height: 1.04;
    max-width: 22ch;
  }
  .manifesto-apoio {
    display: grid;
    gap: 14px;
    max-width: 62ch;
    margin: 48px 0 0 auto;
    font-size: 17px;
    line-height: 1.6;
    color: var(--secundario);
  }

  /* ── 4. sócios ───────────────────────────────────────────────────── */
  .socio {
    padding-block: clamp(80px, 9vw, 130px);
    background: var(--branco);
  }
  .socio-grade {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 110px);
    align-items: start;
  }
  .invertido .socio-texto {
    order: 2;
  }
  .socio-nome {
    margin-top: 14px;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(38px, 4.8vw, 70px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--tinta);
  }
  .socio-nome em {
    font-style: normal;
    color: var(--destaque);
  }
  .oab {
    margin-top: 18px;
    font-size: 19px;
    color: var(--tinta);
  }
  .oab span {
    margin-right: 6px;
    font-size: 14px;
    color: var(--secundario);
  }
  .bio {
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--secundario);
    max-width: 52ch;
  }
  .porque {
    margin: 32px 0 0;
    padding-left: 22px;
    border-left: 2px solid var(--destaque);
  }
  .porque p {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.38;
    color: var(--tinta);
  }
  .porque cite {
    display: block;
    margin-top: 12px;
    font-style: normal;
    font-size: 14px;
    color: var(--secundario);
  }
  .formacao {
    margin: 32px 0;
    display: grid;
    gap: 6px;
  }
  .formacao dt {
    margin-top: 14px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secundario);
  }
  .formacao dd {
    margin: 0;
    font-size: 16px;
    color: var(--tinta);
  }
  .formacao ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .formacao li::before {
    content: '— ';
    color: var(--destaque);
  }
  .socio-foto {
    position: sticky;
    top: 120px;
  }
  /* A pilha: a foto com duas folhas inclinadas atrás (Quadro, "Meet Clara"). */
  .pilha-fotos {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
  }
  .pilha-fotos::before,
  .pilha-fotos::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 6px;
  }
  .pilha-fotos::before {
    background: #c9d5e3;
    transform: rotate(-5deg) translate(-3%, 2%);
  }
  .pilha-fotos::after {
    background: var(--tinta);
    transform: rotate(3.5deg) translate(3%, 1%);
  }
  .pilha-fotos img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 30px 60px -30px rgba(11, 30, 63, 0.5);
  }

  /* ── 5–6. história e números ─────────────────────────────────────── */
  .historia {
    position: relative;
    padding-block: clamp(90px, 10vw, 150px);
    background: var(--branco);
  }
  .marca-dagua.pequena {
    inset: 40px 0 auto;
    text-align: center;
  }
  .marca-dagua.pequena span {
    font-size: clamp(80px, 13vw, 200px);
  }
  .historia .env {
    position: relative;
    z-index: 1;
  }
  .historia h2 {
    max-width: 18ch;
    margin: 0 auto;
  }
  .pilares {
    list-style: none;
    margin: clamp(56px, 7vw, 96px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .pilares li {
    padding: 8px clamp(18px, 2.4vw, 36px) 8px;
    border-left: 1px solid var(--destaque);
  }
  .pilar-num {
    font-size: 14px;
    font-weight: 600;
    color: var(--destaque);
  }
  .pilares h3 {
    margin-top: 18px;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(20px, 1.8vw, 26px);
    letter-spacing: -0.015em;
    color: var(--tinta);
  }
  .pilares p {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.55;
