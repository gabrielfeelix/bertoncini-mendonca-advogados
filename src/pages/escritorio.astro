---
/**
 * /escritorio/ — a página que responde "quem são vocês".
 *
 * Quatro blocos, cada um com a sua superfície:
 *
 * 1. ABERTURA (branco): a foto dos dois e a frase que define a sociedade.
 * 2. O ENCONTRO (azul-tinta, tela cheia): o memorável da página. Os dois
 *    sobrenomes entram cada um por um lado e se encontram no "&" enquanto
 *    a pessoa rola; três frases curtas contam a história. Substitui os
 *    parágrafos de história, que o cliente leu como "texto carregado com
 *    cara de IA".
 * 3. OS SÓCIOS (meio a meio): a tela partida em duas metades — o
 *    consultivo, antes do processo, em papel; o contencioso, dentro dele,
 *    em tinta. É a divisão do escritório virando a própria forma da seção,
 *    e junta num lugar só o que antes era cartão de área + perfil.
 * 4. REGISTRO e CONTATO.
 *
 * O MOVIMENTO é CSS puro, por linha do tempo de rolagem
 * (`animation-timeline: view()`), sem biblioteca. Onde o navegador não
 * suporta, ou com `prefers-reduced-motion`, a seção aparece parada e
 * completa — os nomes já juntos, as três frases visíveis.
 *
 * O QUE NÃO ENTRA, por decisão do cliente: a trajetória de cada um
 * (estágios, nomes de escritórios, órgãos e lugares). De experiência,
 * fica só o tempo de prática. A formação continua: é ela que sustenta o
 * título de especialista, que o Provimento 205/2021 só permite com o
 * título existente.
 *
 * Nenhum fato sobre as pessoas é inventado; o que falta está marcado com
 * `data-placeholder="1"`. A OAB de cada sócio fica em 22px — o portão
 * confere o piso nesta rota.
 */
import Base from '../layouts/Base.astro';
import Contato from '../components/Contato.astro';
import { site } from '../lib/site';


/* A formação vem do briefing (q1.7a e q1.7b). */
const perfis = [
  {
    nome: 'Juscelino',
    sobrenome: 'Bertoncini',
    base: '/media/socios/juscelino',
    largura: 840,
    altura: 1260,
    enquadra: '50% 22%',
    socio: site.socios[0],
    bio: 'Especialista em direito empresarial e em advocacia consultiva. Trabalha na fase que antecede o processo (contratos, pareceres, estruturação de operações, LGPD e compliance) para que o problema não se consolide.',
    formacao: [
      'Bacharel em Direito pela UEM',
      'Especialista em Direito Empresarial pela PUC/RS',
      'Especialista em Advocacia Consultiva pela Legale',
      'Pós-graduando em Direito Imobiliário pela i9',
    ],
  },
  {
    nome: 'Beatriz',
    sobrenome: 'Mendonça',
    base: '/media/socios/beatriz',
    largura: 840,
    altura: 1260,
    enquadra: '50% 24%',
    socio: site.socios[1],
    bio: 'Especialista em processo civil, com experiência em processos judiciais estratégicos em todas as instâncias e em due diligence de operações de fusão e aquisição. Atende quem trabalha e ganha dinheiro na internet.',
    formacao: [
      'Bacharel em Direito pela UEM',
      'Especialista em Direito Processual Civil pela PUC/RS',
      'Pós-graduanda em Direito Digital pela i9',
    ],
  },
];

/* Missão e valores: texto dos sócios (briefing q3.1 e q3.2), com ajuste
   mínimo de forma. A linha de recusa (q3.5) entra em tom sóbrio, como eles
   pediram, e sem adjetivo. */
const missao =
  'Ajudar pessoas, famílias e empresas a construir, proteger e transmitir o seu patrimônio com segurança, planejamento e tranquilidade.';
const valoresFundamentais = [
  { nome: 'Respeito', texto: 'Tratamos cada pessoa, a sua história, as suas escolhas e os seus interesses com consideração, escuta e seriedade.' },
  { nome: 'Igualdade', texto: 'Toda pessoa merece o mesmo respeito e a mesma dedicação, qualquer que seja a sua origem, condição ou posição social.' },
  { nome: 'Dignidade', texto: 'Por trás de cada patrimônio, conflito ou decisão jurídica existe uma pessoa, uma família e uma história, e é assim que as tratamos.' },
];
const valoresDeAtuacao = [
  { nome: 'Clareza', texto: 'Conhecimento jurídico não deve criar distância entre o advogado e o cliente.' },
  { nome: 'Proximidade', texto: 'Conhecer a realidade do cliente para além do problema jurídico.' },
  { nome: 'Segurança', texto: 'Mais do que resolver problemas, buscar evitar que eles aconteçam.' },
  { nome: 'Planejamento', texto: 'Decisões importantes pensadas antes de se tornarem urgências.' },
  { nome: 'Responsabilidade', texto: 'Cada patrimônio tem uma história, e cada decisão tem consequências.' },
  { nome: 'Estratégia', texto: 'A melhor solução é a que faz sentido para o contexto de quem a recebe.' },
];
---

<Base
  titulo="O escritório | Bertoncini & Mendonça Advogados"
  descricao="Quem somos: os dois sócios de Bertoncini & Mendonça, em Maringá, com inscrição na OAB do Paraná, formação, áreas de atuação e contato direto."
  paginaAtual="/escritorio/"
>
  {/* Versão cinematográfica (26/10/2026), a partir da página "About" de
      quadro-template.framer.website. Plano em docs/PLANO-ESCRITORIO.md e
      mecânica medida em docs/refs/REFERENCIAS-ESCRITORIO.md. O movimento
      mora em scripts/escritorio.ts; sem ele (ou com menos movimento pedido)
      a página é um documento comum, tudo visível. */}
  <div class="escritorio">

  <!-- 1–3. ABERTURA, MARCA-D'ÁGUA E MANIFESTO -->
  <section class="topo">
    <div class="marca-dagua" aria-hidden="true"><span data-desliza>Bertoncini &amp; Mendonça /&nbsp;Bertoncini &amp; Mendonça /</span></div>
    <div class="env abertura">
      <p class="pilula" data-sobe>O escritório</p>
      <h1 class="titulo-caixa" data-sobe>Advocacia que pensa <em>antes.</em></h1>
      <p class="apoio" data-sobe>
        Bertoncini &amp; Mendonça é uma sociedade de advogados de Maringá, dedicada ao planejamento
        patrimonial e sucessório e ao direito digital, com atendimento em todo o país.
      </p>
    </div>
    <div class="env manifesto">
      <p class="manifesto-frase" data-acende>{missao}</p>
      <p class="manifesto-apoio" data-sobe>
        Estamos ao lado dos nossos clientes nas decisões que estruturam o patrimônio e o futuro deles,
        com orientação clara, próxima e estratégica. Para que escolhas importantes sejam feitas com
        consciência, e não na urgência.
      </p>
    </div>
  </section>

  <!-- 4. OS SÓCIOS -->
  {/* Os dois lado a lado, com o mesmo peso (06/11/2026). Antes era uma
      seção por sócio, em zigue-zague, com foto inclinada sobre folhas
      coloridas: truque de template, e a alternância reforçava a divisão
      de áreas que o escritório pediu para não mostrar. Cada sócio mantém
      a âncora `#socio-<nome>`, usada pela pilha da home. */}
  <section class="socios" id="socios" aria-labelledby="socios-titulo">
    <div class="env">
      <header class="socios-cab" data-sobe>
        <h2 id="socios-titulo">Os sócios</h2>
        <p>Juscelino e Beatriz atuam juntos nas duas áreas do escritório.</p>
      </header>
      <div class="socios-grade">
        {perfis.map((perfil) => (
          <article class="socio" id={`socio-${perfil.nome.toLowerCase()}`} aria-labelledby={`nome-${perfil.nome.toLowerCase()}`} data-sobe>
            <figure class="socio-foto">
              <picture>
                <source type="image/avif" srcset={`${perfil.base}-560.avif 560w, ${perfil.base}-840.avif 840w`} sizes="(max-width: 900px) 92vw, 44vw" />
                <source type="image/webp" srcset={`${perfil.base}-560.webp 560w, ${perfil.base}-840.webp 840w`} sizes="(max-width: 900px) 92vw, 44vw" />
                <img src={`${perfil.base}-840.jpg`} alt={`Retrato de ${perfil.nome} ${perfil.sobrenome}`} width={perfil.largura} height={perfil.altura} loading="lazy" style={`object-position:${perfil.enquadra}`} />
              </picture>
            </figure>
            <h3 id={`nome-${perfil.nome.toLowerCase()}`} class="socio-nome">{perfil.nome} {perfil.sobrenome}</h3>
            <p class="oab" data-placeholder={perfil.socio.oab.placeholder ? '1' : undefined}>{perfil.socio.oab.valor}</p>
            <p class="bio">{perfil.bio}</p>
            <h4 class="formacao-titulo">Formação</h4>
            <ul class="formacao">{perfil.formacao.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* História, números, a cena dos valores e o registro saíram no retorno
      de 06/11/2026. História e números voltam quando o escritório tiver o
      que contar; o registro fica no rodapé, com os dados institucionais. A
      cena (620vh de cortina, valores trocando e escada) virou a seção
      abaixo: tudo visível de uma vez, só com a revelação comum. */}
  <section class="valores" aria-labelledby="valores-titulo">
    <div class="env">
      <header class="valores-cab">
        <h2 id="valores-titulo">O que orienta o nosso trabalho</h2>
      </header>
      <ol class="valores-lista">
        {valoresFundamentais.map((valor) => (
          <li data-sobe>
            <h3>{valor.nome}</h3>
            <p>{valor.texto}</p>
          </li>
        ))}
      </ol>

      <h3 class="atuacao-titulo">Como isso aparece no trabalho</h3>
      <ul class="atuacao-lista">
        {valoresDeAtuacao.map((valor) => (
          <li data-sobe>
            <h4>{valor.nome}</h4>
            <p>{valor.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  </div>

  <Contato
    titulo="Fale com um dos dois."
    horario="Segunda a sexta, das 9h às 18h. Fora do horário a mensagem fica registrada."
  />
</Base>

<script>
  import '~/scripts/escritorio';
</script>

<style>
  .escritorio {
    --destaque: #2a62ad;
    --gelo: #eaf0f6;
    overflow-x: clip;
  }
  .titulo-caixa {
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(34px, 4.6vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--tinta);
  }
  .titulo-caixa em {
    font-style: normal;
    color: var(--destaque);
  }
  .centro {
    text-align: center;
  }
  .pilula {
    display: inline-block;
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--gelo);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinta);
  }
  .rotulo {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secundario);
  }

  /* ── 1–3 ─────────────────────────────────────────────────────────── */
  .topo {
    position: relative;
    padding-top: clamp(150px, 16vw, 220px);
    background: linear-gradient(180deg, var(--branco) 0%, var(--branco) 30%, #f1f5fa 100%);
  }
  .marca-dagua {
    position: absolute;
    inset: 32vh 0 auto;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .marca-dagua span {
    display: block;
    white-space: nowrap;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(140px, 24vw, 380px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--gelo);
    will-change: transform;
  }
  .abertura,
  .manifesto {
    position: relative;
    z-index: 1;
  }
  .abertura {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 22px;
  }
  .abertura h1 {
    font-size: clamp(40px, 6.2vw, 92px);
    max-width: 12ch;
  }
  .apoio {
    max-width: 52ch;
    font-size: 18px;
    color: var(--secundario);
  }
  .manifesto {
    padding-block: clamp(120px, 22vh, 260px) clamp(90px, 12vw, 160px);
  }
  /* Missão como frase, não como cartaz: caixa normal, peso médio,
     centrada. Em caixa alta 800 ela virava oito linhas gritadas. As
     palavras acendem com a rolagem (`data-acende`). */
  .manifesto {
    text-align: center;
  }
  .manifesto-frase {
    max-width: 21em;
    margin-inline: auto;
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(28px, 3.6vw, 52px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .manifesto-apoio {
    max-width: 40em;
    margin: clamp(32px, 4vw, 48px) auto 0;
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.5;
    color: #5b6b7f;
    text-wrap: pretty;
  }

  /* ── 4. sócios: os dois lado a lado ───────────────────────────────── */
  .socios {
    scroll-margin-top: 90px;
    padding-block: clamp(96px, 11vw, 168px);
    background: var(--branco);
  }
  .socio {
    scroll-margin-top: 110px;
  }
  .socios-cab {
    text-align: center;
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  .socios-cab h2,
  .valores-cab h2 {
    font-family: var(--sans);
    font-weight: 600;
    text-transform: none;
    font-size: clamp(36px, 4.6vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--tinta);
  }
  .socios-cab p {
    margin-top: 14px;
    font-size: clamp(17px, 1.4vw, 20px);
    color: #5b6b7f;
  }
  .socios-grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }
  .socio-foto {
    margin: 0 0 clamp(24px, 2.6vw, 32px);
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    overflow: hidden;
    background: #f2f4f7;
  }
  .socio-foto picture {
    display: contents;
  }
  .socio-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .socio:hover .socio-foto img {
    transform: scale(1.025);
  }
  .socio-nome {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(28px, 2.6vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--tinta);
  }
  .oab {
    margin-top: 6px;
    font-size: 15px;
    color: #5b6b7f;
  }
  .bio {
    margin-top: 18px;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.55;
    color: var(--tinta);
  }
  .formacao-titulo {
    margin-top: 26px;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--tinta);
  }
  .formacao {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
    font-size: 15px;
    line-height: 1.5;
    color: #5b6b7f;
  }

  /* ── 5. valores ──────────────────────────────────────────────────── */
  .valores {
    padding-block: clamp(90px, 11vw, 160px);
    background: var(--papel);
  }
  .valores-cab {
    display: grid;
    gap: 14px;
    max-width: 980px;
  }
  .valores-lista {
    list-style: none;
    margin: clamp(40px, 5vw, 72px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 48px);
  }
  .valores-lista li {
    padding-top: 22px;
    border-top: 1px solid var(--tinta);
  }
  .valores-lista h3 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(26px, 2.4vw, 34px);
    letter-spacing: -0.03em;
    color: var(--tinta);
  }
  .valores-lista p {
    margin-top: 12px;
    max-width: 36ch;
    font-size: 17px;
    line-height: 1.55;
    color: var(--secundario);
  }
  .atuacao-titulo {
    margin-top: clamp(64px, 8vw, 120px);
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(22px, 2vw, 28px);
    letter-spacing: -0.025em;
    color: var(--tinta);
  }
  .atuacao-lista {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(28px, 3vw, 48px);
  }
  .atuacao-lista li {
    padding: 20px 0 26px;
    border-top: 1px solid var(--linha);
  }
  .atuacao-lista h4 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--tinta);
  }
  .atuacao-lista p {
    margin-top: 6px;
    max-width: 34ch;
    font-size: 16px;
    line-height: 1.5;
    color: var(--secundario);
  }

  @media (max-width: 900px) {
    .socios-grade,
    .valores-lista {
      grid-template-columns: 1fr;
    }
    .atuacao-lista {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .atuacao-lista {
      grid-template-columns: 1fr;
    }
  }
</style>
