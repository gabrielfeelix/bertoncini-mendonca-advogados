---
/**
 * /escritorio/ — a página que responde "quem são vocês".
 *
 * A FORMA segue o que as páginas "sobre" que funcionam repetem
 * (Macfarlanes, Oliveira Pitta, Bersay, o perfil de sócio do Arauz):
 *
 * 1. a foto dos dois e a frase que define a sociedade;
 * 2. três fatos que se leem em segundos — prática, áreas, onde;
 * 3. a sociedade: a história em duas colunas e, logo abaixo, a divisão
 *    do trabalho — quem cuida do quê, com link para a área;
 * 4. o perfil de cada sócio: OAB, formação, anos de prática e contato;
 * 5. o registro da sociedade e o contato.
 *
 * O QUE NÃO ENTRA, por decisão do cliente: a trajetória de cada um —
 * estágios, nomes de escritórios, órgãos e lugares por onde passaram.
 * De experiência, fica só o tempo de prática. A formação acadêmica
 * continua: é ela que sustenta o título de especialista, que o
 * Provimento 205/2021 só permite com o título existente.
 *
 * REGRA QUE CONTINUA: nenhum fato sobre as pessoas é inventado. O que
 * falta está marcado com `data-placeholder="1"`.
 *
 * A OAB de cada sócio fica em 22px, em vermelho imperial sobre branco
 * (8.6:1), no perfil de cada um — o portão confere o piso nesta rota.
 */
import Base from '../layouts/Base.astro';
import Contato from '../components/Contato.astro';
import Ficha from '../components/Ficha.astro';
import { site } from '../lib/site';
import { listarAreasConfirmadas } from '../lib/areas';

const areas = await listarAreasConfirmadas();
const nomeDaArea = (slug: string) => areas.find((a) => a.data.slug === slug)?.data.nome ?? '';
const resumoDaArea = (slug: string) => areas.find((a) => a.data.slug === slug)?.data.resumo ?? '';

/* A formação vem do briefing (q1.7a e q1.7b), respondido pelos sócios.
   "Mais de quatro anos" é o tempo de prática que eles contam lado a lado
   (q1.3) — o único número de experiência que o briefing sustenta. */
const perfis = [
  {
    nome: 'Juscelino Bertoncini',
    base: '/media/socios/juscelino',
    largura: 840,
    altura: 1119,
    enquadra: '50% 30%',
    socio: site.socios[0],
    papel: 'Consultivo, antes do processo',
    bio: 'Trabalha na fase que antecede o processo, para que o problema não se consolide. Prevenir o litígio costuma custar menos ao cliente do que vencê-lo.',
    formacao: [
      'Bacharel em Direito pela Universidade Estadual de Maringá (UEM)',
      'Especialista em Direito Empresarial pela PUC/RS',
      'Especialista em Advocacia Consultiva pela Legale',
      'Pós-graduando em Direito Imobiliário pela i9',
    ],
  },
  {
    nome: 'Beatriz Mendonça',
    base: '/media/socios/beatriz',
    largura: 840,
    altura: 1278,
    enquadra: '50% 24%',
    socio: site.socios[1],
    papel: 'Contencioso, quando há processo',
    bio: 'Especialista em Direito Processual Civil, com experiência em processos judiciais estratégicos.',
    formacao: [
      'Bacharel em Direito pela Universidade Estadual de Maringá (UEM)',
      'Especialista em Direito Processual Civil pela PUC/RS',
      'Pós-graduanda em Direito Digital pela i9',
    ],
  },
];

const pratica = 'Mais de quatro anos';
---

<Base
  titulo="O escritório | Bertoncini & Mendonça Advogados"
  descricao="Quem somos: os dois sócios de Bertoncini & Mendonça, em Maringá, com inscrição na OAB do Paraná, formação, áreas de atuação e contato direto."
  paginaAtual="/escritorio/"
>
  <!-- Abertura: a foto dos dois carrega o peso. O recorte panorâmico é um
       enquadramento DIFERENTE do hero da home, para não ler como a mesma
       imagem repetida. -->
  <section class="abertura">
    <div class="env">
      <div class="placa-abre">
        <picture class="retrato">
          {/* No celular entra o recorte 4:5 já gerado para o hero da home:
              ampliar o panorâmico 21:9 numa tela estreita sobrava só um
              rosto e cortava o outro sócio fora. */}
          <source media="(max-width: 820px)" type="image/avif" srcset="/media/hero/socios-vert-600.avif 600w, /media/hero/socios-vert-800.avif 800w" sizes="100vw" />
          <source media="(max-width: 820px)" type="image/webp" srcset="/media/hero/socios-vert-600.webp 600w, /media/hero/socios-vert-800.webp 800w" sizes="100vw" />
          <source type="image/avif" srcset="/media/hero/escritorio-1200.avif 1200w, /media/hero/escritorio-1600.avif 1600w" sizes="100vw" />
          <source type="image/webp" srcset="/media/hero/escritorio-1200.webp 1200w, /media/hero/escritorio-1600.webp 1600w" sizes="100vw" />
          <img
            src="/media/hero/escritorio-1600.jpg"
            alt="Juscelino Bertoncini e Beatriz Mendonça, os dois sócios do escritório"
            width="1672"
            height="717"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <div class="dizer" data-contraste="externo">
          <p class="chapeu">O escritório</p>
          <h1 class="display">Somos dois advogados, e é com um de nós que você fala.</h1>
        </div>
      </div>

      {/* A linha fina e os fatos lado a lado. A linha fina sozinha, em 19px
          cinza sob uma foto de 600px, sumia; os fatos são o que a
          Oliveira Pitta e o Bersay põem logo depois da abertura, e o que
          quem chega quer saber primeiro. Sem número de processos nem de
          clientes: o Provimento 205/2021 proíbe. */}
      <div class="depois-abre">
        <p class="linha-fina">
          Bertoncini &amp; Mendonça é uma sociedade nova, com base em Maringá e atendimento
          online para todo o país. Quem recebe o caso na primeira conversa é quem responde
          por ele até o fim.
        </p>
        <dl class="fatos">
          <div>
            <dt>{pratica}</dt>
            <dd>de prática, cada sócio</dd>
          </div>
          <div>
            <dt>Duas áreas</dt>
            <dd>
              {areas.map((area, n) => (
                <>
                  {n > 0 && ' e '}
                  {area.data.nome.toLowerCase()}
                </>
              ))}
            </dd>
          </div>
          <div>
            <dt>Maringá</dt>
            <dd>e online, para todo o país</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- A SOCIEDADE: a história e a divisão do trabalho num bloco só,
       porque a divisão é a consequência da história.

       Antes eram duas seções, cada uma com título embaixo à esquerda e
       texto pendurado no topo à direita — os dois lados não se tocavam.
       Agora o chapéu corre por cima das duas colunas, e o título e a
       primeira frase começam na mesma linha.

       Saiu a citação em cartão com filete vermelho ("São dois sócios e
       nenhuma camada..."): o formato e a frase liam como texto gerado, e
       o que ela dizia de concreto já está na linha fina da abertura. -->
  <section class="secao sociedade" id="historia" aria-labelledby="sociedade-titulo">
    <div class="env">
      <div class="sociedade-grade">
        <p class="chapeu">A sociedade</p>
        <h2 class="display" id="sociedade-titulo">Como esta sociedade começou.</h2>
        <div class="sociedade-texto">
          <p class="lead">
            Os dois entraram no curso de Direito da Universidade Estadual de Maringá no mesmo
            ano, ele no noturno e ela no matutino, e mal se conheciam.
          </p>
          <p>
            Depois passaram a trabalhar no mesmo setor, e foram mais de quatro anos lado a
            lado, cada um firmando a própria área. A sociedade nasceu daí: de funções que se
            completam e de uma parceria que já tinha sido testada no dia a dia.
          </p>
          <p>
            As áreas refletem essa divisão. A Beatriz vem do processo civil e do contencioso; o
            Juscelino, do direito empresarial e da advocacia consultiva, que trabalha antes do
            litígio.
          </p>
          <p class="nota" data-placeholder="1">
            A data de constituição da sociedade: a confirmar com os sócios.
          </p>
        </div>
      </div>

      <!-- A divisão em duas metades, cada uma levando à sua área, como o
           "What we do" do Macfarlanes. -->
      <div class="metades">
        {perfis.map((perfil, n) => (
          <a class:list={['metade', { escura: n === 1 }]} href={`/areas/${perfil.socio.area}/`}>
            <span class="metade-papel">{perfil.papel}</span>
            <span class="metade-area">{nomeDaArea(perfil.socio.area)}</span>
            <span class="metade-resumo">{resumoDaArea(perfil.socio.area)}</span>
            <span class="metade-quem">Com {perfil.nome}</span>
            <span class="metade-leva">
              Ver a área
              <span class="seta" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- QUEM ASSINA. Um perfil por sócio, no desenho do perfil de sócio do
       Arauz: retrato de um lado, do outro o que se confere — OAB,
       formação, tempo de prática, contato. Antes eram dois retratos de
       página inteira seguidos de uma coluna de texto corrido, com a
       trajetória misturada à bio. -->
  <section class="secao quem" id="socios" aria-labelledby="quem-titulo">
    <div class="env">
      <p class="chapeu">Quem assina</p>
      <h2 class="display" id="quem-titulo">Os sócios.</h2>

      <div class="perfis">
        {perfis.map((perfil) => (
          <article class="perfil">
            <div class="perfil-foto revela">
              <picture>
                <source type="image/avif" srcset={`${perfil.base}-560.avif 560w, ${perfil.base}-840.avif 840w`} sizes="(max-width: 820px) 92vw, 34vw" />
                <source type="image/webp" srcset={`${perfil.base}-560.webp 560w, ${perfil.base}-840.webp 840w`} sizes="(max-width: 820px) 92vw, 34vw" />
                <img
                  src={`${perfil.base}-840.jpg`}
                  alt={`Retrato de ${perfil.nome}`}
                  width={perfil.largura}
                  height={perfil.altura}
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${perfil.enquadra}`}
                />
              </picture>
            </div>

            <div class="perfil-texto">
              <a class="perfil-area" href={`/areas/${perfil.socio.area}/`}>{nomeDaArea(perfil.socio.area)}</a>
              <h3 class="perfil-nome">{perfil.nome}</h3>
              <p class="oab" data-placeholder={perfil.socio.oab.placeholder ? '1' : undefined}>
                <span class="oab-rotulo">Inscrição na Ordem</span>
                <span class="oab-numero">{perfil.socio.oab.valor}</span>
              </p>
              <p class="perfil-bio">{perfil.bio}</p>

              <dl class="perfil-dados">
                <div>
                  <dt>Prática</dt>
                  <dd>{pratica} de prática jurídica</dd>
                </div>
                <div>
                  <dt>Formação</dt>
                  <dd>
                    <ul>
                      {perfil.formacao.map((item) => <li>{item}</li>)}
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt>Contato</dt>
                  <dd class="perfil-contato">
                    <a href={`mailto:${site.email.valor}`} data-placeholder={site.email.placeholder ? '1' : undefined}>{site.email.valor}</a>
                    <a href={`tel:${site.telefoneE164.valor}`} data-placeholder={site.telefone.placeholder ? '1' : undefined}>{site.telefone.valor}</a>
                  </dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Registro da sociedade: exigência do Provimento 205/2021, em ficha,
       com o registro na OAB em destaque. -->
  <section class="secao registro-secao">
    <div class="env">
      <h2 class="titulo-registro">Registro da sociedade</h2>
      <p class="apoio-registro">
        A sociedade está registrada na Ordem dos Advogados do Brasil, Seccional do Paraná.
        Estes dados são exigidos pelo Provimento 205/2021 e ficam visíveis, não no rodapé.
      </p>
      <Ficha
        rotulo="Dados de registro da sociedade"
        itens={[
          { rotulo: 'Registro na OAB/PR', valor: site.registro.oabSociedade.valor, placeholder: site.registro.oabSociedade.placeholder, destaque: true },
          { rotulo: 'Sociedade', valor: site.nomeSociedade },
          { rotulo: 'CNPJ', valor: site.registro.cnpj.valor, placeholder: site.registro.cnpj.placeholder },
          { rotulo: 'Base', valor: `${site.cidade}, ${site.estado}` },
        ]}
      />
    </div>
  </section>

  <Contato
    titulo="Fale com um dos dois."
    horario="Segunda a sexta, das 9h às 18h. Fora do horário a mensagem fica registrada."
  />
</Base>

<style>
  /* ── abertura ─────────────────────────────────────────────────────── */

  .abertura {
    padding-block: clamp(20px, 3vw, 36px) clamp(36px, 5vw, 68px);
  }
  /* A placa: mesma forma da primeira dobra da home. */
  .placa-abre {
    position: relative;
    border-radius: clamp(16px, 2vw, 28px);
    overflow: hidden;
    background: var(--tinta);
    isolation: isolate;
  }
  .retrato,
  .retrato img {
    display: block;
    width: 100%;
  }
  .retrato img {
    aspect-ratio: 21 / 9;
    object-fit: cover;
    object-position: 58% 30%;
  }
  /* Escurecimento NEUTRO (preto transparente, nunca cor) apenas onde há
     texto: a foto mantém a cor dela. Ver docs/PLANO-REDESENHO.md. */
  .placa-abre::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.68) 0%,
      rgba(0, 0, 0, 0.4) 34%,
      transparent 56%
    );
    pointer-events: none;
  }
  .dizer {
    position: absolute;
    z-index: 2;
    inset-block: 0;
    inset-inline-start: 0;
    width: min(56%, 46ch);
    padding: clamp(24px, 3.4vw, 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #fff;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.6), 0 1px 3px rgba(0, 0, 0, 0.45);
  }
  .chapeu {
    font-size: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
    opacity: 0.88;
  }
  .abertura h1 {
    font-size: clamp(30px, 3.9vw, 62px);
    max-width: 15ch;
  }

  .depois-abre {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    align-items: start;
    gap: clamp(28px, 5vw, 88px);
    margin-top: clamp(30px, 3.6vw, 52px);
  }
  .linha-fina {
    margin: 0;
    max-width: 40ch;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(21px, 1.9vw, 27px);
    line-height: 1.4;
    color: var(--tinta);
  }
  /* Os fatos: três colunas com filete no topo, como os números da
     Oliveira Pitta — mas em palavras, porque o que o escritório tem para
     afirmar é tempo, área e lugar, não volume. */
  .fatos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    margin: 0;
  }
  .fatos div {
    padding-top: 16px;
    border-top: 2px solid var(--tinta);
  }
  .fatos dt {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.15;
    color: var(--tinta);
  }
  .fatos dd {
    margin: 8px 0 0;
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--secundario);
  }
  /* No celular a foto perde a área livre à esquerda: o texto sai de cima
     dela e vai para baixo, sobre o azul da própria placa. */
  @media (max-width: 820px) {
    .retrato img {
      aspect-ratio: 4 / 5;
      object-position: 50% 18%;
      max-height: 58svh;
    }
    .placa-abre::after {
      background: linear-gradient(0deg, rgba(0, 0, 0, 0.55) 0%, transparent 45%);
    }
    .dizer {
      position: static;
      width: auto;
      background: var(--tinta);
      padding-block: clamp(24px, 5vw, 34px);
    }
    .abertura h1 {
      font-size: clamp(28px, 7vw, 40px);
      max-width: 18ch;
    }
  }
  @media (max-width: 960px) {
    .depois-abre {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 620px) {
    .fatos {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .fatos div {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      gap: 16px;
      padding-block: 14px;
      border-top-width: 1px;
      border-color: var(--linha);
    }
    .fatos div:first-child {
      border-top: 2px solid var(--tinta);
    }
    .fatos dt {
      font-size: 21px;
    }
    .fatos dd {
      margin: 0;
    }
  }

  /* ── seções: cabeçalho em duas colunas ────────────────────────────── */

  .secao .chapeu {
    color: var(--secundario);
    margin-bottom: 14px;
    opacity: 1;
  }
  .secao h2.display {
    font-size: clamp(32px, 4.2vw, 56px);
    max-width: 14ch;
  }

  /* ── a sociedade ──────────────────────────────────────────────────── */

  .sociedade {
    padding-block: clamp(56px, 7vw, 112px) clamp(48px, 6vw, 88px);
    border-top: 1px solid var(--linha);
  }
  /* O chapéu ocupa a linha de cima inteira; título e texto começam juntos
     na linha de baixo. */
  .sociedade-grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    column-gap: clamp(24px, 5vw, 88px);
    align-items: start;
  }
  .sociedade-grade .chapeu {
    grid-column: 1 / -1;
  }
  .sociedade-grade h2 {
    margin: 0;
  }
  .sociedade-texto {
    max-width: 60ch;
  }
  .sociedade-texto p {
    font-size: 19px;
    line-height: 1.65;
    color: var(--apoio);
  }
  .sociedade-texto p + p {
    margin-top: 16px;
  }
  /* A primeira frase em serifa, o mesmo gesto da abertura das áreas. O
     tamanho acompanha o título ao lado para as duas colunas começarem no
     mesmo peso visual. */
  .sociedade-texto .lead {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(23px, 2.2vw, 31px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--tinta);
    padding-top: 0.25em;
  }
  .sociedade-texto .lead + p {
    margin-top: clamp(20px, 2.2vw, 28px);
  }
  .sociedade-texto .nota {
    margin-top: 22px;
    font-size: 16px;
    color: var(--secundario);
  }
  @media (max-width: 960px) {
    .sociedade-grade {
      grid-template-columns: minmax(0, 1fr);
    }
    .sociedade-texto {
      margin-top: clamp(22px, 4vw, 32px);
    }
  }

  /* ── divisão ──────────────────────────────────────────────────────── */

  .metades {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1vw, 16px);
    margin-top: clamp(30px, 3.6vw, 52px);
  }
  .metade {
    display: flex;
    flex-direction: column;
    min-height: clamp(240px, 22vw, 320px);
    padding: clamp(24px, 3vw, 44px);
    background: var(--papel);
    color: var(--tinta);
    border-radius: clamp(14px, 1.6vw, 22px);
    text-decoration: none;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s;
  }
  .metade:hover {
    transform: translateY(-3px);
    background: #eef1f5;
  }
  .metade.escura {
    background: var(--tinta);
    color: #fff;
  }
  .metade.escura:hover {
    background: #102a55;
  }
  .metade-papel {
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--secundario);
  }
  .escura .metade-papel {
    color: rgba(255, 255, 255, 0.72);
  }
  .metade-area {
    margin-top: 16px;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .metade-resumo {
    margin-top: 14px;
    max-width: 42ch;
    font-size: 17px;
    line-height: 1.55;
    color: var(--apoio);
  }
  .escura .metade-resumo {
    color: rgba(255, 255, 255, 0.82);
  }
  .metade-quem {
    margin-top: 18px;
    font-size: 16px;
    letter-spacing: 0.02em;
    color: var(--apoio);
  }
  .escura .metade-quem {
    color: rgba(255, 255, 255, 0.82);
  }
  .metade-leva {
    margin-top: auto;
    padding-top: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 16.5px;
  }
  .seta {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--imperial);
    color: #fff;
    transition: transform 0.35s;
  }
  .metade:hover .seta {
    transform: translateX(4px);
  }
  @media (max-width: 720px) {
    .metades {
