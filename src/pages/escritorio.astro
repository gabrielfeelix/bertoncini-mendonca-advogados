---
/**
 * O escritório (v3): quem somos, missão e valores, e o perfil dos sócios.
 * Missão e valores são texto dos sócios (briefing q3.1 e q3.2); formação
 * vem do briefing (q1.7a e q1.7b). Sem história e sem números, e sem
 * dividir os sócios por área: pedidos do retorno de 06/11/2026.
 */
import Base from '~/layouts/Base.astro';
import BannerPagina from '~/components/BannerPagina.astro';
import Chamada from '~/components/Chamada.astro';
import { site, formacao } from '~/lib/site';
import { listarAreasConfirmadas } from '~/lib/areas';

const areas = await listarAreasConfirmadas();

const missao =
  'Ajudar pessoas, famílias e empresas a construir, proteger e transmitir o seu patrimônio com segurança, planejamento e tranquilidade.';
const valores = [
  { nome: 'Respeito', texto: 'Tratamos cada pessoa, a sua história, as suas escolhas e os seus interesses com consideração, escuta e seriedade.' },
  { nome: 'Igualdade', texto: 'Toda pessoa merece o mesmo respeito e a mesma dedicação, qualquer que seja a sua origem, condição ou posição social.' },
  { nome: 'Dignidade', texto: 'Por trás de cada patrimônio, conflito ou decisão jurídica existe uma pessoa, uma família e uma história, e é assim que as tratamos.' },
];

const perfis = [
  {
    socio: site.socios[0],
    ancora: 'juscelino',
    cargo: 'Sócio',
    bio: 'Especialista em Direito Empresarial e em Advocacia Consultiva. Trabalha na fase que antecede o processo (contratos, pareceres, estruturação de operações, imóveis e organização do patrimônio) para que o problema não se consolide.',
  },
  {
    socio: site.socios[1],
    ancora: 'beatriz',
    cargo: 'Sócia',
    bio: 'Especialista em Direito Processual Civil e pós-graduanda em Direito Digital. Tem experiência em processos judiciais estratégicos e conduz os casos que precisam ir ao Judiciário. Atende quem trabalha e ganha dinheiro na internet.',
  },
];
---

<Base
  titulo={`O escritório | ${site.nome}`}
  descricao="Quem somos: os sócios de Bertoncini & Mendonça Advogados, em Maringá/PR, com formação, inscrição na OAB e áreas de atuação."
  paginaAtual="/escritorio/"
>
  <BannerPagina html="O <strong>Escritório</strong>" migalhas={[{ rotulo: 'O escritório' }]} />

  <section class="secao">
    <div class="container duas-colunas">
      <div>
        <p class="rotulo">Quem somos</p>
        <h2 class="titulo-bloco">{site.nome}</h2>
        <p>
          Escritório de advocacia de {site.cidade}/{site.estado}. Os sócios, Juscelino Bertoncini e
          Beatriz Mendonça, atuam juntos nas duas áreas do escritório:
          {areas.map((a, i) => (
            <>{i > 0 && ' e '}<a href={`/areas/${a.data.slug}/`}>{a.data.nome}</a></>
          ))}.
        </p>
        <p>
          Também atuamos em {site.outrasAreas.slice(0, -1).join(', ').toLowerCase()} e{' '}
          {site.outrasAreas.at(-1)?.toLowerCase()}.
        </p>
        <p>{site.atendimentoRodape}, e presencial em {site.cidade}/{site.estado}.</p>
      </div>
      <img class="foto" src="/media/hero/socios-1600.jpg" alt="Juscelino Bertoncini e Beatriz Mendonça, sócios do escritório." width="1600" height="900" />
    </div>
  </section>

  <section class="secao secao-cinza">
    <div class="container">
      <div class="titulo-secao">
        <h2>Nossa <strong>Missão</strong></h2>
        <p class="missao">{missao}</p>
      </div>
      <div class="grade grade-3">
        {valores.map((v) => (
          <div class="cartao">
            <div class="cartao-corpo">
              <h3>{v.nome}</h3>
              <p>{v.texto}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="titulo-secao">
        <h2>Nossos <strong>Sócios</strong></h2>
      </div>
      <div class="perfis">
        {perfis.map((p) => {
          return (
            <article class="perfil" id={p.ancora}>
              <img src={`${p.socio.retrato}-840.jpg`} alt={`Retrato de ${p.socio.nome}.`} width="840" height="1260" loading="lazy" />
              <div>
                <p class="rotulo">{p.cargo}</p>
                <h3>{p.socio.nome}</h3>
                <p class="oab">{p.socio.oab.valor}</p>
                <p>{p.bio}</p>
                <h4>Formação</h4>
                <ul>{(formacao[p.socio.nome] ?? []).map((item) => <li>{item}</li>)}</ul>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <Chamada />
</Base>

<style>
  .titulo-bloco { font-size: 30px; }
  .foto { border-radius: 6px; box-shadow: var(--sombra); }
  .missao { font-size: 19px; color: var(--texto) !important; max-width: 760px !important; }

  .perfis { display: grid; gap: 48px; max-width: 980px; margin: 0 auto; }
  .perfil { display: grid; grid-template-columns: 300px 1fr; gap: 40px; align-items: start; scroll-margin-top: calc(var(--altura-barra) + 24px); }
  .perfil + .perfil { padding-top: 48px; border-top: 1px solid var(--linha); }
  .perfil img { border-radius: 6px; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; box-shadow: var(--sombra); }
  .perfil h3 { font-size: 26px; margin-bottom: 4px; }
  .perfil h4 { font-size: 16px; margin: 22px 0 8px; }
  .oab { color: var(--texto-suave); }

  @media (max-width: 680px) {
    .perfil { grid-template-columns: 1fr; gap: 24px; }
    .perfil img { max-width: 320px; }
    .titulo-bloco { font-size: 26px; }
  }
</style>
