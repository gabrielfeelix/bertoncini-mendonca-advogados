---
/**
 * `/blog/` e `/blog/2/`, `/blog/3/`...: a lista do blog.
 *
 * O blog se chama **Blog** em toda a interface — decisão do cliente,
 * "tudo BLOG, sempre, textos nunca". Ele teve nome próprio ("Em português
 * claro") e o nome foi revogado: nome de seção inventado obriga o leitor a
 * descobrir o que a seção é, e "Blog" ele já sabe.
 *
 * ── Por que uma rota `[...page]` e não `index.astro` ────────────────────
 * O `paginate()` do Astro precisa de um parâmetro de caminho para numerar as
 * páginas, e ele exige que o parâmetro se chame exatamente `page` — é o
 * único nome em inglês do projeto, e é obrigação da ferramenta, não escolha.
 * Com um parâmetro comum (`[page].astro`) a primeira página sairia
 * em `/blog/1/`, e `/blog/` teria de ser uma segunda página duplicada,
 * com o custo de SEO que conteúdo duplicado traz. Com o parâmetro rest, o
 * Astro entrega `undefined` na primeira página, que vira `/blog/`, e as
 * seguintes viram `/blog/2/`. Uma rota, uma página por conteúdo.
 *
 * ── O destaque ──────────────────────────────────────────────────────────
 * O artigo mais recente aparece em evidência no topo da PRIMEIRA página, e
 * não entra na grade abaixo. Nas páginas seguintes não há destaque: quem
 * chegou na página 3 já passou pelo mais recente.
 *
 * ── Quando não há artigo nenhum ─────────────────────────────────────────
 * Enquanto o Supabase não tem credencial no ambiente, o loader devolve zero
 * artigo e esta página precisa continuar de pé. Ela mostra uma frase
 * explicando que ainda não há texto publicado e oferece a newsletter, que é o
 * que faz sentido para quem chegou. Não é um erro: é o estado normal do site
 * enquanto o CMS não entra no ar.
 *
 * A página inteira é HTML estático. Não há um comportamento aqui que dependa
 * de JavaScript: os cartões são `<a>`, a paginação são `<a>`.
 */
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import Marca from '~/components/Marca.astro';
import CartaoTexto from '~/components/CartaoTexto.astro';
import Newsletter from '~/components/Newsletter.astro';
import Contato from '~/components/Contato.astro';
import { listarArtigos, POR_PAGINA, NOME_DO_BLOG } from '~/lib/artigos';
void POR_PAGINA;

export const getStaticPaths = (async ({ paginate }) => {
  const artigos = await listarArtigos();

  /* A lista vazia também precisa de uma rota: sem isto, `paginate([])` não
     devolveria caminho nenhum e `/blog/` seria 404 — mas o menu do site
     aponta para ela em toda página. Um item 404 no menu principal é pior que
     uma página explicando que ainda não há texto. */
  if (artigos.length === 0) {
    return [
      {
        params: { page: undefined },
        props: {
          /* O mesmo formato que `paginate()` devolve, para a página abaixo
             não precisar de um segundo caminho de leitura. */
          page: {
            data: [],
            start: 0,
            end: -1,
            total: 0,
            size: POR_PAGINA,
            currentPage: 1,
            lastPage: 1,
            url: {
              current: '/blog/',
              prev: undefined,
              next: undefined,
              first: undefined,
              last: undefined,
            },
          },
          destaque: undefined,
        },
      },
    ];
  }

  /* O mais recente sai da grade e vira destaque da primeira página. */
  const [destaque, ...resto] = artigos;

  /* Uma página só (06/11/2026): filtro por assunto, ordem e busca rodam no
     navegador e precisam da lista inteira. O "Mostrar mais" da lista faz o
     papel da paginação. `POR_PAGINA` segue valendo para os redirecionamentos
     antigos de /textos/. */
  return paginate(resto, {
    pageSize: 10000,
    props: { destaque },
  });
}) satisfies GetStaticPaths;

const { page, destaque } = Astro.props;

const primeira = page.currentPage === 1;

/* Assuntos do filtro: as categorias que existem nos textos publicados, na
   ordem em que aparecem (o mais recente primeiro). */
const todos = [...(destaque ? [destaque] : []), ...page.data];
const assuntos = [...new Set(todos.map((a) => a.data.categoria))];
const semAcento = (t: string) => t.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
const dadosDe = (a: (typeof todos)[number]) => ({
  'data-assunto': a.data.categoria,
  'data-quando': String(a.data.publicadoEm.getTime()),
  'data-busca': semAcento(`${a.data.titulo} ${a.data.resumo} ${a.data.categoria}`),
});
const temArtigos = Boolean(destaque) || page.data.length > 0;

const titulo = primeira
  ? `${NOME_DO_BLOG} | Bertoncini & Mendonça Advogados`
  : `${NOME_DO_BLOG}, página ${page.currentPage} | Bertoncini & Mendonça Advogados`;

const descricao =
  'Textos sobre Planejamento Patrimonial e Sucessório e Direito Digital, escritos para quem não é da ' +
  'área. Um assunto por vez, em linguagem simples, pelo escritório ' +
  'Bertoncini & Mendonça, em Maringá, PR.';

/** Endereço de uma página da lista. A primeira é `/blog/`, sem número. */
const enderecoDaPagina = (numero: number) => (numero === 1 ? '/blog/' : `/blog/${numero}/`);
---

<Base titulo={titulo} descricao={descricao} paginaAtual="/blog/">
  <section class="abertura">
    <div class="env">
      <p class="etiqueta">Blog</p>
      {/* Era "Em português claro", nome próprio da seção, com a etiqueta
          "Textos" acima. O cliente reverteu os dois: "tudo BLOG, sempre,
          textos nunca". O que o nome próprio dizia — que o texto é escrito
          para quem não é da área — passou a ser dito pela frase de apoio
          abaixo, que é onde ele de fato se explica. */}
      <h1 class="display">Escrito para quem não é da área</h1>
      <p class="texto">
        Um assunto por vez, em linguagem simples, sem citação de artigo de lei
        que ninguém precisa decorar. Nenhum texto daqui substitui a conversa
        sobre o seu caso.
      </p>
      {
        !primeira && (
          <p class="posicao">
            Página {page.currentPage} de {page.lastPage}.
          </p>
        )
      }
    </div>
  </section>

  {
    !temArtigos && (
      <section class="vazio">
        <div class="env">
          <div class="placa">
            <Marca tipo="pauta" class="selo" />
            <div>
          <p class="frase">
            Ainda não publicamos nenhum texto por aqui. Os primeiros entram assim que
            estiverem escritos, e você pode receber cada um por e-mail.
          </p>
          <p class="atalho">
            <a href="/areas/">Ver as áreas de atuação</a>
          </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* Uma seção só (06/11/2026): o mais recente é o cartão grande no topo
      da mesma grade, e não uma seção à parte com rótulo e meia tela vazia
      ao lado. */}
  {
    (destaque && primeira) || page.data.length > 0 ? (
      <section class="lista" aria-label="Textos publicados">
        <div class="env">
          {/* Busca, assunto e ordem. Sem JavaScript a barra não aparece
              (`hidden`) e a lista inteira fica visível. */}
          <div class="filtros" data-filtros hidden>
            <label class="busca">
              <span class="visualmente-oculto">Buscar nos textos</span>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="2" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
              <input type="search" placeholder="Buscar" autocomplete="off" data-busca-campo />
            </label>
            {/* Menus próprios, e não o <select> nativo: o nativo abre com a
                cara do sistema operacional e não com a do site. */}
            <div class="escolha assunto" data-escolha="assunto">
              <button type="button" class="escolha-botao" aria-haspopup="listbox" aria-expanded="false" aria-label="Assunto">
                <span data-rotulo>Todos os assuntos</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <ul class="escolha-lista" role="listbox" aria-label="Assunto" tabindex="-1" hidden>
                <li role="option" data-valor="" aria-selected="true"><svg class="marca-ok" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m3 7.5 2.5 2.5L11 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>Todos os assuntos</li>
                {assuntos.map((a) => <li role="option" data-valor={a} aria-selected="false"><svg class="marca-ok" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m3 7.5 2.5 2.5L11 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>{a}</li>)}
              </ul>
            </div>
            <div class="escolha ordem" data-escolha="ordem">
              <button type="button" class="escolha-botao" aria-haspopup="listbox" aria-expanded="false" aria-label="Ordem">
                <span data-rotulo>Mais recentes</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <ul class="escolha-lista" role="listbox" aria-label="Ordem" tabindex="-1" hidden>
                <li role="option" data-valor="novos" aria-selected="true"><svg class="marca-ok" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m3 7.5 2.5 2.5L11 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>Mais recentes</li>
                <li role="option" data-valor="antigos" aria-selected="false"><svg class="marca-ok" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m3 7.5 2.5 2.5L11 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>Mais antigos</li>
              </ul>
            </div>
          </div>

          <div class="banca" data-banca>
            {primeira && destaque && <CartaoTexto artigo={destaque} nivel={2} grande dados={dadosDe(destaque)} />}
            {page.data.map((artigo) => (
              <CartaoTexto artigo={artigo} nivel={primeira && destaque ? 3 : 2} dados={dadosDe(artigo)} />
            ))}
          </div>

          <div class="nada" data-nada hidden>
            <p>Nenhum texto encontrado.</p>
            <button type="button" class="ler" data-limpar>Limpar filtros</button>
          </div>
          <div class="mais-env">
            <button type="button" class="mais" data-mais hidden>Mostrar mais textos</button>
          </div>

          {page.lastPage > 1 && (
            <nav class="paginas" aria-label="Páginas da lista de textos">
              {page.url.prev ? (
                <a class="passo" href={page.url.prev} rel="prev">
                  Anteriores
                </a>
              ) : (
                <span class="passo mudo">Anteriores</span>
              )}

              <ol class="numeros">
                {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((numero) => (
                  <li>
                    <a
                      href={enderecoDaPagina(numero)}
                      aria-current={numero === page.currentPage ? 'page' : undefined}
                      aria-label={`Página ${numero}`}
                    >
                      {numero}
                    </a>
                  </li>
                ))}
              </ol>

              {page.url.next ? (
                <a class="passo" href={page.url.next} rel="next">
                  Próximos
                </a>
              ) : (
                <span class="passo mudo">Próximos</span>
              )}
            </nav>
          )}
        </div>
      </section>
    ) : null
  }

  <script>
    /* Filtro do blog: assunto, busca e ordem, no navegador. Mostra até
       LOTE cartões de cada vez, e "Mostrar mais" libera o próximo lote.
       Com qualquer filtro ativo, o cartão grande vira cartão comum: o mais
       recente só faz sentido em destaque na lista completa. */
    const LOTE = 10;
    const raiz = document.querySelector<HTMLElement>('[data-filtros]');
    const banca = document.querySelector<HTMLElement>('[data-banca]');
    if (raiz && banca) {
      raiz.hidden = false;
      const cartoes = [...banca.querySelectorAll<HTMLAnchorElement>('a[data-quando]')];
      const campo = raiz.querySelector<HTMLInputElement>('[data-busca-campo]')!;
      /* Menu próprio: botão + lista. Setas andam, Enter/Espaço escolhem,
         Esc e clique fora fecham. Devolve quem define o valor de fora. */
      const ligaEscolha = (el: HTMLElement, aoMudar: (v: string) => void) => {
        const botao = el.querySelector<HTMLButtonElement>('.escolha-botao')!;
        const lista = el.querySelector<HTMLUListElement>('[role="listbox"]')!;
        const rotulo = el.querySelector<HTMLElement>('[data-rotulo]')!;
        const opcoes = [...lista.querySelectorAll<HTMLLIElement>('[role="option"]')];
        let foco = 0;
        const marca = (i: number) => {
          opcoes.forEach((o, k) => o.classList.toggle('foco', k === i));
          foco = i;
        };
        const abre = () => {
          lista.hidden = false;
          botao.setAttribute('aria-expanded', 'true');
          marca(Math.max(0, opcoes.findIndex((o) => o.getAttribute('aria-selected') === 'true')));
          lista.focus();
        };
        const fecha = (devolve = true) => {
          lista.hidden = true;
          botao.setAttribute('aria-expanded', 'false');
          if (devolve) botao.focus();
        };
        const define = (valor: string, avisa = true) => {
          opcoes.forEach((o) => {
            const sim = o.dataset.valor === valor;
            o.setAttribute('aria-selected', String(sim));
            if (sim) rotulo.textContent = o.textContent;
          });
          if (avisa) aoMudar(valor);
        };
        botao.addEventListener('click', () => (lista.hidden ? abre() : fecha()));
        opcoes.forEach((o, i) => {
          o.addEventListener('click', () => {
            define(o.dataset.valor ?? '');
            fecha();
          });
          o.addEventListener('pointerenter', () => marca(i));
        });
        lista.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown') marca(Math.min(opcoes.length - 1, foco + 1));
          else if (e.key === 'ArrowUp') marca(Math.max(0, foco - 1));
          else if (e.key === 'Enter' || e.key === ' ') {
            define(opcoes[foco].dataset.valor ?? '');
            fecha();
          } else if (e.key === 'Escape' || e.key === 'Tab') fecha(e.key === 'Escape');
          else return;
          e.preventDefault();
        });
        document.addEventListener('click', (e) => {
          if (!lista.hidden && !el.contains(e.target as Node)) fecha(false);
        });
        return define;
      };
      let ordemValor = 'novos';
      const nada = document.querySelector<HTMLElement>('[data-nada]')!;
      const mais = document.querySelector<HTMLButtonElement>('[data-mais]')!;
      const semAcento = (t: string) => t.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
      let assunto = '';
      let limite = LOTE;

      const aplica = () => {
        const termos = semAcento(campo.value.trim()).split(/\s+/).filter(Boolean);
        const filtrando = Boolean(assunto || termos.length || ordemValor !== 'novos');
        banca.classList.toggle('filtrando', filtrando);
        const ordenados = [...cartoes].sort((a, b) => {
          const d = Number(b.dataset.quando) - Number(a.dataset.quando);
          return ordemValor === 'antigos' ? -d : d;
        });
        let visiveis = 0;
        ordenados.forEach((c) => {
          banca.appendChild(c);
          const bate =
            (!assunto || c.dataset.assunto === assunto) &&
            termos.every((t) => (c.dataset.busca ?? '').includes(t));
          const mostra = bate && visiveis < limite;
          if (bate) visiveis++;
          c.hidden = !mostra;
          if (mostra) c.classList.add('aberta', 'visivel');
        });
        nada.hidden = visiveis > 0;
        mais.hidden = visiveis <= limite;
      };

      campo.addEventListener('input', () => {
        limite = LOTE;
        aplica();
      });
      const defineAssunto = ligaEscolha(raiz.querySelector('[data-escolha="assunto"]')!, (v) => {
        assunto = v;
        limite = LOTE;
        aplica();
      });
      const defineOrdem = ligaEscolha(raiz.querySelector('[data-escolha="ordem"]')!, (v) => {
        ordemValor = v;
        aplica();
      });
      mais.addEventListener('click', () => {
        limite += LOTE;
        aplica();
      });
      document.querySelector('[data-limpar]')?.addEventListener('click', () => {
        campo.value = '';
        ordemValor = 'novos';
        assunto = '';
        defineAssunto('', false);
        defineOrdem('novos', false);
        limite = LOTE;
        aplica();
      });
      aplica();
    }
  </script>

  <Newsletter id="textos" />
  <Contato />
</Base>

<style>
  .abertura {
    padding-block: clamp(40px, 7vw, 96px) clamp(30px, 4.5vw, 64px);
  }
  .etiqueta {
    font-size: 19px;
    font-weight: 500;
    color: #2a62ad;
    margin-bottom: 12px;
  }
  .abertura h1 {
    font-size: clamp(38px, 6.4vw, 82px);
    max-width: 14ch;
  }
  .abertura .texto {
    margin-top: clamp(20px, 2.6vw, 30px);
    max-width: 58ch;
    font-size: 18px;
    color: var(--secundario);
  }
  .posicao {
    margin-top: 16px;
    font-size: 16px;
    color: var(--secundario);
  }

  /* ── A lista sem nenhum artigo ── */
  .vazio {
    padding-block: clamp(24px, 3vw, 40px) clamp(48px, 6vw, 88px);
  }
  /*
    O estado vazio era uma frase solta e um botão, perdidos numa página
    larga: parecia página quebrada, não pauta em aberto. Vira placa, com
    a marca da pilha de folhas ao lado — a mesma gramática das outras
    páginas do redesenho.
  */
  .vazio .placa {
    display: flex;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    background: var(--papel);
    border-radius: clamp(16px, 2vw, 26px);
    padding: clamp(28px, 4vw, 56px);
    /* Sem limite, a placa atravessava a tela inteira enquanto o texto
       ocupava metade dela, e sobrava um campo de papel vazio à direita. */
    max-width: 920px;
  }
  .vazio :global(.selo) {
    width: clamp(96px, 11vw, 150px);
    flex: none;
  }
  @media (max-width: 700px) {
    .vazio .placa {
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
    }
    .vazio :global(.selo) {
      width: 84px;
    }
  }
  .vazio .frase {
    max-width: 46ch;
    font-size: clamp(20px, 2vw, 25px);
    line-height: 1.55;
    margin: 0;
  }
  .vazio .atalho {
    margin-top: 24px;
  }
  .vazio .atalho a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border: 1px solid var(--linha);
    border-radius: 999px;
    font-size: 16.5px;
    text-decoration: none;
  }
  .vazio .atalho a {
    background: var(--branco);
  }
  .vazio .atalho a:hover {
    border-color: var(--tinta);
    background: var(--linha);
  }

  /* Cartões brancos sobre cinza-claro, como nas notícias da Apple. */
  .lista {
    padding-block: clamp(40px, 5vw, 72px) clamp(64px, 8vw, 120px);
    background: #f2f4f7;
  }
  .banca > :global(.grande) {
    grid-column: 1 / -1;
  }
  .banca > :global([hidden]) {
    display: none;
  }
  /* Filtrando, o cartão grande vira comum. */
  .banca.filtrando > :global(.grande) {
    grid-column: auto;
    display: flex;
  }
  .banca.filtrando > :global(.grande .capa) {
    aspect-ratio: 16 / 10;
    min-height: 0;
  }
  .banca.filtrando > :global(.grande .corpo) {
    justify-content: flex-start;
    padding: clamp(20px, 2vw, 28px);
  }
  .banca.filtrando > :global(.grande .nome) {
    font-size: clamp(19px, 1.5vw, 22px);
  }
  .banca.filtrando > :global(.grande .resumo) {
    display: none;
  }
  .banca.filtrando > :global(.grande .pe) {
    margin-top: auto;
    padding-top: 18px;
  }

  /* ── barra de filtros ─────────────────────────────────────────────── */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(20px, 2.4vw, 32px);
  }
  .filtros[hidden] {
    display: none;
  }
  .busca {
    flex: 1 1 220px;
    max-width: 320px;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(11, 30, 63, 0.08);
    color: #7a8798;
  }
  .busca:focus-within {
    box-shadow: 0 0 0 2px #2a62ad;
  }
  .busca input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    font: inherit;
    font-size: 16px;
    color: var(--tinta);
  }
  .ordem {
    margin-inline-start: auto;
  }
  /* ── menus próprios ───────────────────────────────────────────── */
  .escolha {
    position: relative;
  }
  .escolha-botao {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    max-width: 100%;
    padding: 0 16px 0 18px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(11, 30, 63, 0.08);
    font-size: 15px;
    color: var(--tinta);
    cursor: pointer;
    transition: box-shadow 0.2s;
  }
  .escolha-botao span {
    overflow: hidden;
    text-overflow: ellipsis;
