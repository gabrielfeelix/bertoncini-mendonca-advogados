---
/**
 * Lista do blog (v3): grade de cartões com paginação e barra lateral.
 * Com zero artigos a rota continua existindo, porque o menu aponta para ela.
 */
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import BannerPagina from '~/components/BannerPagina.astro';
import CartaoArtigo from '~/components/CartaoArtigo.astro';
import Chamada from '~/components/Chamada.astro';
import { listarAreasConfirmadas } from '~/lib/areas';
import { listarArtigos, POR_PAGINA, NOME_DO_BLOG } from '~/lib/artigos';

export const getStaticPaths = (async ({ paginate }) => {
  const artigos = await listarArtigos();

  /* A lista vazia também precisa de uma rota: sem isto, `paginate([])` não
     devolveria caminho nenhum e `/blog/` seria 404 — mas o menu do site
     aponta para ela em toda página. Um item 404 no menu principal é pior que
     uma página explicando que ainda não há texto. */
  if (artigos.length === 0) {
    return [
      {
        params: { page: undefined },
        props: {
          /* O mesmo formato que `paginate()` devolve, para a página abaixo
             não precisar de um segundo caminho de leitura. */
          page: {
            data: [],
            start: 0,
            end: -1,
            total: 0,
            size: POR_PAGINA,
            currentPage: 1,
            lastPage: 1,
            url: {
              current: '/blog/',
              prev: undefined,
              next: undefined,
              first: undefined,
              last: undefined,
            },
          },
          destaque: undefined,
        },
      },
    ];
  }

  /* O mais recente sai da grade e vira destaque da primeira página. */
  const [destaque, ...resto] = artigos;

  return paginate(resto, {
    pageSize: POR_PAGINA,
    props: { destaque },
  });
}) satisfies GetStaticPaths;

const { page, destaque } = Astro.props;

const primeira = page.currentPage === 1;
const temArtigos = Boolean(destaque) || page.data.length > 0;

const titulo = primeira
  ? `${NOME_DO_BLOG} | Bertoncini & Mendonça Advogados`
  : `${NOME_DO_BLOG}, página ${page.currentPage} | Bertoncini & Mendonça Advogados`;

const descricao =
  'Textos sobre Planejamento Patrimonial e Sucessório e Direito Digital, escritos para quem não é da ' +
  'área. Um assunto por vez, em linguagem simples, pelo escritório ' +
  'Bertoncini & Mendonça, em Maringá, PR.';

/** Endereço de uma página da lista. A primeira é `/blog/`, sem número. */
const enderecoDaPagina = (numero: number) => (numero === 1 ? '/blog/' : `/blog/${numero}/`);

/* Na v3 não há destaque separado: o mais recente volta para o topo da grade. */
const lista = primeira && destaque ? [destaque, ...page.data] : page.data;
const areas = await listarAreasConfirmadas();
---

<Base titulo={titulo} descricao={descricao} paginaAtual="/blog/">
  <BannerPagina html="<strong>Blog</strong>" migalhas={[{ rotulo: 'Blog' }]} />

  <section class="secao">
    <div class="container com-lateral">
      <div>
        {temArtigos ? (
          <div class="grade grade-2">
            {lista.map((artigo) => <CartaoArtigo artigo={artigo} />)}
          </div>
        ) : (
          <p>Ainda não há publicações. Os primeiros textos estão sendo escritos.</p>
        )}

        {page.lastPage > 1 && (
          <nav class="paginacao" aria-label="Páginas do blog">
            {page.url.prev && <a href={page.url.prev}>← Anteriores</a>}
            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) =>
              n === page.currentPage ? (
                <span aria-current="page">{n}</span>
              ) : (
                <a href={enderecoDaPagina(n)}>{n}</a>
              ),
            )}
            {page.url.next && <a href={page.url.next}>Próximas →</a>}
          </nav>
        )}
      </div>

      <aside class="lateral">
        <div class="widget">
          <h2>Áreas de atuação</h2>
          <ul>
            {areas.map((a) => <li><a href={`/areas/${a.data.slug}/`}>{a.data.nome}</a></li>)}
          </ul>
        </div>
        <div class="widget widget-azul">
          <h2>Fale conosco</h2>
          <p>Tem uma dúvida sobre o seu caso? Escreva para o escritório.</p>
          <a class="botao botao-claro" href="/contato/">Enviar mensagem</a>
        </div>
      </aside>
    </div>
  </section>

  <Chamada />
</Base>

<style>
  .paginacao { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 40px; }
  .paginacao a, .paginacao span {
    display: inline-block; min-width: 40px; padding: 8px 12px; text-align: center;
    border: 1px solid var(--linha); border-radius: 4px; text-decoration: none;
  }
  .paginacao span { background: var(--azul); border-color: var(--azul); color: #fff; }
</style>
