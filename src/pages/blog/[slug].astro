---
/**
 * Artigo do blog (v3): banner com o título, texto com barra lateral
 * (outros textos, áreas, contato), padrão de post de tema WordPress.
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import BannerPagina from '~/components/BannerPagina.astro';
import Chamada from '~/components/Chamada.astro';
import { listarAreasConfirmadas } from '~/lib/areas';
import { listarArtigos, dataLegivel, NOME_DO_BLOG } from '~/lib/artigos';
import { site } from '~/lib/site';

export const getStaticPaths = (async () => {
  const artigos = await listarArtigos();
  return artigos.map((artigo) => ({ params: { slug: artigo.id }, props: { artigo } }));
}) satisfies GetStaticPaths;

const { artigo } = Astro.props;
const d = artigo.data;
const { Content } = await render(artigo);

/* Três outros textos no fim da página. A escolha prefere a mesma categoria,
   porque quem leu sobre um assunto tende a querer mais dele, e completa com os
   mais recentes quando a categoria não dá três. */
const todos = (await listarArtigos()).filter((item) => item.id !== artigo.id);
const daCategoria = todos.filter((item) => item.data.categoria === d.categoria);
const relacionados = [
  ...daCategoria,
  ...todos.filter((item) => !daCategoria.includes(item)),
].slice(0, 3);

/* O SEO vem do artigo. Nada de copy inventada aqui: se o banco trouxer
   seoTitulo ou seoDescricao, mandam eles. */
/* O sufixo encolhe conforme o título do artigo cresce, e some se nem o
   nome curto couber. O título do artigo vem do autor e pode ter até 120
   caracteres; com sufixo fixo, um título longo empurrava o nome do
   escritório para além do corte do Google, que exibia reticências no lugar
   dele. Melhor um <title> sem o nome do que um com o nome cortado. */
const tituloBase = d.seoTitulo ?? d.titulo;
const comNome = `${tituloBase} | ${site.nome}`;
const comCurto = `${tituloBase} | ${site.nomeCurto}`;
const titulo = comNome.length <= 70 ? comNome : comCurto.length <= 70 ? comCurto : tituloBase;
const descricao = d.seoDescricao ?? d.resumo;
const areas = await listarAreasConfirmadas();
---

<Base titulo={titulo} descricao={descricao} paginaAtual="/blog/">
  <BannerPagina
    titulo={d.titulo}
    migalhas={[{ rotulo: NOME_DO_BLOG, href: '/blog/' }, { rotulo: d.categoria }]}
  />

  <section class="secao">
    <div class="container com-lateral">
      <article>
        <p class="meta">
          <span class="rotulo">{d.categoria}</span>
          <span>
            <time datetime={d.publicadoEm.toISOString()}>{dataLegivel(d.publicadoEm)}</time>
            {d.tempoLeitura && <> · {d.tempoLeitura} min de leitura</>}
            {d.autor && <> · {d.autor}</>}
            {d.atualizadoEm && (
              <> · Atualizado em <time datetime={d.atualizadoEm.toISOString()}>{dataLegivel(d.atualizadoEm)}</time></>
            )}
          </span>
        </p>

        {d.capa && d.capaLargura && d.capaAltura && (
          <Image
            class="capa"
            src={d.capa}
            alt={d.capaAlt ?? ''}
            width={d.capaLargura}
            height={d.capaAltura}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1100px) 780px, 100vw"
            loading="eager"
          />
        )}
        {d.capa && d.capaCredito && <p class="credito">{d.capaCredito}</p>}

        <div class="texto">
          <p class="resumo">{d.resumo}</p>
          <Content />
        </div>

        <p class="aviso">{site.avisoInformativo}</p>
      </article>

      <aside class="lateral">
        {relacionados.length > 0 && (
          <div class="widget">
            <h2>Outros textos</h2>
            <ul>
              {relacionados.map((item) => <li><a href={`/blog/${item.id}/`}>{item.data.titulo}</a></li>)}
            </ul>
          </div>
        )}
        <div class="widget">
          <h2>Áreas de atuação</h2>
          <ul>
            {areas.map((a) => <li><a href={`/areas/${a.data.slug}/`}>{a.data.nome}</a></li>)}
          </ul>
        </div>
        <div class="widget widget-azul">
          <h2>Fale conosco</h2>
          <p>Tem uma dúvida sobre o seu caso? Escreva para o escritório.</p>
          <a class="botao botao-claro" href="/contato/">Enviar mensagem</a>
        </div>
      </aside>
    </div>
  </section>

  <Chamada />
</Base>

<style>
  .meta { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline; font-size: 14px; color: var(--texto-suave); }
  .meta .rotulo { margin: 0; }
  :global(.capa) { width: 100%; height: auto; border-radius: 6px; margin: 8px 0 6px; }
  .credito { font-size: 13px; color: var(--texto-suave); }
  .resumo { font-size: 20px; color: var(--azul); font-weight: 500; }
  .aviso { margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--linha); font-size: 14px; color: var(--texto-suave); }
</style>
