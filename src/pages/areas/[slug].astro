---
/**
 * `/areas/[slug]/`: uma página por área confirmada, gerada do conteúdo da
 * coleção `areas`.
 *
 * Só as áreas confirmadas entram no `getStaticPaths`. A terceira e a
 * quarta aparecem em `/areas/` marcadas "a confirmar" e sem link, então
 * nenhum link do site aponta para uma rota que não existe.
 *
 * A FORMA. A versão anterior era um zigue-zague de "cenas": parágrafo de
 * um lado, ícone genérico do outro, sete vezes, com o mesmo peso. O
 * cliente leu como "nada com nada". As páginas de área que funcionam
 * (Macfarlanes, Farrer, Cooley, Mattos Filho, Arauz) têm a mesma
 * estrutura, e é a que esta segue:
 *
 * 1. capa com o nome e a tese da área (o `resumo`) e a ação;
 * 2. o texto como documento: índice fixo à esquerda, seções numeradas
 *    à direita, em coluna de leitura. O índice é o que dá a quem chega a
 *    visão do que a área cobre sem precisar de uma lista duplicada;
 * 3. quem atende, com rosto e OAB — o "key contact" do Farrer;
 * 4. onde e como começa, em placa, com a segunda chamada.
 *
 * O texto não muda uma palavra: só o invólucro. A página funciona sem
 * JavaScript; o script do fim só marca no índice a seção que está na
 * tela.
 */
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import Perguntas from '~/components/Perguntas.astro';
import Marca from '~/components/Marca.astro';
import Zap from '~/components/Zap.astro';
import Contato from '~/components/Contato.astro';
import { listarAreas, listarAreasConfirmadas, whatsappDaArea } from '~/lib/areas';
import { site } from '~/lib/site';

export const getStaticPaths = (async () => {
  const areas = await listarAreasConfirmadas();
  return areas.map((area) => ({ params: { slug: area.data.slug }, props: { area } }));
}) satisfies GetStaticPaths;

const { area } = Astro.props;
const dados = area.data;

const outras = (await listarAreasConfirmadas()).filter((item) => item.data.slug !== dados.slug);
const pendentes = (await listarAreas()).filter((item) => item.data.aConfirmar);

const mensagem = dados.mensagemWhatsapp ?? 'Olá, gostaria de falar sobre um caso.';
const linkWhatsapp = whatsappDaArea(mensagem);
const aConfirmar = new Set(dados.corpoAConfirmar);

/* O mapa é por slug e não por índice: acrescentar uma terceira área não
   pode deslocar a marca das duas que existem. */
const marcaDaCapa: Record<string, 'sucessao' | 'rede'> = {
  'planejamento-patrimonial-e-sucessorio': 'sucessao',
  'direito-digital': 'rede',
};
const marcaCapa = marcaDaCapa[dados.slug];

/* O corpo em três papéis, lidos de `cenas` (ver o schema):
   - antes da primeira cena: a abertura;
   - cena só com rubrica: seção numerada, com entrada no índice;
   - cena com foto: a placa "Onde atendemos";
   - depois das cenas, sem cena: o fecho, que diz como o trabalho começa. */
const cenaPorIndice = new Map(dados.cenas.map((c) => [c.indice, c]));
const primeiraCena = Math.min(...dados.cenas.map((c) => c.indice));

type Paragrafo = { texto: string; placeholder: boolean };
const abertura: Paragrafo[] = [];
const fecho: Paragrafo[] = [];
const secoes: (Paragrafo & { id: string; rubrica: string })[] = [];
let onde: (Paragrafo & { rubrica: string; foto: string; fotoAlt: string }) | undefined;

const ids = new Set<string>();
const idDe = (rubrica: string) => {
  const base = rubrica
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
  let id = base;
  for (let n = 2; ids.has(id); n++) id = `${base}-${n}`;
  ids.add(id);
  return id;
};

dados.corpo.forEach((texto, indice) => {
  const paragrafo = { texto, placeholder: aConfirmar.has(indice) };
  const cena = cenaPorIndice.get(indice);
  if (!cena) {
    (indice < primeiraCena ? abertura : fecho).push(paragrafo);
  } else if (cena.foto && cena.fotoAlt && !onde) {
    onde = { ...paragrafo, rubrica: cena.rubrica, foto: cena.foto, fotoAlt: cena.fotoAlt };
  } else {
    secoes.push({ ...paragrafo, id: idDe(cena.rubrica), rubrica: cena.rubrica });
  }
});

/* Quem atende: o sócio cuja área é esta. A divisão está em `site.socios`. */
const socio = site.socios.find((s) => s.area === dados.slug);
const numero = (n: number) => String(n + 1).padStart(2, '0');
---

{/* Nome curto no sufixo: "Planejamento Patrimonial e Sucessório" já tem 37
    caracteres, e com o nome completo do escritório o título passava de 70 —
    o Google corta e o fim da linha vira reticências. */}
<Base
  titulo={`${dados.nome} | ${site.nomeCurto}`}
  descricao={`${dados.resumo} Atuação em ${site.cidade}, ${site.estado}.`}
  paginaAtual="/areas/"
>
  <article>
    {/* A CAPA carrega a trilha, o H1, a tese e a ação. A tese (o `resumo`)
        ficava solta abaixo da placa, em 19px, e a placa dizia só o nome:
        quem chegava via um título e mais nada. As referências põem a frase
        que define a área junto do nome, e é ela que diz em três segundos
        se a pessoa está no lugar certo. */}
    <div class="env">
      <header class="capa">
        <div class="capa-texto">
          <nav class="trilha" aria-label="Trilha de navegação">
            <a href="/areas/">Áreas de atuação</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{dados.nome}</span>
          </nav>
          <h1 class="display capa-nome">{dados.nome}</h1>
          <p class="tese">{dados.resumo}</p>
          <div class="capa-acao">
            <a
              class="botao zap vidro"
              href={linkWhatsapp}
              target="_blank"
              rel="noopener"
              data-placeholder={site.whatsapp.placeholder ? '1' : undefined}
            >
              Falar sobre {dados.nome.toLowerCase()}
              <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
            </a>
            <p class="nota">{site.horario}. A mensagem já vai com o assunto escrito.</p>
          </div>
        </div>
        {marcaCapa && <Marca tipo={marcaCapa} class="selo" />}
      </header>
    </div>

    {/* O DOCUMENTO. Índice à esquerda, texto à direita. */}
    <div class="env leitura">
      <aside class="lateral" aria-label="Nesta página">
        <div class="lateral-fixa">
          <p class="lateral-rotulo">Nesta página</p>
          <ol class="indice">
            {secoes.map((secao, n) => (
              <li>
                <a href={`#${secao.id}`} data-indice={secao.id}>
                  <span class="indice-num" aria-hidden="true">{numero(n)}</span>
                  {secao.rubrica}
                </a>
              </li>
            ))}
          </ol>
          <ul class="indice indice-extra">
            {socio && <li><a href="#quem-atende" data-indice="quem-atende">Quem atende</a></li>}
            {onde && <li><a href="#onde-atendemos" data-indice="onde-atendemos">{onde.rubrica}</a></li>}
            {dados.perguntas.length > 0 && <li><a href="#perguntas">Perguntas frequentes</a></li>}
          </ul>
        </div>
      </aside>

      <div class="texto">
        {abertura.length > 0 && (
          <div class="abertura">
            {abertura.map((p, n) => (
              <p class={n === 0 ? 'lead' : 'lead-apoio'} data-placeholder={p.placeholder ? '1' : undefined}>
                {p.texto}
              </p>
            ))}
          </div>
        )}

        {secoes.map((secao, n) => (
          <section class="secao-area" id={secao.id} aria-labelledby={`${secao.id}-titulo`}>
            <p class="secao-num" aria-hidden="true">{numero(n)}</p>
            <h2 id={`${secao.id}-titulo`}>{secao.rubrica}</h2>
            <p data-placeholder={secao.placeholder ? '1' : undefined}>{secao.texto}</p>
          </section>
        ))}

        {/* QUEM ATENDE. O cartão fica no fim do texto e não na lateral:
            a lateral é fixa, e um retrato preso ao lado do texto o tempo
            todo pesa mais do que informa. Aqui ele chega quando a pessoa
            terminou de ler e vai decidir se escreve. */}
        {socio && (
          <section class="quem" id="quem-atende" aria-labelledby="quem-titulo">
            <picture class="quem-foto">
              <source type="image/avif" srcset={`${socio.retrato}-560.avif`} />
              <source type="image/webp" srcset={`${socio.retrato}-560.webp`} />
              <img src={`${socio.retrato}-840.jpg`} alt={`Retrato de ${socio.nome}`} width="560" height="700" loading="lazy" decoding="async" />
            </picture>
            <div class="quem-texto">
              <h2 id="quem-titulo" class="quem-rotulo">Quem atende</h2>
              <p class="quem-nome">{socio.nome}</p>
              <p class="quem-oab" data-placeholder={socio.oab.placeholder ? '1' : undefined}>{socio.oab.valor}</p>
              <p class="quem-linha">{socio.linha}</p>
              <a class="quem-link" href="/escritorio/">Formação e trajetória</a>
            </div>
          </section>
        )}
      </div>
    </div>

    {/* ONDE E COMO COMEÇA. Os dois parágrafos que não são tema — onde o
        escritório atende e como o trabalho começa — viram a placa de
        fechamento, com a segunda chamada. É o ponto em que quem leu até
        aqui decide, e o botão precisa estar onde a decisão acontece. */}
    {(onde || fecho.length > 0) && (
      <div class="env">
        <section class="placa" id="onde-atendemos" aria-labelledby="placa-titulo">
          {onde && (
            <picture class="placa-foto">
              <source srcset={`/media/areas/${onde.foto}-900.avif 900w, /media/areas/${onde.foto}-1400.avif 1400w`} sizes="(max-width: 860px) 92vw, 44vw" type="image/avif" />
              <source srcset={`/media/areas/${onde.foto}-900.webp 900w, /media/areas/${onde.foto}-1400.webp 1400w`} sizes="(max-width: 860px) 92vw, 44vw" type="image/webp" />
              <img src={`/media/areas/${onde.foto}-1400.jpg`} alt={onde.fotoAlt} width="1400" height="1050" loading="lazy" decoding="async" />
            </picture>
          )}
          <div class="placa-texto">
            {onde && (
              <>
                <h2 id="placa-titulo">{onde.rubrica}</h2>
                <p data-placeholder={onde.placeholder ? '1' : undefined}>{onde.texto}</p>
              </>
            )}
            {fecho.length > 0 && (
              <>
                {onde ? <h3>Como o trabalho começa</h3> : <h2 id="placa-titulo">Como o trabalho começa</h2>}
                {fecho.map((p) => (
                  <p data-placeholder={p.placeholder ? '1' : undefined}>{p.texto}</p>
                ))}
              </>
            )}
            <p class="placa-acao">
              <a
                class="botao zap"
                href={linkWhatsapp}
                target="_blank"
                rel="noopener"
                data-placeholder={site.whatsapp.placeholder ? '1' : undefined}
              >
                Falar sobre {dados.nome.toLowerCase()} no WhatsApp
                <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
              </a>
            </p>
          </div>
        </section>
      </div>
    )}

    {dados.perguntas.length > 0 && (
      <div id="perguntas" class="ancora-perguntas">
        <Perguntas
          titulo={`Perguntas frequentes sobre ${dados.nome.toLowerCase()}`}
          perguntas={dados.perguntas}
        />
      </div>
    )}

    {/* Um cartão por área, com a ilustração, o resumo e a seta: quem chega
        no fim da página está decidindo se o assunto dela é outro, e para
        isso precisa ver o que a outra área é, não só o nome. */}
    <section class="outras">
      <div class="env">
        <h2>Outras áreas</h2>
        <div class="grade-outras">
          {outras.map((item) => (
            <a class="cartao-area" href={`/areas/${item.data.slug}/`}>
              {marcaDaCapa[item.data.slug] && (
                <Marca tipo={marcaDaCapa[item.data.slug]} class="selo-outra" />
              )}
              <h3>{item.data.nome}</h3>
              <p>{item.data.resumo}</p>
              <span class="leva">
                Ver a área
                <span class="seta" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
              </span>
            </a>
          ))}
          {pendentes.map((item) => (
            <div class="cartao-area vago">
              <h3>{item.data.nome}</h3>
              <p>A confirmar com os sócios.</p>
            </div>
          ))}
        </div>
        <p class="todas"><a href="/areas/">Ver todas as áreas</a></p>
      </div>
    </section>
  </article>

  <Contato />
</Base>

<script>
  /* Marca no índice a seção que está na tela. Só enfeite de orientação:
     sem este script o índice continua sendo uma lista de links que
     funciona. A "seção atual" é a última cujo topo já passou de 35% da
     altura da janela — com IntersectionObserver puro, duas seções curtas
     visíveis ao mesmo tempo disputavam a marca e ela piscava. */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.indice a[data-indice]')];
  const alvos = links
    .map((a) => document.getElementById(a.dataset.indice ?? ''))
    .filter((el): el is HTMLElement => !!el);

  if (alvos.length) {
    let pendente = false;
    const marca = () => {
      pendente = false;
      const linha = window.innerHeight * 0.35;
      let atual: HTMLElement | undefined;
      for (const alvo of alvos) {
        if (alvo.getBoundingClientRect().top <= linha) atual = alvo;
      }
      for (const a of links) {
        if (atual && a.dataset.indice === atual.id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!pendente) {
          pendente = true;
          requestAnimationFrame(marca);
        }
      },
      { passive: true },
    );
    marca();
  }
</script>

<style>
  /* ── Capa ─────────────────────────────────────────────────────────── */
  .capa {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(24px, 5vw, 80px);
    margin-top: clamp(14px, 2vw, 26px);
    padding: clamp(28px, 4vw, 64px) clamp(24px, 4vw, 72px);
    background: var(--tinta);
    color: #fff;
    border-radius: clamp(16px, 2vw, 26px);
    overflow: hidden;
  }
  .capa-texto {
    display: grid;
    justify-items: start;
    min-width: 0;
  }
  .trilha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.66);
  }
  .trilha a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.86);
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
  }
  .trilha a:hover {
    color: #fff;
    border-color: #fff;
  }
  .capa-nome {
    margin: clamp(10px, 1.4vw, 18px) 0 0;
    font-size: clamp(38px, 5.4vw, 80px);
    color: #fff;
    max-width: 14ch;
  }
  .tese {
    margin: clamp(16px, 2vw, 26px) 0 0;
    max-width: 38ch;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(20px, 1.9vw, 27px);
    line-height: 1.38;
    color: rgba(255, 255, 255, 0.84);
  }
  .capa-acao {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
    margin-top: clamp(26px, 3.2vw, 44px);
  }
  .capa-acao .botao {
    min-height: 48px;
  }
  .capa-acao .nota {
    margin: 0;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    max-width: 38ch;
  }

  .capa :global(.selo) {
    width: clamp(120px, 17vw, 250px);
    flex: none;
    /* A marca é desenhada para fundo claro: sobre a chapa azul as peças
       cheias em --tinta virariam buracos. Redefinir os tokens no escopo do
       ícone é o que faz o mesmo desenho servir às duas superfícies, como
       nos cards da home. */
    --tinta: #ffffff;
    --branco: #0b1e3f;
    --linha: rgba(255, 255, 255, 0.3);
    --secundario: rgba(255, 255, 255, 0.66);
    --papel: rgba(255, 255, 255, 0.1);
  }
  /* A ilustração da capa anima ao passar o mouse, como na home. Escopo por
     tipo de marca: as duas usam as mesmas tags, e um seletor por posição
     giraria a peça errada na outra. */
  .capa :global(.selo circle),
  .capa :global(.selo path),
  .capa :global(.selo rect) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .capa:hover :global(.marca-rede circle:first-of-type) {
    animation: gira 9s linear infinite;
  }
  .capa:hover :global(.marca-rede path) {
    animation: gira 9s linear infinite reverse;
  }
  .capa:hover :global(.marca-rede circle:last-of-type) {
    animation: pulsa 2.4s ease-in-out infinite;
  }
  .capa:hover :global(.marca-sucessao circle) {
    animation: pulsa 2.4s ease-in-out infinite;
  }
  .capa:hover :global(.marca-sucessao rect:nth-of-type(2)) {
    animation: acena 2.2s ease-in-out infinite;
  }
  .capa:hover :global(.marca-sucessao rect:nth-of-type(3)) {
    animation: acena 2.2s ease-in-out infinite 0.18s;
  }
  .capa:hover :global(.marca-sucessao rect:nth-of-type(4)) {
    animation: acena 2.2s ease-in-out infinite 0.36s;
  }
  @keyframes gira {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes pulsa {
    50% {
      transform: scale(1.22);
    }
  }
  @keyframes acena {
    50% {
      transform: translateY(-7px);
    }
  }

  /* ── O documento ──────────────────────────────────────────────────── */
  /*
    Duas colunas: índice e texto. A coluna do texto tem teto de 760px —
    a medida de leitura de ~70 caracteres em 19px —, e o que sobra da
    largura vai para o espaço entre as duas, não para linhas mais longas.
    `space-between` alinha o texto à borda direita da capa: com `start`
    sobrava uma faixa vazia à direita, e a página parecia torta.
  */
  .leitura {
    display: grid;
    grid-template-columns: minmax(200px, 280px) minmax(0, 760px);
    justify-content: space-between;
    gap: clamp(40px, 9vw, 160px);
    padding-block: clamp(48px, 6.5vw, 104px) clamp(40px, 5vw, 80px);
  }
  .lateral-fixa {
    position: sticky;
    top: 32px;
  }
  .lateral-rotulo {
    margin: 0 0 12px;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--secundario);
  }
  .indice {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--linha);
  }
  .indice a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-height: 44px;
    padding: 11px 0 11px 16px;
    border-bottom: 1px solid var(--linha);
    font-size: 16.5px;
    line-height: 1.3;
    color: var(--apoio);
    text-decoration: none;
    transition: color 0.2s;
  }
  /* O filete à esquerda é o marcador da seção atual e do hover. */
  .indice a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: var(--imperial);
    transform: scaleY(0);
    transition: transform 0.25s;
  }
  .indice a:hover,
  .indice a[aria-current] {
    color: var(--tinta);
  }
  .indice a:hover::before,
  .indice a[aria-current]::before {
    transform: scaleY(1);
  }
  .indice-num {
    flex: none;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    color: var(--secundario);
  }
  .indice a[aria-current] .indice-num {
    color: var(--imperial);
  }
  .indice-extra {
    margin-top: 22px;
  }

  .texto {
    min-width: 0;
  }
  .abertura {
    padding-bottom: clamp(36px, 4.5vw, 64px);
  }
  .lead {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(25px, 2.5vw, 35px);
    line-height: 1.32;
    letter-spacing: -0.01em;
    color: var(--tinta);
  }
  .lead-apoio {
    margin: clamp(18px, 2vw, 26px) 0 0;
    font-size: 19px;
    line-height: 1.65;
    color: var(--apoio);
  }

  /* Cada seção: número, título, texto. O número em vermelho imperial é o
     único acento da coluna; tudo o mais é tinta sobre branco. */
  .secao-area {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    column-gap: 8px;
    padding-block: clamp(30px, 3.6vw, 48px);
    border-top: 1px solid var(--linha);
    scroll-margin-top: 24px;
  }
  .secao-num {
    grid-row: 1;
    margin: 0;
    padding-top: 0.5em;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--imperial);
  }
  .secao-area h2 {
    grid-column: 2;
    margin: 0;
