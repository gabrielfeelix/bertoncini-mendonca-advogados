---
/**
 * Página de uma área (v3). Layout de página de tema WordPress: banner com
 * o nome, coluna de conteúdo (texto, "o que fazemos", perguntas) e barra
 * lateral com as áreas, o sócio responsável e uma caixa de contato.
 * O texto é o `corpo` da área, sem alteração.
 */
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import BannerPagina from '~/components/BannerPagina.astro';
import Chamada from '~/components/Chamada.astro';
import { site } from '~/lib/site';
import {
  listarAreasConfirmadas,
  assuntosDaArea,
  socioDaArea,
  FOTO_DA_AREA,
  type Area,
} from '~/lib/areas';

export const getStaticPaths = (async () => {
  const areas = await listarAreasConfirmadas();
  return areas.map((area) => ({ params: { slug: area.data.slug }, props: { area } }));
}) satisfies GetStaticPaths;

interface Props {
  area: Area;
}
const { area } = Astro.props;
const d = area.data;
const todas = await listarAreasConfirmadas();
const socio = socioDaArea(d.slug);
const assuntos = assuntosDaArea(d.assuntos);
const aConfirmar = new Set(d.corpoAConfirmar);
---

<Base titulo={`${d.nome} | ${site.nome}`} descricao={d.resumo} paginaAtual="/areas/">
  <BannerPagina
    titulo={d.nome}
    foto={FOTO_DA_AREA[d.slug]}
    migalhas={[{ rotulo: 'Áreas de atuação', href: '/areas/' }, { rotulo: d.nome }]}
  />

  <section class="secao">
    <div class="container com-lateral">
      <article class="texto">
        <p class="lead">{d.resumo}</p>
        {d.corpo.map((paragrafo, i) => (
          <p data-placeholder={aConfirmar.has(i) ? '1' : undefined}>{paragrafo}</p>
        ))}

        {d.publicos.length > 0 && (
          <>
            <h2>Para quem</h2>
            <ul class="publicos">
              {d.publicos.map((p) => <li><strong>{p.titulo}.</strong> {p.texto}</li>)}
            </ul>
          </>
        )}

        <h2>O que fazemos</h2>
        <table class="tabela-assuntos">
          <tbody>
            {assuntos.map((a) => (
              <tr>
                <th scope="row">{a.nome}</th>
                <td>{a.faz ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>

        {d.perguntas.length > 0 && (
          <>
            <h2>Perguntas frequentes</h2>
            <div class="faq">
              {d.perguntas.map((p) => (
                <details>
                  <summary>{p.pergunta}</summary>
                  <p>{p.resposta}</p>
                </details>
              ))}
            </div>
          </>
        )}

        <p class="aviso">{site.avisoInformativo}</p>
      </article>

      <aside class="lateral">
        <div class="widget">
          <h2>Áreas de atuação</h2>
          <ul>
            {todas.map((a) => (
              <li>
                <a href={`/areas/${a.data.slug}/`} aria-current={a.data.slug === d.slug ? 'page' : undefined}>
                  {a.data.nome}
                </a>
              </li>
            ))}
          </ul>
        </div>

        {socio && (
          <div class="widget socio">
            <h2>Responsável</h2>
            <img src={`${socio.retrato}-560.jpg`} alt={`Retrato de ${socio.nome}.`} width="560" height="840" loading="lazy" />
            <p class="socio-nome"><a href={`/escritorio/#${socio.nome.split(' ')[0].toLowerCase()}`}>{socio.nome}</a></p>
            <p class="socio-oab">{socio.oab.valor}</p>
          </div>
        )}

        <div class="widget widget-azul">
          <h2>Fale conosco</h2>
          <p>Conte o seu caso. Respondemos pelo e-mail que você informar.</p>
          <a class="botao botao-claro" href={`/contato/?assunto=${d.slug}`}>Enviar mensagem</a>
        </div>
      </aside>
    </div>
  </section>

  <Chamada />
</Base>

<style>
  .lead { font-size: 20px; color: var(--azul); font-weight: 500; }
  .publicos li { margin-bottom: 8px; }
  .tabela-assuntos { width: 100%; border-collapse: collapse; font-size: 16px; margin-bottom: 1em; }
  .tabela-assuntos th, .tabela-assuntos td { text-align: left; vertical-align: top; padding: 12px 14px; border-bottom: 1px solid var(--linha); }
  .tabela-assuntos th { width: 36%; color: var(--azul); font-weight: 500; }
  .tabela-assuntos tr:nth-child(odd) { background: var(--fundo-cinza); }
  .aviso { margin-top: 32px; font-size: 14px; color: var(--texto-suave); }

  .socio img { border-radius: 4px; aspect-ratio: 1; object-fit: cover; object-position: 50% 18%; margin-bottom: 14px; }
  .socio-nome { margin: 0; font-weight: 700; }
  .socio-nome a { color: var(--azul); text-decoration: none; }
  .socio-nome a:hover { text-decoration: underline; }
  .socio-oab { margin: 0; font-size: 14px; color: var(--texto-suave); }

  @media (max-width: 680px) {
    .tabela-assuntos th, .tabela-assuntos td { display: block; width: auto; }
    .tabela-assuntos th { padding-bottom: 2px; }
    .tabela-assuntos td { padding-top: 0; }
  }
</style>
