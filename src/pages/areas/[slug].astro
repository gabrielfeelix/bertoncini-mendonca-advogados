---
/**
 * `/areas/[slug]/`: uma página por área confirmada, gerada do conteúdo da
 * coleção `areas`.
 *
 * Só as áreas confirmadas entram no `getStaticPaths`. A terceira e a
 * quarta aparecem em `/areas/` marcadas "a confirmar" e sem link, então
 * nenhum link do site aponta para uma rota que não existe.
 *
 * A FORMA. A versão anterior era um zigue-zague de "cenas": parágrafo de
 * um lado, ícone genérico do outro, sete vezes, com o mesmo peso. O
 * cliente leu como "nada com nada". As páginas de área que funcionam
 * (Macfarlanes, Farrer, Cooley, Mattos Filho, Arauz) têm a mesma
 * estrutura, e é a que esta segue:
 *
 * 1. capa com o nome e a tese da área (o `resumo`) e a ação;
 * 2. o texto como documento: índice fixo à esquerda, seções numeradas
 *    à direita, em coluna de leitura. O índice é o que dá a quem chega a
 *    visão do que a área cobre sem precisar de uma lista duplicada;
 * 3. quem atende, com rosto e OAB — o "key contact" do Farrer;
 * 4. onde e como começa, em placa, com a segunda chamada.
 *
 * O texto não muda uma palavra: só o invólucro. A página funciona sem
 * JavaScript; o script do fim só marca no índice a seção que está na
 * tela.
 */
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import Perguntas from '~/components/Perguntas.astro';
import Zap from '~/components/Zap.astro';
import Contato from '~/components/Contato.astro';
import { listarAreas, listarAreasConfirmadas, whatsappDaArea } from '~/lib/areas';
import { site } from '~/lib/site';

export const getStaticPaths = (async () => {
  const areas = await listarAreasConfirmadas();
  return areas.map((area) => ({ params: { slug: area.data.slug }, props: { area } }));
}) satisfies GetStaticPaths;

const { area } = Astro.props;
const dados = area.data;

const outras = (await listarAreasConfirmadas()).filter((item) => item.data.slug !== dados.slug);
const pendentes = (await listarAreas()).filter((item) => item.data.aConfirmar);

const mensagem = dados.mensagemWhatsapp ?? 'Olá, gostaria de falar sobre um caso.';
const linkWhatsapp = whatsappDaArea(mensagem);
/* O formulário é o canal principal (briefing q7.5). O link leva o slug e
   /contato/ chega com o assunto já escolhido. */
const linkFormulario = `/contato/?assunto=${dados.slug}#formulario`;
const aConfirmar = new Set(dados.corpoAConfirmar);

/* O mapa é por slug e não por índice: acrescentar uma terceira área não
   pode deslocar a marca das duas que existem. */
const marcaDaCapa: Record<string, 'sucessao' | 'rede'> = {
  'planejamento-patrimonial-e-sucessorio': 'sucessao',
  'direito-digital': 'rede',
};
const marcaCapa = marcaDaCapa[dados.slug];

/* O corpo em três papéis, lidos de `cenas` (ver o schema):
   - antes da primeira cena: a abertura;
   - cena só com rubrica: seção numerada, com entrada no índice;
   - cena com foto: a placa "Onde atendemos";
   - depois das cenas, sem cena: o fecho, que diz como o trabalho começa. */
const cenaPorIndice = new Map(dados.cenas.map((c) => [c.indice, c]));
const primeiraCena = Math.min(...dados.cenas.map((c) => c.indice));

type Paragrafo = { texto: string; placeholder: boolean };
const abertura: Paragrafo[] = [];
const fecho: Paragrafo[] = [];
const secoes: (Paragrafo & { id: string; rubrica: string })[] = [];
let onde: (Paragrafo & { rubrica: string; foto: string; fotoAlt: string }) | undefined;

const ids = new Set<string>();
const idDe = (rubrica: string) => {
  const base = rubrica
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
  let id = base;
  for (let n = 2; ids.has(id); n++) id = `${base}-${n}`;
  ids.add(id);
  return id;
};

dados.corpo.forEach((texto, indice) => {
  const paragrafo = { texto, placeholder: aConfirmar.has(indice) };
  const cena = cenaPorIndice.get(indice);
  if (!cena) {
    (indice < primeiraCena ? abertura : fecho).push(paragrafo);
  } else if (cena.foto && cena.fotoAlt && !onde) {
    onde = { ...paragrafo, rubrica: cena.rubrica, foto: cena.foto, fotoAlt: cena.fotoAlt };
  } else {
    secoes.push({ ...paragrafo, id: idDe(cena.rubrica), rubrica: cena.rubrica });
  }
});

/* Quem atende: os dois sócios, sempre. O escritório pediu (06/11/2026)
   para não dividir a atuação por sócio no site: os dois atendem as duas
   áreas, e o cliente precisa ver isso. A divisão interna fica com eles. */
const socios = site.socios;
const numero = (n: number) => String(n + 1).padStart(2, '0');

/* Fotos da série própria (docs/PROMPTS-IMAGENS.md). A da outra área é a
   do banner do fim. Área nova cai na padrão até ganhar a sua. */
const FOTO_DA_AREA: Record<string, string> = {
  'planejamento-patrimonial-e-sucessorio': '/media/novas/area-familia',
  'direito-digital': '/media/novas/area-presenca',
};
const fotoDe = (slug: string) => FOTO_DA_AREA[slug] ?? '/media/novas/area-contratos';
const assuntos = dados.assuntos.map((a) => (typeof a === 'string' ? a : a.nome));

/* A abertura da página: uma frase só, direta, com um destaque entre
   asteriscos. O texto longo de abertura do JSON continua sendo do cliente,
   mas na página ele ninguém lia (eram 60 palavras em 40px). Área sem frase
   aqui cai no resumo. */
const LEAD_DA_AREA: Record<string, string> = {
  'planejamento-patrimonial-e-sucessorio':
    'Decidir em vida o destino do *patrimônio*, para que ele não vire inventário demorado, imposto a mais ou briga de família.',
  'direito-digital':
    'As regras do que você faz na *internet*: os dados que coleta, o que publica, os contratos que assina e os danos que sofre.',
};
const lead = (LEAD_DA_AREA[dados.slug] ?? dados.resumo).split(/(\*[^*]+\*)/).filter(Boolean);
---

<Base
  titulo={`${dados.nome} | ${site.nomeCurto}`}
  descricao={`${dados.resumo} Atuação em ${site.cidade}, ${site.estado}.`}
  paginaAtual="/areas/"
  heroSobreposto={true}
>
  {/* Versão cinematográfica (26/10/2026), com o repertório da home e de O
      escritório: capa em painel azul com grão, abertura que se acende,
      "para quem" em painel (padrão green-volt), os assuntos num trilho
      horizontal preso à rolagem, quem atende em cartão de foto inteira, onde
      atendemos sobre a foto de Maringá e a outra área em banner. Movimento
      em scripts/cinema.ts; sem ele, tudo é documento comum. */}
  <article class="area-pagina">
    <section class="capa">
      <span class="grao" style="filter:url(#grao)" aria-hidden="true"></span>
      <div class="env capa-grade">
        <div class="capa-texto">
          <nav class="trilha" aria-label="Você está em">
            <a href="/areas/">Áreas de atuação</a><span aria-hidden="true"> / </span><span aria-current="page">{dados.nome}</span>
          </nav>
          <h1 class="capa-nome" data-sobe>{dados.nome}</h1>
          <p class="capa-resumo" data-sobe>{dados.resumo}</p>
          <div class="capa-acoes" data-sobe>
            <a class="botao claro" href={linkFormulario}>
              Contar o seu caso
              <span class="disco" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="#fff" stroke-width="1.6" stroke-linecap="round" /></svg></span>
            </a>
            <a class="botao zap vidro" href={linkWhatsapp} target="_blank" rel="noopener">
              WhatsApp
              <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
            </a>
          </div>
        </div>
        <figure class="capa-foto" data-sobe>
          <picture>
            <source type="image/avif" srcset={`${fotoDe(dados.slug)}.avif`} />
            <source type="image/webp" srcset={`${fotoDe(dados.slug)}.webp`} />
            <img src={`${fotoDe(dados.slug)}.jpg`} alt="" width="900" height="1125" />
          </picture>
        </figure>
      </div>
      <div class="capa-letreiro" aria-label="Assuntos da área">
        <div class="trilho">
          {[0, 1].map((copia) => (
            <ul aria-hidden={copia === 1 ? 'true' : undefined}>{assuntos.map((a) => <li>{a}</li>)}</ul>
          ))}
        </div>
      </div>
    </section>

    <section class="abertura">
      <div class="env">
        <p class="lead" data-acende-leve>
          {lead.map((parte) => (parte.startsWith('*') ? <em>{parte.slice(1, -1)}</em> : parte))}
        </p>
      </div>
    </section>

    {dados.publicos.length > 0 && (
      <section class="publicos" aria-labelledby="publicos-titulo">
        <div class="env">
          <div class="painel-publicos">
            <header>
              <p class="chave">{'{ 01 }'}</p>
              <h2 id="publicos-titulo">Para quem é</h2>
            </header>
            <ul class="cartoes-publicos" style={`--n:${dados.publicos.length}`}>
              {dados.publicos.map((p, i) => (
                <li data-sobe>
                  <span class="pilula-vidro">{numero(i)}</span>
                  <h3>{p.titulo}</h3>
                  <p>{p.texto}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    {dados.servicos.length > 0 && (
      <section class="servicos-area" aria-labelledby="servicos-titulo">
        <div class="env servicos-grade">
          <header class="servicos-cab">
            <p class="chave">{'{ 02 }'}</p>
            <h2 id="servicos-titulo">Serviços</h2>
            <p>O que você pode contratar nesta área. Se o seu caso não estiver na lista, escreva mesmo assim.</p>
            <a class="botao zap" href={linkWhatsapp} target="_blank" rel="noopener">
              Falar pelo WhatsApp
              <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
            </a>
          </header>
          <ul class="servicos-lista">
            {dados.servicos.map((servico, i) => (
              <li data-sobe>
                <span class="servico-num" aria-hidden="true">{numero(i)}</span>
                <span>{servico}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {secoes.length > 0 && (
      <section class="abrange" data-trilho style={`--n:${secoes.length}`} aria-labelledby="abrange-titulo">
        <div class="abrange-palco">
          <div class="env abrange-cab">
            <p class="chave">{'{ 03 }'}</p>
            <h2 id="abrange-titulo">O que a área <em>abrange.</em></h2>
            <div class="progresso" aria-hidden="true"><span data-progresso></span></div>
          </div>
          <div class="abrange-janela">
            <ol class="abrange-faixa" data-faixa>
              {secoes.map((secao, n) => (
                <li class="assunto" id={secao.id}>
                  <span class="assunto-num">{numero(n)}</span>
                  <h3>{secao.rubrica}</h3>
                  <p data-placeholder={secao.placeholder ? '1' : undefined}>{secao.texto}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    )}

    {/* Os dois sócios numa foto só, a da hero da home, ocupando o cartão
        inteiro. A versão com dois retratos lado a lado sobre bloco azul
        parecia montagem; a foto em que eles já estão juntos diz "atuação
        integrada" sem precisar de frase. */}
    <section class="quem" id="quem-atende" aria-labelledby="quem-titulo">
      <div class="env">
        <div class="quem-cartao" data-sobe>
          <picture class="quem-foto">
            <source media="(max-width: 700px)" type="image/avif" srcset="/media/hero/socios-vert-600.avif 600w, /media/hero/socios-vert-800.avif 800w" sizes="100vw" />
            <source media="(max-width: 700px)" type="image/webp" srcset="/media/hero/socios-vert-600.webp 600w, /media/hero/socios-vert-800.webp 800w" sizes="100vw" />
            <source type="image/avif" srcset="/media/hero/socios-900.avif 900w, /media/hero/socios-1200.avif 1200w, /media/hero/socios-1600.avif 1600w" sizes="(min-width: 1500px) 1360px, 92vw" />
            <source type="image/webp" srcset="/media/hero/socios-900.webp 900w, /media/hero/socios-1200.webp 1200w, /media/hero/socios-1600.webp 1600w" sizes="(min-width: 1500px) 1360px, 92vw" />
            <img src="/media/hero/socios-1600.jpg" alt={`${socios.map((s) => s.nome).join(' e ')}, sócios do escritório`} width="1600" height="900" loading="lazy" decoding="async" />
          </picture>
          <div class="quem-texto">
            <h2 id="quem-titulo" class="quem-rotulo">Quem atende</h2>
            <ul class="quem-nomes">
              {socios.map((socio) => (
                <li>
                  <p class="quem-nome">{socio.nome}</p>
                  <p class="quem-oab" data-placeholder={socio.oab.placeholder ? '1' : undefined}>{socio.oab.valor}</p>
                </li>
              ))}
            </ul>
            <p class="quem-linha">Os dois sócios atuam juntos nos casos da área, do trabalho preventivo ao processo, quando ele é necessário.</p>
            <a class="botao vidro" href="/escritorio/">
              Conheça o escritório
              <span class="disco" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="#fff" stroke-width="1.6" stroke-linecap="round" /></svg></span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="onde" id="onde-atendemos" aria-labelledby="onde-titulo">
      <picture class="onde-fundo" aria-hidden="true">
        <source type="image/avif" srcset="/media/novas/contato-lateral.avif" />
        <source type="image/webp" srcset="/media/novas/contato-lateral.webp" />
        <img src="/media/novas/contato-lateral.jpg" alt="" width="1100" height="1375" loading="lazy" />
      </picture>
      <div class="env onde-corpo">
        <div class="onde-texto" data-sobe>
          {onde ? (
            <>
              <h2 id="onde-titulo">{onde.rubrica}</h2>
              <p data-placeholder={onde.placeholder ? '1' : undefined}>{onde.texto}</p>
              <h3>Como o trabalho começa</h3>
            </>
          ) : (
            <h2 id="onde-titulo">Como o trabalho começa</h2>
          )}
          {fecho.map((p) => <p data-placeholder={p.placeholder ? '1' : undefined}>{p.texto}</p>)}
          <div class="capa-acoes">
            <a class="botao claro" href={linkFormulario}>
              Contar o seu caso
              <span class="disco" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="#fff" stroke-width="1.6" stroke-linecap="round" /></svg></span>
            </a>
            <a class="botao zap vidro" href={linkWhatsapp} target="_blank" rel="noopener">
              WhatsApp
              <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {dados.perguntas.length > 0 && (
      <div id="perguntas" class="ancora-perguntas">
        <Perguntas titulo={`Perguntas frequentes sobre ${dados.nome.toLowerCase()}`} perguntas={dados.perguntas} />
      </div>
    )}

    {(outras.length > 0 || pendentes.length > 0) && (
      <section class="outras" aria-labelledby="outras-titulo">
        <div class="env">
          <h2 id="outras-titulo" class="chave">Conheça também</h2>
          {outras.map((item) => (
            <a class="banner" href={`/areas/${item.data.slug}/`}>
              <picture aria-hidden="true">
                <source type="image/avif" srcset={`${fotoDe(item.data.slug)}.avif`} />
                <source type="image/webp" srcset={`${fotoDe(item.data.slug)}.webp`} />
                <img src={`${fotoDe(item.data.slug)}.jpg`} alt="" width="900" height="1125" loading="lazy" />
              </picture>
              <span class="banner-texto">
                <span class="banner-nome">{item.data.nome}</span>
                <span class="banner-resumo">{item.data.resumo}</span>
              </span>
              <span class="banner-seta" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 14 14" fill="none"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg></span>
            </a>
          ))}
          {pendentes.map((item) => (
            <p class="vago">{item.data.nome}: a confirmar com os sócios.</p>
          ))}
          <p class="todas"><a href="/areas/">Ver todas as áreas</a></p>
        </div>
      </section>
    )}
  </article>

  <Contato />
</Base>

<script>
  import { ligaCinema } from '~/scripts/cinema';
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('movimento-area');
    void ligaCinema();
  }
</script>

<style>
  .area-pagina {
    --destaque: #2a62ad;
    --gelo: #eaf0f6;
    overflow-x: clip;
  }
  .pilula {
    display: inline-block;
    align-self: start;
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--gelo);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinta);
  }
  .chave {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secundario);
  }
  .chave.claro {
    color: rgba(255, 255, 255, 0.65);
  }
  .grao {
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: inset(0);
    background: #8aa0bc;
    mix-blend-mode: overlay;
    opacity: 0.4;
    pointer-events: none;
  }
  .botao.claro {
    background: #fff;
    color: var(--tinta);
  }
  .botao.claro:hover {
    background: var(--papel);
  }

  /* ── capa ────────────────────────────────────────────────────────── */
  .capa {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100vh;
    display: grid;
    grid-template-rows: 1fr auto;
    color: #fff;
    background: linear-gradient(125deg, #1f4c88 0%, #163a6d 38%, #0e2a52 72%, var(--tinta) 100%);
  }
  .capa-grade {
    width: 100%;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(32px, 5vw, 96px);
    align-items: center;
    padding-block: clamp(120px, 15vh, 170px) clamp(36px, 6vh, 64px);
  }
  .trilha {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.65);
  }
  .trilha a {
    color: inherit;
  }
  .capa-nome {
    margin-top: 22px;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(44px, 6vw, 96px);
    line-height: 0.94;
    letter-spacing: -0.03em;
  }
  .capa-resumo {
    margin-top: 24px;
    max-width: 38ch;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.9);
  }
  .capa-acoes {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .capa-foto {
    margin: 0;
    justify-self: center;
    aspect-ratio: 4 / 5;
    max-height: 68vh;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6);
  }
  .capa-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .capa-letreiro {
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-block: 18px;
  }
  .capa-letreiro .trilho {
    display: flex;
    width: max-content;
    animation: corre 60s linear infinite;
  }
  .capa-letreiro ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  .capa-letreiro li {
    padding-inline: 26px;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(18px, 1.8vw, 26px);
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.3);
  }
  .capa-letreiro li::after {
    content: '/';
    margin-left: 52px;
  }
  @keyframes corre {
    to {
      transform: translateX(-50%);
    }
  }

  /* ── abertura ────────────────────────────────────────────────────── */
  .abertura {
    padding-block: clamp(72px, 9vw, 130px);
  }
  .lead {
    max-width: 30ch;
    margin: 0 auto;
    text-align: center;
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 38px);
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .lead :global(.palavra) {
    display: inline-block;
  }
  .lead em {
    font-style: normal;
    color: var(--destaque);
  }

  /* ── para quem (painel green-volt) ───────────────────────────────── */
  .painel-publicos {
    position: relative;
    padding: clamp(32px, 4vw, 64px);
    border-radius: 22px;
    background: linear-gradient(135deg, #163a6d, var(--tinta));
    color: #fff;
  }
  .painel-publicos .chave {
    color: rgba(255, 255, 255, 0.6);
  }
  .painel-publicos h2 {
    margin-top: 10px;
    font-family: var(--sans);
