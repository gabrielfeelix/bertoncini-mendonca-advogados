---
/**
 * Página de uma área, em português. Conteúdo em src/views/Area.astro.
 * `alternativa` é a mesma área em inglês, achada pelo `slugPt`.
 */
import type { GetStaticPaths } from 'astro';
import Area from '~/views/Area.astro';
import { areasDoIdioma, type AreaNoIdioma } from '~/lib/areas';

export const getStaticPaths = (async () => {
  const [pt, en] = await Promise.all([areasDoIdioma('pt'), areasDoIdioma('en')]);
  return pt.map((area) => ({
    params: { slug: area.data.slug },
    props: { area, alternativa: en.find((e) => e.slugPt === area.slugPt)?.href ?? '/en/practice-areas/' },
  }));
}) satisfies GetStaticPaths;

interface Props {
  area: AreaNoIdioma;
  alternativa: string;
}
const { area, alternativa } = Astro.props;
---

<Area lang="pt" area={area} alternativa={alternativa} />
