---
/** Lista das áreas de atuação (v3): banner + cartões. */
import Base from '~/layouts/Base.astro';
import BannerPagina from '~/components/BannerPagina.astro';
import Chamada from '~/components/Chamada.astro';
import IconeArea from '~/components/IconeArea.astro';
import { site } from '~/lib/site';
import { listarAreasConfirmadas, assuntosDaArea } from '~/lib/areas';

const areas = await listarAreasConfirmadas();
---

<Base
  titulo={`Áreas de atuação | ${site.nome}`}
  descricao="As áreas de atuação de Bertoncini & Mendonça Advogados: Planejamento Patrimonial e Sucessório e Direito Digital."
  paginaAtual="/areas/"
>
  <BannerPagina html="Áreas de <strong>Atuação</strong>" migalhas={[{ rotulo: 'Áreas de atuação' }]} />

  <section class="secao">
    <div class="container">
      <div class="grade grade-2">
        {areas.map((area) => {
          const lista = area.data.servicos.length > 0 ? area.data.servicos : assuntosDaArea(area.data.assuntos).map((a) => a.nome);
          return (
            <article class="cartao">
              <div class="cartao-corpo">
                <IconeArea slug={area.data.slug} />
                <h2 class="nome"><a href={`/areas/${area.data.slug}/`}>{area.data.nome}</a></h2>
                <p>{area.data.resumo}</p>
                <ul class="assuntos">
                  {lista.map((item) => <li>{item}</li>)}
                </ul>
                <a class="botao botao-contorno" href={`/areas/${area.data.slug}/`}>Ver mais</a>
              </div>
            </article>
          );
        })}
      </div>

      <div class="outras">
        <h2>Também atuamos em</h2>
        <ul>{site.outrasAreas.map((a) => <li>{a}</li>)}</ul>
      </div>
    </div>
  </section>

  <Chamada />
</Base>

<style>
  .nome { font-size: 24px; }
  .nome a { color: var(--azul); text-decoration: none; }
  .nome a:hover { color: var(--azul-medio); text-decoration: underline; }
  .assuntos { columns: 2; column-gap: 24px; padding-left: 1.1em; margin-bottom: 18px; }
  .assuntos li { break-inside: avoid; margin-bottom: 4px; }
  .outras { margin-top: 40px; padding: 28px 32px; background: var(--fundo-cinza); border-radius: 6px; }
  .outras h2 { font-size: 22px; margin-bottom: 14px; }
  .outras ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .outras li { background: #fff; border: 1px solid var(--linha); border-radius: 4px; padding: 6px 14px; }
  .cartao-corpo .botao { align-self: flex-start; margin-top: auto; }
  @media (max-width: 480px) { .assuntos { columns: 1; } }
</style>
