---
/**
 * Áreas de atuação (06/11/2026).
 *
 * Página de categoria no padrão da Apple: título calmo, e cada área como um
 * tile claro grande, com texto e foto lado a lado e os serviços abaixo.
 * Substitui a versão de painéis azuis de tela cheia, que tinha título em
 * caixa alta, numeração, letreiro de assuntos e não mostrava os serviços.
 *
 * As áreas vêm da coleção: área nova no JSON ganha tile sozinha (a foto cai
 * na padrão até alguém escolher uma em FOTO_DA_AREA). Os dois sócios
 * atendem todas as áreas (retorno de 06/11/2026).
 */
import Base from '~/layouts/Base.astro';
import Contato from '~/components/Contato.astro';
import OutrasAreas from '~/components/OutrasAreas.astro';
import { listarAreasConfirmadas, whatsappDaArea } from '~/lib/areas';

const areas = await listarAreasConfirmadas();

const FOTO_DA_AREA: Record<string, string> = {
  'planejamento-patrimonial-e-sucessorio': '/media/novas/area-familia',
  'direito-digital': '/media/novas/area-presenca',
};

const tiles = areas.map((area) => {
  const d = area.data;
  return {
    slug: d.slug,
    nome: d.nome,
    resumo: d.resumo,
    publico: d.publicoCurto,
    servicos: d.servicos,
    href: `/areas/${d.slug}/`,
    whatsapp: whatsappDaArea(d.mensagemWhatsapp ?? `Olá! Gostaria de conversar sobre ${d.nome.toLowerCase()}.`),
    foto: FOTO_DA_AREA[d.slug] ?? '/media/novas/area-contratos',
  };
});

const descricao =
  `Áreas de atuação do escritório em Maringá, PR: ` +
  `${areas.map((area) => area.data.nome).join(' e ')}. ` +
  `Os serviços de cada uma e as outras áreas em que o escritório atua.`;
---

<Base titulo="Áreas de atuação | Bertoncini & Mendonça Advogados" descricao={descricao} paginaAtual="/areas/">
  <section class="topo">
    <div class="env">
      <h1 class="sobe">Áreas de atuação</h1>
      <p class="sobe">
        Dois campos concentram o nosso trabalho, e costumam chegar juntos: quem organiza o patrimônio
        também tem marca, e quem vive da internet precisa de contrato e de pensar na sucessão.
      </p>
    </div>
  </section>

  <section class="lista" aria-label="As áreas">
    <div class="env">
      {tiles.map((t) => (
        <article class="area sobe" aria-labelledby={`area-${t.slug}`}>
          <div class="area-topo">
            <div class="area-texto">
              <h2 id={`area-${t.slug}`}>{t.nome}</h2>
              <p class="resumo">{t.resumo}</p>
              {t.publico && (
                <p class="publico">
                  <b>Para quem é.</b> {t.publico}
                </p>
              )}
              <div class="acoes">
                <a class="pilula" href={t.href}>Conhecer a área</a>
                <a class="ler" href={t.whatsapp} target="_blank" rel="noopener">Falar pelo WhatsApp</a>
              </div>
            </div>
            <a class="area-foto" href={t.href} tabindex="-1" aria-hidden="true">
              <picture>
                <source type="image/avif" srcset={`${t.foto}.avif`} />
                <source type="image/webp" srcset={`${t.foto}.webp`} />
                <img src={`${t.foto}.jpg`} alt="" width="900" height="1125" loading="lazy" decoding="async" />
              </picture>
            </a>
          </div>

          {t.servicos.length > 0 && (
            <div class="servicos">
              <h3>Serviços</h3>
              <ul>
                {t.servicos.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          )}
        </article>
      ))}

      <div class="vao"><OutrasAreas /></div>
    </div>
  </section>

  <Contato />
</Base>

<style>
  /* ── topo ─────────────────────────────────────────────────────────── */
  .topo {
    padding-block: clamp(72px, 9vw, 140px) clamp(40px, 5vw, 72px);
    text-align: center;
  }
  .topo h1 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(44px, 6.4vw, 96px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--tinta);
  }
  .topo p {
    max-width: 34em;
    margin: 20px auto 0;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: #5b6b7f;
    text-wrap: balance;
  }

  /* ── tiles ────────────────────────────────────────────────────────── */
  .lista {
    padding-bottom: clamp(96px, 11vw, 168px);
  }
  .area {
    padding: clamp(28px, 4vw, 64px);
    border-radius: 32px;
    background: #f2f4f7;
  }
  .area + .area {
    margin-top: clamp(16px, 1.8vw, 24px);
  }
  .area-topo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }
  .area-texto h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(36px, 4.4vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .resumo {
    margin-top: 18px;
    max-width: 30em;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--tinta);
  }
  .publico {
    margin-top: 14px;
    max-width: 34em;
    font-size: 17px;
    line-height: 1.5;
    color: #5b6b7f;
  }
  .publico b {
    font-weight: 600;
    color: var(--tinta);
  }
  .acoes {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 26px;
  }
  .pilula {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--tinta);
    color: #fff;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .pilula:hover {
    background: #2a62ad;
  }
  .ler {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 17px;
    color: #2a62ad;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  .ler:hover {
    text-decoration: underline;
  }
  .pilula:focus-visible,
  .ler:focus-visible {
    outline: 2px solid #2a62ad;
    outline-offset: 3px;
    border-radius: 999px;
  }

  .area-foto {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: 22px;
    overflow: hidden;
  }
  .area-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .area:hover .area-foto img {
    transform: scale(1.03);
  }

  /* Serviços no mesmo painel branco com § da home. */
  .servicos {
    margin-top: clamp(28px, 4vw, 56px);
    padding: clamp(24px, 3vw, 40px);
    border-radius: 22px;
    background: #fff;
  }
  .servicos h3 {
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 600;
    color: var(--tinta);
  }
  .servicos ul {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px clamp(20px, 3vw, 44px);
  }
  .servicos li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    column-gap: 8px;
    align-items: baseline;
    font-size: 16px;
    line-height: 1.4;
    color: var(--tinta);
  }
  .servicos li::before {
    content: '§';
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1;
    color: #2a62ad;
    opacity: 0.6;
  }

  .vao {
    margin-top: clamp(96px, 11vw, 168px);
  }

  @media (max-width: 900px) {
    .area-topo {
      grid-template-columns: 1fr;
    }
    .area-foto {
      order: -1;
    }
    .servicos ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .area {
      padding: 20px 20px 24px;
      border-radius: 26px;
    }
    .servicos ul {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .area-foto img,
    .pilula {
      transition: none;
    }
  }
</style>
