---
/**
 * Áreas de atuação (versão cinematográfica, 26/10/2026).
 *
 * Abertura no padrão de O escritório (pílula, título em caixa alta, marca-
 * d'água que anda), e as áreas em painéis de tela cheia que se empilham:
 * cada um é `sticky` no topo e o seguinte sobe por cima. Dentro, o nome
 * gigante, o resumo, para quem é, o sócio que atende, os assuntos correndo
 * em letreiro e a foto da série própria (docs/PROMPTS-IMAGENS.md).
 *
 * As áreas vêm da coleção: área nova no JSON ganha painel sozinha (a foto
 * cai na padrão até alguém escolher uma em FOTO_DA_AREA).
 */
import Base from '~/layouts/Base.astro';
import Contato from '~/components/Contato.astro';
import Zap from '~/components/Zap.astro';
import { listarAreasConfirmadas, assuntosDaArea, whatsappDaArea } from '~/lib/areas';
import { site } from '~/lib/site';

const areas = await listarAreasConfirmadas();

const FOTO_DA_AREA: Record<string, string> = {
  'planejamento-patrimonial-e-sucessorio': '/media/novas/area-familia',
  'direito-digital': '/media/novas/area-presenca',
};

const paineis = areas.map((area, i) => {
  const d = area.data;
  const socio = site.socios.find((s) => s.area === d.slug);
  return {
    n: String(i + 1).padStart(2, '0'),
    nome: d.nome,
    resumo: d.resumo,
    publico: d.publicoCurto,
    assuntos: assuntosDaArea(d.assuntos).map((a) => a.nome),
    href: `/areas/${d.slug}/`,
    whatsapp: whatsappDaArea(d.mensagemWhatsapp ?? `Olá! Gostaria de conversar sobre ${d.nome.toLowerCase()}.`),
    foto: FOTO_DA_AREA[d.slug] ?? '/media/novas/area-contratos',
    socio: socio ? { nome: socio.nome, oab: socio.oab.valor, retrato: socio.retrato } : undefined,
  };
});

const descricao =
  `Áreas de atuação do escritório em Maringá, PR: ` +
  `${areas.map((area) => area.data.nome).join(' e ')}. ` +
  `O que cada uma abrange e como o atendimento funciona.`;
---

<Base titulo="Áreas de atuação | Bertoncini & Mendonça Advogados" descricao={descricao} paginaAtual="/areas/">
  <div class="areas-pagina">
    <section class="topo">
      <div class="marca-dagua" aria-hidden="true"><span data-desliza>Áreas de atuação /&nbsp;Áreas de atuação /</span></div>
      <div class="env abertura">
        <p class="pilula" data-sobe>Áreas de atuação</p>
        <h1 class="titulo-caixa" data-sobe>Do patrimônio à <em>presença digital.</em></h1>
        <p class="apoio" data-sobe>
          Duas áreas que costumam chegar juntas: quem monta uma holding também tem marca, e quem vive de
          conteúdo precisa de contrato e, cedo ou tarde, de pensar na sucessão.
        </p>
        <a class="rolar" href="#paineis" data-sobe>
          Ver as áreas
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 2v10M3 8l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </section>

    <div class="paineis" id="paineis">
      {paineis.map((p) => (
        <section class="painel" aria-labelledby={`painel-${p.n}`}>
          <span class="grao" style="filter:url(#grao)" aria-hidden="true"></span>
          <div class="env painel-grade">
            <div class="painel-texto">
              <p class="painel-num">{p.n} / {String(paineis.length).padStart(2, '0')}</p>
              <h2 id={`painel-${p.n}`} class="painel-nome">{p.nome}</h2>
              <p class="painel-resumo">{p.resumo}</p>
              <dl class="painel-dados">
                <div>
                  <dt>Para quem</dt>
                  <dd>{p.publico}</dd>
                </div>
                {p.socio && (
                  <div class="quem">
                    <dt>Quem atende</dt>
                    <dd>
                      <img src={`${p.socio.retrato}-560.webp`} alt="" width="40" height="40" loading="lazy" />
                      <span>{p.socio.nome}<small>{p.socio.oab}</small></span>
                    </dd>
                  </div>
                )}
              </dl>
              <div class="painel-acoes">
                <a class="botao claro" href={p.href}>
                  Entrar na área
                  <span class="disco" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="#fff" stroke-width="1.6" stroke-linecap="round" /></svg></span>
                </a>
                <a class="botao zap vidro" href={p.whatsapp} target="_blank" rel="noopener">
                  WhatsApp
                  <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
                </a>
              </div>
            </div>
            <a class="painel-foto" href={p.href} tabindex="-1" aria-hidden="true">
              <picture>
                <source type="image/avif" srcset={`${p.foto}.avif`} />
                <source type="image/webp" srcset={`${p.foto}.webp`} />
                <img src={`${p.foto}.jpg`} alt="" width="900" height="1125" loading="lazy" />
              </picture>
            </a>
          </div>
          <div class="painel-letreiro" aria-label={`Assuntos de ${p.nome}`}>
            <div class="trilho">
              {[0, 1].map((copia) => (
                <ul aria-hidden={copia === 1 ? 'true' : undefined}>
                  {p.assuntos.map((a) => <li>{a}</li>)}
                </ul>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>

    <section class="tambem">
      <div class="env">
        <p class="pilula" data-sobe>Fora das duas áreas</p>
        <p class="titulo-caixa grande" data-acende>
          Também atuamos em direito imobiliário, tributário e cível. Se o seu caso não for para nós,
          dizemos isso na primeira conversa.
        </p>
      </div>
    </section>
  </div>

  <Contato />
</Base>

<script>
  import { ligaCinema } from '~/scripts/cinema';
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) void ligaCinema();
</script>

<style>
  .areas-pagina {
    --destaque: #2a62ad;
    --gelo: #eaf0f6;
    overflow-x: clip;
  }
  .titulo-caixa {
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--tinta);
  }
  .titulo-caixa em {
    font-style: normal;
    color: var(--destaque);
  }
  .pilula {
    display: inline-block;
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--gelo);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinta);
  }

  /* ── abertura ────────────────────────────────────────────────────── */
  .topo {
    position: relative;
    padding-block: clamp(150px, 16vw, 220px) clamp(90px, 12vw, 160px);
    background: linear-gradient(180deg, var(--branco) 0%, var(--branco) 40%, #f1f5fa 100%);
  }
  .marca-dagua {
    position: absolute;
    inset: 30vh 0 auto;
    overflow: hidden;
    pointer-events: none;
  }
  .marca-dagua span {
    display: block;
    white-space: nowrap;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(130px, 22vw, 340px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--gelo);
  }
  .abertura {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 22px;
  }
  .abertura h1 {
    font-size: clamp(42px, 6.4vw, 96px);
    max-width: 13ch;
  }
  .apoio {
    max-width: 54ch;
    font-size: 18px;
    color: var(--secundario);
  }
  .rolar {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--tinta);
    text-decoration: none;
  }
  .rolar svg {
    animation: desce 1.8s ease-in-out infinite;
  }
  @keyframes desce {
    50% {
      transform: translateY(4px);
    }
  }

  /* ── painéis empilhados ──────────────────────────────────────────── */
  .painel {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: grid;
    grid-template-rows: 1fr auto;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background: linear-gradient(125deg, #1f4c88 0%, #163a6d 38%, #0e2a52 72%, var(--tinta) 100%);
    box-shadow: 0 -30px 60px -20px rgba(3, 8, 18, 0.45);
  }
  .painel:nth-child(even) {
    background: linear-gradient(235deg, #1f4c88 0%, #163a6d 38%, #0e2a52 72%, var(--tinta) 100%);
  }
  .grao {
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: inset(0);
    background: #8aa0bc;
    mix-blend-mode: overlay;
    opacity: 0.4;
    pointer-events: none;
  }
  .painel-grade {
    width: 100%;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 5vw, 96px);
    align-items: center;
    padding-block: clamp(110px, 14vh, 150px) clamp(32px, 5vh, 56px);
  }
  .painel:nth-child(even) .painel-texto {
    order: 2;
  }
  .painel-num {
    font-size: 14px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.6);
  }
  .painel-nome {
    margin-top: 14px;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(40px, 5.4vw, 84px);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .painel-resumo {
    margin-top: 22px;
    max-width: 40ch;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(21px, 2vw, 28px);
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.9);
  }
  .painel-dados {
    margin: 30px 0;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    max-width: 640px;
  }
  .painel-dados div {
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  .painel-dados dt {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }
  .painel-dados dd {
    margin: 8px 0 0;
    font-size: 16px;
    line-height: 1.45;
  }
  .quem dd {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .quem img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 20%;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.4);
  }
  .quem small {
    display: block;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.65);
  }
  .painel-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .botao.claro {
    background: #fff;
    color: var(--tinta);
  }
  .botao.claro:hover {
    background: var(--papel);
  }
  .painel-foto {
    display: block;
    aspect-ratio: 4 / 5;
    max-height: 70vh;
    justify-self: center;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6);
  }
  .painel-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .painel-foto:hover img {
    transform: scale(1.05);
  }
  .painel-letreiro {
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-block: 18px;
  }
  .painel-letreiro .trilho {
    display: flex;
    width: max-content;
    animation: corre 60s linear infinite;
  }
  .painel:nth-child(even) .trilho {
    animation-direction: reverse;
  }
  .painel-letreiro ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  .painel-letreiro li {
    padding-inline: 26px;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(18px, 1.8vw, 26px);
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.3);
  }
  .painel-letreiro li::after {
    content: '/';
    margin-left: 52px;
    color: rgba(255, 255, 255, 0.3);
  }
  @keyframes corre {
    to {
      transform: translateX(-50%);
    }
  }

  /* ── também ──────────────────────────────────────────────────────── */
  .tambem {
    position: relative;
    z-index: 1;
    padding-block: clamp(90px, 12vw, 170px);
    background: var(--branco);
  }
  .grande {
    margin-top: 26px;
    font-size: clamp(28px, 3.8vw, 56px);
    line-height: 1.05;
    max-width: 24ch;
  }

  @media (max-width: 900px) {
    .painel {
      position: relative;
      min-height: 0;
    }
    .painel-grade {
      grid-template-columns: 1fr;
      padding-block: 80px 36px;
    }
    .painel:nth-child(even) .painel-texto {
      order: 0;
    }
    .painel-foto {
      order: -1;
      width: 100%;
      aspect-ratio: 16 / 11;
    }
    .painel-dados {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .painel-letreiro .trilho,
    .rolar svg {
      animation: none;
    }
    .painel-letreiro {
      overflow-x: auto;
    }
  }
</style>
