---
/**
 * Método (redesenho de 21/10/2026, a partir do "Our Process" de
 * marketinglab.framer.ai).
 *
 * Quatro cartões que chegam um depois do outro enquanto a página rola e
 * param alinhados numa fileira. É só CSS: cada cartão mora numa coluna da
 * altura do palco, é `sticky` no mesmo `top`, e começa com um recuo
 * vertical que cresce a cada passo (`--i`). O primeiro gruda logo; o
 * último só depois de rolar três recuos. Sem GSAP, sem pin, sem medir nada.
 *
 * O fundo de cada cartão é uma foto da série própria (`docs/PROMPTS-IMAGENS.md`,
 * seção 2), sem cor por cima. A vinheta escura do pé existe por função: o
 * texto branco precisa de contraste sobre qualquer foto.
 *
 * Abaixo de 900px os cartões viram uma coluna comum, sem sticky: numa tela
 * estreita não cabem quatro lado a lado, e a chegada escalonada perde o
 * sentido.
 */
/** A foto de cada passo, na ordem (`public/media/novas/passo-*.jpg`). */
const FOTOS = ['escreve', 'conversa', 'opcoes', 'caso-anda'];

interface Passo {
  /** Número exibido (string, para preservar o zero à esquerda). */
  n: string;
  /** Nome curto do passo, o título do cartão. */
  nome: string;
  /** Descrição do passo. */
  texto: string;
}

interface Props {
  titulo?: string;
  apoio?: string;
  passos?: Passo[];
}

const {
  titulo = 'Como trabalhamos',
  apoio = 'Do primeiro contato até o caso andar, o caminho é o mesmo para todo mundo.',
  /* Um verbo por passo, no imperativo e dirigido a quem lê: é o que a
     pessoa faz em cada etapa. As descrições têm o mesmo tamanho (~85
     caracteres, três linhas no cartão) para os títulos alinharem. */
  passos = [
    {
      n: '01',
      nome: 'Conte',
      texto: 'Pelo site, WhatsApp ou e-mail. Poucas linhas bastam, e quem lê é um dos sócios.',
    },
    {
      n: '02',
      nome: 'Converse',
      texto: 'Por vídeo ou em Maringá. Ouvimos a história inteira antes de dar qualquer opinião.',
    },
    {
      n: '03',
      nome: 'Decida',
      texto: 'Opções, prazos e custo em português claro. Se não valer a pena processar, dizemos.',
    },
    {
      n: '04',
      nome: 'Acompanhe',
      texto: 'Cada movimentação do caso chega até você, mesmo quando a notícia é que nada mudou.',
    },
  ],
}: Props = Astro.props;
---

<section class="metodo" id="metodo" aria-labelledby="metodo-titulo">
  <div class="env palco">
    {/* O título corre num trilho que termina uma altura de cartão antes do
        palco: assim ele se solta e sobe ANTES de os cartões o alcançarem.
        Sticky direto no palco, os dois se soltavam juntos e o título
        descia por cima da fileira. */}
    <div class="trilho-cab">
      <header class="cab">
        <h2 id="metodo-titulo">{titulo}</h2>
        <p>{apoio}</p>
      </header>
    </div>
    <ol class="cartoes">
      {passos.map((passo, i) => (
        <li style={`--i:${i}`}>
          <article class="cartao">
            <picture aria-hidden="true">
              <source type="image/avif" srcset={`/media/novas/passo-${FOTOS[i]}.avif`} />
              <source type="image/webp" srcset={`/media/novas/passo-${FOTOS[i]}.webp`} />
              <img src={`/media/novas/passo-${FOTOS[i]}.jpg`} alt="" width="720" height="1200" loading="lazy" decoding="async" />
            </picture>
            <span class="n" aria-hidden="true">{passo.n}</span>
            <div class="txt">
              <h3>{passo.nome}</h3>
              <p>{passo.texto}</p>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .metodo {
    --topo-cab: 104px;
    --alt-cab: 170px;
    --topo-card: calc(var(--topo-cab) + var(--alt-cab) + 12px);
    --alt-card: clamp(380px, 54vh, 470px);
    --recuo: 30vh;
    background: #071531;
    color: #fff;
    padding-block: clamp(80px, 9vw, 130px);
  }

  .palco {
    position: relative;
  }
  .trilho-cab {
    position: absolute;
    inset: 0 var(--gutter) calc(var(--alt-card) + 12px);
    pointer-events: none;
  }
  .cab {
    position: sticky;
    top: var(--topo-cab);
    z-index: 1;
    pointer-events: auto;
    min-height: var(--alt-cab);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
  }
  .cab h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(40px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 7ch;
  }
  .cab p {
    max-width: 36ch;
    padding-top: 10px;
    text-align: right;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.62);
  }

  /* O palco: três recuos para todos chegarem, mais um respiro com a fileira
     completa parada antes de a seção ir embora. */
  .cartoes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 20px);
    padding-top: calc(var(--alt-cab) + 12px);
    height: calc(var(--alt-cab) + 12px + var(--recuo) * 3 + var(--alt-card) + 28vh);
  }
  .cartoes li {
    padding-top: calc(var(--i) * var(--recuo));
  }
  .cartao {
    position: sticky;
    top: var(--topo-card);
    height: var(--alt-card);
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    background: #0d1f3d;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(20px, 2vw, 28px);
  }
  .cartao img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cartao:hover img {
    transform: scale(1.05);
  }
  .cartao::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.28) 0%, transparent 30%, transparent 45%, rgba(0, 0, 0, 0.78) 100%);
  }
  .n {
    align-self: flex-end;
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(64px, 7vw, 108px);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .txt h3 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(21px, 1.8vw, 26px);
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  /* Três linhas reservadas: se uma descrição quebrar em menos, o título
     dela não desce em relação aos vizinhos. */
  .txt p {
    min-height: calc(1.45em * 3);
    font-size: 16px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 900px) {
    .trilho-cab {
      position: static;
    }
    .cab {
      position: static;
      min-height: 0;
      flex-direction: column;
      margin-bottom: 32px;
    }
    .cab p {
      text-align: left;
    }
    .cartoes {
      grid-template-columns: 1fr;
      height: auto;
      padding-top: 0;
    }
    .cartoes li {
      padding-top: 0;
    }
    .cartao {
      position: relative;
      top: auto;
      height: 340px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trilho-cab {
      position: static;
    }
    .cartoes {
      height: auto;
      padding-top: 0;
    }
    .cartoes li {
      padding-top: 0;
    }
    .cartao,
    .cab {
      position: relative;
      top: auto;
    }
  }
</style>
