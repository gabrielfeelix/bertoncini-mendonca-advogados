---
/**
 * Método: coluna fixa (sticky por CSS, sem pin de GSAP) à esquerda e os
 * passos numerados à direita, com uma lista do que vale em todos os casos
 * embaixo. Migrado do protótipo (CSS linhas 267-297, HTML linhas 641-676).
 *
 * Marcações para a Tarefa 5: o id `#metodo`, `.sobe` em cada passo, o
 * `.traco i` que a barra vermelha preenche e as classes `.viva`/`.foco`
 * que o JS adiciona. Sem JS o passo em foco não existe e todos ficam em
 * `--tinta`, que é a cor de maior contraste: a degradação escurece o
 * texto, nunca o apaga.
 */
interface Passo {
  /** Número exibido (string, para preservar o zero à esquerda). */
  n: string;
  /** Título do passo. */
  titulo: string;
  /** Descrição do passo. */
  texto: string;
}

interface Vale {
  /** Trecho em negrito, primeira linha do item. */
  forte: string;
  /** Restante do item. */
  texto: string;
  /** true quando o item ainda depende de confirmação dos sócios. */
  placeholder?: boolean;
  /** Ressalva em vermelho, visível enquanto o dado for placeholder. */
  ressalva?: string;
}

interface Props {
  /** Título da seção. */
  titulo?: string;
  /** Frase de apoio abaixo do título. */
  apoio?: string;
  /** Passos, na ordem. */
  passos?: Passo[];
  /** Rótulo acessível da lista final. */
  valemRotulo?: string;
  /** Itens que valem em todos os casos. */
  valem?: Vale[];
}

const {
  titulo = 'Como trabalhamos',
  apoio = 'Do primeiro contato até o caso andar, o caminho é o mesmo para todo mundo.',
  passos = [
    {
      n: '01',
      titulo: 'Você escreve o que aconteceu',
      texto: 'Pelo WhatsApp ou pelo formulário, do seu jeito. Não existe questionário longo nem triagem automática.',
    },
    {
      n: '02',
      titulo: 'Marcamos uma conversa',
      texto: 'Por vídeo, ou presencial em Maringá se você preferir. Nela ouvimos a história inteira antes de opinar.',
    },
    {
      n: '03',
      titulo: 'Você recebe as opções, os prazos e o custo',
      texto: 'Em português claro, antes de qualquer compromisso. Se não valer a pena entrar com o processo, dizemos isso também.',
    },
    {
      n: '04',
      titulo: 'O caso anda, e você acompanha',
      texto: 'Cada movimentação chega para você, inclusive quando a notícia é que nada mudou.',
    },
  ],
  valemRotulo = 'O que vale em todos os casos',
  valem = [
    {
      forte: 'Quem atende é quem assina.',
      texto: ' Não há atendente nem estagiário entre você e o sócio.',
    },
    {
      forte: 'O custo vem antes do compromisso.',
      texto: ' Nenhuma cobrança que você não tenha visto por escrito.',
    },
    {
      forte: 'Resposta em até um dia útil.',
      texto: '',
      placeholder: true,
      ressalva: 'Prazo a confirmar com os sócios antes de publicar.',
    },
  ],
}: Props = Astro.props;
---

<section class="secao metodo" id="metodo">
  <div class="env">
    <div class="fixa">
      <h2 class="display sobe">{titulo}</h2>
      <p class="sobe">{apoio}</p>
      <div class="traco" aria-hidden="true"><i></i></div>
    </div>
    <ol class="passos">
      {passos.map((passo) => (
        <li class="passo sobe">
          <span class="n">{passo.n}</span>
          <h3>{passo.titulo}</h3>
          <p>{passo.texto}</p>
        </li>
      ))}
    </ol>
    <ul class="valem sobe" aria-label={valemRotulo}>
      {valem.map((item) => (
        <li data-placeholder={item.placeholder ? '1' : undefined}>
          <b>{item.forte}</b>{item.texto}
          {item.ressalva && <span style="color:var(--imperial)">{item.ressalva}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* método: coluna fixa à esquerda, passos à direita. Sem JS o passo em
     foco não existe, todos ficam em --tinta. */
  .metodo :global(.env) {
    display: grid;
    /* 4fr/8fr, não 5fr/7fr: a coluna da esquerda carrega só um título
       curto e uma frase, e com 5fr sobrava um vazio grande embaixo dela
       — o cliente leu a seção como "espalhada". */
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
  }
  .metodo .fixa {
    position: sticky;
    top: calc(var(--bloco) * 0.55);
  }
  .metodo .fixa p {
    margin-top: 18px;
    max-width: 34ch;
    color: var(--secundario);
  }
  /* O traço vertical decorativo saiu: com a coluna da esquerda mais
     estreita e os passos em cartão, ele só marcava o vazio que sobrava. */
  .metodo .traco {
    display: none;
  }
  .metodo .traco i {
    position: absolute;
    inset: 0;
    background: var(--imperial);
    transform: scaleY(0);
    transform-origin: top;
  }
  .passos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(10px, 1vw, 14px);
  }
  /* Cada passo é um bloco em papel, não uma linha separada por filete.
     É a mesma decisão do mosaico das áreas: dar forma ao conteúdo em vez
     de empilhar texto separado por traço. O papel é a terceira superfície
     do site (--papel), usada aqui como material de componente. */
  .passo {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(16px, 2.2vw, 30px);
    align-items: start;
    padding: clamp(22px, 2.4vw, 32px) clamp(22px, 2.6vw, 36px);
    background: var(--papel);
    border-radius: clamp(12px, 1.4vw, 18px);
    color: var(--tinta);
    transition: color 0.5s, background-color 0.4s;
  }
  .passo .n {
    /* O número ocupa as DUAS linhas do grid. Sem isto ele forçava a altura
       da primeira linha (72px de serifada) e abria um vão entre o título e
       o parágrafo, que a olho lia como texto espalhado. */
    grid-row: 1 / span 2;
    align-self: start;
    font-family: var(--serif);
    font-weight: 200;
    font-size: clamp(36px, 4vw, 56px);
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: var(--imperial);
    opacity: 0.9;
  }
  .passo h3 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(24px, 2.4vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .passo p {
    margin-top: 8px;
    max-width: 52ch;
    color: var(--secundario);
  }
  .passo h3,
  .passo p {
    grid-column: 2;
  }
  /* O título centra na sua linha, para encostar no parágrafo em vez de
     ficar suspenso acima dele. */
  .passo h3 {
    align-self: center;
  }
  /* O passo em foco se marca pelo FUNDO, não apagando o texto dos outros.
     Apagar levava `--secundario` sobre `--papel` a 4.54:1 — passa em AA,
     mas raspa, e o público tem 70 anos. Assim todo o texto fica sempre no
     contraste cheio e o destaque continua existindo. */
  :global(.js) .metodo:global(.viva) .passo.foco {
    background: #fff;
    box-shadow: 0 1px 0 rgba(11, 30, 63, 0.1), 0 14px 40px rgba(11, 30, 63, 0.08);
  }
  :global(.js) .metodo:global(.viva) .passo:global(.foco) {
    color: var(--tinta);
  }
  .valem {
    grid-column: 1 / -1;
    list-style: none;
    margin: clamp(40px, 5vw, 68px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(10px, 1vw, 14px);
    font-size: 17px;
    line-height: 1.5;
  }
  .valem li {
    padding: clamp(20px, 2.2vw, 28px);
    border: 1px solid var(--linha);
    border-radius: clamp(12px, 1.4vw, 18px);
  }
  .valem b {
    display: block;
    font-weight: 600;
    color: var(--tinta);
    margin-bottom: 6px;
  }
  .valem li {
    color: var(--secundario);
  }
  @media (max-width: 900px) {
    .metodo :global(.env) {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .metodo .fixa {
      position: static;
    }
    .metodo .traco {
      display: none;
    }
    .valem {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }

  /* prefers-reduced-motion desliga todo movimento desta seção. A Tarefa 5
     traz o kill-switch global do protótipo; este bloco garante que o
     componente já cumpra a regra sozinho, em qualquer página. */
  @media (prefers-reduced-motion: reduce) {
    .metodo,
    .metodo * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
