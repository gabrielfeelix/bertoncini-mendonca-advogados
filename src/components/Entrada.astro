---
/**
 * Cortina de entrada (a mesma da v1): chapa azul-noite em tela cheia com o
 * monograma e um grão leve, que sobe e sai logo depois da primeira pintura.
 *
 * Diferente da v1, a saída é toda em CSS (animation), sem depender de um
 * script que a tire: se o JavaScript falhar no meio do caminho, a cortina
 * sai sozinha do mesmo jeito e nunca esconde o site.
 *
 * Só aparece com JavaScript (`.com-js`, posto no <head> do Base), só na
 * primeira página da sessão (`.entrada-vista`, também posta no <head>, pelo
 * sessionStorage) e nunca com `prefers-reduced-motion`.
 *
 * `aria-hidden`: é decoração, leitor de tela nenhum precisa anunciá-la.
 */
import monogramaBruto from '../../public/media/marca/monograma-creme.svg?raw';

/* O SVG entra inline para já estar pronto na primeira pintura (como <img>
   ele podia chegar depois da cortina). Os ids ganham prefixo para não
   colidir com outro SVG inline da página. */
const monograma = monogramaBruto
  .replace(/<\?xml[^>]*\?>\s*/, '')
  .replace(/id="([^"]+)"/g, 'id="ent-$1"')
  .replace(/#(glyph|clip|source)/g, '#ent-$1');
---

<div class="entrada" aria-hidden="true">
  <svg class="entrada-filtro" width="0" height="0" focusable="false">
    <filter id="ent-grao" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
  </svg>
  <div class="entrada-grao"></div>
  <div class="entrada-mono" set:html={monograma} />
</div>
<script is:inline>
  /* Terminada a subida, a cortina sai da página. O CSS já a deixa fora da
     tela e invisível; isto garante que nenhum navegador a pinte depois. */
  (function () {
    var e = document.querySelector('.entrada');
    if (e) e.addEventListener('animationend', function (ev) { if (ev.target === e) e.remove(); });
  })();
</script>

<style>
  .entrada { display: none; }

  /* Tempos da v1: o monograma aparece em 0,6s, começa a sumir aos 0,65s e
     a chapa sobe entre 0,8s e 1,5s. */
  :global(.com-js:not(.entrada-vista)) .entrada {
    display: grid;
    place-items: center;
    position: fixed;
    inset: 0;
    z-index: 1000;
    overflow: hidden; /* o filtro do grão desenha além da borda: sem isto,
                         uma faixa clara ficava no topo depois da subida */
    background: var(--azul);
    animation: entrada-sobe 0.7s cubic-bezier(0.76, 0, 0.24, 1) 0.8s forwards;
  }
  .entrada-filtro { position: absolute; width: 0; height: 0; }
  .entrada-grao {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    mix-blend-mode: overlay;
    background: #8aa0bc;
    filter: url(#ent-grao);
  }
  .entrada-mono {
    position: relative;
    opacity: 0;
    animation:
      entrada-mono-vem 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.05s both,
      entrada-mono-vai 0.5s ease 0.65s forwards;
  }
  .entrada-mono :global(svg) { display: block; height: 64px; width: auto; }

  @keyframes entrada-sobe {
    to { transform: translateY(-101%); visibility: hidden; }
  }
  @keyframes entrada-mono-vem {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 0.92; transform: none; }
  }
  @keyframes entrada-mono-vai {
    from { opacity: 0.92; }
    to { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.com-js:not(.entrada-vista)) .entrada { display: none; }
  }
  @media print {
    :global(.com-js:not(.entrada-vista)) .entrada { display: none; }
  }
</style>
