---
/**
 * Perguntas frequentes: título à esquerda, acordeão à direita. Migrado do
 * protótipo (CSS linhas 369-384, HTML linhas 738-766).
 *
 * O acordeão usa `<details>`/`<summary>` nativos: abre e fecha sem uma
 * linha de JavaScript, e o conteúdo de cada resposta está no HTML desde o
 * primeiro paint (leitores de tela e a busca do navegador encontram tudo).
 * A Tarefa 5 não precisa tocar nesta seção.
 */
interface Pergunta {
  /** Texto do `<summary>`. */
  pergunta: string;
  /** Texto da resposta. */
  resposta: string;
}

interface Grupo {
  /** Nome da aba. */
  nome: string;
  perguntas: Pergunta[];
}

interface Props {
  /** Título da seção. */
  titulo?: string;
  /** Perguntas, na ordem. */
  perguntas?: Pergunta[];
  /**
   * Perguntas separadas por assunto (home, 06/11/2026). Com grupos, a
   * coluna do título ganha uma aba por grupo e só o grupo escolhido
   * aparece. Sem JavaScript as abas somem e os grupos ficam empilhados,
   * cada um com o próprio título: nada fica inacessível.
   */
  grupos?: Grupo[];
}

const {
  titulo = 'As perguntas que mais recebemos',
  perguntas = [
    {
      pergunta: 'Quanto custa uma consulta?',
      resposta: 'Depende do caso. Na primeira conversa entendemos a situação e informamos o valor antes de você assumir qualquer compromisso.',
    },
    {
      pergunta: 'Como funciona do primeiro contato até o processo andar?',
      resposta: 'Você envia uma mensagem contando o que aconteceu. Respondemos marcando uma conversa por vídeo. Nela você recebe as opções, os prazos e o custo. Se decidir seguir, assumimos o caso e informamos cada movimentação, inclusive quando a notícia é que nada mudou.',
    },
    {
      pergunta: 'Preciso ir até o escritório?',
      resposta: 'Não. O atendimento é online, por mensagem e por chamada de vídeo, e isso cobre todas as etapas do caso. Quando um encontro presencial for necessário, combinamos o lugar em Maringá.',
    },
    {
      pergunta: 'Quanto tempo demora um processo?',
      resposta: 'Varia com a vara e com a complexidade. Você recebe uma estimativa realista, com a ressalva de que prazo de tribunal não depende de advogado.',
    },
    {
      pergunta: 'Vocês atendem fora de Maringá?',
      resposta: 'Sim. O processo tramita online na maior parte do tempo, então atendemos clientes de outras cidades do Paraná.',
    },
  ],
  grupos,
}: Props = Astro.props;

/* Ids estáveis e únicos na página: `pergunta-N` continua valendo para a
   lista simples (links antigos), e cada grupo tem o próprio prefixo. */
const listas = grupos?.length
  ? grupos.map((g, i) => ({ nome: g.nome, perguntas: g.perguntas, prefixo: `pergunta-${i + 1}-` }))
  : [{ nome: '', perguntas, prefixo: 'pergunta-' }];
const comAbas = listas.length > 1;
---

<section class="secao perguntas" id="perguntas" data-perguntas>
  <div class="env">
    <div class="cabeca">
      <h2 class="display sobe">{titulo}</h2>
      {comAbas && (
        <div class="abas sobe" role="tablist" aria-label="Assunto das perguntas" hidden>
          {listas.map((l, i) => (
            <button
              type="button"
              role="tab"
              class="aba"
              id={`aba-${l.prefixo}`}
              aria-controls={`painel-${l.prefixo}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? undefined : -1}
            >
              {l.nome}
            </button>
          ))}
        </div>
      )}
    </div>
    <div class="paineis sobe">
      {listas.map((l) => (
        <div
          class="lista"
          id={`painel-${l.prefixo}`}
          role={comAbas ? 'tabpanel' : undefined}
          aria-labelledby={comAbas ? `aba-${l.prefixo}` : undefined}
        >
          {comAbas && <h3 class="titulo-grupo">{l.nome}</h3>}
          {l.perguntas.map((item, n) => (
            <details class="q" id={`${l.prefixo}${n + 1}`}>
              <summary>{item.pergunta}<span class="cruz"></span></summary>
              <p class="resposta">{item.resposta}</p>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  /* Quem chega por um link `#pergunta-N` (a seção "O que as pessoas nos
     perguntam", na home) encontra a resposta já aberta. Sem este script o
     link ainda rola até a pergunta; só não a abre. */
  const abre = () => {
    const alvo = location.hash ? document.getElementById(location.hash.slice(1)) : null;
    if (alvo instanceof HTMLDetailsElement) {
      alvo.open = true;
      alvo.scrollIntoView({ block: 'center' });
    }
  };
  abre();
  window.addEventListener('hashchange', abre);

  /* Abas dos grupos. Só existem com JS: sem ele os grupos ficam empilhados.
     Trocar de aba não muda a rolagem: o painel novo entra no lugar do
     antigo com um fade curto, o único efeito da seção além da abertura
     das respostas. Setas do teclado andam entre as abas (padrão ARIA). */
  document.querySelectorAll<HTMLElement>('[data-perguntas]').forEach((secao) => {
    const abas = [...secao.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    if (abas.length < 2) return;
    const paineis = abas.map((a) => document.getElementById(a.getAttribute('aria-controls')!)!);
    secao.classList.add('com-abas');
    secao.querySelector('.abas')?.removeAttribute('hidden');

    const escolhe = (i: number, foco = false) => {
      abas.forEach((a, k) => {
        const sim = k === i;
        a.setAttribute('aria-selected', String(sim));
        if (sim) a.removeAttribute('tabindex');
        else a.setAttribute('tabindex', '-1');
        paineis[k].hidden = !sim;
      });
      if (foco) abas[i].focus();
    };
    /* Quem chega por link para uma pergunta de outro grupo cai na aba dela. */
    const alvo = location.hash ? document.getElementById(location.hash.slice(1)) : null;
    const inicial = Math.max(0, paineis.findIndex((p) => alvo && p.contains(alvo)));
    escolhe(inicial);

    abas.forEach((a, i) => {
      a.addEventListener('click', () => escolhe(i));
      a.addEventListener('keydown', (e) => {
        const passo = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!passo) return;
        e.preventDefault();
        escolhe((i + passo + abas.length) % abas.length, true);
      });
    });
  });
</script>

<style>
  .perguntas :global(.env) {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(28px, 5vw, 90px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .perguntas :global(.env) {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
  .cabeca {
    display: grid;
    gap: clamp(24px, 3vw, 40px);
  }
  @media (min-width: 901px) {
    .cabeca {
      position: sticky;
      top: 120px;
    }
  }
  .perguntas h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(32px, 4.2vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 12ch;
  }
  /* Abas: texto simples com um traço à esquerda na escolhida. Sóbrias de
     propósito (retorno de 06/11: menos efeito nesta seção). */
  .abas {
    display: grid;
    justify-items: start;
    gap: 2px;
    border-left: 1px solid var(--linha);
  }
  .aba {
    all: unset;
    box-sizing: border-box;
    position: relative;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 6px 0 6px 18px;
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--secundario);
    cursor: pointer;
    transition: color 0.3s;
  }
  .aba::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: var(--tinta);
    transform: scaleY(0);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .aba:hover {
    color: var(--tinta);
  }
  .aba[aria-selected='true'] {
    color: var(--tinta);
  }
  .aba[aria-selected='true']::before {
    transform: scaleY(1);
  }
  .aba:focus-visible {
    outline: 2px solid var(--tinta);
    outline-offset: 2px;
    border-radius: 6px;
  }
  @media (max-width: 900px) {
    /* No celular as abas viram uma linha que rola de lado, colada ao
       título, para não empurrar as perguntas para baixo. */
    .abas {
      grid-auto-flow: column;
      justify-content: start;
      gap: 8px;
      border-left: 0;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    .aba {
      padding: 8px 16px;
      border-radius: 999px;
      white-space: nowrap;
      font-size: 15px;
      box-shadow: inset 0 0 0 1px var(--linha);
    }
    .aba::before {
      display: none;
    }
    .aba[aria-selected='true'] {
      background: var(--tinta);
      color: #fff;
      box-shadow: none;
    }
  }

  .paineis {
    display: grid;
  }
  .titulo-grupo {
    margin: 0 0 6px;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--secundario);
  }
  .paineis .lista + .lista {
    margin-top: 40px;
  }
  .lista[hidden] {
    display: none;
  }
  .com-abas .titulo-grupo {
    display: none;
  }
  .com-abas .paineis .lista + .lista {
    margin-top: 0;
  }
  .com-abas .lista:not([hidden]) {
    animation: entra 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Pílulas (redesenho de 21/10/2026, a partir do FAQ de
     marketinglab.framer.ai): cada pergunta numa faixa arredondada; a aberta
     fica preenchida em --tinta, com o disco claro. */
  .lista {
    display: grid;
    gap: 10px;
    interpolate-size: allow-keywords;
  }
  .q {
    scroll-margin-top: 120px;
    border-radius: 16px;
    background: var(--papel);
    box-shadow: inset 0 0 0 1px var(--linha);
    transition: background-color 0.35s, color 0.35s;
  }
  .q[open] {
    background: var(--tinta);
    color: #fff;
    box-shadow: none;
  }
  .q summary {
    cursor: pointer;
    list-style: none;
    padding: 18px 18px 18px 24px;
    display: flex;
    gap: 22px;
    justify-content: space-between;
    align-items: center;
    font-family: var(--sans);
    font-size: clamp(17px, 1.6vw, 19px);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .q summary::-webkit-details-marker {
    display: none;
  }
  .q summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
    border-radius: 16px;
  }
  .q .cruz {
    width: 34px;
    height: 34px;
    flex: none;
    position: relative;
    border-radius: 50%;
    background: var(--tinta);
    transition: background-color 0.35s, transform 0.35s;
  }
  .q summary:hover .cruz {
    transform: rotate(90deg);
  }
  .q[open] .cruz {
    background: #fff;
  }
  .q .cruz::before,
  .q .cruz::after {
    content: '';
    position: absolute;
    left: 11px;
    right: 11px;
    top: 16px;
    height: 2px;
    border-radius: 2px;
    background: #fff;
    transition: transform 0.3s, background-color 0.35s;
  }
  .q .cruz::after {
    transform: rotate(90deg);
  }
  .q[open] .cruz::before,
  .q[open] .cruz::after {
    background: var(--tinta);
  }
  .q[open] .cruz::after {
    transform: rotate(0deg);
  }
  /* Abre animando a altura onde o navegador sabe (::details-content); nos
     outros, abre seco, que é o comportamento nativo. */
  .q::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 0.45s cubic-bezier(0.65, 0, 0.35, 1), content-visibility 0.45s allow-discrete;
  }
  .q[open]::details-content {
    block-size: auto;
  }
  .q .resposta {
    padding: 0 24px 22px;
    color: rgba(255, 255, 255, 0.82);
    max-width: 62ch;
    font-size: 16.5px;
  }

  /* prefers-reduced-motion desliga todo movimento desta seção. A Tarefa 5
     traz o kill-switch global do protótipo; este bloco garante que o
     componente já cumpra a regra sozinho, em qualquer página. */
  @media (prefers-reduced-motion: reduce) {
    .perguntas,
    .perguntas * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
