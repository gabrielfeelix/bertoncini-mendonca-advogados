---
import { t, rota, type Idioma } from '../lib/i18n';
/**
 * Banner do topo das páginas internas: foto escurecida, título centrado e
 * migalhas de pão. Padrão de "page title" de tema WordPress.
 * `titulo` é texto puro (pode vir do banco, no caso do blog). Os títulos
 * fixos com peso misto ("Áreas de <strong>atuação</strong>") usam `html`.
 */
interface Props {
  titulo?: string;
  html?: string;
  foto?: string;
  migalhas?: { rotulo: string; href?: string }[];
  lang?: Idioma;
  /** Capa alta, como a da home, com o título à esquerda (ex.: O escritório). */
  alto?: boolean;
  /**
   * Capa alta com a foto inteira, começando no topo da página por baixo do
   * cabeçalho, e o escurecimento da capa da home (ex.: Central de
   * Conteúdos). Diferente de `alto`, a foto não é recortada abaixo do menu:
   * cabeçalho e capa leem como uma peça só.
   */
  cheio?: boolean;
  /** Enquadramento da foto (CSS background-position). */
  posicao?: string;
  /** Linha de apoio sob o título, só na capa alta. */
  apoio?: string;
  /** Enquadramento da foto da capa alta no celular, onde ela ocupa a
      largura toda e o corte central pode tirar rostos de quadro. */
  posicaoCelular?: string;
}
const {
  titulo,
  html,
  foto = '/media/novas/escritorio-historia.jpg',
  migalhas = [],
  lang = 'pt',
  alto = false,
  cheio = false,
  posicao = 'center',
  apoio,
  posicaoCelular,
} = Astro.props;
const tx = t(lang);
---

<section
  class:list={['banner-pagina', { 'banner-alto': alto, 'banner-cheio': cheio }]}
  style={alto ? undefined : `background-image:url('${foto}');background-position:${posicao}`}
>
  {/* Na capa alta a foto é uma imagem à direita que começa ABAIXO do
      cabeçalho, para rosto nenhum ficar atrás do menu, e se funde no azul
      pela esquerda (mask-image). */}
  {alto && <img class="banner-foto" src={foto} alt="" style={`--posicao:${posicao};--posicao-celular:${posicaoCelular ?? posicao}`} />}
  <div class="container">
    {html ? <h1 set:html={html} /> : <h1>{titulo}</h1>}
    {(alto || cheio) && apoio && <p class="banner-apoio">{apoio}</p>}
    {/* Conteúdo extra da capa alta (ex.: a busca da Central de Conteúdos). */}
    <slot />
    {migalhas.length > 0 && (
      <nav aria-label={tx.migalhas.aria}>
        <p class="migalhas">
          <a href={rota(lang, '/')}>{tx.migalhas.inicio}</a>
          {migalhas.map((m) => (
            <>
              {' / '}
              {m.href ? <a href={m.href}>{m.rotulo}</a> : <span aria-current="page">{m.rotulo}</span>}
            </>
          ))}
        </p>
      </nav>
    )}
  </div>
</section>
