---
/**
 * Os campos de um texto. Veio do CMS de origem (linhas "rótulo | campo",
 * endereço com prévia da URL, data, tempo de leitura com "calcular sozinho",
 * capa com prévia, contador da descrição) e ganhou o que este site já tinha:
 * formato, autores marcados entre os sócios, título para busca, crédito da
 * capa, rascunho/publicar e apagar.
 *
 * Tudo vem preenchido do servidor e o formulário funciona sem JavaScript:
 * o corpo é um <textarea> de markdown, que o editor rico (painel-editor.ts)
 * substitui quando carrega. Com JavaScript entram o Tiptap, a prévia da
 * capa, os contadores e o envio sem recarregar.
 */
import { FORMATOS, ROTA_CONTEUDOS, autoresDoArtigo } from '~/lib/artigos';
import { categoriaCanonica } from '~/lib/painel-artigo';
import { minutosDeLeitura } from '~/lib/markdown-editor';
import { site } from '~/lib/site';

export interface ArtigoDoPainel {
  slug: string;
  titulo: string;
  resumo: string;
  corpo: string;
  categoria: string;
  autor: string;
  formato: string | null;
  estado: string;
  publicado_em: string;
  tempo_leitura: number | null;
  capa: string | null;
  capa_alt: string | null;
  capa_largura: number | null;
  capa_altura: number | null;
  capa_credito?: string | null;
  seo_titulo: string | null;
  seo_descricao: string | null;
}

interface Props {
  artigo: ArtigoDoPainel | null;
  categorias: string[];
}

const { artigo, categorias } = Astro.props;
const a = artigo;
const publicado = a?.estado === 'publicado';

const assinantes = autoresDoArtigo(a?.autor ?? '').map((s) => s.nome);
const categoriaAtual = (a && categoriaCanonica(a.categoria, categorias)) ?? categorias[0];

/* Hoje no fuso do escritório, no formato do <input type="date">. */
const hoje = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
const data = a ? a.publicado_em.slice(0, 10) : hoje;

/* "Calcular sozinho" vem marcado, a não ser que o número gravado seja
   diferente do calculado — sinal de que alguém o corrigiu à mão. */
const calculado = a ? minutosDeLeitura(a.corpo) : 1;
const tempoNaMao = Boolean(a?.tempo_leitura && a.tempo_leitura !== calculado);

const urlBase = new URL(ROTA_CONTEUDOS, site.url).toString();
---

<form class="pnl-form" id="form-artigo" method="post" action="/api/painel/salvar" enctype="multipart/form-data" data-novo={a ? undefined : ''}>
  <input type="hidden" name="slug_original" value={a?.slug ?? ''} />
  {/* O script troca para "html" quando o editor rico está ligado. */}
  <input type="hidden" name="corpo_tipo" value="markdown" id="corpo-tipo" />

  <fieldset class="pnl-grupo">
    <legend>Texto</legend>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-titulo">Título</label>
      <div>
        <input class="pnl-campo" id="c-titulo" name="titulo" maxlength="120" required value={a?.titulo ?? ''} />
        <p class="pnl-dica"><span class="pnl-conta" data-conta="c-titulo" data-max="120">{a?.titulo.length ?? 0}</span>/120</p>
      </div>
    </div>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-slug">Endereço</label>
      <div>
        <input
          class="pnl-campo"
          id="c-slug"
          name="slug"
          maxlength="80"
          pattern="[a-z0-9]+(-[a-z0-9]+)*"
          value={a?.slug ?? ''}
          readonly={Boolean(a)}
          placeholder="sai do título se ficar vazio"
          data-base={urlBase}
        />
        <p class="pnl-url" id="previa-url">{a ? `${urlBase}${a.slug}/` : ''}</p>
        <p class="pnl-dica">
          {a
            ? 'O endereço não muda depois de criado: mudar quebraria os links já compartilhados.'
            : 'Só letras minúsculas, números e hífen. Depois de criado, não muda mais.'}
        </p>
      </div>
    </div>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-resumo">Resumo</label>
      <div>
        <textarea class="pnl-campo" id="c-resumo" name="resumo" maxlength="300" rows="3" required>{a?.resumo ?? ''}</textarea>
        <p class="pnl-dica">
          Aparece na lista da Central de Conteúdos, embaixo do título, e no Google.{' '}
          <span class="pnl-conta" data-conta="c-resumo" data-max="300">{a?.resumo.length ?? 0}</span>/300
        </p>
      </div>
    </div>

    <div class="pnl-linha">
      <span class="pnl-rotulo" id="rotulo-corpo">Conteúdo</span>
      <div>
        <div class="ed">
          {/* A barra é revelada pelo script; sem JavaScript o textarea abaixo é o editor. */}
          <div class="ed__barra" role="toolbar" aria-label="Formatação" hidden>
            <select class="pnl-campo ed__bloco" id="ed-bloco" aria-label="Tipo de bloco">
              <option value="p">Parágrafo</option>
              <option value="h2">Título</option>
              <option value="h3">Subtítulo</option>
            </select>
            <span class="ed__risco"></span>
            <button class="ed__b" type="button" data-cmd="bold" title="Negrito (Ctrl+B)" aria-label="Negrito"><b>N</b></button>
            <button class="ed__b" type="button" data-cmd="italic" title="Itálico (Ctrl+I)" aria-label="Itálico"><i>I</i></button>
            <button class="ed__b" type="button" data-cmd="link" title="Inserir ou remover link">Link</button>
            <span class="ed__risco"></span>
            <button class="ed__b" type="button" data-cmd="bulletList" title="Lista com marcadores">Lista</button>
            <button class="ed__b" type="button" data-cmd="orderedList" title="Lista numerada">Numerada</button>
            <button class="ed__b" type="button" data-cmd="blockquote" title="Citação">Citação</button>
            <span class="ed__risco"></span>
            <button class="ed__b" type="button" data-cmd="imagem" title="Inserir imagem no texto">Imagem</button>
            <button class="ed__b" type="button" data-cmd="markdown" title="Ver e editar o texto em markdown" aria-pressed="false">Markdown</button>
          </div>
          <div class="ed__area" id="ed-area" hidden></div>
          <textarea class="pnl-campo ed__cru" id="corpo-md" name="corpo" rows="18" required aria-labelledby="rotulo-corpo">{a?.corpo ?? ''}</textarea>
        </div>
        <input type="file" id="ed-arquivo" accept="image/jpeg,image/png,image/webp,image/avif" hidden />
        <p class="pnl-dica" id="ed-recado" aria-live="polite">
          Escreva em markdown: <code>**negrito**</code>, <code>*itálico*</code>, <code>## título</code>,
          <code>- lista</code>, <code>[texto](https://endereço)</code>.
        </p>
      </div>
    </div>
  </fieldset>

  <fieldset class="pnl-grupo">
    <legend>Publicação</legend>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-formato">Formato</label>
      <div>
        <select class="pnl-campo" id="c-formato" name="formato">
          {Object.entries(FORMATOS).map(([valor, f]) => (
            <option value={valor} selected={(a?.formato ?? 'artigo') === valor}>{f.singular}</option>
          ))}
        </select>
        <p class="pnl-dica">É o filtro "Formato" da Central de Conteúdos.</p>
      </div>
    </div>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-categoria">Categoria</label>
      <div>
        <select class="pnl-campo" id="c-categoria" name="categoria">
          {categorias.map((c) => <option value={c} selected={c === categoriaAtual}>{c}</option>)}
        </select>
        <p class="pnl-dica">A área do texto. Aparece no cartão e no filtro "Área".</p>
      </div>
    </div>

    <div class="pnl-linha">
      <span class="pnl-rotulo" id="rotulo-autores">Autores</span>
      <div role="group" aria-labelledby="rotulo-autores">
        {site.socios.map((s) => (
          <label class="pnl-marca">
            <input type="checkbox" name="autores" value={s.nome} checked={assinantes.includes(s.nome)} />
            {s.nome}
          </label>
        ))}
        <p class="pnl-dica">Quem assina aparece no fim do texto, com foto e link para o perfil. Sem ninguém marcado, o texto sai como do escritório.</p>
      </div>
    </div>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-data">Data</label>
      <div>
        <input class="pnl-campo" id="c-data" type="date" name="publicado_em" required value={data} style="max-width: 220px" />
        <p class="pnl-dica">A data que aparece no texto. Também define a ordem da lista.</p>
      </div>
    </div>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-tempo">Tempo de leitura</label>
      <div>
        <div class="pnl-duplo" style="max-width: 420px; align-items: center">
          <input class="pnl-campo" id="c-tempo" type="number" name="tempo_leitura" min="1" max="120" value={a?.tempo_leitura ?? ''} />
          <label class="pnl-marca"><input type="checkbox" id="c-tempo-auto" name="tempo_auto" value="1" checked={!tempoNaMao} /> calcular sozinho</label>
        </div>
        <p class="pnl-dica">Em minutos. Com "calcular sozinho" marcado, sai do tamanho do texto (200 palavras por minuto).</p>
      </div>
    </div>
  </fieldset>

  <fieldset class="pnl-grupo">
    <legend>Capa</legend>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-capa-arquivo">Imagem</label>
      <div class="pnl-capa">
        <img class="pnl-capa__previa" id="previa-capa" src={a?.capa ?? undefined} alt="" hidden={!a?.capa} />
        <div class="pnl-capa__campos">
          <input class="pnl-campo" id="c-capa-arquivo" type="file" name="capa_arquivo" accept="image/jpeg,image/png,image/webp,image/avif" />
          <p class="pnl-dica" id="capa-recado">JPG, PNG, WebP ou AVIF, até 4 MB. A imagem é reduzida e sai sem os dados de localização da foto. Ao editar, deixe vazio para manter a atual.</p>
          {a?.capa && (
            <label class="pnl-marca"><input type="checkbox" name="remover_capa" value="1" id="c-remover-capa" /> tirar a capa deste texto</label>
          )}
        </div>
      </div>
    </div>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-capa">Endereço da imagem</label>
      <div>
        <input class="pnl-campo" id="c-capa" name="capa" value={a?.capa ?? ''} placeholder="https://… ou /media/capas/…" />
        <p class="pnl-dica">Preenchido sozinho ao enviar uma imagem. Use só para apontar uma imagem que já está no ar.</p>
      </div>
    </div>

    <div class="pnl-linha">
      <span class="pnl-rotulo">Medidas (px)</span>
      <div>
        <div class="pnl-duplo" style="max-width: 420px">
          <input class="pnl-campo" id="c-capa-largura" type="number" name="capa_largura" min="1" placeholder="largura" aria-label="Largura da capa em pixels" value={a?.capa_largura ?? ''} />
          <input class="pnl-campo" id="c-capa-altura" type="number" name="capa_altura" min="1" placeholder="altura" aria-label="Altura da capa em pixels" value={a?.capa_altura ?? ''} />
        </div>
        <p class="pnl-dica">Medidas pelo painel ao enviar ou ao colar um endereço. O site precisa delas para a página não pular enquanto a capa carrega.</p>
      </div>
    </div>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-capa-alt">Descrição da imagem</label>
      <div>
        <input class="pnl-campo" id="c-capa-alt" name="capa_alt" maxlength="200" value={a?.capa_alt ?? ''} />
        <p class="pnl-dica">Obrigatória quando há capa. É o que ouve quem usa leitor de tela: diga o que a foto mostra.</p>
      </div>
    </div>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-capa-credito">Crédito</label>
      <div>
        <input class="pnl-campo" id="c-capa-credito" name="capa_credito" maxlength="200" value={a?.capa_credito ?? ''} placeholder="Foto: Nome, CC BY 2.0" />
        <p class="pnl-dica">Só quando a licença da foto exige atribuição. Sai embaixo da capa.</p>
      </div>
    </div>
  </fieldset>

  <fieldset class="pnl-grupo">
    <legend>Busca (Google)</legend>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-seo-titulo">Título para busca</label>
      <div>
        <input class="pnl-campo" id="c-seo-titulo" name="seo_titulo" maxlength="60" value={a?.seo_titulo ?? ''} />
        <p class="pnl-dica">Opcional. Vazio, vale o título do texto. <span class="pnl-conta" data-conta="c-seo-titulo" data-max="60">{a?.seo_titulo?.length ?? 0}</span>/60</p>
      </div>
    </div>

    <div class="pnl-linha">
      <label class="pnl-rotulo" for="c-seo-desc">Descrição para busca</label>
      <div>
        <textarea class="pnl-campo" id="c-seo-desc" name="seo_descricao" maxlength="160" rows="2">{a?.seo_descricao ?? ''}</textarea>
        <p class="pnl-dica">Opcional. Vazio, vale o resumo. <span class="pnl-conta" data-conta="c-seo-desc" data-max="160">{a?.seo_descricao?.length ?? 0}</span>/160</p>
      </div>
    </div>
  </fieldset>

  <div class="pnl-acoes">
    <button class="pnl-btn" type="submit" name="acao" value="rascunho">{publicado ? 'Tirar do site (voltar a rascunho)' : 'Guardar rascunho'}</button>
    <button class="pnl-btn pnl-btn--principal" type="submit" name="acao" value="publicar">{publicado ? 'Salvar no site' : 'Publicar no site'}</button>
    <p class="pnl-acoes__estado" id="estado" role="alert"></p>
    <p class="pnl-dica" style="flex-basis: 100%">
      Rascunho fica só no painel. Publicar coloca o texto no site, alguns minutos depois, quando o site termina de ser atualizado.
    </p>
  </div>
</form>
