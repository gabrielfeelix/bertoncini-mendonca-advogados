---
/**
 * Abas da seção Leads do painel (18/11/2026): Contatos (formulário do site)
 * e Newsletter (inscritos na lista da Brevo). Links simples, sem JS.
 */
interface Props {
  atual: 'contatos' | 'newsletter';
}
const { atual } = Astro.props;
const abas = [
  { chave: 'contatos', href: '/painel/contatos/', rotulo: 'Contatos' },
  { chave: 'newsletter', href: '/painel/newsletter/', rotulo: 'Newsletter' },
] as const;
---

<nav class="pnl-abas" aria-label="Leads">
  {abas.map((a) => (
    <a href={a.href} aria-current={a.chave === atual ? 'page' : undefined}>{a.rotulo}</a>
  ))}
</nav>

<style>
  .pnl-abas { display: flex; gap: 28px; border-bottom: 1px solid #E3E6EA; margin: 0 0 24px; }
  .pnl-abas a { padding: 12px 0; margin-bottom: -1px; font-size: 15px; font-weight: 500; color: #5B6B7F; text-decoration: none; border-bottom: 2px solid transparent; }
  .pnl-abas a:hover { color: #0B1E3F; }
  .pnl-abas a[aria-current='page'] { color: #0B1E3F; border-bottom-color: #004369; }
</style>
