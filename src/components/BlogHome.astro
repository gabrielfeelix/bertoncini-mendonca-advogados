---
/**
 * As publicações na home (redesenho de 21/10/2026, a partir do "Blog &
 * Insights" de marketinglab.framer.ai): o texto mais recente em destaque,
 * largo, com foto de um lado e resumo do outro, e os dois seguintes em
 * cartões comuns embaixo.
 *
 * Eram seis cartões iguais numa grade. Três, com hierarquia, dizem mais:
 * o destaque responde "o que eles escreveram por último" sem o leitor
 * precisar comparar seis capas.
 *
 * Lista vazia não renderiza a seção (quem chama já checa).
 */
import CartaoTexto from './CartaoTexto.astro';
import type { Artigo } from '~/lib/artigos';

interface Props {
  artigos: Artigo[];
}

const { artigos } = Astro.props;
/* Cartões iguais (06/11/2026): o mais recente em destaque grande não
   agradou na home. Só um artigo publicado ganha o cartão grande, para não
   ficar um cartão pequeno sozinho na linha. */
const sozinho = artigos.length === 1;
---

<section class="blog" id="publicacoes" aria-labelledby="blog-titulo">
  <div class="env">
    <header class="cab">
      <h2 id="blog-titulo">Últimas publicações</h2>
      <div class="lado">
        <p>
          O que escrevemos para quem não é da área. Um assunto por vez, sem citação de artigo de lei
          que ninguém precisa decorar.
        </p>
        <a class="botao" href="/blog/">
          Ver todo o blog
          <span class="disco" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="#fff" stroke-width="1.6" stroke-linecap="round" /></svg>
          </span>
        </a>
      </div>
    </header>

    {sozinho ? (
      <CartaoTexto artigo={artigos[0]} grande />
    ) : (
      <div class="grade">
        {artigos.slice(0, 3).map((artigo) => (
          <CartaoTexto artigo={artigo} sizes="(min-width: 1080px) 420px, (min-width: 700px) 45vw, 92vw" />
        ))}
      </div>
    )}
  </div>
</section>

<style>
  /* Cinza-claro com cartões brancos, o mesmo da página do blog. */
  .blog {
    padding-block: clamp(72px, 9vw, 136px);
    background: #f2f4f7;
  }
  .cab {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: clamp(24px, 4vw, 64px);
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .cab h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(36px, 4.6vw, 64px);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--tinta);
    max-width: 9ch;
  }
  .lado {
    max-width: 40ch;
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .lado p {
    font-size: 17px;
    color: var(--secundario);
  }

  .grade {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 1.8vw, 24px);
  }

  @media (max-width: 900px) {
    .grade {
      grid-template-columns: 1fr;
    }
    .cab {
      flex-direction: column;
    }
  }
</style>
