---
/**
 * "O que chega até nós" sobre a faixa (redesenho de 21/10/2026, a partir
 * da seção de depoimentos de marketinglab.framer.ai).
 *
 * Depoimento de cliente é vedado pelo Provimento 205/2021, então o lugar
 * dos depoimentos vai para as perguntas reais que os sócios ouvem, na forma
 * em que o cliente as faz (briefing, q7.4). O efeito é o mesmo: o fundo
 * (a biblioteca à noite, `fundo-perguntas`) e a frase da antiga
 * `Faixa.astro` ficam parados (`sticky`) enquanto os cartões sobem por cima,
 * alternando os lados. A vinheta é preta, não marinho: só dá contraste ao
 * texto, sem tingir a foto.
 *
 * Cada cartão leva à resposta na página da área (`#pergunta-N`).
 */
interface Grupo {
  nome: string;
  slug: string;
  perguntas: { texto: string; indice: number }[];
}

interface Props {
  grupos: Grupo[];
}

const { grupos } = Astro.props;

/* Quatro por área, intercaladas: a coluna da esquerda e a da direita não
   ficam cada uma com uma área. */
const POR_AREA = 4;
const cartas = Array.from({ length: POR_AREA }).flatMap((_, i) =>
  grupos
    .filter((g) => g.perguntas[i])
    .map((g) => ({ area: g.nome, slug: g.slug, ...g.perguntas[i] })),
);
---

<section class="situacoes" aria-labelledby="situacoes-titulo">
  <div class="fundo">
    <picture aria-hidden="true">
      <source type="image/avif" srcset="/media/novas/fundo-perguntas.avif" />
      <source type="image/webp" srcset="/media/novas/fundo-perguntas.webp" />
      <img class="filme" src="/media/novas/fundo-perguntas.jpg" alt="" width="1664" height="936" loading="lazy" decoding="async" />
    </picture>
    <div class="lavagem" aria-hidden="true"></div>
    <div class="frase env">
      <h2 id="situacoes-titulo">Decisões importantes merecem ser pensadas antes de virarem urgência.</h2>
      <p>Algumas das dúvidas que chegam na primeira conversa, do jeito que elas chegam.</p>
    </div>
  </div>

  <ol class="cartas env">
    {cartas.map((c) => (
      <li>
        <a href={`/areas/${c.slug}/#pergunta-${c.indice + 1}`}>
          <span class="area">{c.area}</span>
          <span class="pergunta">“{c.texto}”</span>
          <span class="ler">
            Ler a resposta
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .situacoes {
    position: relative;
    background: #050e22;
    color: #fff;
  }
  .fundo {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .filme {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lavagem {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 50%, rgba(0, 0, 0, 0.45), transparent 70%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.45), transparent 40%, rgba(0, 0, 0, 0.55));
  }
  .frase {
    position: relative;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 18px;
  }
  .frase h2 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(38px, 5.6vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }
  .frase p {
    max-width: 40ch;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Os cartões entram depois do fundo, mas puxados 100vh para cima: correm
     por cima dele enquanto ele está grudado. */
  .cartas {
    position: relative;
    list-style: none;
    margin: -100vh auto 0;
    padding-block: 85vh 30vh;
    display: flex;
    flex-direction: column;
  }
  .cartas li {
    width: min(100%, 360px);
  }
  .cartas li:nth-child(odd) {
    align-self: flex-start;
    margin-left: 4%;
  }
  .cartas li:nth-child(even) {
    align-self: flex-end;
    margin-right: 4%;
    margin-top: -14vh;
  }
  .cartas li + li:nth-child(odd) {
    margin-top: 6vh;
  }
  .cartas a {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 260px;
    padding: 26px 26px 24px;
    border-radius: 18px;
    background: rgba(26, 36, 56, 0.86);
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 30px 60px -20px rgba(0, 0, 0, 0.6);
    color: #fff;
    text-decoration: none;
    transition: background-color 0.3s, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cartas a:hover {
    background: rgba(36, 50, 76, 0.92);
    transform: translateY(-4px);
  }
  .area {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
  }
  .area::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--imperial);
    box-shadow: 0 0 0 3px rgba(155, 28, 46, 0.3);
  }
  .pergunta {
    font-size: 21px;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .ler {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .cartas li,
    .cartas li:nth-child(odd),
    .cartas li:nth-child(even) {
      align-self: center;
      margin: 18px 0 0;
    }
    .cartas {
      padding-block: 80vh 20vh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cartas a {
      transition: none;
    }
  }
</style>
