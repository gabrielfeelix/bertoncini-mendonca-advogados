---
/**
 * "O que chega até nós": as perguntas que os sócios mais ouvem, agrupadas
 * por área, cada uma levando à resposta na página da área.
 *
 * As perguntas vêm do briefing (q7.4), na forma em que o cliente as faz,
 * e as respostas já estão no JSON de cada área. Esta seção não tem texto
 * próprio além do título: ela serve para a pessoa se reconhecer numa
 * pergunta e ir direto para a resposta.
 *
 * Cada link aponta para o `id` do `<details>` correspondente
 * (`#pergunta-N`), e o script de `Perguntas.astro` abre a resposta quando
 * a página carrega com esse endereço.
 */
import Marca from './Marca.astro';

interface Grupo {
  nome: string;
  slug: string;
  marca?: 'sucessao' | 'rede';
  perguntas: { texto: string; indice: number }[];
}

interface Props {
  grupos: Grupo[];
}

const { grupos } = Astro.props;
---

<section class="secao situacoes" id="situacoes" aria-labelledby="situacoes-titulo">
  <div class="env">
    <div class="topo">
      <h2 class="display sobe" id="situacoes-titulo">O que as pessoas nos perguntam</h2>
      <p class="apoio sobe">
        Algumas das dúvidas que chegam na primeira conversa, do jeito que elas chegam. Cada uma
        tem resposta curta na página da área.
      </p>
    </div>

    <div class="grupos">
      {grupos.map((grupo) => (
        <div class="grupo sobe">
          <div class="grupo-cabeca">
            {grupo.marca && <Marca tipo={grupo.marca} class="grupo-icone" />}
            <h3>{grupo.nome}</h3>
          </div>
          <ul>
            {grupo.perguntas.map((pergunta) => (
              <li>
                <a href={`/areas/${grupo.slug}/#pergunta-${pergunta.indice + 1}`}>
                  <span>{pergunta.texto}</span>
                  <span class="seta" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a class="todas" href={`/areas/${grupo.slug}/#perguntas`}>Todas as perguntas sobre {grupo.nome.toLowerCase()}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .situacoes {
    padding-block: clamp(64px, 8vw, 128px);
  }
  .topo {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(20px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .topo h2 {
    font-size: clamp(34px, 4.6vw, 64px);
    max-width: 16ch;
  }
  .apoio {
    font-size: 18px;
    color: var(--secundario);
    max-width: 46ch;
  }
  .grupos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(14px, 1.6vw, 22px);
  }
  .grupo {
    background: var(--papel);
    border-radius: clamp(16px, 2vw, 26px);
    padding: clamp(22px, 2.8vw, 40px);
    display: flex;
    flex-direction: column;
  }
  .grupo-cabeca {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--linha);
  }
  .grupo-cabeca :global(.grupo-icone) {
    width: 48px;
    height: auto;
    flex: none;
  }
  .grupo h3 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.15;
  }
  .grupo ul {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }
  .grupo li {
    border-bottom: 1px solid var(--linha);
  }
  .grupo li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 12px 0;
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.35;
    color: var(--tinta);
    text-decoration: none;
  }
  .grupo li a .seta {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--imperial);
    background: #fff;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.25s, color 0.25s;
  }
  .grupo li a:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .grupo li a:hover .seta {
    transform: translateX(3px);
    background: var(--imperial);
    color: #fff;
  }
  .todas {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 18px;
    font-size: 17px;
    color: var(--apoio);
    text-underline-offset: 4px;
  }
  @media (max-width: 900px) {
    .topo,
    .grupos {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .grupo li a .seta {
      transition: none;
    }
  }
</style>
