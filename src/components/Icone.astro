---
/**
 * Ícones de linha dos assuntos e públicos das áreas (06/11/2026).
 *
 * Mesmo traço em todos (1.6 numa caixa de 24, pontas redondas), cor por
 * `currentColor`. Escolhidos pelo texto do título (`iconeDe`), para área
 * nova no JSON ganhar ícone sem mexer aqui; o que não casar cai em
 * `documento`. Ornamento: `aria-hidden`, o título está escrito ao lado.
 */
interface Props {
  nome: Nome;
  tamanho?: number;
  class?: string;
}

export type Nome =
  | 'documento'
  | 'pena'
  | 'presente'
  | 'percentual'
  | 'predio'
  | 'chave'
  | 'camera'
  | 'escudo'
  | 'selo'
  | 'sacola'
  | 'alerta'
  | 'brilho'
  | 'lista'
  | 'maleta'
  | 'familia'
  | 'megafone'
  | 'pessoa';

const { nome, tamanho = 28, class: classe } = Astro.props;
---

<svg
  class={classe}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {nome === 'documento' && (
    <>
      <path d="M7 3h7l4 4v14H7z" />
      <path d="M14 3v4h4M10 12h5M10 15.5h5" />
    </>
  )}
  {nome === 'pena' && (
    <>
      <path d="M20 4c-6 0-11 5-12 11l-2 5 5-2c6-1 11-6 11-12z" />
      <path d="M6 20 14 12" />
    </>
  )}
  {nome === 'presente' && (
    <>
      <path d="M4 10h16v4H4zM5.5 14v7h13v-7M12 10v11" />
      <path d="M12 10c-1.5-3-5-4-5-1.5S10 10 12 10zm0 0c1.5-3 5-4 5-1.5S14 10 12 10z" />
    </>
  )}
  {nome === 'percentual' && (
    <>
      <path d="M18 6 6 18" />
      <circle cx="7.5" cy="7.5" r="2.5" />
      <circle cx="16.5" cy="16.5" r="2.5" />
    </>
  )}
  {nome === 'predio' && (
    <>
      <path d="M4 21V5l8-2v18M12 8l8 2.5V21M3 21h18" />
      <path d="M7.5 8h1M7.5 12h1M7.5 16h1M15.5 13h1M15.5 17h1" />
    </>
  )}
  {nome === 'chave' && (
    <>
      <circle cx="8" cy="15" r="4" />
      <path d="m11 12 8-8M16 7l2.5 2.5M14 9l2 2" />
    </>
  )}
  {nome === 'camera' && (
    <>
      <rect x="3" y="6" width="13" height="12" rx="2.5" />
      <path d="m16 10.5 5-3v9l-5-3" />
    </>
  )}
  {nome === 'escudo' && (
    <>
      <path d="M12 3 5 6v5c0 4.5 3 8.5 7 10 4-1.5 7-5.5 7-10V6z" />
      <rect x="9" y="11" width="6" height="5" rx="1" />
      <path d="M10.5 11V9.5a1.5 1.5 0 0 1 3 0V11" />
    </>
  )}
  {nome === 'selo' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M10 16.5v-9h3a2.5 2.5 0 0 1 0 5h-3M13 12.5l2.5 4" />
    </>
  )}
  {nome === 'sacola' && (
    <>
      <path d="M5 8h14l-1 13H6z" />
      <path d="M9 10V7a3 3 0 0 1 6 0v3" />
    </>
  )}
  {nome === 'alerta' && (
    <>
      <path d="M12 3.5 21.5 20h-19z" />
      <path d="M12 10v4.5M12 17.2v.1" />
    </>
  )}
  {nome === 'brilho' && (
    <>
      <path d="M12 3c.6 4.2 2.8 6.4 7 7-4.2.6-6.4 2.8-7 7-.6-4.2-2.8-6.4-7-7 4.2-.6 6.4-2.8 7-7z" />
      <path d="M19 15.5c.25 1.6 1 2.3 2.5 2.5-1.5.2-2.25.9-2.5 2.5-.25-1.6-1-2.3-2.5-2.5 1.5-.2 2.25-.9 2.5-2.5z" />
    </>
  )}
  {nome === 'lista' && (
    <>
      <rect x="5" y="4" width="14" height="17" rx="2" />
      <path d="M9 4V3h6v1M8.5 10l1.5 1.5 3-3M8.5 15.5l1.5 1.5 3-3" />
    </>
  )}
  {nome === 'maleta' && (
    <>
      <rect x="3" y="7" width="18" height="13" rx="2" />
      <path d="M9 7V5h6v2M3 12.5h18" />
    </>
  )}
  {nome === 'familia' && (
    <>
      <circle cx="8" cy="7" r="2.5" />
      <circle cx="16" cy="7" r="2.5" />
      <circle cx="12" cy="13" r="2" />
      <path d="M3.5 20v-3a4.5 4.5 0 0 1 9 0M11.5 17a4.5 4.5 0 0 1 9 0v3M9 21v-1.5a3 3 0 0 1 6 0V21" />
    </>
  )}
  {nome === 'megafone' && (
    <>
      <path d="M4 10v4h3l9 5V5L7 10z" />
      <path d="M7 14l1 5h2.5l-1-4.5M19 9.5a3 3 0 0 1 0 5" />
    </>
  )}
  {nome === 'pessoa' && (
    <>
      <circle cx="12" cy="8" r="3.5" />
      <path d="M5 20a7 7 0 0 1 14 0" />
    </>
  )}
</svg>
