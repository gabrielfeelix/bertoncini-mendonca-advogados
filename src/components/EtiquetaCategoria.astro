---
/**
 * Rótulo da publicação, acima do título: formato e área ("Artigo · Direito
 * digital"), em texto colorido, como os blogs de escritório costumam fazer.
 *
 * Era uma etiqueta em caixa colorida (pílula); virou texto em 07/11/2026,
 * no redesenho dos cartões. Continua em letra normal, e não em caixa alta,
 * porque o cliente pediu que a área "leia como assunto, não como
 * sobretítulo em caixa alta".
 *
 * Fica num componente só porque aparece no cartão e no destaque da Central
 * de Conteúdos, e os dois precisam ser iguais.
 */
import { FORMATOS, type Formato } from '../lib/artigos';

interface Props {
  categoria: string;
  formato?: Formato;
}
const { categoria, formato } = Astro.props;
---

<p class="etiqueta-linha">
  {formato && <span class="etiqueta-formato">{FORMATOS[formato].singular}</span>}
  {formato && <span class="etiqueta-ponto" aria-hidden="true">·</span>}
  <span>{categoria}</span>
</p>

<style>
  .etiqueta-linha {
    margin: 0 0 8px;
    font: 500 14px/1.4 var(--fonte);
    color: var(--azul-claro);
  }
  .etiqueta-formato { color: var(--azul-medio); font-weight: 700; }
  .etiqueta-ponto { margin: 0 6px; }
</style>
