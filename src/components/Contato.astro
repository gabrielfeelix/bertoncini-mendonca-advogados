---
/**
 * Contato: chamada, botão do WhatsApp, horário e a lista de dados.
 * Migrado do protótipo (CSS linhas 386-399, HTML linhas 768-790).
 *
 * Telefone, e-mail, WhatsApp, cidade e forma de atendimento vêm de
 * `src/lib/site.ts`, que é a única fonte desses valores. Todos ainda são
 * placeholder e cada linha recebe `data-placeholder="1"` para a Tarefa 15
 * conseguir inventariá-los.
 *
 * A Tarefa 5 só anima o `.sobe` daqui; a seção é inteiramente utilizável
 * sem JavaScript (o botão é um `<a>` e os dados são `tel:` e `mailto:`).
 */
import { site } from '../lib/site';
import Zap from './Zap.astro';

interface Dado {
  /** Rótulo da linha (`<dt>`). */
  rotulo: string;
  /** Valor exibido. */
  valor: string;
  /** Destino, quando o valor for um link. */
  href?: string;
  /** true quando o valor ainda é placeholder. */
  placeholder?: boolean;
}

interface Props {
  /** Chamada principal. */
  titulo?: string;
  /** Rótulo do botão. */
  botaoRotulo?: string;
  /** Destino do botão. */
  botaoHref?: string;
  /** true quando o destino do botão ainda é placeholder. */
  botaoPlaceholder?: boolean;
  /** Frase do horário de atendimento. */
  horario?: string;
  /** Linhas da lista de dados. */
  dados?: Dado[];
}

const {
  titulo = 'Conte o que está acontecendo.',
  botaoRotulo = 'Abrir conversa no WhatsApp',
  botaoHref = site.whatsapp.valor,
  botaoPlaceholder = site.whatsapp.placeholder,
  horario = 'Segunda a sexta, das 9h às 18h. Fora do horário a mensagem fica registrada.',
  dados = [
    {
      rotulo: 'Telefone',
      valor: site.telefone.valor,
      href: `tel:${site.telefoneE164.valor}`,
      placeholder: site.telefone.placeholder,
    },
    {
      rotulo: 'E-mail',
      valor: site.email.valor,
      href: `mailto:${site.email.valor}`,
      placeholder: site.email.placeholder,
    },
    { rotulo: 'Atendimento', valor: site.atendimento },
    { rotulo: 'Base', valor: `${site.cidade}, ${site.estado}` },
  ],
}: Props = Astro.props;
---

<section class="secao contato" id="contato">
  <div class="env">
    <div>
      <h2 class="display sobe">{titulo}</h2>
      <div class="acao sobe">
        <a class="botao zap" href={botaoHref} data-placeholder={botaoPlaceholder ? '1' : undefined}>
          {botaoRotulo}
          <span class="disco"><Zap tamanho={15} /></span>
        </a>
      </div>
      <p class="horario sobe"><span class="ponto"></span>{horario}</p>
    </div>
    <dl class="dados sobe">
      {dados.map((dado) => (
        <div class="dado">
          <dt>{dado.rotulo}</dt>
          <dd>
            {dado.href ? (
              <a href={dado.href} data-placeholder={dado.placeholder ? '1' : undefined}>{dado.valor}</a>
            ) : (
              <span data-placeholder={dado.placeholder ? '1' : undefined}>{dado.valor}</span>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .contato :global(.env) {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(30px, 5vw, 88px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .contato :global(.env) {
      grid-template-columns: 1fr;
      gap: 38px;
    }
  }
  .contato h2 {
    font-size: clamp(34px, 5.4vw, 72px);
    max-width: 13ch;
  }
  .contato .acao {
    margin-top: 34px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .contato .horario {
    margin-top: 20px;
    font-size: 16px;
    color: var(--secundario);
  }
  .contato .horario .ponto {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2c8a5b;
    margin-right: 8px;
  }
  .dados {
    border-top: 1px solid var(--linha);
    margin: 0;
  }
  .dado {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--linha);
    font-size: 16.5px;
  }
  .dado dt {
    color: var(--secundario);
    font-size: 15px;
  }
  .dado dd {
    margin: 0;
  }
  .dado a {
    text-decoration: none;
    border-bottom: 1px solid var(--linha);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .dado a:hover {
    border-color: var(--tinta);
  }

  /* prefers-reduced-motion desliga todo movimento desta seção. A Tarefa 5
     traz o kill-switch global do protótipo; este bloco garante que o
     componente já cumpra a regra sozinho, em qualquer página. */
  @media (prefers-reduced-motion: reduce) {
    .contato,
    .contato * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
