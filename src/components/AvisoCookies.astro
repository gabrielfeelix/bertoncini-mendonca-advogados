---
/**
 * Aviso de cookies: três escolhas, guardadas no aparelho. Migrado do
 * protótipo (CSS linhas 457-468, HTML linhas 869-879).
 *
 * Nasce com o atributo `hidden`: sem JavaScript não há rastreamento
 * nenhum para consentir, então o aviso simplesmente não aparece e não
 * rouba espaço da leitura. A Tarefa 5 remove o `hidden` quando ainda não
 * houver escolha guardada e trata o clique dos três botões.
 *
 * O texto é provisório e está marcado com `data-placeholder="1"`: o
 * definitivo vem do escritório, com o link real da política.
 *
 * Marcações: o id `#aviso` e os três
 * `data-consente="todos|necessarios|nenhum"`.
 *
 * Tarefa 13: a escolha deixou de ser gravada aqui no `localStorage` na mão
 * (protótipo, linhas 1171-1184) e passou por `src/lib/consentimento.ts`,
 * adaptado do projeto da Isabella. As três escolhas continuam as mesmas, a
 * chave do `localStorage` continua `consentimento`, e o
 * `CustomEvent('consentimento')` que o protótipo dispara no `document`
 * continua sendo disparado, com o mesmo `detail`. Quem vier a ligar medição
 * depois escuta esse evento, exatamente como o protótipo previa.
 */
interface Opcao {
  /** Valor lido no clique e gravado por `consentimento.ts`. */
  consente: string;
  /** Rótulo do botão. */
  rotulo: string;
}

interface Props {
  /** Rótulo acessível da região. */
  rotulo?: string;
  /** Texto do aviso. */
  texto?: string;
  /** Rótulo do link para a política. */
  linkRotulo?: string;
  /** Destino do link para a política. */
  linkHref?: string;
  /** true quando o link ainda é placeholder. */
  linkPlaceholder?: boolean;
  /** Ressalva em vermelho, visível enquanto o texto for provisório. */
  ressalva?: string;
  /** Os três botões de escolha, na ordem. */
  opcoes?: Opcao[];
  /** Rótulo do botão que reabre o aviso depois da escolha (LGPD: revogar tem de ser tão fácil quanto aceitar). */
  preferencias?: string;
}

const {
  rotulo = 'Aviso de cookies',
  texto = 'Este site usa cookies para medir visitas. Você escolhe o que aceita.',
  linkRotulo = 'Saiba mais',
  linkHref = '/politica-de-cookies/',
  linkPlaceholder = false,
  ressalva = 'Texto provisório. O definitivo vem do Juscelino.',
  opcoes = [
    { consente: 'todos', rotulo: 'Aceitar todos' },
    { consente: 'necessarios', rotulo: 'Apenas necessários' },
    { consente: 'nenhum', rotulo: 'Rejeitar' },
  ],
  preferencias = 'Preferências de cookies',
}: Props = Astro.props;
---

<div class="aviso" id="aviso" role="region" aria-label={rotulo} hidden>
  <p data-placeholder="1">
    {texto}{' '}
    <a href={linkHref} data-placeholder={linkPlaceholder ? '1' : undefined}>{linkRotulo}</a>{' '}
    {ressalva && <span style="color:var(--imperial)">{ressalva}</span>}
  </p>
  <div class="opcoes">
    {opcoes.map((opcao) => (
      <button type="button" data-consente={opcao.consente}>{opcao.rotulo}</button>
    ))}
  </div>
</div>

<!-- Reabre o aviso depois que a pessoa já escolheu. Pela LGPD, retirar o
     consentimento tem de ser tão fácil quanto dar: sem isto, quem aceitou
     não tinha por onde voltar atrás. Canto inferior direito (07/11/2026): a
     acessibilidade fica no meio da lateral direita, o canto de baixo é livre. -->
<button type="button" class="cookie-flutuante" data-abrir-cookies aria-label={preferencias} title={preferencias} hidden>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20.5 12.3A8.5 8.5 0 1 1 11.7 3.5a3 3 0 0 0 3.4 3.4 3 3 0 0 0 3 3 3 3 0 0 0 2.4 2.4Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="8.5" cy="10" r="1.2" fill="currentColor"/><circle cx="12" cy="15.5" r="1.2" fill="currentColor"/><circle cx="15.8" cy="13" r="1" fill="currentColor"/><circle cx="8.8" cy="15" r=".9" fill="currentColor"/></svg>
</button>

<script>
  import { lerEscolha, registrar, type Escolha } from '~/lib/consentimento';

  /* O aviso nasce com `hidden` no HTML: sem JavaScript não existe medição
     nenhuma para consentir, então ele simplesmente não aparece. */
  const caixa = document.getElementById('aviso');

  const flutuante = document.querySelector<HTMLButtonElement>('.cookie-flutuante');
  const mostrarFlutuante = (sim: boolean) => { if (flutuante) flutuante.hidden = !sim; };

  if (caixa) {
    /* Qualquer [data-abrir-cookies] (o botão flutuante, o link do rodapé)
       reabre o aviso para a pessoa mudar a escolha. */
    document.addEventListener('click', (e) => {
      const alvo = (e.target as Element | null)?.closest('[data-abrir-cookies]');
      if (!alvo) return;
      e.preventDefault();
      caixa.hidden = false;
      mostrarFlutuante(false);
      caixa.querySelector<HTMLButtonElement>('[data-consente]')?.focus();
    });

    if (lerEscolha()) mostrarFlutuante(true);
    if (!lerEscolha()) {
      caixa.hidden = false;
      /* A altura do aviso vai para o CSS: no celular os botões de
         acessibilidade (Acessibilidade.astro) sobem para cima dele. */
      const medir = () => document.documentElement.style.setProperty('--altura-aviso', `${caixa.offsetHeight + 12}px`);
      medir();
      new ResizeObserver(medir).observe(caixa);
    }

    caixa.querySelectorAll<HTMLButtonElement>('[data-consente]').forEach((botao) => {
      botao.addEventListener('click', () => {
        const valor = botao.dataset.consente as Escolha | undefined;
        if (!valor) return;
        /* `registrar` grava a escolha e dispara o `CustomEvent`
           `consentimento` no `document`, o mesmo contrato do protótipo. */
        registrar(valor);
        caixa.hidden = true;
        mostrarFlutuante(true);
      });
    });
  }
</script>

<style>
  /* aviso de cookies: três escolhas, guardadas no aparelho. Só existe com
     JS, sem JS não há rastreamento nenhum para consentir. */
  .aviso {
    position: fixed;
    z-index: 90;
    right: 16px;
    bottom: 16px;
    max-width: 420px;
    padding: 20px 22px;
    background: #fff;
    color: var(--tinta);
    border: 1px solid var(--linha);
    border-radius: 18px;
    box-shadow: 0 20px 60px rgba(11, 30, 63, 0.16);
    font-size: 15px;
    line-height: 1.55;
  }
  .aviso p {
    margin: 0 0 16px;
  }
  /* O protótipo deixa este link com a altura da linha (16px). O alvo de
     toque mínimo do projeto é 44px e vale para todo link clicável, então
     ele vira inline-flex com 44px de altura. É a única medida alterada em
     relação ao protótipo nesta seção; a cor, o tamanho da fonte e o texto
     continuam iguais. */
  .aviso a {
    color: var(--apoio);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .aviso .opcoes {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .aviso button {
    font: 500 14px/1 var(--sans);
    padding: 13px 16px;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid var(--tinta);
    background: #fff;
    color: var(--tinta);
    min-height: 44px;
  }
  .aviso button[data-consente='todos'] {
    background: var(--tinta);
    color: #fff;
  }
  .aviso button:hover {
    background: var(--apoio);
    color: #fff;
    border-color: var(--apoio);
  }
  @media (prefers-reduced-motion: reduce) {
    .aviso,
    .aviso * {
      transition: none !important;
      animation: none !important;
    }
  }
  @media (max-width: 560px) {
    .aviso {
      left: 12px;
      right: 12px;
      bottom: 12px;
      max-width: none;
    }
  }

  .cookie-flutuante {
    position: fixed; right: 16px; bottom: 16px; z-index: 55;
    display: grid; place-items: center; width: 44px; height: 44px;
    border-radius: 50%; border: 1px solid rgba(248, 247, 242, .35); cursor: pointer;
    background: var(--azul, #0b1e3f); color: #fff;
    box-shadow: 0 8px 22px rgba(11, 30, 63, .28);
    transition: background-color .15s ease;
  }
  .cookie-flutuante[hidden] { display: none; }
  .cookie-flutuante:hover { background: var(--azul-medio, #004369); }
</style>
