---
/**
 * Cartão de sócio, no formato da página "Profissionais" de escritório
 * grande: foto, cargo, nome e OAB. Sem área individual: os sócios atuam
 * juntos nas duas áreas (retorno de 06/11/2026). Sem efeito de hover na foto.
 */
import { site } from '../lib/site';

interface Props {
  socio: (typeof site.socios)[number];
  /** 'o' para Sócio, 'a' para Sócia. */
  genero: 'o' | 'a';
  /** Âncora do perfil completo em /escritorio/. */
  href?: string;
}
const { socio, genero, href = `/escritorio/#${socio.nome.split(' ')[0].toLowerCase()}` } = Astro.props;
---

<article class="cartao cartao-socio">
  <img src={`${socio.retrato}-560.jpg`} alt={`Retrato de ${socio.nome}.`} width="560" height="840" loading="lazy" />
  <div class="cartao-corpo">
    <p class="rotulo">Sóci{genero}</p>
    <h3><a href={href}>{socio.nome}</a></h3>
    <p class="oab">{socio.oab.valor}</p>
  </div>
</article>

<style>
  .cartao-socio img { width: 100%; aspect-ratio: 4 / 4.4; object-fit: cover; object-position: 50% 20%; background: var(--fundo-cinza); }
  .cartao-socio h3 a { color: var(--azul); text-decoration: none; }
  .cartao-socio h3 a:hover { color: var(--azul-medio); text-decoration: underline; }
  .oab { margin: 0 0 4px; font-size: 15px; }
</style>
