---
/**
 * Áreas de atuação: chapa azul com grão, lista de áreas em linhas grandes.
 * Redesenhado (Tarefa 1 do redesenho): era uma lista de linhas grandes
 * sobre chapa azul com degradê e corte diagonal; virou um mosaico de
 * blocos sobre azul chapado.
 *
 * Duas áreas: Planejamento Patrimonial e Sucessório e Direito Digital,
 * conforme o briefing 2.1-2.3.
 *
 * O componente ainda sabe renderizar área "a confirmar" (vira um
 * `<div class="item aberto">` sem link, nunca um `<a>` morto), mas não há
 * nenhuma no conteúdo: as duas que existiam foram removidas a pedido do
 * cliente. O caminho continua aqui porque o teto de quatro áreas é decisão
 * registrada, e uma terceira pode entrar sem refazer o componente.
 *
 * O vídeo de prévia que seguia o cursor (`.espia`, `data-espia`) saiu no
 * redesenho: ele só existia com mouse, nunca aparecia no celular nem sob
 * reduced-motion, e competia com o próprio bloco pela atenção. O mosaico
 * já mostra o que a área abrange, sem depender de hover.
 *
 * Marcação que a camada de movimento procura: `.sobe` em cada bloco.
 */
import { site } from '../lib/site';
import Marca from './Marca.astro';

interface Area {
  /** Nome da área. */
  nome: string;
  /** Frase curta abaixo do nome da área. */
  glosa?: string;
  /**
   * Assuntos da área. String simples ainda vale; a forma com `faz`
   * acrescenta o que se faz no assunto, e é a que o card usa.
   */
  assuntos?: (string | { nome: string; faz?: string })[];
  /** Destino do link. Ausente = área "a confirmar", sem link. */
  href?: string;
  /** true quando o href ainda é placeholder. */
  placeholder?: boolean;
  /** Rótulo da pílula vermelha nas áreas ainda não definidas. */
  pendente?: string;
  /** Ícone do canto superior direito do bloco. Ausente nas "a confirmar". */
  marca?: 'sucessao' | 'rede';
}

interface Props {
  /** Título da seção. */
  titulo?: string;
  /** Frase de apoio ao lado do título. */
  apoio?: string;
  /** Lista de áreas, na ordem. */
  areas?: Area[];
  /**
   * Quantos assuntos cada bloco mostra.
   *
   * Existe porque o bloco é um CARTÃO, não a página da área: com os seis
   * ou sete assuntos completos ele fica com mais de uma tela de altura, os
   * dois cartões ficam de alturas muito diferentes (uma área tem seis
   * assuntos, a outra sete) e o "Falar sobre isso" some abaixo da dobra.
   * A lista inteira vive na página da área, que é para onde o cartão leva.
   */
  limiteAssuntos?: number;
}

const whats = site.whatsapp.valor.split('?')[0];

const {
  titulo = 'Áreas de atuação',
  apoio = 'As duas áreas em que o escritório atua, e o que cada uma abrange.',
  limiteAssuntos = 3,
  areas = [
    {
      nome: 'Planejamento Patrimonial e Sucessório',
      glosa: 'Organizar em vida o que, sem organização, vira inventário e disputa entre herdeiros.',
      assuntos: [
        { nome: 'Inventário e partilha', faz: 'Em cartório quando os herdeiros concordam, na Justiça quando não.' },
        { nome: 'Testamento e doação', faz: 'A transmissão escrita respeitando a legítima.' },
        { nome: 'Holding familiar', faz: 'A conta feita antes: o que custa contra o que economiza.' },
      ],
      marca: 'sucessao',
      href: `${whats}?text=Ol%C3%A1%2C%20preciso%20de%20orienta%C3%A7%C3%A3o%20sobre%20planejamento%20patrimonial%20e%20sucess%C3%B3rio.`,
      placeholder: site.whatsapp.placeholder,
    },
    {
      nome: 'Direito Digital',
      glosa: 'Dados pessoais, propriedade intelectual, contratos eletrônicos e o que acontece quando algo dá errado na internet.',
      assuntos: [
        { nome: 'Proteção de dados e LGPD', faz: 'Mapear o que a empresa coleta e responder o titular no prazo.' },
        { nome: 'Propriedade intelectual', faz: 'Marca no INPI, e em contrato a quem pertence o que foi criado.' },
        { nome: 'Crimes cibernéticos', faz: 'Preservar a prova primeiro. É o que mais se perde por demora.' },
      ],
      marca: 'rede',
      href: `${whats}?text=Ol%C3%A1%2C%20preciso%20de%20orienta%C3%A7%C3%A3o%20sobre%20direito%20digital.`,
      placeholder: site.whatsapp.placeholder,
    },
  ],
}: Props = Astro.props;
---

<section class="areas" id="areas">
  <div class="env">
    <div class="topo">
      <h2 class="display sobe">{titulo}</h2>
      {/* O leque fecha o vão que sobrava entre o título e a frase de
          apoio, e diz em forma o que a frase diz em palavra: quatro
          lâminas do mesmo eixo, duas firmes e duas apagadas. */}
      <div class="apoio sobe">
        <Marca tipo="leque" class="leque" />
        <p>{apoio}</p>
      </div>
    </div>

    {/* Mosaico de blocos: cada área é uma peça de cor com título grande e
        texto dentro, encaixadas em alturas desiguais. É o mecanismo do
        Oliveira Pitta e do Medina — os dois escritórios de Maringá que o
        cliente mandou como referência — e resolve o problema de acervo:
        é peça gráfica feita de cor e tipografia, sem exigir imagem. */}
    <div class="mosaico">
      {areas.map((area, i) => (
        area.href ? (
          <a
            class:list={['bloco', 'sobe', `t${i % 2}`]}
            href={area.href}
            data-placeholder={area.placeholder ? '1' : undefined}
            target="_blank"
            rel="noopener"
          >
            <span class="ordem">{String(i + 1).padStart(2, '0')}</span>
            {/* O título quebra em três linhas e para na metade da largura:
                sobrava um vão no alto à direita do bloco. O ícone ocupa
                esse vão e diz de que área se trata antes da leitura. */}
            {area.marca && <Marca tipo={area.marca} class="icone" />}
            <h3>{area.nome}</h3>
            {area.glosa && <span class="glosa">{area.glosa}</span>}
            {area.assuntos && area.assuntos.length > 0 && (()=>{
              const mostrados = area.assuntos.slice(0, limiteAssuntos);
              const restantes = area.assuntos.length - mostrados.length;
              return (
              /* Lista de serviço, não pílulas. Cada linha é o assunto
                 seguido do que se faz nele — a pílula dizia só a
                 palavra-chave, e palavra-chave solta é o que o cliente
                 reprovou por soar a texto gerado. O texto de `faz` vem do
                 corpo da área, que passou pela revisão do Provimento
                 205/2021. */
              <>
                <ul class="assuntos" aria-label={`Assuntos em ${area.nome}`}>
                  {mostrados.map((assunto) => {
                    const item = typeof assunto === 'string' ? { nome: assunto } : assunto;
                    return (
                      <li>
                        <b>{item.nome}</b>
                        {item.faz && <span>{item.faz}</span>}
                      </li>
                    );
                  })}
                </ul>
                {/* Diz que a lista continua, em vez de cortar em silêncio. */}
                {restantes > 0 && (
                  <span class="mais">e mais {restantes} {restantes === 1 ? 'assunto' : 'assuntos'}</span>
                )}
              </>
              );
            })()}
            <span class="leva">
              <span class="rotulo">Falar sobre isso</span>
              <span class="seta" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            </span>
          </a>
        ) : (
          <div class="bloco vago sobe">
            <h3>{area.nome}</h3>
            {area.pendente && <span class="pendente">{area.pendente}</span>}
          </div>
        )
      ))}
    </div>
  </div>
</section>

<style>
  /*
    Chapa azul CHAPADA, sem degradê.

    O fundo anterior era `radial-gradient` misturando azul de apoio com o
    vermelho imperial, mais um corte diagonal (`clip-path`) em cima e
    embaixo. O cliente pediu o azul da marca, "não aquele degradê de azul
    com vermelho" — e o corte diagonal brigava com a placa arredondada da
    primeira dobra, que é a forma que o site passou a usar.
  */
  .areas {
    position: relative;
    background: var(--tinta);
    color: #fff;
    overflow: hidden;
    padding-block: var(--bloco);
  }

  .areas .env {
    position: relative;
    z-index: 3;
  }
  .areas .topo {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: clamp(30px, 4vw, 52px);
  }
  .areas h2 {
    font-size: clamp(32px, 4.4vw, 60px);
  }
  .areas .apoio {
    display: flex;
    align-items: center;
    gap: clamp(16px, 1.8vw, 26px);
  }
  .areas .apoio p {
    color: rgba(255, 255, 255, 0.72);
    font-size: 17px;
    max-width: 30ch;
    margin: 0;
  }
  .areas :global(.leque) {
    width: clamp(52px, 5vw, 74px);
    flex: none;
  }

  /* Em tela estreita o leque sairia empurrando a frase para duas linhas
     a mais sem acrescentar nada: o mosaico logo abaixo já diz o mesmo. */
  @media (max-width: 700px) {
    .areas :global(.leque) {
      display: none;
    }
  }

  /*
    O mosaico: blocos de alturas desiguais que se encaixam.

    Duas colunas em desktop. As áreas confirmadas ocupam blocos altos; as
    "a confirmar" ficam lado a lado num bloco baixo cada. O desencontro de
    altura é o que faz a peça parecer montada em vez de listada — é o que
    o Oliveira Pitta faz com as áreas dele.
  */
  /*
    Com quatro blocos, a altura desigual era o efeito: dois altos em cima
    e dois baixos embaixo, encaixados. Com dois lado a lado ela vira só
    desalinho — o de Direito Digital tem um parágrafo a menos e terminava
    acima do outro. `align-items: stretch` (padrão do grid) já igualaria,
    mas o conteúdo de cada bloco precisa empurrar o rodapé para baixo:
    daí o `margin-top: auto` no `.leva`.
  */
  .mosaico {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(12px, 1.2vw, 18px);
    align-items: stretch;
  }
  .bloco .leva {
    margin-top: auto;
  }

  /* Ocupa o vão no alto à direita, ao lado do número e do título. Medido
     no bloco real: o título para em x=428 de 625px úteis, deixando ~190px
     livres. `pointer-events: none` porque o bloco inteiro é o link. */
  .bloco :global(.icone) {
    position: absolute;
    top: clamp(30px, 3vw, 44px);
    right: clamp(30px, 3vw, 44px);
    width: clamp(62px, 6.4vw, 92px);
    pointer-events: none;
  }
  /*
    O bloco escuro tem `--tinta` como fundo, e as marcas usam `--tinta`
    nas peças cheias: ali elas viravam buracos no card. Redefinir os
    tokens no escopo do ícone é o que faz a mesma marca servir às duas
    superfícies sem uma segunda versão do desenho.
  */
  .bloco.t1 :global(.icone) {
    --tinta: #ffffff;
    --branco: #0b1e3f;
    --linha: rgba(255, 255, 255, 0.28);
    --secundario: rgba(255, 255, 255, 0.62);
    --papel: rgba(255, 255, 255, 0.1);
  }
  /* Abaixo de 620px o título usa a largura toda e o ícone encostaria
     nele. */
  @media (max-width: 620px) {
    .bloco :global(.icone) {
      display: none;
    }
  }
  .bloco {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: clamp(14px, 1.6vw, 22px);
    padding: clamp(26px, 2.8vw, 44px);
    min-height: clamp(280px, 30vw, 420px);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.4s;
  }
  /* As duas áreas confirmadas alternam entre papel e azul mais claro:
     duas superfícies, como no mosaico da referência, em vez de quatro
     caixas iguais. */
  .bloco.t0 {
    background: var(--papel);
    color: var(--tinta);
  }
  .bloco.t1 {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .bloco.t1:hover {
    background: rgba(255, 255, 255, 0.11);
  }
  .bloco.t0:hover {
    background: #fff;
  }
  .bloco:hover {
    transform: translateY(-4px);
  }

  .ordem {
    font-family: var(--serif);
    font-size: 16px;
    letter-spacing: 0.06em;
    opacity: 0.6;
    margin-bottom: 14px;
  }
  .bloco h3 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(27px, 2.9vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .glosa {
    margin-top: 14px;
    font-size: 17px;
    line-height: 1.5;
    max-width: 40ch;
  }
  .bloco.t0 .glosa {
    color: var(--secundario);
  }
  .bloco.t1 .glosa {
    color: rgba(255, 255, 255, 0.74);
  }

  /*
    A lista de assuntos.

    Eram pílulas arredondadas: seis etiquetas soltas por card, cada uma
    uma palavra-chave. O cliente reprovou o formato — "tem cara de
    inteligência artificial" — e a causa não é o raio da borda, é a
    etiqueta não dizer nada além do nome do assunto. Aqui cada assunto é
    uma linha com o nome em cima e o serviço embaixo, separada por filete.

    O filete à esquerda, e não borda em volta: é o que ainda agrupa as
    linhas sem redesenhar uma caixa por item.
  */
  .assuntos {
    display: grid;
    gap: 0;
    margin: clamp(20px, 2.4vw, 28px) 0 0;
    padding: 0;
    list-style: none;
  }
  .assuntos li {
    display: grid;
    gap: 3px;
    padding: 13px 0 13px 16px;
    border-inline-start: 2px solid;
  }
  .assuntos b {
    font-weight: 500;
    font-size: 16.5px;
    line-height: 1.35;
  }
  .assuntos span {
    font-size: 15.5px;
    line-height: 1.45;
  }
  .bloco.t0 .assuntos li {
    border-color: rgba(11, 30, 63, 0.14);
  }
  .bloco.t0 .assuntos b {
    color: var(--tinta);
  }
  .bloco.t0 .assuntos span {
    color: var(--secundario);
  }
  .bloco.t1 .assuntos li {
    border-color: rgba(255, 255, 255, 0.2);
  }
  .bloco.t1 .assuntos b {
    color: #fff;
  }
  .bloco.t1 .assuntos span {
    color: rgba(255, 255, 255, 0.68);
  }
  .mais {
    margin-top: 12px;
    font-size: 15px;
  }
  .bloco.t0 .mais {
    color: var(--secundario);
  }
  .bloco.t1 .mais {
    color: rgba(255, 255, 255, 0.58);
  }

  /* O filete acende na linha sob o cursor: a cor de ação do site, aplicada
     no menor componente possível. */
  .bloco:hover .assuntos li:hover {
    border-color: var(--imperial);
  }
  .bloco.t1:hover .assuntos li:hover {
    border-color: #e0616f;
  }

  /* A ação fica no pé do bloco, empurrada pelo `margin-top:auto` — é o que
     mantém a base alinhada mesmo com os blocos tendo alturas diferentes. */
  .leva {
    margin-top: auto;
    padding-top: 26px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    min-height: 44px;
  }
  .leva .seta {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: transform 0.35s, background-color 0.35s;
  }
  /* A seta é vermelho imperial nas duas superfícies: é a cor de ação do
     site, e o disco quase transparente que estava aqui não era cor
     nenhuma. Sobre o card claro ela se sustenta sozinha; sobre o escuro
     ganha um anel de 1px para não se fundir ao fundo. */
  .bloco .leva .seta {
    background: var(--imperial);
    color: #fff;
  }
  .bloco.t1 .leva .seta {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.28);
  }
  .bloco:hover .leva .seta {
    transform: translateX(4px);
  }

  /* Área ainda não definida: bloco baixo, sem link, sem promessa. Continua
     aparecendo — o teto de quatro áreas é decisão registrada —, mas sem
     fingir que tem conteúdo. */
  .bloco.vago {
    min-height: 0;
    background: transparent;
    border: 1px dashed rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.5);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: clamp(20px, 2vw, 28px);
  }
  .bloco.vago h3 {
    font-size: clamp(21px, 2vw, 27px);
    color: rgba(255, 255, 255, 0.5);
  }
  .pendente {
    font-size: 15px;
    color: #fff;
    background: var(--imperial);
    padding: 7px 14px;
    border-radius: 999px;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .mosaico {
      grid-template-columns: 1fr;
    }
    .bloco {
      min-height: 0;
    }
    .bloco.vago {
      flex-direction: row;
    }
  }

  /*
    ── A ilustração em movimento no hover ──────────────────────────────

    Pedido do cliente: passar o mouse e a ilustração "começar a rodar".
    Rodar o SVG inteiro foi o primeiro impulso e está errado para estes
    dois desenhos: `sucessao` é uma árvore de partilha com texto implícito
    de cima para baixo, e girada de lado ela deixa de ser uma herança que
    desce. O que gira é o que no desenho tem eixo.

    Por isso o movimento é por peça, e cada marca ganha o movimento do seu
    próprio mecanismo:
      - `rede`  — o anel e as diagonais giram em torno do centro, que é o
        que a figura já é: nós ligados por um eixo. Giro contínuo.
      - `sucessao` — não gira: pulsa no nó vermelho e as três caixas da
        partilha sobem em cascata, que é a direção que o desenho conta.

    `transform-box: fill-box` + `transform-origin: center` é o que faz o
    giro acontecer em torno do centro da própria peça: sem eles o SVG usa
    a origem do viewport do elemento e a peça sai de órbita.
  */
  .bloco :global(.icone circle),
  .bloco :global(.icone path),
  .bloco :global(.icone rect) {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* rede: o anel externo e o feixe de diagonais, em sentidos opostos.
     Os seletores são presos a `.marca-rede` / `.marca-sucessao`, não à
     posição da tag: as duas marcas usam as mesmas tags, e `> path` sem
     escopo giraria também a barra da partilha de `sucessao`. */
  .bloco:hover :global(.marca-rede circle:first-of-type) {
    animation: gira 9s linear infinite;
  }
  .bloco:hover :global(.marca-rede path) {
    animation: gira 9s linear infinite reverse;
  }
  /* rede: o miolo vermelho respira. */
  .bloco:hover :global(.marca-rede circle:last-of-type) {
    animation: pulsa 2.4s ease-in-out infinite;
  }

  /* sucessao: não gira — é uma herança que desce, e de lado deixa de ser
     isso. O nó vermelho pulsa e as três caixas da partilha sobem em
     cascata, na direção que o desenho já conta. */
  .bloco:hover :global(.marca-sucessao circle) {
    animation: pulsa 2.4s ease-in-out infinite;
  }
  .bloco:hover :global(.marca-sucessao rect:nth-of-type(2)) {
    animation: acena 2.2s ease-in-out infinite;
  }
  .bloco:hover :global(.marca-sucessao rect:nth-of-type(3)) {
    animation: acena 2.2s ease-in-out infinite 0.18s;
  }
  .bloco:hover :global(.marca-sucessao rect:nth-of-type(4)) {
    animation: acena 2.2s ease-in-out infinite 0.36s;
  }

  @keyframes gira {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes pulsa {
    50% {
      transform: scale(1.22);
    }
  }
  @keyframes acena {
    50% {
      transform: translateY(-7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .areas,
    .areas * {
      transition: none !important;
      animation: none !important;
      transform: none !important;
    }
  }
</style>
