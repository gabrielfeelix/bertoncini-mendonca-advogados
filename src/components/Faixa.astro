---
/**
 * Faixa de vídeo (`.corte` no protótipo): tarja diagonal com vídeo de
 * fundo e uma frase. Migrado do protótipo (CSS linhas 252-265, HTML
 * linhas 630-639).
 *
 * O `<video>` usa `data-src` em vez de `src`, exatamente como o protótipo:
 * a Tarefa 5 só troca para `src` quando a faixa entra na tela, para não
 * baixar o vídeo de quem nunca rola até aqui. Sem JS o vídeo nunca
 * carrega e a faixa fica só com a chapa azul escura e a lavagem, o que
 * mantém o texto branco perfeitamente legível: nenhuma informação está no
 * vídeo.
 */
interface Props {
  /** Vídeo de fundo, carregado pela Tarefa 5 (`data-src`). */
  video?: string;
  /** Frase principal. */
  titulo?: string;
  /** Parágrafo de apoio. */
  apoio?: string;
  /** Legenda do canto inferior esquerdo. */
  cantoEsquerdo?: string;
  /** Legenda do canto inferior direito. */
  cantoDireito?: string;
}

const {
  video = '/media/faixa.mp4',
  titulo = 'Quem atende na primeira conversa é quem assina a petição.',
  apoio = 'Não existe camada intermediária entre você e o seu processo. São dois sócios, e o contato é direto com eles, do começo ao fim.',
  cantoEsquerdo = 'Bertoncini & Mendonça',
  cantoDireito = 'Maringá, Paraná',
}: Props = Astro.props;
---

<section class="corte">
  <video class="filme" data-src={video} autoplay muted loop playsinline preload="none"></video>
  <div class="lavagem"></div>
  <div class="env">
    <h2 class="display sobe">{titulo}</h2>
    <p class="apoio sobe">{apoio}</p>
  </div>
  <div class="cantos"><span>{cantoEsquerdo}</span><span>{cantoDireito}</span></div>
</section>

<style>
  /*
    A faixa virou PLACA: cantos arredondados e margem lateral, em vez do
    corte diagonal (`clip-path`) que ela tinha.

    O corte diagonal brigava com a forma que o site passou a usar desde a
    primeira dobra — a placa arredondada do Neural Atlas. Duas linguagens
    de forma na mesma página é o que fazia as seções parecerem coladas de
    lugares diferentes.
  */
  .corte {
    position: relative;
    overflow: hidden;
    background: #0b1e3f;
    color: #fff;
    border-radius: clamp(16px, 2vw, 28px);
    margin-inline: var(--gutter);
    max-width: 1500px;
    margin-block: clamp(20px, 3vw, 40px);
  }
  @media (min-width: 1645px) {
    /* Acima da largura da coluna, centraliza como `.env` faz. */
    .corte {
      margin-inline: auto;
    }
  }
  .corte .filme {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.2) brightness(0.62);
  }
  .corte .lavagem {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(11, 30, 63, 0.86), rgba(11, 30, 63, 0.32));
  }
  .corte :global(.env) {
    position: relative;
    z-index: 3;
    padding-block: var(--bloco);
  }
  .corte h2 {
    font-size: clamp(32px, 5.4vw, 72px);
    max-width: 16ch;
  }
  .corte .apoio {
    margin-top: 24px;
    color: rgba(255, 255, 255, 0.74);
    max-width: 42ch;
    font-size: 17.5px;
  }
  .corte .cantos {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(20px, 2.4vw, 30px);
    display: flex;
    justify-content: space-between;
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
  }
  @media (max-width: 760px) {
    .corte .cantos {
      display: none;
    }
  }

  /* prefers-reduced-motion desliga todo movimento desta seção. A Tarefa 5
     traz o kill-switch global do protótipo; este bloco garante que o
     componente já cumpra a regra sozinho, em qualquer página. */
  @media (prefers-reduced-motion: reduce) {
    .corte,
    .corte * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
