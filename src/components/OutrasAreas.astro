---
/**
 * "Também atuamos em" clicável. Cada área pequena abre um painel lateral
 * (um <dialog> que desliza da direita) com foto, descrição curta, a área
 * grande a que pertence e o botão "Falar sobre …", que leva ao contato
 * com o assunto já escolhido (?assunto=<chave>).
 *
 * Sem JavaScript, cada item é um link direto para esse contato.
 * Os textos vêm de src/lib/outras-areas.ts (provisórios, para os sócios
 * aprovarem).
 *
 * `variante`: 'cartoes' (grade de cards iguais com ícone, na seção
 * TambemAtuamos da home e de /areas/) ou 'lista' (lista da barra lateral
 * da página de área).
 * `prefixo` separa os ids quando há mais de uma instância na página.
 */
import { outrasAreas } from '../lib/outras-areas';
import { areasDoIdioma } from '../lib/areas';
import { rota, type Idioma } from '../lib/i18n';

interface Props {
  lang?: Idioma;
  variante?: 'cartoes' | 'lista';
  prefixo?: string;
}
const { lang = 'pt', variante = 'cartoes', prefixo = 'oa' } = Astro.props;

/* Ícones de linha de cada área (24×24, traço), no mesmo desenho dos ícones
   do resto do site. Chave = `chave` em lib/outras-areas. */
const ICONES: Record<string, string> = {
  contratos: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6"/>',
  societario: '<circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M21 20c0-2.6-1.6-4.9-4-5.7"/>',
  imobiliario: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-5.5h4V20"/>',
  'assessoria-empresarial': '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/>',
  compliance: '<path d="M12 3 4.5 6v6c0 4.5 3.2 7.8 7.5 9 4.3-1.2 7.5-4.5 7.5-9V6z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>',
  civil: '<path d="M12 4v16M7 20h10M5 7h14"/><path d="m5 7-3 6a3 3 0 0 0 6 0zM19 7l-3 6a3 3 0 0 0 6 0z"/>',
};
const lista = outrasAreas(lang);
const grandes = await areasDoIdioma(lang);
const contato = rota(lang, '/contato/');
const T = lang === 'en'
  ? { rotulo: 'We also practice', parte: 'Part of', falar: 'Talk to us about', fechar: 'Close', abrir: 'Learn more about', duvidas: 'Quick questions' }
  : { rotulo: 'Também atuamos em', parte: 'Faz parte de', falar: 'Falar sobre', fechar: 'Fechar', abrir: 'Saiba mais sobre', duvidas: 'Dúvidas rápidas' };
const nomeMinusculo = (n: string) => (lang === 'en' ? n.toLowerCase() : n.charAt(0).toLowerCase() + n.slice(1));
---

<ul class:list={['oa', `oa-${variante}`]}>
  {lista.map((a) => (
    <li>
      <a
        href={`${contato}?assunto=${a.chave}`}
        data-oa-abrir={`${prefixo}-${a.chave}`}
        aria-haspopup="dialog"
        aria-label={`${T.abrir} ${a.nome}`}
      >
        {variante === 'cartoes' && ICONES[a.chave] && (
          <svg class="oa-icone" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONES[a.chave]} />
        )}
        <span class="oa-nome">{a.nome}</span>
      </a>
    </li>
  ))}
</ul>

{lista.map((a) => {
  const ligadas = grandes.filter((g) => a.ligada.includes(g.slugPt));
  return (
    <dialog class="oa-painel" id={`${prefixo}-${a.chave}`} aria-labelledby={`${prefixo}-${a.chave}-titulo`}>
      <div class="oa-foto">
        <img src={a.foto} alt="" width="1600" height="900" loading="lazy" />
        <button type="button" class="oa-fechar" data-oa-fechar aria-label={T.fechar}>×</button>
      </div>
      <div class="oa-corpo">
        <p class="rotulo">{T.rotulo}</p>
        <h2 id={`${prefixo}-${a.chave}-titulo`}>{a.nome}</h2>
        <p class="oa-texto">{a.texto}</p>
        {ligadas.length > 0 && (
          <p class="oa-ligada">
            {T.parte}{' '}
            {ligadas.map((g, i) => (
              <>{i > 0 && (lang === 'en' ? ' and ' : ' e ')}<a href={g.href}>{g.data.nome}</a></>
            ))}
          </p>
        )}
        {a.perguntas.length > 0 && (
          <div class="oa-faq">
            <p class="oa-faq-rotulo">{T.duvidas}</p>
            {a.perguntas.map((q) => (
              <details>
                <summary>{q.pergunta}</summary>
                <p>{q.resposta}</p>
              </details>
            ))}
          </div>
        )}
        <a class="botao" href={`${contato}?assunto=${a.chave}`}>{T.falar} {nomeMinusculo(a.nome)}</a>
      </div>
    </dialog>
  );
})}

<script>
  /* Abre o painel no clique; sem JS o link leva ao contato. Fecha no X, no
     Esc e no clique fora do cartão (no fundo), deslizando de volta antes de
     fechar. A página atrás não rola enquanto ele está aberto. */
  const calmo = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  function abrir(painel: HTMLDialogElement) {
    painel.classList.remove('fechando');
    painel.showModal();
    document.documentElement.style.overflow = 'hidden';
  }

  function fechar(painel: HTMLDialogElement) {
    if (!painel.open || painel.classList.contains('fechando')) return;
    if (calmo()) return painel.close();
    painel.classList.add('fechando');
    const fim = (e: AnimationEvent) => {
      if (e.target !== painel) return;
      painel.removeEventListener('animationend', fim);
      painel.classList.remove('fechando');
      painel.close();
    };
    painel.addEventListener('animationend', fim);
  }

  for (const gatilho of document.querySelectorAll<HTMLAnchorElement>('[data-oa-abrir]')) {
    const painel = document.getElementById(gatilho.dataset.oaAbrir ?? '') as HTMLDialogElement | null;
    if (!painel || typeof painel.showModal !== 'function') continue;
    gatilho.addEventListener('click', (e) => {
      e.preventDefault();
      abrir(painel);
    });
  }
  for (const painel of document.querySelectorAll<HTMLDialogElement>('.oa-painel')) {
    painel.querySelector('[data-oa-fechar]')?.addEventListener('click', () => fechar(painel));
    painel.addEventListener('click', (e) => {
      if (e.target === painel) fechar(painel);
    });
    /* Esc: o <dialog> fecharia na hora; segura e fecha com a animação. */
    painel.addEventListener('cancel', (e) => {
      e.preventDefault();
      fechar(painel);
    });
    painel.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });
  }
</script>

<style>
  .oa { list-style: none; margin: 0; padding: 0; }
  .oa a { text-decoration: none; cursor: pointer; }

  /* Cartões (seção TambemAtuamos): iguais, ícone no alto e nome embaixo, à
     esquerda, como os cards de áreas do Mattos Filho. No hover o card vira
     azul-noite e o texto creme. */
  .oa-cartoes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  /* Cores por variável: a seção que monta os cards (TambemAtuamos) troca
     para a versão sobre azul-noite. */
  .oa-cartoes a {
    display: flex; flex-direction: column; justify-content: space-between; gap: 28px;
    height: 100%; min-height: 188px; padding: 24px 24px 22px;
    background: var(--oa-fundo, #fff); border-radius: 10px; color: var(--oa-texto, var(--azul));
    border: 1px solid var(--oa-borda, transparent);
    box-shadow: 0 1px 2px rgba(11, 30, 63, .06);
    transition: background-color .25s ease, color .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  .oa-icone {
    width: 34px; height: 34px; fill: none; stroke: var(--oa-icone, var(--azul-medio));
    stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round;
    transition: stroke .25s ease;
  }
  .oa-cartoes .oa-nome { font-size: 19px; font-weight: 500; line-height: 1.3; }
  .oa-cartoes a:hover, .oa-cartoes a:focus-visible {
    background: var(--oa-fundo-hover, var(--azul)); color: var(--oa-texto-hover, #f8f7f2);
    transform: translateY(-3px); box-shadow: 0 18px 36px rgba(11, 30, 63, .18);
  }
  .oa-cartoes a:hover .oa-icone, .oa-cartoes a:focus-visible .oa-icone { stroke: var(--oa-icone-hover, #f8f7f2); }

  /* Lista (barra lateral): herda as setinhas de .widget ul */
  .oa-lista a { display: block; padding: 9px 0; color: var(--texto); }
  .oa-lista a:hover { color: var(--azul-medio); }

  /* ---------- Painel lateral ---------- */
  .oa-painel {
    position: fixed; inset: 0 0 0 auto; margin: 0;
    width: min(560px, 100vw); height: 100dvh; max-height: 100dvh; max-width: 100vw;
    padding: 0; border: 0; background: #fff; color: var(--texto);
    box-shadow: -20px 0 50px rgba(11, 30, 63, .25);
    overflow-y: auto;
  }
  /* Entra deslizando da direita, com desaceleração longa (curva "expo"); o
     fundo escurece e desfoca junto. Ao fechar, o caminho inverso, mais curto. */
  .oa-painel[open] { animation: oa-entra .65s cubic-bezier(.22, 1, .36, 1); }
  .oa-painel::backdrop {
    background: rgba(11, 30, 63, .5);
    -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
  }
  .oa-painel[open]::backdrop { animation: oa-fundo .5s ease; }
  .oa-painel.fechando { animation: oa-sai .22s cubic-bezier(.4, 0, 1, 1) forwards; }
  .oa-painel.fechando::backdrop { animation: oa-fundo-sai .22s ease forwards; }
  @keyframes oa-entra { from { transform: translateX(100%); } to { transform: none; } }
  @keyframes oa-sai { to { transform: translateX(100%); } }
  @keyframes oa-fundo { from { background: rgba(11, 30, 63, 0); -webkit-backdrop-filter: blur(0); backdrop-filter: blur(0); } }
  @keyframes oa-fundo-sai { to { background: rgba(11, 30, 63, 0); -webkit-backdrop-filter: blur(0); backdrop-filter: blur(0); } }
  /* Dentro: a foto assenta com um zoom sutil e o texto sobe em sequência. */
  .oa-painel[open] .oa-foto img { animation: oa-foto 1.1s cubic-bezier(.22, 1, .36, 1); }
  .oa-painel[open] .oa-corpo > * { animation: oa-sobe .7s cubic-bezier(.22, 1, .36, 1) both; }
  .oa-painel[open] .oa-corpo > :nth-child(1) { animation-delay: .18s; }
  .oa-painel[open] .oa-corpo > :nth-child(2) { animation-delay: .24s; }
  .oa-painel[open] .oa-corpo > :nth-child(3) { animation-delay: .30s; }
  .oa-painel[open] .oa-corpo > :nth-child(4) { animation-delay: .36s; }
  .oa-painel[open] .oa-corpo > :nth-child(5) { animation-delay: .42s; }
  .oa-painel[open] .oa-corpo > :nth-child(6) { animation-delay: .48s; }
  @keyframes oa-foto { from { transform: scale(1.08); } to { transform: none; } }
  @keyframes oa-sobe { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .oa-foto { position: relative; }
  .oa-foto img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
  .oa-fechar {
    position: absolute; top: 14px; right: 14px;
    width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(255, 255, 255, .92); color: var(--azul); font-size: 24px; line-height: 1;
  }
  .oa-fechar:hover { background: #fff; }
  .oa-foto { overflow: hidden; }
  .oa-corpo { padding: 36px 44px 44px; }
  .oa-corpo h2 { font-size: 32px; margin-bottom: 14px; }
  .oa-texto { font-size: 17px; line-height: 1.65; }
  .oa-ligada { font-size: 15px; color: var(--texto-suave); margin-bottom: 24px; }
  .oa-ligada a { color: var(--azul-medio); font-weight: 500; }

  /* FAQ rápido: acordeão com filete e "+" que vira "−". */
  .oa-faq { margin: 0 0 28px; border-top: 1px solid var(--linha); }
  .oa-faq-rotulo { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--azul-claro); margin: 20px 0 6px; }
  .oa-faq details { border-bottom: 1px solid var(--linha); }
  .oa-faq summary {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
    padding: 14px 0; cursor: pointer; list-style: none;
    font-size: 16px; font-weight: 500; line-height: 1.4; color: var(--azul);
  }
  .oa-faq summary::-webkit-details-marker { display: none; }
  .oa-faq summary::after {
    content: ''; flex: none; width: 12px; height: 12px; margin-top: 5px;
    background:
      linear-gradient(var(--azul-medio), var(--azul-medio)) center / 12px 1.5px no-repeat,
      linear-gradient(var(--azul-medio), var(--azul-medio)) center / 1.5px 12px no-repeat;
    transition: background-size .25s ease;
  }
  .oa-faq details[open] summary::after { background-size: 12px 1.5px, 1.5px 0; }
  .oa-faq summary:hover { color: var(--azul-medio); }
  .oa-faq details p { margin: -4px 0 16px; font-size: 15.5px; line-height: 1.65; color: var(--texto-suave); }
  .oa-faq details[open] p { animation: oa-sobe .35s ease both; }

  @media (prefers-reduced-motion: reduce) {
    .oa-painel[open], .oa-painel[open]::backdrop, .oa-painel.fechando, .oa-painel.fechando::backdrop,
    .oa-painel[open] .oa-foto img, .oa-painel[open] .oa-corpo > * { animation: none; }
    .oa-cartoes a, .oa-icone { transition: none; }
    .oa-cartoes a:hover, .oa-cartoes a:focus-visible { transform: none; }
  }
  @media (max-width: 991px) { .oa-cartoes { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 680px) {
    .oa-cartoes { gap: 12px; }
    .oa-cartoes a { min-height: 150px; padding: 18px; gap: 20px; }
    .oa-cartoes .oa-nome { font-size: 17px; }
    .oa-corpo { padding: 24px 20px 32px; }
  }
</style>
