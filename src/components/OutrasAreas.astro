---
/**
 * "Também atuamos em" clicável. Cada área pequena abre um painel lateral
 * (um <dialog> que desliza da direita) com foto, descrição curta, a área
 * grande a que pertence e o botão "Falar sobre …", que leva ao contato
 * com o assunto já escolhido (?assunto=<chave>).
 *
 * Sem JavaScript, cada item é um link direto para esse contato.
 * Os textos vêm de src/lib/outras-areas.ts (provisórios, para os sócios
 * aprovarem).
 *
 * `variante`: 'etiquetas' (linha de etiquetas, na home), 'grade' (três
 * colunas com setinha, em /areas/) ou 'lista' (lista da barra lateral).
 * `prefixo` separa os ids quando há mais de uma instância na página.
 */
import { outrasAreas } from '../lib/outras-areas';
import { areasDoIdioma } from '../lib/areas';
import { t, rota, type Idioma } from '../lib/i18n';

interface Props {
  lang?: Idioma;
  variante?: 'etiquetas' | 'grade' | 'lista';
  prefixo?: string;
}
const { lang = 'pt', variante = 'etiquetas', prefixo = 'oa' } = Astro.props;
const lista = outrasAreas(lang);
const grandes = await areasDoIdioma(lang);
const contato = rota(lang, '/contato/');
const T = lang === 'en'
  ? { rotulo: 'We also practice', parte: 'Part of', falar: 'Talk to us about', fechar: 'Close', abrir: 'Learn more about' }
  : { rotulo: 'Também atuamos em', parte: 'Faz parte de', falar: 'Falar sobre', fechar: 'Fechar', abrir: 'Saiba mais sobre' };
const nomeMinusculo = (n: string) => (lang === 'en' ? n.toLowerCase() : n.charAt(0).toLowerCase() + n.slice(1));
---

<ul class:list={['oa', `oa-${variante}`]}>
  {lista.map((a) => (
    <li>
      <a
        href={`${contato}?assunto=${a.chave}`}
        data-oa-abrir={`${prefixo}-${a.chave}`}
        aria-haspopup="dialog"
        aria-label={`${T.abrir} ${a.nome}`}
      >
        {a.nome}
      </a>
    </li>
  ))}
</ul>

{lista.map((a) => {
  const ligadas = grandes.filter((g) => a.ligada.includes(g.slugPt));
  return (
    <dialog class="oa-painel" id={`${prefixo}-${a.chave}`} aria-labelledby={`${prefixo}-${a.chave}-titulo`}>
      <div class="oa-foto">
        <img src={a.foto} alt="" width="1600" height="900" loading="lazy" />
        <button type="button" class="oa-fechar" data-oa-fechar aria-label={T.fechar}>×</button>
      </div>
      <div class="oa-corpo">
        <p class="rotulo">{T.rotulo}</p>
        <h2 id={`${prefixo}-${a.chave}-titulo`}>{a.nome}</h2>
        <p class="oa-texto">{a.texto}</p>
        {ligadas.length > 0 && (
          <p class="oa-ligada">
            {T.parte}{' '}
            {ligadas.map((g, i) => (
              <>{i > 0 && (lang === 'en' ? ' and ' : ' e ')}<a href={g.href}>{g.data.nome}</a></>
            ))}
          </p>
        )}
        <a class="botao" href={`${contato}?assunto=${a.chave}`}>{T.falar} {nomeMinusculo(a.nome)}</a>
      </div>
    </dialog>
  );
})}

<script>
  /* Abre o painel no clique; sem JS o link leva ao contato. Fecha no X, no
     Esc (nativo do <dialog>) e no clique fora do cartão (no fundo). */
  for (const gatilho of document.querySelectorAll<HTMLAnchorElement>('[data-oa-abrir]')) {
    const painel = document.getElementById(gatilho.dataset.oaAbrir ?? '') as HTMLDialogElement | null;
    if (!painel || typeof painel.showModal !== 'function') continue;
    gatilho.addEventListener('click', (e) => {
      e.preventDefault();
      painel.showModal();
    });
  }
  for (const painel of document.querySelectorAll<HTMLDialogElement>('.oa-painel')) {
    painel.querySelector('[data-oa-fechar]')?.addEventListener('click', () => painel.close());
    painel.addEventListener('click', (e) => {
      if (e.target === painel) painel.close();
    });
  }
</script>

<style>
  .oa { list-style: none; margin: 0; padding: 0; }
  .oa a { text-decoration: none; cursor: pointer; }

  /* Etiquetas (home) */
  .oa-etiquetas { display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .oa-etiquetas a {
    display: inline-flex; align-items: center; gap: 8px;
    background: #fff; border: 1px solid var(--linha); border-radius: 6px;
    padding: 6px 12px; font-size: 15px; color: var(--azul);
    transition: border-color .15s ease, color .15s ease;
  }
  .oa-etiquetas a::after {
    content: ''; width: 6px; height: 6px;
    border-top: 1.6px solid var(--azul-claro); border-right: 1.6px solid var(--azul-claro);
    transform: rotate(45deg);
  }
  .oa-etiquetas a:hover { border-color: var(--azul-claro); color: var(--azul-medio); }

  /* Grade (página de áreas) */
  .oa-grade { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 32px; }
  .oa-grade a {
    position: relative; display: block; padding: 16px 0 16px 22px;
    border-bottom: 1px solid var(--linha); color: var(--azul); font-size: 16px;
  }
  .oa-grade a::before {
    content: ''; position: absolute; left: 2px; top: 29px; width: 7px; height: 7px; margin-top: -4px;
    border-top: 2px solid var(--azul-claro); border-right: 2px solid var(--azul-claro);
    transform: rotate(45deg); transition: transform .15s ease;
  }
  .oa-grade a:hover { color: var(--azul-medio); }
  .oa-grade a:hover::before { transform: translateX(3px) rotate(45deg); }

  /* Lista (barra lateral): herda as setinhas de .widget ul */
  .oa-lista a { display: block; padding: 9px 0; color: var(--texto); }
  .oa-lista a:hover { color: var(--azul-medio); }

  /* ---------- Painel lateral ---------- */
  .oa-painel {
    position: fixed; inset: 0 0 0 auto; margin: 0;
    width: min(440px, 100vw); height: 100dvh; max-height: 100dvh; max-width: 100vw;
    padding: 0; border: 0; background: #fff; color: var(--texto);
    box-shadow: -20px 0 50px rgba(11, 30, 63, .25);
    overflow-y: auto;
  }
  .oa-painel[open] { animation: oa-entra .25s ease; }
  .oa-painel::backdrop { background: rgba(11, 30, 63, .45); }
  @keyframes oa-entra { from { transform: translateX(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  .oa-foto { position: relative; }
  .oa-foto img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
  .oa-fechar {
    position: absolute; top: 14px; right: 14px;
    width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(255, 255, 255, .92); color: var(--azul); font-size: 24px; line-height: 1;
  }
  .oa-fechar:hover { background: #fff; }
  .oa-corpo { padding: 28px 30px 36px; }
  .oa-corpo h2 { font-size: 28px; margin-bottom: 12px; }
  .oa-texto { font-size: 17px; line-height: 1.65; }
  .oa-ligada { font-size: 15px; color: var(--texto-suave); margin-bottom: 24px; }
  .oa-ligada a { color: var(--azul-medio); font-weight: 500; }

  @media (prefers-reduced-motion: reduce) {
    .oa-painel[open] { animation: none; }
    .oa-grade a::before, .oa-etiquetas a { transition: none; }
  }
  @media (max-width: 991px) { .oa-grade { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 680px) {
    .oa-grade { grid-template-columns: 1fr; }
    .oa-corpo { padding: 24px 20px 32px; }
  }
</style>
