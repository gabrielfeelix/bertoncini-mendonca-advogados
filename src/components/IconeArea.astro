---
/**
 * Ícone de linha de cada área, no lugar dos ícones de cartão do tema.
 * Desenhado à mão em SVG para não depender de biblioteca de ícones.
 */
interface Props {
  slug: string;
  class?: string;
}
const { slug, class: classe = 'icone-area' } = Astro.props;
---

{slug === 'planejamento-patrimonial-e-sucessorio' ? (
  <svg class={classe} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M6 22 24 8l18 14" />
    <path d="M11 19v21h26V19" />
    <circle cx="20" cy="27" r="3.2" />
    <circle cx="29" cy="27" r="3.2" />
    <path d="M15 40v-3a5 5 0 0 1 10 0v3M24 40v-3a5 5 0 0 1 10 0v3" />
  </svg>
) : slug === 'direito-digital' ? (
  <svg class={classe} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="5" y="9" width="38" height="25" rx="2.5" />
    <path d="M17 40h14M24 34v6" />
    <path d="M24 15.5 30 18v4.5c0 3.6-2.5 6-6 7-3.5-1-6-3.4-6-7V18z" />
  </svg>
) : (
  <svg class={classe} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M24 6v36M12 42h24M8 14h32" />
    <path d="M8 14 3 26a5 5 0 0 0 10 0zM40 14l-5 12a5 5 0 0 0 10 0z" />
  </svg>
)}
