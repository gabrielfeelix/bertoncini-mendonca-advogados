---
/**
 * Rodapé da v3: faixa azul chapada em quatro colunas (marca, institucional,
 * áreas, contato) e barra inferior com registro da sociedade e políticas.
 * O registro (OAB da sociedade, CNPJ) é exigência do Provimento 205/2021.
 */
import { site } from '../lib/site';
import { areasDoIdioma } from '../lib/areas';
import { t, rota, type Idioma } from '../lib/i18n';
import Icone from './Icone.astro';

interface Props {
  lang?: Idioma;
}
const { lang = 'pt' } = Astro.props;
const tx = t(lang);
const areas = await areasDoIdioma(lang);
const ano = new Date().getFullYear();
/* A página pode pôr conteúdo no topo do rodapé (a newsletter da home). */
const temTopo = Astro.slots.has('default');
/* "Golpe do falso advogado: só falamos…" vira título + texto. */
const [golpeTitulo, golpeTexto = ''] = tx.rodape.golpe.includes(': ')
  ? tx.rodape.golpe.split(/: (.*)/s)
  : [tx.rodape.golpe, ''];
const golpeFrase = golpeTexto.charAt(0).toUpperCase() + golpeTexto.slice(1);
---

<footer class="rodape">
  {/* Fundo: brilho petróleo no alto e o monograma do logo, grande, ocupando
      a altura toda do rodapé (com a newsletter, quando houver). */}
  <span class="rodape-arte" aria-hidden="true"></span>
  <slot />
  <div class:list={['container colunas', { 'com-topo': temTopo }]}>
    <div>
      <picture>
        <source media="(min-resolution: 2dppx)" srcset="/media/marca/lockup-creme.svg" />
        <img class="rodape-logo" src="/media/marca/lockup-creme-tela.svg" alt={site.nome} width="550" height="196" />
      </picture>
      <p>{tx.atendimento} {tx.presencialEm} {site.cidade}/{site.estado}.</p>
      <ul class="redes" aria-label={tx.rodape.redesAria}>
        <li><a href={site.redes.instagram.valor} rel="noopener" target="_blank" aria-label={`Instagram ${site.redes.instagramArroba}`}><Icone nome="instagram" tamanho={20} /></a></li>
        <li><a href={site.whatsapp.valor} rel="noopener" target="_blank" aria-label={`WhatsApp ${site.telefone.valor}`}><Icone nome="whatsapp" tamanho={20} /></a></li>
        <li><a href={`mailto:${site.email.valor}`} aria-label={`E-mail ${site.email.valor}`}><Icone nome="email" tamanho={20} /></a></li>
      </ul>
    </div>

    <div>
      <h2>{tx.rodape.institucional}</h2>
      <ul>
        <li><a href={rota(lang, '/')}>{tx.rodape.inicio}</a></li>
        {tx.rodape.links.map((item) => <li><a href={rota(lang, item.chave)}>{item.rotulo}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>{tx.rodape.areas}</h2>
      <ul>
        {areas.map((area) => <li><a href={area.href}>{area.data.nome}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>{tx.rodape.contato}</h2>
      <ul class="contato">
        <li><a class="com-icone" href={site.whatsapp.valor} rel="noopener" target="_blank"><Icone nome="whatsapp" /><span>WhatsApp {site.telefone.valor}</span></a></li>
        <li><a class="com-icone" href={`mailto:${site.email.valor}`}><Icone nome="email" /><span>{site.email.valor}</span></a></li>
        <li>{tx.horario}</li>
        <li>{site.cidade}/{site.estado}</li>
      </ul>
    </div>
  </div>

  {/* Faixa final, em dois níveis (07/11/2026): a linha principal (sociedade
      e registro | políticas | assinatura) e, abaixo de um filete, os dois
      avisos lado a lado, cada um com título curto. */}
  <div class="barra">
    <div class="container barra-linha">
      <div class="legal">
        <p class="legal-nome">© {ano} {site.nomeSociedade}</p>
        <p class="legal-dados">{tx.rodape.inscrita} {site.registro.oabSociedade.valor} · CNPJ {site.registro.cnpj.valor}</p>
      </div>
      <p class="politicas">
        {tx.rodape.politicas.map((item) => <a href={rota(lang, item.chave)}>{item.rotulo}</a>)}
        <button type="button" class="link-cookies" data-abrir-cookies>{tx.rodape.preferencias}</button>
      </p>
      {/* Assinatura de quem fez o site: "Gabriel Felix" em Dancing Script
          (OFL, hospedada aqui só com as letras usadas) e um aviãozinho de
          papel vermelho com o caminho tracejado dando a volta no nome. O
          caminho se desenha quando aparece na tela; no hover o avião voa. */}
      <a class="credito" href="https://gabrielfelix-ux.4yu.com.br/" target="_blank" rel="noopener" data-credito>
          <span class="credito-feito">{lang === 'en' ? 'made by' : 'feito por'}</span>
          <span class="credito-nome">
            Gabriel Felix
            <svg class="credito-voo" viewBox="0 0 196 66" aria-hidden="true" focusable="false">
              <defs>
                <mask id="credito-mascara" maskUnits="userSpaceOnUse" x="0" y="0" width="196" height="66">
                  <path class="voo-revela" d="M10 52 C 50 63, 112 63, 140 50 C 164 39, 167 22, 152 22 C 138 22, 141 41, 160 34 C 171 30, 175 21, 179 13" pathLength="1" />
                </mask>
              </defs>
              <path class="voo-caminho" mask="url(#credito-mascara)" d="M10 52 C 50 63, 112 63, 140 50 C 164 39, 167 22, 152 22 C 138 22, 141 41, 160 34 C 171 30, 175 21, 179 13" />
              <g class="voo-aviao" transform="translate(178 13) rotate(-52)">
                <path d="M-6 -6 L 9 0 L -6 6 L -3 0 Z" />
                <path class="voo-dobra" d="M-3 0 L 9 0" />
              </g>
            </svg>
          </span>
          <span class="oculto">{lang === 'en' ? ' (opens his portfolio in a new tab)' : ' (abre o portfólio em nova aba)'}</span>
        </a>
    </div>
    <div class="container barra-avisos">
      <p class="aviso"><strong>{lang === 'en' ? 'Notice' : 'Aviso'}</strong>{tx.aviso}</p>
      {/* Golpe do falso advogado: aviso pedido no briefing (q9.3), discreto,
          com os canais oficiais. Na página de contato ele aparece completo. */}
      <p class="aviso golpe">
        <strong>{golpeTitulo}</strong>
        {golpeFrase} <a href={`tel:${site.telefoneE164.valor}`}>{site.telefone.valor}</a>{' '}
        {tx.rodape.golpeE} <a href={`mailto:${site.email.valor}`}>{site.email.valor}</a>. {tx.rodape.golpeFim}
      </p>
    </div>
  </div>
</footer>

<script>
  /* Desenha o traço da assinatura uma vez, quando ela entra na tela. */
  for (const credito of document.querySelectorAll<HTMLElement>('[data-credito]')) {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    credito.classList.add('espera');
    const olho = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) {
        credito.classList.add('visto');
        olho.disconnect();
      }
    }, { threshold: 0.6 });
    olho.observe(credito);
  }
</script>

<style is:global>
  /* Com o "Também atuamos em" dentro (/areas/): o rodapé ganha a diagonal
     no topo e avança sobre a faixa de cima, que aparece na cunha. Global
     porque o :has() com filho de outro componente não sobrevive ao escopo. */
  footer.rodape:has(> .antes-do-rodape) {
    --corte: 64px;
    margin-top: calc(-1 * var(--corte));
    clip-path: polygon(0 var(--corte), 100% 0, 100% 100%, 0 100%);
  }
  /* Filete entre o "Também atuamos em" e a chamada. */
  footer.rodape > .antes-do-rodape + .chamada { padding-top: 0; }
  footer.rodape > .antes-do-rodape + .chamada > .container { border-top: 1px solid rgba(248, 247, 242, .12); padding-top: 56px; }
  @media (max-width: 991px) { footer.rodape:has(> .antes-do-rodape) { --corte: 40px; } }
  @media (max-width: 680px) { footer.rodape:has(> .antes-do-rodape) { --corte: 28px; } }

  @font-face {
    font-family: 'Assinatura';
    src: url('/fonts/assinatura.woff2') format('woff2');
    font-weight: 600;
    font-display: swap;
  }
</style>

<style>
  .rodape {
    position: relative; overflow: hidden;
    background:
      radial-gradient(900px 520px at 88% 0%, rgba(0, 67, 105, .55), rgba(0, 67, 105, 0) 70%),
      radial-gradient(700px 420px at 0% 100%, rgba(81, 116, 147, .16), rgba(81, 116, 147, 0) 70%),
      var(--azul);
    color: rgba(255,255,255,.8); font-size: 15px;
  }
  .rodape-arte {
    position: absolute; right: -6%; top: 50%; transform: translateY(-50%);
    height: min(125%, 900px); aspect-ratio: 254 / 276; opacity: .05; pointer-events: none;
    background: url('/media/marca/monograma-creme.svg') center / contain no-repeat;
  }
  .rodape > :not(.rodape-arte) { position: relative; z-index: 1; }
  /* Com a newsletter acima, um filete fino separa as duas partes. */
  .colunas.com-topo { border-top: 1px solid rgba(248, 247, 242, .12); }
  .colunas {
    display: grid; grid-template-columns: 1.15fr .8fr 1.15fr 1.45fr; gap: 40px;
    padding-top: 60px; padding-bottom: 48px;
  }
  .rodape-logo { display: block; width: 200px; height: auto; margin-bottom: 18px; }
  .rodape h2 { color: #fff; font-size: 16px; margin-bottom: 16px; }
  .rodape ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .rodape a { color: rgba(255,255,255,.88); text-decoration: none; }
  .rodape a:hover { color: #fff; text-decoration: underline; }
  /* Ícones redondos brancos com o azul da marca dentro. Para incluir
     LinkedIn ou YouTube quando existirem, basta outro <li> igual. */
  .redes { display: flex !important; gap: 12px !important; margin-top: 18px !important; }
  .redes a {
    display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%;
    background: #fff; color: var(--azul); transition: background-color .15s, color .15s;
  }
  .redes a:hover { background: var(--azul-claro); color: #fff; text-decoration: none; }
  /* Ícone sempre colado ao texto; se o endereço não couber, quebra o
     texto, nunca separa o ícone dele. */
  .com-icone { display: inline-flex; align-items: baseline; gap: 8px; }
  .com-icone :global(.icone) { position: relative; top: 2px; }
  .com-icone span { overflow-wrap: anywhere; }

  .barra { background: #071530; font-size: 13px; }
  .barra p { margin: 0; }
  /* Linha principal: registro | políticas | assinatura. */
  .barra-linha {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center; gap: 16px 40px; padding-top: 22px; padding-bottom: 22px;
  }
  .legal-nome { color: rgba(255, 255, 255, .9); font-weight: 500; }
  .legal-dados { color: rgba(255, 255, 255, .55); margin-top: 3px !important; }
  .politicas { display: flex; flex-wrap: wrap; gap: 6px 22px; }
  /* Avisos: duas colunas, título curto em negrito, texto apagado. */
  .barra-avisos {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px 48px;
    padding-top: 16px; padding-bottom: 22px;
    border-top: 1px solid rgba(248, 247, 242, .08);
  }
  .aviso { color: rgba(255, 255, 255, .5); font-size: 12.5px; line-height: 1.6; }
  .aviso strong { display: block; color: rgba(255, 255, 255, .75); font-weight: 500; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 4px; }
  .aviso a { color: rgba(255, 255, 255, .75); }

  /* ---------- Assinatura ---------- */
  .credito {
    display: inline-flex; align-items: baseline; gap: 10px; padding: 14px 28px 14px 0; margin: -14px 0;
    color: rgba(248, 247, 242, .6); text-decoration: none;
    transition: color .25s ease;
  }
  .credito-feito { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
  .credito-nome {
    position: relative; font-family: 'Assinatura', 'Segoe Script', cursive; font-weight: 600;
    font-size: 24px; line-height: 1; color: #f8f7f2;
  }
  .credito-voo { position: absolute; left: -14px; top: -20px; width: 196px; height: 66px; overflow: visible; pointer-events: none; }
  .voo-caminho { fill: none; stroke: #e0574f; stroke-width: 1.3; stroke-linecap: round; stroke-dasharray: 3 4; opacity: .9; }
  .voo-revela { fill: none; stroke: #fff; stroke-width: 4; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .voo-aviao path { fill: #e0574f; }
  .voo-aviao .voo-dobra { fill: none; stroke: #9e2f29; stroke-width: 1; }
  .credito:hover, .credito:focus-visible { color: #f8f7f2; }
  /* Entrada: o caminho se desenha e o avião aparece no fim dele. */
  .credito.espera .voo-revela { stroke-dashoffset: 1; }
  .credito.espera .voo-aviao { opacity: 0; }
  .credito.visto .voo-revela { stroke-dashoffset: 0; transition: stroke-dashoffset 1.3s cubic-bezier(.65, 0, .35, 1) .2s; }
  .credito.visto .voo-aviao { opacity: 1; transition: opacity .3s ease 1.35s; }
  /* Hover: o caminho se refaz e o avião dá um impulso para frente. */
  .credito:hover .voo-revela { animation: voo-revela 1s cubic-bezier(.65, 0, .35, 1); }
  .credito:hover .voo-aviao { animation: voo-aviao 1s cubic-bezier(.65, 0, .35, 1); }
  @keyframes voo-revela { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes voo-aviao {
    0%, 70% { opacity: 0; transform: translate(178px, 13px) rotate(-52deg) translate(-6px, 0); }
    100% { opacity: 1; transform: translate(178px, 13px) rotate(-52deg); }
  }
  .oculto {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .credito:hover .voo-revela, .credito:hover .voo-aviao { animation: none; }
  }
  @media (max-width: 991px) {
    .barra-linha { grid-template-columns: 1fr; }
    .barra-avisos { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .credito { justify-self: center; margin-top: 4px; } }

  @media (max-width: 900px) { .colunas { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    .colunas { grid-template-columns: 1fr; gap: 32px; }
    /* Alvo de toque perto de 40px nos links das listas e das políticas,
       sem mudar o ritmo visual (o respiro vira área clicável). */
    .rodape ul:not(.redes) { gap: 0; }
    .rodape ul:not(.redes) a { display: inline-block; padding: 7px 0; }
    .rodape ul:not(.redes) a.com-icone { display: inline-flex; }
    /* Itens só de texto (horário, cidade) com o mesmo respiro dos links. */
    .rodape ul:not(.redes) > li:not(:has(a)) { padding: 7px 0; }
    .politicas a { display: inline-block; padding: 10px 0; }
    .barra-linha { gap: 14px; }
  }
  .link-cookies {
    background: none; border: 0; padding: 0; cursor: pointer;
    font: inherit; color: rgba(255,255,255,.88); text-decoration: none;
  }
  .link-cookies:hover { color: #fff; text-decoration: underline; }
  .golpe a { color: rgba(255,255,255,.8); text-decoration: underline; }
</style>
