---
/**
 * Rodapé da v3: faixa azul chapada em quatro colunas (marca, institucional,
 * áreas, contato) e barra inferior com registro da sociedade e políticas.
 * O registro (OAB da sociedade, CNPJ) é exigência do Provimento 205/2021.
 */
import { site, rodape } from '../lib/site';
import { listarAreasConfirmadas } from '../lib/areas';

const areas = await listarAreasConfirmadas();
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="container colunas">
    <div>
      <img class="rodape-logo" src="/media/marca/lockup-branco.png" alt={site.nome} width="779" height="298" />
      <p>{site.atendimentoRodape} e presencial em {site.cidade}/{site.estado}.</p>
      <ul class="redes" aria-label="Redes e canais">
        <li>
          <a href={site.redes.instagram.valor} rel="noopener" target="_blank" aria-label={`Instagram ${site.redes.instagramArroba}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1" class="cheio" /></svg>
          </a>
        </li>
        <li>
          <a href={site.whatsapp.valor} rel="noopener" target="_blank" aria-label={`WhatsApp ${site.telefone.valor}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.2-4A8 8 0 1 1 8.4 19z" /><path d="M9 8.6c0 3 2.5 6 5.6 6.4l1.2-1.4-1.9-.9-.8.9c-1-.4-2.1-1.4-2.6-2.6l.9-.8-.8-1.9L9.4 8" /></svg>
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email.valor}`} aria-label={`E-mail ${site.email.valor}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="M4 7l8 6 8-6" /></svg>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2>Institucional</h2>
      <ul>
        <li><a href="/">Início</a></li>
        {rodape.institucional.map((item) => <li><a href={item.href}>{item.rotulo}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>Áreas de atuação</h2>
      <ul>
        {areas.map((area) => <li><a href={`/areas/${area.data.slug}/`}>{area.data.nome}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>Contato</h2>
      <ul class="contato">
        <li><a href={site.whatsapp.valor} rel="noopener" target="_blank">WhatsApp {site.telefone.valor}</a></li>
        <li><a href={`mailto:${site.email.valor}`}>{site.email.valor}</a></li>
        <li>{site.horario}</li>
        <li>{site.cidade}/{site.estado}</li>
      </ul>
    </div>
  </div>

  <div class="barra">
    <div class="container">
      <p>
        © {ano} {site.nomeSociedade} · Sociedade inscrita na {site.registro.oabSociedade.valor} · CNPJ {site.registro.cnpj.valor}
      </p>
      <p class="politicas">
        {rodape.legal.map((item) => <a href={item.href}>{item.rotulo}</a>)}
      </p>
    </div>
    <div class="container">
      <p class="aviso">{site.avisoInformativo}</p>
    </div>
  </div>
</footer>

<style>
  .rodape { background: var(--azul); color: rgba(255,255,255,.8); font-size: 15px; }
  .colunas {
    display: grid; grid-template-columns: 1.3fr 1fr 1.2fr 1.1fr; gap: 40px;
    padding-top: 60px; padding-bottom: 48px;
  }
  .rodape-logo { width: 200px; height: auto; margin-bottom: 18px; }
  .rodape h2 { color: #fff; font-size: 16px; margin-bottom: 16px; }
  .rodape ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .rodape a { color: rgba(255,255,255,.88); text-decoration: none; }
  .rodape a:hover { color: #fff; text-decoration: underline; }
  /* Ícones redondos brancos com o azul da marca dentro. Para incluir
     LinkedIn ou YouTube quando existirem, basta outro <li> igual. */
  .redes { display: flex !important; gap: 12px !important; margin-top: 18px !important; }
  .redes a {
    display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%;
    background: #fff; color: var(--azul); transition: background-color .15s, color .15s;
  }
  .redes a:hover { background: var(--azul-claro); color: #fff; text-decoration: none; }
  .redes svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .redes .cheio { fill: currentColor; stroke: none; }

  .barra { background: #071530; font-size: 13px; padding: 18px 0; }
  .barra .container { display: flex; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; }
  .barra p { margin: 0; }
  .politicas { display: flex; gap: 20px; }
  .aviso { margin-top: 10px !important; color: rgba(255,255,255,.6); }

  @media (max-width: 900px) { .colunas { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .colunas { grid-template-columns: 1fr; gap: 32px; } }
</style>
