---
/**
 * Rodapé da v3: faixa azul chapada em quatro colunas (marca, institucional,
 * áreas, contato) e barra inferior com registro da sociedade e políticas.
 * O registro (OAB da sociedade, CNPJ) é exigência do Provimento 205/2021.
 */
import { site } from '../lib/site';
import { areasDoIdioma } from '../lib/areas';
import { t, rota, type Idioma } from '../lib/i18n';
import Icone from './Icone.astro';

interface Props {
  lang?: Idioma;
}
const { lang = 'pt' } = Astro.props;
const tx = t(lang);
const areas = await areasDoIdioma(lang);
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="container colunas">
    <div>
      <picture>
        <source media="(min-resolution: 2dppx)" srcset="/media/marca/lockup-creme.svg" />
        <img class="rodape-logo" src="/media/marca/lockup-creme-tela.svg" alt={site.nome} width="550" height="196" />
      </picture>
      <p>{tx.atendimento} {tx.presencialEm} {site.cidade}/{site.estado}.</p>
      <ul class="redes" aria-label={tx.rodape.redesAria}>
        <li><a href={site.redes.instagram.valor} rel="noopener" target="_blank" aria-label={`Instagram ${site.redes.instagramArroba}`}><Icone nome="instagram" tamanho={20} /></a></li>
        <li><a href={site.whatsapp.valor} rel="noopener" target="_blank" aria-label={`WhatsApp ${site.telefone.valor}`}><Icone nome="whatsapp" tamanho={20} /></a></li>
        <li><a href={`mailto:${site.email.valor}`} aria-label={`E-mail ${site.email.valor}`}><Icone nome="email" tamanho={20} /></a></li>
      </ul>
    </div>

    <div>
      <h2>{tx.rodape.institucional}</h2>
      <ul>
        <li><a href={rota(lang, '/')}>{tx.rodape.inicio}</a></li>
        {tx.rodape.links.map((item) => <li><a href={rota(lang, item.chave)}>{item.rotulo}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>{tx.rodape.areas}</h2>
      <ul>
        {areas.map((area) => <li><a href={area.href}>{area.data.nome}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>{tx.rodape.contato}</h2>
      <ul class="contato">
        <li><a class="com-icone" href={site.whatsapp.valor} rel="noopener" target="_blank"><Icone nome="whatsapp" /><span>WhatsApp {site.telefone.valor}</span></a></li>
        <li><a class="com-icone" href={`mailto:${site.email.valor}`}><Icone nome="email" /><span>{site.email.valor}</span></a></li>
        <li>{tx.horario}</li>
        <li>{site.cidade}/{site.estado}</li>
      </ul>
    </div>
  </div>

  <div class="barra">
    <div class="container">
      <p>
        © {ano} {site.nomeSociedade} · {tx.rodape.inscrita} {site.registro.oabSociedade.valor} · CNPJ {site.registro.cnpj.valor}
      </p>
      <p class="politicas">
        {tx.rodape.politicas.map((item) => <a href={rota(lang, item.chave)}>{item.rotulo}</a>)}
        <button type="button" class="link-cookies" data-abrir-cookies>{tx.rodape.preferencias}</button>
      </p>
    </div>
    <div class="container">
      <p class="aviso">{tx.aviso}</p>
      {/* Golpe do falso advogado: aviso pedido no briefing (q9.3), discreto,
          com os canais oficiais. Na página de contato ele aparece completo. */}
      <p class="aviso golpe">
        {tx.rodape.golpe} <a href={`tel:${site.telefoneE164.valor}`}>{site.telefone.valor}</a>{' '}
        {tx.rodape.golpeE} <a href={`mailto:${site.email.valor}`}>{site.email.valor}</a>. {tx.rodape.golpeFim}
      </p>
    </div>
  </div>
</footer>

<style>
  .rodape { background: var(--azul); color: rgba(255,255,255,.8); font-size: 15px; }
  .colunas {
    display: grid; grid-template-columns: 1.15fr .8fr 1.15fr 1.45fr; gap: 40px;
    padding-top: 60px; padding-bottom: 48px;
  }
  .rodape-logo { display: block; width: 200px; height: auto; margin-bottom: 18px; }
  .rodape h2 { color: #fff; font-size: 16px; margin-bottom: 16px; }
  .rodape ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .rodape a { color: rgba(255,255,255,.88); text-decoration: none; }
  .rodape a:hover { color: #fff; text-decoration: underline; }
  /* Ícones redondos brancos com o azul da marca dentro. Para incluir
     LinkedIn ou YouTube quando existirem, basta outro <li> igual. */
  .redes { display: flex !important; gap: 12px !important; margin-top: 18px !important; }
  .redes a {
    display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%;
    background: #fff; color: var(--azul); transition: background-color .15s, color .15s;
  }
  .redes a:hover { background: var(--azul-claro); color: #fff; text-decoration: none; }
  /* Ícone sempre colado ao texto; se o endereço não couber, quebra o
     texto, nunca separa o ícone dele. */
  .com-icone { display: inline-flex; align-items: baseline; gap: 8px; }
  .com-icone :global(.icone) { position: relative; top: 2px; }
  .com-icone span { overflow-wrap: anywhere; }

  .barra { background: #071530; font-size: 13px; padding: 18px 0; }
  .barra .container { display: flex; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; }
  .barra p { margin: 0; }
  .politicas { display: flex; gap: 20px; }
  .aviso { margin-top: 10px !important; color: rgba(255,255,255,.6); }

  @media (max-width: 900px) { .colunas { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    .colunas { grid-template-columns: 1fr; gap: 32px; }
    /* Alvo de toque perto de 40px nos links das listas e das políticas,
       sem mudar o ritmo visual (o respiro vira área clicável). */
    .rodape ul:not(.redes) { gap: 0; }
    .rodape ul:not(.redes) a { display: inline-block; padding: 7px 0; }
    .rodape ul:not(.redes) a.com-icone { display: inline-flex; }
    /* Itens só de texto (horário, cidade) com o mesmo respiro dos links. */
    .rodape ul:not(.redes) > li:not(:has(a)) { padding: 7px 0; }
    .politicas a { display: inline-block; padding: 10px 0; }
    .barra .container { gap: 4px 24px; }
  }
  .link-cookies {
    background: none; border: 0; padding: 0; cursor: pointer;
    font: inherit; color: rgba(255,255,255,.88); text-decoration: none;
  }
  .link-cookies:hover { color: #fff; text-decoration: underline; }
  .golpe { margin-top: 6px !important; }
  .golpe a { color: rgba(255,255,255,.8); text-decoration: underline; }
</style>
