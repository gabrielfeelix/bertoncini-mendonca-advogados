---
/**
 * Áreas de atuação na home: lista com prévia fixa (26/10/2026).
 *
 * Era um acordeão que abria no hover. Cada linha que abria mudava a altura
 * da página, e mesmo com intenção de hover e correção de rolagem a tela subia
 * e descia sozinha enquanto o mouse passava. O padrão mudou para um que não
 * mexe em altura nenhuma:
 *
 * - à esquerda, os seis temas numa lista de alturas fixas; o hover só
 *   destaca a linha;
 * - à direita, um painel grudado (sticky) com foto, texto, chips e as duas
 *   saídas; ele troca de conteúdo por crossfade quando outra linha é
 *   apontada (mouse, foco do teclado ou clique).
 *
 * Como nada muda de tamanho, o hover pode reagir na hora, sem espera, e a
 * página nunca se move por conta própria.
 *
 * Abaixo de 900px não há hover nem espaço para o painel: cada linha abre o
 * próprio conteúdo por toque, como acordeão comum.
 *
 * Fotos da série própria (docs/PROMPTS-IMAGENS.md), sem cor por cima.
 */
import Zap from './Zap.astro';
import { whatsappDaArea } from '~/lib/areas';

interface Tema {
  nome: string;
  area: string;
  href: string;
  texto: string;
  assuntos: string[];
  /** Caminho sem extensão: há .avif, .webp e .jpg. */
  foto: string;
}

const PATRIMONIAL = '/areas/planejamento-patrimonial-e-sucessorio/';
const DIGITAL = '/areas/direito-digital/';

const temas: Tema[] = [
  {
    nome: 'Bens',
    area: 'Planejamento patrimonial',
    href: PATRIMONIAL,
    texto: 'Imóveis, investimentos e participações: em nome de quem estão e quanto custa transmiti-los.',
    assuntos: ['Holding familiar', 'Compra de imóvel', 'Direito imobiliário'],
    foto: '/media/novas/area-bens',
  },
  {
    nome: 'Família',
    area: 'Planejamento patrimonial',
    href: PATRIMONIAL,
    texto: 'Regime de bens, testamento, doação e uma partilha que não vire disputa entre herdeiros.',
    assuntos: ['Testamento e doação', 'Inventário e partilha', 'Holding familiar'],
    foto: '/media/novas/area-familia',
  },
  {
    nome: 'Empresa',
    area: 'Planejamento patrimonial',
    href: PATRIMONIAL,
    texto: 'Holding, acordo de sócios e quem administra o negócio quando o fundador sai.',
    assuntos: ['Empresa familiar e acordo de sócios', 'Societário e tributário'],
    foto: '/media/novas/area-empresa',
  },
  {
    nome: 'Contratos',
    area: 'As duas áreas',
    href: '/areas/',
    texto: 'Os documentos que ligam bens, sócios, clientes, marcas e parceiros.',
    assuntos: ['Contratos', 'Contratos eletrônicos e e-commerce', 'Criadores de conteúdo'],
    foto: '/media/novas/area-contratos',
  },
  {
    nome: 'Dados',
    area: 'Direito digital',
    href: DIGITAL,
    texto: 'O que a empresa coleta, por que coleta e como responde a quem pede os próprios dados.',
    assuntos: ['Proteção de dados e LGPD', 'Compliance digital', 'Inteligência artificial'],
    foto: '/media/novas/area-dados',
  },
  {
    nome: 'Presença digital',
    area: 'Direito digital',
    href: DIGITAL,
    texto: 'Marca, perfil e conteúdo, e o que fazer quando algo dá errado na internet.',
    assuntos: ['Redes sociais e internet', 'Propriedade intelectual', 'Crimes cibernéticos'],
    foto: '/media/novas/area-presenca',
  },
];

const id = (i: number) => `tema-${i}`;
---

<section class="servicos" id="areas" aria-labelledby="servicos-titulo">
  <header class="cabeca env">
    <h2 id="servicos-titulo" class="sobe">Áreas de atuação</h2>
    <p class="sobe">
      Duas áreas, uma com cada sócio. Os assuntos costumam chegar juntos: quem monta uma holding
      também tem marca, e quem vive de conteúdo precisa de contrato.
    </p>
  </header>

  <div class="env palco" data-servicos>
    <ol class="lista">
      {temas.map((tema, i) => (
        <li class:list={['tema', { ativo: i === 0 }]} data-i={i}>
          <button type="button" class="linha" aria-controls={id(i)} aria-expanded={i === 0 ? 'true' : 'false'}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span class="nomes">
              <span class="rotulo">{tema.area}</span>
              <span class="nome">{tema.nome}</span>
            </span>
            <span class="seta" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </button>
          {/* Corpo do tema no celular: o painel da direita só existe no desktop. */}
          <div class="corpo-movel">
            <div class="dentro">
              <p>{tema.texto}</p>
              <ul class="chips">{tema.assuntos.map((a) => <li>{a}</li>)}</ul>
              <div class="acoes-movel">
                <a class="botao zap" href={whatsappDaArea(`Olá! Gostaria de conversar sobre ${tema.nome.toLowerCase()}.`)} target="_blank" rel="noopener">
                  Falar sobre {tema.nome.toLowerCase()}
                  <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
                </a>
                <a class="ler" href={tema.href}>Ler sobre {tema.area === 'As duas áreas' ? 'as áreas' : 'a área'}</a>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="painel" aria-live="polite">
      <span class="grao" style="filter:url(#grao)" aria-hidden="true"></span>
      {temas.map((tema, i) => (
        <article class:list={['camada', { ativa: i === 0 }]} id={id(i)} data-i={i} aria-hidden={i === 0 ? undefined : 'true'}>
          <figure class="foto">
            <picture>
              <source type="image/avif" srcset={`${tema.foto}.avif`} />
              <source type="image/webp" srcset={`${tema.foto}.webp`} />
              <img src={`${tema.foto}.jpg`} alt="" width="900" height="1125" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </picture>
          </figure>
          <div class="texto">
            <p class="rotulo-painel">{tema.area}</p>
            <h3>{tema.nome}</h3>
            <p class="descricao">{tema.texto}</p>
            <ul class="chips">
              {tema.assuntos.map((a) => (
                <li><img class="selo" src="/media/marca/mono-branco.png" alt="" width="18" height="18" loading="lazy" />{a}</li>
              ))}
            </ul>
            <div class="acoes">
              <a class="botao zap claro" href={whatsappDaArea(`Olá! Gostaria de conversar sobre ${tema.nome.toLowerCase()}.`)} target="_blank" rel="noopener" tabindex={i === 0 ? undefined : -1}>
                Falar sobre {tema.nome.toLowerCase()}
                <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
              </a>
              <a class="ler" href={tema.href} tabindex={i === 0 ? undefined : -1}>
                Ler sobre {tema.area === 'As duas áreas' ? 'as áreas' : 'a área'}
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  /* Troca o tema ativo. No desktop isso só muda classes: a lista tem alturas
     fixas e o painel é sticky, então nada se move. No celular a mesma classe
     abre o corpo da linha (acordeão por toque). */
  document.querySelectorAll<HTMLElement>('[data-servicos]').forEach((palco) => {
    const temas = [...palco.querySelectorAll<HTMLElement>('.tema')];
    const camadas = [...palco.querySelectorAll<HTMLElement>('.camada')];
    const fino = matchMedia('(hover: hover) and (pointer: fine)');
    const largo = matchMedia('(min-width: 901px)');

    const ativa = (i: number) => {
      temas.forEach((t, k) => {
        const sim = k === i;
        t.classList.toggle('ativo', sim);
        t.querySelector('.linha')?.setAttribute('aria-expanded', String(sim));
      });
      camadas.forEach((c, k) => {
        const sim = k === i;
        c.classList.toggle('ativa', sim);
        if (sim) c.removeAttribute('aria-hidden');
        else c.setAttribute('aria-hidden', 'true');
        c.querySelectorAll('a').forEach((a) => (sim ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
    };

    temas.forEach((t, i) => {
      const linha = t.querySelector<HTMLElement>('.linha')!;
      t.addEventListener('pointerenter', () => {
        if (fino.matches && largo.matches) ativa(i);
      });
      linha.addEventListener('focus', () => {
        if (largo.matches) ativa(i);
      });
      linha.addEventListener('click', () => ativa(i));
    });
  });
</script>

<style>
  .servicos {
    padding-block: clamp(80px, 9vw, 136px);
    background: var(--branco);
  }
  .cabeca {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 16px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .cabeca h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(34px, 4.6vw, 64px);
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--tinta);
  }
  .cabeca p {
    max-width: 52ch;
    font-size: 18px;
    color: var(--secundario);
  }

  .palco {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: start;
  }

  /* ── lista: alturas fixas, o hover só destaca ───────────────────── */
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--linha);
  }
  .tema {
    border-bottom: 1px solid var(--linha);
  }
  .linha {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 22px 6px;
    cursor: pointer;
    color: var(--tinta);
  }
  .linha:focus-visible {
    outline: 2px solid var(--tinta);
    outline-offset: 2px;
    border-radius: 6px;
  }
  .n {
    font-size: 14px;
    color: var(--secundario);
    transition: color 0.4s var(--ease);
  }
  .nomes {
    display: grid;
    gap: 2px;
    transform: translateX(0);
    transition: transform 0.6s var(--ease);
  }
  .rotulo {
    font-size: 13px;
    color: var(--secundario);
  }
  .nome {
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(26px, 2.8vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #9aa8b8;
    transition: color 0.45s var(--ease);
  }
  .seta {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--tinta);
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.4s var(--ease), transform 0.6s var(--ease), background-color 0.4s;
  }
  .tema.ativo .nome {
    color: var(--tinta);
  }
  .tema.ativo .n {
    color: #2a62ad;
  }
  .tema.ativo .nomes {
    transform: translateX(10px);
  }
  .tema.ativo .seta {
    opacity: 1;
    transform: none;
    background: var(--papel);
  }

  /* ── painel sticky com crossfade ────────────────────────────────── */
  .painel {
    position: sticky;
    top: 110px;
    isolation: isolate;
    display: grid;
    min-height: min(640px, calc(100vh - 140px));
    border-radius: 26px;
    overflow: hidden;
    color: #fff;
    background: linear-gradient(130deg, #1f4c88 0%, #163a6d 40%, #0e2a52 75%, var(--tinta) 100%);
  }
  .grao {
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: inset(0);
    background: #8aa0bc;
    mix-blend-mode: overlay;
    opacity: 0.4;
    pointer-events: none;
  }
  .camada {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s var(--ease), visibility 0s linear 0.5s;
  }
  .camada.ativa {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s var(--ease), visibility 0s;
  }
  .foto {
    margin: 0;
    position: relative;
    min-height: 240px;
    overflow: hidden;
  }
  .foto picture {
    display: contents;
  }
  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 1.4s var(--ease);
  }
  .camada.ativa .foto img {
    transform: scale(1);
  }
  .texto {
    padding: clamp(22px, 2.6vw, 36px);
  }
  .texto > * {
    transform: translateY(14px);
    opacity: 0;
    transition: transform 0.7s var(--ease), opacity 0.5s var(--ease);
  }
  .camada.ativa .texto > * {
    transform: none;
    opacity: 1;
  }
  .camada.ativa .texto > :nth-child(2) {
    transition-delay: 0.04s;
  }
  .camada.ativa .texto > :nth-child(3) {
    transition-delay: 0.08s;
  }
  .camada.ativa .texto > :nth-child(4) {
    transition-delay: 0.12s;
  }
  .camada.ativa .texto > :nth-child(5) {
    transition-delay: 0.16s;
  }
  .rotulo-painel {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
  }
  .texto h3 {
    margin-top: 6px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(28px, 2.6vw, 38px);
    letter-spacing: -0.03em;
  }
  .descricao {
    margin-top: 10px;
    font-size: 17px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }
  .chips {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(10px);
    font-size: 14px;
  }
  .selo {
    width: 14px;
    height: 14px;
    object-fit: contain;
    opacity: 0.6;
  }
  .acoes {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
  }
  .botao.claro {
    background: #fff;
    color: var(--tinta);
  }
  .botao.claro:hover {
    background: var(--papel);
  }
  .ler {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 5px;
  }

  /* ── celular: acordeão por toque, sem painel ───────────────────── */
  .corpo-movel {
    display: none;
  }
  @media (max-width: 900px) {
    .palco {
      grid-template-columns: 1fr;
    }
    .painel {
      display: none;
    }
    .corpo-movel {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.5s var(--ease);
    }
    .corpo-movel > .dentro {
      overflow: hidden;
      min-height: 0;
    }
    .tema.ativo .corpo-movel {
      grid-template-rows: 1fr;
    }
    .corpo-movel p {
      padding: 0 6px;
      font-size: 16px;
      line-height: 1.5;
      color: var(--secundario);
    }
    .corpo-movel .chips {
      padding: 0 6px;
    }
    .corpo-movel .chips li {
      background: var(--papel);
      box-shadow: inset 0 0 0 1px var(--linha);
      color: var(--tinta);
    }
    .acoes-movel {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
      padding: 16px 6px 24px;
    }
    .corpo-movel .ler {
      color: var(--tinta);
      text-decoration-color: var(--linha);
    }
    .tema.ativo .nomes {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .palco *,
    .palco *::before {
      transition: none !important;
    }
  }
</style>
