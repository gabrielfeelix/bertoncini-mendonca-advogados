---
/**
 * Áreas de atuação na home: os dois nichos pelos serviços (06/11/2026).
 *
 * Retorno do escritório: o site falava das áreas pelo tema (Bens, Família,
 * Dados...) e não dizia o que se contrata. Quem chega precisa reconhecer o
 * serviço que procura sem clicar em nada. Por isso a lista com painel de
 * hover (26/10) saiu: ela escondia o conteúdo atrás de uma interação.
 *
 * Agora são dois blocos iguais, lado a lado, com a lista inteira à vista:
 * PPS e Digital pesam o mesmo, porque os dois sócios atuam juntos nas duas
 * (o escritório pediu para não dividir a atuação por sócio). Abaixo, uma
 * faixa com as outras áreas em que o escritório atua, que não têm página
 * própria mas precisam aparecer.
 *
 * Os serviços vêm do campo `servicos` do JSON de cada área: a página da
 * área mostra a mesma lista, então as duas nunca discordam.
 *
 * Movimento: só a revelação comum (`.sobe`). Nada aqui troca de conteúdo.
 */
import type { CollectionEntry } from 'astro:content';
import Zap from './Zap.astro';
import { whatsappDaArea } from '~/lib/areas';
import { site } from '~/lib/site';

interface Props {
  areas: CollectionEntry<'areas'>[];
}

const { areas } = Astro.props;

/* Fotos da série própria (docs/PROMPTS-IMAGENS.md), sem cor por cima.
   Caminho sem extensão: há .avif, .webp e .jpg. */
const fotos: Record<string, string> = {
  'planejamento-patrimonial-e-sucessorio': '/media/novas/area-familia',
  'direito-digital': '/media/novas/area-presenca',
};

const nichos = areas.filter((a) => !a.data.aConfirmar && a.data.servicos.length > 0);
const n2 = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="servicos" id="areas" aria-labelledby="servicos-titulo">
  <header class="cabeca env">
    <h2 id="servicos-titulo" class="sobe">Áreas de atuação</h2>
    <p class="sobe">
      Concentramos o trabalho em dois campos. Abaixo, o que você pode contratar em cada um.
    </p>
  </header>

  <div class="env">
    <div class="nichos">
      {nichos.map((area, i) => (
        <article class="nicho sobe" aria-labelledby={`nicho-${area.data.slug}`}>
          {fotos[area.data.slug] && (
            <figure class="foto">
              <picture>
                <source type="image/avif" srcset={`${fotos[area.data.slug]}.avif`} />
                <source type="image/webp" srcset={`${fotos[area.data.slug]}.webp`} />
                <img src={`${fotos[area.data.slug]}.jpg`} alt="" width="900" height="1125" loading="lazy" decoding="async" />
              </picture>
            </figure>
          )}
          <div class="corpo">
            <p class="rotulo">Área {n2(i)}</p>
            <h3 id={`nicho-${area.data.slug}`}>{area.data.nome}</h3>
            <p class="resumo">{area.data.resumo}</p>

            <p class="rotulo rotulo-lista">Serviços</p>
            <ul class="lista">
              {area.data.servicos.map((servico, k) => (
                <li>
                  <span class="n" aria-hidden="true">{n2(k)}</span>
                  <span>{servico}</span>
                </li>
              ))}
            </ul>

            <div class="acoes">
              <a
                class="botao zap"
                href={whatsappDaArea(area.data.mensagemWhatsapp ?? `Olá! Gostaria de falar sobre ${area.data.nome}.`)}
                target="_blank"
                rel="noopener"
              >
                Falar sobre esta área
                <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
              </a>
              <a class="ler" href={`/areas/${area.data.slug}/`}>
                Conhecer a área
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="outras sobe" aria-labelledby="outras-titulo">
      <div class="outras-cabeca">
        <h3 id="outras-titulo">Também atuamos em</h3>
        <p>Além dos dois campos principais, atendemos empresas e pessoas nestas áreas.</p>
        <a class="ler" href="/contato/">
          Conversar sobre outro assunto
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
      <ul class="outras-lista">
        {site.outrasAreas.map((nome) => <li>{nome}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .servicos {
    padding-block: clamp(80px, 9vw, 136px);
    background: var(--branco);
  }
  .cabeca {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 16px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .cabeca h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(34px, 4.6vw, 64px);
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--tinta);
  }
  .cabeca p {
    max-width: 52ch;
    font-size: 18px;
    color: var(--secundario);
  }

  /* ── os dois nichos ─────────────────────────────────────────────── */
  .nichos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    align-items: stretch;
  }
  .nicho {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 26px;
    overflow: hidden;
    background: var(--papel);
  }
  .foto {
    margin: 0;
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }
  .foto picture {
    display: contents;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .corpo {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3vw, 44px);
  }
  .rotulo {
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--secundario);
  }
  .corpo h3 {
    margin-top: 8px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(26px, 2.5vw, 36px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .resumo {
    margin-top: 12px;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.5;
    color: var(--secundario);
  }
  .rotulo-lista {
    margin-top: clamp(24px, 2.6vw, 36px);
    margin-bottom: 4px;
  }

  /* Lista em duas colunas no desktop: dez itens numa coluna só deixavam
     o bloco de PPS com o dobro da altura do Digital. */
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
  }
  .lista li {
    display: grid;
    grid-template-columns: 26px 1fr;
    align-items: baseline;
    padding: 13px 0;
    border-top: 1px solid var(--linha);
    font-size: 16px;
    line-height: 1.35;
    font-weight: 500;
    color: var(--tinta);
  }
  .lista .n {
    font-size: 12px;
    font-weight: 400;
    color: var(--secundario);
    font-variant-numeric: tabular-nums;
  }

  .acoes {
    margin-top: auto;
    padding-top: clamp(24px, 2.6vw, 36px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
  }
  .ler {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 15px;
    color: var(--tinta);
    text-decoration: underline;
    text-decoration-color: var(--linha);
    text-underline-offset: 5px;
    transition: text-decoration-color 0.3s;
  }
  .ler:hover {
    text-decoration-color: currentColor;
  }
  .ler svg {
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ler:hover svg {
    transform: translateX(3px);
  }

  /* ── outras áreas ───────────────────────────────────────────────── */
  .outras {
    margin-top: clamp(56px, 6vw, 96px);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: clamp(28px, 5vw, 88px);
    align-items: start;
  }
  .outras-cabeca h3 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(24px, 2.2vw, 32px);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--tinta);
  }
  .outras-cabeca p {
    margin-top: 10px;
    max-width: 36ch;
    font-size: 16px;
    line-height: 1.5;
    color: var(--secundario);
  }
  .outras-cabeca .ler {
    margin-top: 10px;
  }
  .outras-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 24px;
  }
  .outras-lista li {
    padding: 18px 0 22px;
    border-top: 1px solid var(--linha);
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--tinta);
  }

  @media (max-width: 1100px) {
    .lista {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 900px) {
    .nichos {
      grid-template-columns: 1fr;
    }
    .lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .outras {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .lista {
      grid-template-columns: 1fr;
    }
    .outras-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 16px;
    }
    .foto {
      aspect-ratio: 16 / 9;
    }
  }
</style>
