---
/**
 * Áreas de atuação na home: os dois nichos pelos serviços (06/11/2026).
 *
 * Retorno do escritório: o site falava das áreas pelo tema (Bens, Família,
 * Dados...) e não dizia o que se contrata. Quem chega precisa reconhecer o
 * serviço que procura sem clicar em nada. Por isso a lista com painel de
 * hover (26/10) saiu: ela escondia o conteúdo atrás de uma interação.
 *
 * Agora são dois blocos iguais, lado a lado, com a lista inteira à vista:
 * PPS e Digital pesam o mesmo, porque os dois sócios atuam juntos nas duas
 * (o escritório pediu para não dividir a atuação por sócio). Abaixo, uma
 * faixa com as outras áreas em que o escritório atua, que não têm página
 * própria mas precisam aparecer.
 *
 * Os serviços vêm do campo `servicos` do JSON de cada área: a página da
 * área mostra a mesma lista, então as duas nunca discordam.
 *
 * Movimento: só a revelação comum (`.sobe`). Nada aqui troca de conteúdo.
 */
import type { CollectionEntry } from 'astro:content';
import Zap from './Zap.astro';
import { whatsappDaArea } from '~/lib/areas';
import { site } from '~/lib/site';

interface Props {
  areas: CollectionEntry<'areas'>[];
}

const { areas } = Astro.props;

/* Fotos da série própria (docs/PROMPTS-IMAGENS.md), sem cor por cima.
   Caminho sem extensão: há .avif, .webp e .jpg. */
const fotos: Record<string, string> = {
  'planejamento-patrimonial-e-sucessorio': '/media/novas/area-familia',
  'direito-digital': '/media/novas/area-presenca',
};

const nichos = areas.filter((a) => !a.data.aConfirmar && a.data.servicos.length > 0);

/* "Também atuamos em" é uma frase, não uma tabela: as áreas em tinta, o
   que as liga em cinza. Lida em voz alta, continua fazendo sentido. */
const outras = site.outrasAreas.map((a) => a.charAt(0).toLowerCase() + a.slice(1));
---

<section class="servicos" id="areas" aria-labelledby="servicos-titulo">
  <header class="cabeca env">
    <h2 id="servicos-titulo" class="sobe">Áreas de atuação</h2>
    <p class="sobe">
      Dois campos concentram o nosso trabalho. Estes são os serviços de cada um.
    </p>
  </header>

  <div class="env">
    <div class="nichos">
      {nichos.map((area) => (
        <article class="nicho sobe" aria-labelledby={`nicho-${area.data.slug}`}>
          {fotos[area.data.slug] && (
            <figure class="foto">
              <picture>
                <source type="image/avif" srcset={`${fotos[area.data.slug]}.avif`} />
                <source type="image/webp" srcset={`${fotos[area.data.slug]}.webp`} />
                <img src={`${fotos[area.data.slug]}.jpg`} alt="" width="900" height="1125" loading="lazy" decoding="async" />
              </picture>
            </figure>
          )}
          <div class="corpo">
            <h3 id={`nicho-${area.data.slug}`}>{area.data.nome}</h3>
            <p class="resumo">{area.data.resumo}</p>

            <ul class="lista" aria-label={`Serviços de ${area.data.nome}`}>
              {area.data.servicos.map((servico) => <li>{servico}</li>)}
            </ul>

            <div class="acoes">
              <a
                class="botao zap"
                href={whatsappDaArea(area.data.mensagemWhatsapp ?? `Olá! Gostaria de falar sobre ${area.data.nome}.`)}
                target="_blank"
                rel="noopener"
              >
                Falar sobre esta área
                <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
              </a>
              <a class="ler" href={`/areas/${area.data.slug}/`}>Conhecer a área</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="outras sobe">
      <p class="outras-frase">
        Também atuamos em{' '}
        {outras.map((nome, k) => (
          <>
            <b>{nome}</b>
            {k < outras.length - 2 ? ', ' : k === outras.length - 2 ? ' e ' : '.'}
          </>
        ))}
      </p>
      <a class="ler" href="/contato/">Falar sobre outro assunto</a>
    </div>
  </div>
</section>

<style>
  .servicos {
    padding-block: clamp(80px, 9vw, 136px);
    background: var(--branco);
  }
  .cabeca {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 16px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .cabeca h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(34px, 4.6vw, 64px);
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--tinta);
  }
  .cabeca p {
    max-width: 52ch;
    font-size: 18px;
    color: var(--secundario);
  }

  /* ── os dois nichos ─────────────────────────────────────────────── */
  .nichos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    align-items: stretch;
  }
  .nicho {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 26px;
    overflow: hidden;
    background: var(--papel);
  }
  .foto {
    margin: 0;
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }
  .foto picture {
    display: contents;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .corpo {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3vw, 44px);
  }
  .corpo h3 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(30px, 3vw, 44px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .resumo {
    margin-top: 12px;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.5;
    color: var(--secundario);
  }
  /* Lista em duas colunas no desktop: dez itens numa coluna só deixavam
     o bloco de PPS com o dobro da altura do Digital. */
  .lista {
    list-style: none;
    margin: clamp(28px, 3vw, 40px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
  }
  .lista li {
    padding: 14px 0;
    border-top: 1px solid rgba(11, 30, 63, 0.08);
    font-size: 17px;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--tinta);
  }

  .acoes {
    margin-top: auto;
    padding-top: clamp(24px, 2.6vw, 36px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
  }
  /* Link de texto: azul da marca, sublinhado só no hover. */
  .ler {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 17px;
    color: #2a62ad;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  .ler:hover {
    text-decoration: underline;
  }

  /* ── outras áreas: uma frase grande ─────────────────────────────── */
  .outras {
    margin: clamp(88px, 10vw, 160px) auto 0;
    max-width: 22em;
    font-size: clamp(26px, 3.2vw, 46px);
    text-align: center;
  }
  .outras-frase {
    font-family: var(--sans);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: #9aa8b8;
    text-wrap: balance;
  }
  .outras-frase b {
    font-weight: 500;
    color: var(--tinta);
  }
  .outras .ler {
    margin-top: 20px;
  }

  @media (max-width: 1100px) {
    .lista {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 900px) {
    .nichos {
      grid-template-columns: 1fr;
    }
    .lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .lista {
      grid-template-columns: 1fr;
    }
    .foto {
      aspect-ratio: 16 / 9;
    }
  }
</style>
