---
/**
 * Áreas de atuação, em acordeão (redesenho de 21/10/2026).
 *
 * Padrão tirado de marketinglab.framer.ai, seção "What we offer": cada tema
 * é uma linha fina e clara; a linha ativa abre escura, com foto, texto e
 * os assuntos em chips. No desktop abre ao passar o mouse; no toque e no
 * teclado, pelo botão do título. Uma aberta por vez, e a primeira já vem
 * aberta para a seção nunca parecer uma lista vazia.
 *
 * Sem JS todas ficam abertas (o CSS só fecha com `.js`): o conteúdo inteiro
 * continua legível.
 *
 * As fotos são as da série própria (`public/media/novas`, prompts em
 * `docs/PROMPTS-IMAGENS.md`), sem tratamento de cor por cima: a paleta
 * marinho já sai da própria imagem.
 */
import Zap from './Zap.astro';
import { whatsappDaArea } from '~/lib/areas';

interface Tema {
  nome: string;
  area: string;
  href: string;
  texto: string;
  assuntos: string[];
  /** Caminho sem extensão: há .avif, .webp e .jpg. */
  foto: string;
}

const PATRIMONIAL = '/areas/planejamento-patrimonial-e-sucessorio/';
const DIGITAL = '/areas/direito-digital/';

const temas: Tema[] = [
  {
    nome: 'Bens',
    area: 'Planejamento patrimonial',
    href: PATRIMONIAL,
    texto: 'Imóveis, investimentos e participações: em nome de quem estão e quanto custa transmiti-los.',
    assuntos: ['Holding familiar', 'Compra de imóvel', 'Direito imobiliário'],
    foto: '/media/novas/area-bens',
  },
  {
    nome: 'Família',
    area: 'Planejamento patrimonial',
    href: PATRIMONIAL,
    texto: 'Regime de bens, testamento, doação e uma partilha que não vire disputa entre herdeiros.',
    assuntos: ['Testamento e doação', 'Inventário e partilha', 'Holding familiar'],
    foto: '/media/novas/area-familia',
  },
  {
    nome: 'Empresa',
    area: 'Planejamento patrimonial',
    href: PATRIMONIAL,
    texto: 'Holding, acordo de sócios e quem administra o negócio quando o fundador sai.',
    assuntos: ['Empresa familiar e acordo de sócios', 'Societário e tributário'],
    foto: '/media/novas/area-empresa',
  },
  {
    nome: 'Contratos',
    area: 'As duas áreas',
    href: '/areas/',
    texto: 'Os documentos que ligam bens, sócios, clientes, marcas e parceiros.',
    assuntos: ['Contratos', 'Contratos eletrônicos e e-commerce', 'Criadores de conteúdo'],
    foto: '/media/novas/area-contratos',
  },
  {
    nome: 'Dados',
    area: 'Direito digital',
    href: DIGITAL,
    texto: 'O que a empresa coleta, por que coleta e como responde a quem pede os próprios dados.',
    assuntos: ['Proteção de dados e LGPD', 'Compliance digital', 'Inteligência artificial'],
    foto: '/media/novas/area-dados',
  },
  {
    nome: 'Presença digital',
    area: 'Direito digital',
    href: DIGITAL,
    texto: 'Marca, perfil e conteúdo, e o que fazer quando algo dá errado na internet.',
    assuntos: ['Redes sociais e internet', 'Propriedade intelectual', 'Crimes cibernéticos'],
    foto: '/media/novas/area-presenca',
  },
];
---

<section class="servicos" id="areas" aria-labelledby="servicos-titulo">
  <header class="cabeca env">
    <h2 id="servicos-titulo" class="sobe">Áreas de atuação</h2>
    <p class="sobe">
      Duas áreas, uma com cada sócio. Os assuntos costumam chegar juntos: quem monta uma holding
      também tem marca, e quem vive de conteúdo precisa de contrato.
    </p>
  </header>

  <ol class="linhas">
    {temas.map((tema, i) => {
      const id = `tema-${i}`;
      return (
        <li class:list={['linha', { aberta: i === 0 }]}>
          <span class="grao" style="filter:url(#grao)" aria-hidden="true"></span>
          <div class="env grade">
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

            <div class="foto dobra" aria-hidden="true">
              <div class="dentro">
                <figure>
                  <picture>
                    <source type="image/avif" srcset={`${tema.foto}.avif`} />
                    <source type="image/webp" srcset={`${tema.foto}.webp`} />
                    <img src={`${tema.foto}.jpg`} alt="" width="900" height="1125" loading="lazy" decoding="async" />
                  </picture>
                </figure>
              </div>
            </div>

            <div class="conteudo">
              <div class="topo">
                <div>
                  <span class="rotulo">{tema.area}</span>
                  <h3>
                    <button type="button" class="abre" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={id}>
                      {tema.nome}
                    </button>
                  </h3>
                </div>
                <a class="botao zap vai" href={whatsappDaArea(`Olá! Gostaria de conversar sobre ${tema.nome.toLowerCase()}.`)} target="_blank" rel="noopener">
                  Falar sobre {tema.nome.toLowerCase()}
                  <span class="disco" aria-hidden="true"><Zap tamanho={15} /></span>
                </a>
              </div>
              <div class="corpo dobra" id={id}>
                <div class="dentro">
                  <p>{tema.texto}</p>
                  <ul class="chips">
                    {tema.assuntos.map((a) => (
                      <li>
                        <img class="selo" src="/media/marca/mono-branco.png" alt="" width="20" height="20" loading="lazy" />
                        {a}
                      </li>
                    ))}
                  </ul>
                  <a class="ler" href={tema.href}>
                    Ler sobre {tema.area === 'As duas áreas' ? 'as áreas' : 'a área'}
                    <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</section>

<script>
  /*
    Uma linha aberta por vez.

    Abrir no hover sozinho quebrava a navegação com mouse: a linha de cima
    fechava, a de baixo subia para debaixo do cursor parado, abria, e a
    página entrava em cascata. Três travas:

    1. Intenção: só abre se o ponteiro SE MEXER dentro da linha (posição
       diferente da última vista: os eventos que o navegador dispara quando
       o conteúdo anda sob um cursor parado repetem a mesma posição) e
       ficar ali DEMORA ms.
    2. Âncora: durante a transição, a rolagem é corrigida quadro a quadro
       para a linha escolhida ficar no mesmo lugar da tela. O que muda de
       altura acima dela não a empurra.
    3. Toque e teclado abrem pelo botão do título, sem espera.
  */
  const DEMORA = 120;
  const DURACAO = 520;
  /** px/ms acima do qual o ponteiro está de passagem. */
  const VELOZ = 0.45;

  document.querySelectorAll<HTMLElement>('.servicos').forEach((sec) => {
    const linhas = [...sec.querySelectorAll<HTMLElement>('.linha')];
    const fino = matchMedia('(hover: hover) and (pointer: fine)');
    let espera = 0;
    let alvoDaEspera: HTMLElement | null = null;
    let ultimoX = -1;
    let ultimoT = 0;
    let ultimoY = -1;

    const abre = (alvo: HTMLElement) => {
      if (alvo.classList.contains('aberta')) return;
      const antes = alvo.getBoundingClientRect().top;
      linhas.forEach((l) => {
        const sim = l === alvo;
        l.classList.toggle('aberta', sim);
        l.querySelector('.abre')?.setAttribute('aria-expanded', String(sim));
      });
      /* A correção passa pelo Lenis quando ele existe: mover a janela por
         fora dele faz o Lenis puxar de volta, e os dois ficavam se
         corrigindo (a página "teleportava"). Se a pessoa está rolando, não
         corrige: a rolagem dela manda. */
      const lenis = window.rolagem;
      const inicio = performance.now();
      const segura = (agora: number) => {
        const desvio = alvo.getBoundingClientRect().top - antes;
        if (Math.abs(desvio) > 0.5 && !lenis?.isScrolling) {
          if (lenis) lenis.scrollTo(lenis.scroll + desvio, { immediate: true, force: true });
          else window.scrollBy(0, desvio);
        }
        if (agora - inicio < DURACAO) requestAnimationFrame(segura);
      };
      requestAnimationFrame(segura);
    };

    linhas.forEach((l) => {
      l.addEventListener('pointermove', (e) => {
        const parado = e.clientX === ultimoX && e.clientY === ultimoY;
        const dt = Math.max(1, e.timeStamp - ultimoT);
        const veloz = Math.hypot(e.clientX - ultimoX, e.clientY - ultimoY) / dt > VELOZ;
        ultimoX = e.clientX;
        ultimoY = e.clientY;
        ultimoT = e.timeStamp;
        if (!fino.matches || parado || l.classList.contains('aberta')) return;
        /* Devagar, a espera conta desde a entrada e não reinicia (reiniciando,
           a linha só abria quando o mouse parava). Rápido, reinicia: o mouse
           está só passando a caminho de outra linha. */
        if (espera && alvoDaEspera === l && !veloz) return;
        clearTimeout(espera);
        alvoDaEspera = l;
        espera = window.setTimeout(() => {
          espera = 0;
          abre(l);
        }, DEMORA);
      });
      l.addEventListener('pointerleave', () => {
        clearTimeout(espera);
        espera = 0;
      });
      l.querySelector('.abre')?.addEventListener('click', () => abre(l));
    });
  });
</script>

<style>
  /* `overflow-anchor: none`: a âncora nativa do navegador também corrige a
     rolagem quando algo acima muda de altura, e somada à correção do
     script dava salto em dobro. */
  .servicos {
    overflow-anchor: none;
    padding-top: clamp(72px, 9vw, 136px);
    background: var(--branco);
  }
  .cabeca {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 16px;
    margin-bottom: clamp(36px, 4.4vw, 64px);
  }
  .cabeca h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(34px, 4.6vw, 64px);
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--tinta);
  }
  .cabeca p {
    max-width: 52ch;
    font-size: 18px;
    color: var(--secundario);
  }

  .linhas {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .linha {
    --ease: cubic-bezier(0.45, 0, 0.15, 1);
    border-top: 1px solid var(--tinta);
    background: var(--branco);
    color: var(--tinta);
    transition: background-color 0.45s var(--ease), color 0.45s var(--ease);
  }
  .linha:last-child {
    border-bottom: 1px solid var(--tinta);
  }
  /* Aberta: só azul, do médio ao escuro, com o grão do hero e do rodapé
     por cima (o filtro `#grao` de Base.astro). O vinho saiu a pedido. */
  .linha {
    position: relative;
    isolation: isolate;
  }
  .linha.aberta {
    background: linear-gradient(120deg, #1f4c88 0%, #163a6d 40%, #0e2a52 75%, var(--tinta) 100%);
    color: #fff;
  }
  /* `clip-path`: o filtro SVG pinta 10% além da caixa do elemento (região
     padrão de <filter>), e sem o recorte o grão vazava como uma faixa
     cinza sobre as linhas vizinhas. */
  .grao {
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: inset(0);
    background: #8aa0bc;
    mix-blend-mode: overlay;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s var(--ease);
  }
  .linha.aberta .grao {
    opacity: 0.4;
  }
  .grade {
    display: grid;
    grid-template-columns: 56px minmax(0, 0.9fr) minmax(0, 1.5fr);
    column-gap: clamp(16px, 2.4vw, 32px);
    padding-block: clamp(22px, 2.6vw, 36px);
  }
  .n {
    font-size: 16px;
    padding-top: 4px;
  }

  /* A dobra: 0fr fechada, 1fr aberta. Anima a altura real do conteúdo
     sem medir nada em JS. */
  .dobra {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease);
  }
  .dobra > .dentro {
    overflow: hidden;
    min-height: 0;
  }
  .linha.aberta .dobra,
  :global(html:not(.js)) .dobra {
    grid-template-rows: 1fr;
  }

  .foto figure {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    max-height: 440px;
    border-radius: 18px;
    overflow: hidden;
    background: #12284d;
    opacity: 0;
    transform: scale(0.94);
    transition: opacity 0.45s var(--ease), transform 0.6s var(--ease);
  }
  .linha.aberta .foto figure {
    opacity: 1;
    transform: none;
  }
  /* A foto sai com a cor dela: tingir imagem foi vetado pelo cliente
     ("nunca coloque", ver commit 80d73a2). */
  .foto picture {
    display: contents;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .foto figure:hover img {
    transform: scale(1.06);
  }

  .topo {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
  }
  .rotulo {
    display: block;
    font-size: 15px;
    margin-bottom: 8px;
    opacity: 0.8;
  }
  h3 {
    margin: 0;
  }
  .abre {
    all: unset;
    cursor: pointer;
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(28px, 3.3vw, 48px);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .abre:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
    border-radius: 4px;
  }
  .vai {
    flex: none;
  }
  .linha.aberta .vai {
    background: #fff;
    color: var(--tinta);
  }
  .linha.aberta .vai:hover {
    background: var(--papel);
  }

  .corpo p {
    margin-top: clamp(28px, 6vw, 120px);
    max-width: 52ch;
    font-size: 18px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.86);
  }
  .chips {
    list-style: none;
    margin: 22px 0 4px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  /* Vidro, não cartão branco: a chapa clara pesava sobre o fundo escuro e
     parecia componente pronto. Translúcido, o chip pertence à linha. */
  .chips li {
    position: relative;
    min-height: 112px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 18px 18px;
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    transform: translateY(14px);
    opacity: 0;
    transition: transform 0.5s var(--ease), opacity 0.4s var(--ease);
  }
  .selo {
    width: 20px;
    height: 20px;
    object-fit: contain;
    opacity: 0.55;
  }
  .ler {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 16px;
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.35);
    text-underline-offset: 5px;
    transition: text-decoration-color 0.3s;
  }
  .ler:hover {
    text-decoration-color: #fff;
  }
  .linha.aberta .chips li {
    transform: none;
    opacity: 1;
  }
  .linha.aberta .chips li:nth-child(2) {
    transition-delay: 0.06s;
  }
  .linha.aberta .chips li:nth-child(3) {
    transition-delay: 0.12s;
  }

  @media (max-width: 900px) {
    .grade {
      grid-template-columns: 40px minmax(0, 1fr);
    }
    .foto {
      grid-column: 2;
      grid-row: 2;
    }
    .conteudo {
      grid-column: 2;
      grid-row: 1;
    }
    .foto figure {
      margin-top: 22px;
      aspect-ratio: 16 / 10;
    }
    .topo {
      flex-direction: column;
    }
    .corpo p {
      margin-top: 18px;
    }
    .chips {
      grid-template-columns: 1fr;
    }
    .chips li {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .linha,
    .linha * {
      transition: none !important;
    }
  }
</style>
