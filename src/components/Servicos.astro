---
/**
 * Áreas de atuação na home: os dois nichos pelos serviços (06/11/2026).
 *
 * Retorno do escritório: o site falava das áreas pelo tema (Bens, Família,
 * Dados...) e não dizia o que se contrata. Quem chega precisa reconhecer o
 * serviço que procura sem clicar em nada. Por isso a lista com painel de
 * hover (26/10) saiu: ela escondia o conteúdo atrás de uma interação.
 *
 * Agora são dois blocos iguais, lado a lado, com a lista inteira à vista:
 * PPS e Digital pesam o mesmo, porque os dois sócios atuam juntos nas duas
 * (o escritório pediu para não dividir a atuação por sócio). Abaixo, uma
 * faixa com as outras áreas em que o escritório atua, que não têm página
 * própria mas precisam aparecer.
 *
 * Os serviços vêm do campo `servicos` do JSON de cada área: a página da
 * área mostra a mesma lista, então as duas nunca discordam.
 *
 * Movimento: só a revelação comum (`.sobe`). Nada aqui troca de conteúdo.
 */
import type { CollectionEntry } from 'astro:content';
import { whatsappDaArea } from '~/lib/areas';
import OutrasAreas from './OutrasAreas.astro';

interface Props {
  areas: CollectionEntry<'areas'>[];
}

const { areas } = Astro.props;

/* Fotos da série própria (docs/PROMPTS-IMAGENS.md), sem cor por cima.
   Caminho sem extensão: há .avif, .webp e .jpg. */
const fotos: Record<string, string> = {
  'planejamento-patrimonial-e-sucessorio': '/media/novas/area-familia',
  'direito-digital': '/media/novas/area-presenca',
};

const nichos = areas.filter((a) => !a.data.aConfirmar && a.data.servicos.length > 0);

---

<section class="servicos" id="areas" aria-labelledby="servicos-titulo">
  <header class="cabeca env">
    <h2 id="servicos-titulo" class="sobe">Áreas de atuação</h2>
    <p class="sobe">
      Dois campos concentram o nosso trabalho. Estes são os serviços de cada um.
    </p>
  </header>

  <div class="env">
    <div class="nichos">
      {nichos.map((area) => (
        <article class="nicho sobe" aria-labelledby={`nicho-${area.data.slug}`}>
          <h3 id={`nicho-${area.data.slug}`}>{area.data.nome}</h3>
          <p class="resumo">{area.data.resumo}</p>
          <div class="acoes">
            <a
              class="pilula"
              href={whatsappDaArea(area.data.mensagemWhatsapp ?? `Olá! Gostaria de falar sobre ${area.data.nome}.`)}
              target="_blank"
              rel="noopener"
            >
              Falar sobre esta área
            </a>
            <a class="ler" href={`/areas/${area.data.slug}/`}>Conhecer a área</a>
          </div>

          <ul class="lista" aria-label={`Serviços de ${area.data.nome}`}>
            {area.data.servicos.map((servico) => <li>{servico}</li>)}
          </ul>

          {fotos[area.data.slug] && (
            <figure class="foto">
              <picture>
                <source type="image/avif" srcset={`${fotos[area.data.slug]}.avif`} />
                <source type="image/webp" srcset={`${fotos[area.data.slug]}.webp`} />
                <img src={`${fotos[area.data.slug]}.jpg`} alt="" width="900" height="1125" loading="lazy" decoding="async" />
              </picture>
            </figure>
          )}
        </article>
      ))}
    </div>

    <div class="vao"><OutrasAreas /></div>
  </div>
</section>

<style>
  .servicos {
    padding-block: clamp(80px, 9vw, 136px);
    background: var(--branco);
  }
  .cabeca {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 16px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .cabeca h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(34px, 4.6vw, 64px);
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--tinta);
  }
  .cabeca p {
    max-width: 52ch;
    font-size: 18px;
    color: var(--secundario);
  }

  /* ── os dois nichos: tiles no padrão Apple ──────────────────────────
     Texto centrado no topo (título, frase, as duas ações), a lista de
     serviços arejada logo abaixo e a foto na base, sangrando até a borda
     do tile. Hierarquia só por tamanho e cor: nenhum rótulo, número ou
     divisória. */
  /* Subgrid: título, frase, ações, lista e foto ficam na mesma linha nos
     dois tiles, mesmo com um título em duas linhas e o outro em uma. */
  .nichos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(5, auto);
    gap: clamp(12px, 1.4vw, 20px);
  }
  .nicho {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    justify-items: center;
    text-align: center;
    --recuo: clamp(16px, 1.8vw, 28px);
    padding: clamp(44px, 4.6vw, 64px) var(--recuo) 0;
    border-radius: 28px;
    overflow: hidden;
    background: #f2f4f7;
  }
  .nicho h3 {
    align-self: end;
    max-width: 14em;
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(32px, 3.2vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .resumo {
    align-self: start;
    margin-top: 14px;
    max-width: 30em;
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: #5b6b7f;
    text-wrap: balance;
  }
  .acoes {
    align-self: start;
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 26px;
  }
  .pilula {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--tinta);
    color: #fff;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .pilula:hover {
    background: #2a62ad;
  }
  .pilula:focus-visible,
  .ler:focus-visible {
    outline: 2px solid #2a62ad;
    outline-offset: 3px;
    border-radius: 999px;
  }

  /* Os serviços num painel branco dentro do tile, em duas colunas
     alinhadas à esquerda. Marcador: o "§" do parágrafo de lei, em serifa,
     azul e discreto. Signo do ofício, sem o clichê da balança. */
  .lista {
    align-self: start;
    list-style: none;
    width: 100%;
    max-width: 640px;
    margin: clamp(36px, 4vw, 48px) 0 0;
    padding: clamp(22px, 2.4vw, 30px) clamp(20px, 2.2vw, 30px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    gap: 16px clamp(20px, 2.6vw, 36px);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(11, 30, 63, 0.04);
    text-align: left;
  }
  .lista li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    column-gap: 8px;
    align-items: baseline;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: var(--tinta);
  }
  .lista li::before {
    content: '§';
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1;
    color: #2a62ad;
    opacity: 0.6;
  }

  .foto {
    align-self: end;
    justify-self: stretch;
    margin: 0 calc(-1 * var(--recuo));
    padding-top: clamp(32px, 3.6vw, 48px);
  }
  .foto picture {
    display: block;
    aspect-ratio: 16 / 8;
    overflow: hidden;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .nicho:hover .foto img {
    transform: scale(1.03);
  }

  /* Link de texto: azul da marca, sublinhado só no hover. */
  .ler {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 17px;
    color: #2a62ad;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  .ler:hover {
    text-decoration: underline;
  }

  .vao {
    margin-top: clamp(88px, 10vw, 160px);
  }

  @media (max-width: 900px) {
    .nichos {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .nicho {
      grid-row: auto;
      grid-template-rows: none;
    }
  }
  @media (max-width: 560px) {
    .lista {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .foto img,
    .pilula {
      transition: none;
    }
  }
</style>
