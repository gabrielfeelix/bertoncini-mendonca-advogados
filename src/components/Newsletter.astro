---
/**
 * Newsletter (`.assinar` no protótipo): chapa azul com grão, título e um
 * campo de e-mail. Migrado do protótipo (CSS linhas 337-367, HTML linhas
 * 715-736).
 *
 * Tarefa 13 ligou este formulário à Brevo. O que mudou em relação à versão
 * migrada:
 *
 * - o `<form>` ganhou `method="post"` e `action="/api/newsletter"`, então
 *   **ele envia de verdade sem JavaScript**. Antes era um `<form>` sem
 *   destino, que recarregava a página e não inscrevia ninguém.
 * - o campo ganhou um `<label>` visível e associado por `for`. O protótipo
 *   só tinha `placeholder` e `aria-label`, e placeholder some ao digitar.
 * - entrou o campo escondido `origem`, para o 303 de quem está sem JS
 *   devolver a pessoa à página de onde ela enviou (esta seção aparece em
 *   mais de uma página). A rota valida esse valor antes de usar.
 * - entraram os campos-isca de `src/lib/antispam.ts`.
 * - o recibo deixou de ser um texto sempre presente com `opacity:0`. Isso
 *   escondia texto de leitor de tela de forma inconsistente. Agora ele é um
 *   `role="status"` vazio, preenchido pelo script ou pelo `?envio=` da
 *   volta sem JS.
 */
import { CAMPOS_ISCA } from '~/lib/antispam';
import { voltaPermitida } from '~/lib/voltas';

interface Props {
  /** Título da seção. */
  titulo?: string;
  /** Frase que explica o ritmo do envio. */
  ritmo?: string;
  /** Placeholder do campo de e-mail. */
  exemplo?: string;
  /** Rótulo visível do campo. */
  rotuloCampo?: string;
  /** Rótulo acessível do botão de envio. */
  rotuloBotao?: string;
  /** Aviso discreto abaixo do campo. */
  mudo?: string;
  /** Texto da confirmação, mostrado depois do envio. */
  recibo?: string;
  /** Texto mostrado quando o envio falha. */
  erro?: string;
  /** Sufixo do id, para a seção poder aparecer duas vezes na mesma página. */
  id?: string;
}

const {
  titulo = 'Um texto por mês, escrito para ser entendido.',
  ritmo = 'Sem promoção, sem novidade do escritório. Só o assunto que estiver pegando mais gente de surpresa naquele mês.',
  exemplo = 'seu@email.com.br',
  rotuloCampo = 'Seu e-mail',
  rotuloBotao = 'Assinar',
  mudo = 'Você pode sair da lista em um clique, em qualquer e-mail.',
  recibo = 'Pronto. O próximo texto vai para esse endereço.',
  erro = 'Não foi possível inscrever agora. Confira o e-mail e tente novamente.',
  id = 'forma',
}: Props = Astro.props;

/*
  Volta sem JavaScript: a rota redireciona com `?envio-newsletter=ok` ou
  `?envio-newsletter=erro`. Lido aqui, no servidor, para a mensagem existir
  mesmo com o script desligado.

  O parâmetro é nomeado por formulário de propósito. Com um `?envio=` genérico,
  uma página que tivesse esta seção E o formulário de contato faria as duas
  anunciarem o resultado uma da outra: um envio de contato bem sucedido
  apareceria aqui como "inscrição confirmada", sem ninguém ter se inscrito.

  RESSALVA: isto só funciona em página renderizada a cada pedido. Numa página
  pré-gerada no build o parâmetro não chega até aqui, e a pessoa sem
  JavaScript volta sem ver confirmação, embora a inscrição tenha acontecido.
  Por isso esta seção vive em `/contato/`, que declara `prerender = false`.
  Ao levá-la para uma página nova, declare o mesmo lá E acrescente o caminho
  em `VOLTAS_PERMITIDAS`, em `src/pages/api/newsletter.ts`.
*/
const envio = Astro.url.searchParams.get('envio-newsletter');
const origem = Astro.url.pathname;

/*
  A newsletter aparece em mais de uma página, e o 303 de quem está sem
  JavaScript só devolve a pessoa para um caminho da lista fechada em
  `~/lib/voltas`. Montar esta seção numa página fora da lista não quebra
  nada visivelmente — a inscrição funciona —, mas joga quem está sem JS
  para a home em vez de devolvê-lo para onde estava, e a confirmação
  aparece numa página que a pessoa não abriu.

  Aconteceu com `/textos/`, que ficou fora da lista. Por isso a conferência
  roda no build: acrescentar a newsletter a uma página nova sem registrar o
  caminho derruba `npm run build`, em vez de virar defeito silencioso.
*/
/* `/previa` é página de trabalho, não versionada e fora de produção (ver
   docs/HANDOFF-SITE.md). Ela monta as seções da home para revisão visual,
   então cai aqui — mas não entra na lista fechada da rota, que é defesa de
   produção: um caminho a mais na lista é um destino a mais de redirecionamento. */
if (origem !== '/previa/' && !voltaPermitida(origem)) {
  throw new Error(
    `Newsletter montada em "${origem}", que não está em VOLTAS_PERMITIDAS ` +
      '(src/lib/voltas.ts). Sem JavaScript, quem se inscrever nesta página ' +
      'seria devolvido para a home. Acrescente o caminho à lista.',
  );
}
---

<section class="assinar">
  <div class="lastro"></div>
  <div class="grao" style="filter:url(#grao)"></div>
  <div class="env">
    <div>
      <h2 class="sobe">{titulo}</h2>
      <p class="ritmo sobe">{ritmo}</p>
    </div>
    <form class="sobe" id={id} method="post" action="/api/newsletter">
      <label class="rotulo" for={`${id}-email`}>{rotuloCampo}</label>
      <div class="campo">
        <input
          id={`${id}-email`}
          type="email"
          name="email"
          required
          autocomplete="email"
          maxlength="254"
          placeholder={exemplo}
          aria-invalid={envio === 'erro' ? 'true' : undefined}
          aria-describedby={envio === 'erro' ? `recibo-${id}` : undefined}
        />
        <button type="submit">
          <span class="texto-botao">{rotuloBotao}</span>
          <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 11.5 11.5 2.5M5 2.5h6.5V9" stroke="#fff" stroke-width="1.7" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      {/* Sem JS o 303 precisa saber para onde voltar. A rota valida o valor. */}
      <input type="hidden" name="origem" value={origem} />

      {/* Iscas: fora da vista e fora do foco por teclado. Nunca display:none,
          para que um leitor de tela também as ignore por aria-hidden. */}
      <div class="iscas" aria-hidden="true">
        {CAMPOS_ISCA.map((campo) => (
          <input type="text" name={campo} tabindex="-1" autocomplete="off" />
        ))}
      </div>

      <p class="mudo">{mudo}</p>
      <p
        class:list={['recibo', { visto: envio === 'ok' || envio === 'erro', falhou: envio === 'erro' }]}
        id={`recibo-${id}`}
        data-sucesso={recibo}
        data-falha={erro}
        role="status"
        aria-live="polite"
      >{envio === 'ok' ? recibo : envio === 'erro' ? erro : ''}</p>
    </form>
  </div>
</section>

<script>
  /*
    Melhoria progressiva. Sem este script o formulário envia por POST normal
    e a rota devolve 303 com `?envio=`, que o Astro lê no servidor e usa para
    renderizar a mensagem. Com o script, a pessoa não perde a página.
  */
  document.querySelectorAll<HTMLFormElement>('form[action="/api/newsletter"]').forEach((forma) => {
    const recibo = forma.querySelector<HTMLElement>('.recibo');
    const botao = forma.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!recibo || !botao) return;

    const sucesso = recibo.dataset.sucesso ?? 'Pronto.';
    const falha = recibo.dataset.falha ?? 'Não foi possível inscrever agora.';

    forma.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      botao.disabled = true;
      recibo.classList.remove('falhou');
      recibo.classList.add('visto');
      recibo.textContent = 'Enviando.';

      try {
        const resposta = await fetch('/api/newsletter', {
          method: 'POST',
          body: new FormData(forma),
          headers: { accept: 'application/json' },
        });
        const dados = await resposta.json().catch(() => ({}) as { erro?: string });

        if (resposta.ok) {
          forma.reset();
          recibo.textContent = sucesso;
        } else {
          recibo.classList.add('falhou');
          recibo.textContent = dados.erro ?? falha;
        }
      } catch {
        recibo.classList.add('falhou');
        recibo.textContent = 'Sem conexão no momento. Tente novamente.';
      } finally {
        botao.disabled = false;
      }
    });
  });
</script>

<style>
  .assinar {
    position: relative;
    overflow: hidden;
    background: var(--tinta);
    color: #fff;
    clip-path: polygon(0 2.6vw, 100% 0, 100% 100%, 0 calc(100% - 2.6vw));
    padding-block: calc(clamp(60px, 7vw, 110px) + 2.6vw);
  }
  .assinar .lastro {
    position: absolute;
    inset: -16% -8%;
    background:
      radial-gradient(38% 48% at 82% 26%, rgba(81, 116, 147, 0.5), transparent 64%),
      radial-gradient(40% 44% at 14% 78%, rgba(155, 28, 46, 0.3), transparent 62%),
      linear-gradient(150deg, #102a50, #0b1e3f);
  }
  /* Grão só sobre a chapa azul escura desta seção. */
  .assinar .grao {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    pointer-events: none;
  }
  .assinar :global(.env) {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(26px, 4vw, 70px);
    align-items: end;
  }
  @media (max-width: 900px) {
    .assinar :global(.env) {
      grid-template-columns: 1fr;
      gap: 34px;
      align-items: start;
    }
  }
  .assinar h2 {
    font-family: var(--serif);
    font-weight: 200;
    font-size: clamp(30px, 4.4vw, 58px);
    letter-spacing: -0.03em;
    line-height: 1.04;
    max-width: 17ch;
  }
  .assinar .ritmo {
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 16px;
    max-width: 38ch;
  }
  /* Rótulo visível e associado por `for`. O protótipo trazia só um
     placeholder, que some assim que a pessoa digita: quem tem 70 anos e
     volta ao campo depois de uma interrupção perde a referência. */
  .rotulo {
    display: block;
    margin-bottom: 10px;
    font-size: 16px;
    color: #fff;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.34);
    padding-bottom: 12px;
    transition: border-color 0.4s;
  }
  .campo:focus-within {
    border-color: #fff;
  }
  .campo input {
    flex: 1;
    background: none;
    border: 0;
    color: #fff;
    font: inherit;
    font-size: clamp(17px, 2vw, 22px);
    padding: 6px 0;
    min-width: 0;
    min-height: 44px;
  }
  .campo input::placeholder {
    color: rgba(255, 255, 255, 0.42);
  }
  .campo input:focus {
    outline: none;
  }
  .campo input:focus-visible {
    outline: 2px solid var(--imperial);
    outline-offset: 2px;
  }
  /* O protótipo tinha um disco de 46px só com a seta, e o rótulo "Assinar"
     vivia apenas no `aria-label`. Aqui o rótulo é texto visível: o público
     do site não precisa deduzir o que uma seta diagonal faz. O alvo
     continua acima de 44px nas duas medidas. */
  .campo button {
    flex: none;
    min-height: 48px;
    min-width: 48px;
    padding: 0 20px;
    border-radius: 999px;
    border: 0;
    background: var(--imperial);
    color: #fff;
    font: 500 16px/1 var(--sans);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: background 0.3s;
  }
  .campo button:hover {
    background: var(--apoio);
  }
  .campo button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  @media (max-width: 420px) {
    /* Numa tela de 390px o campo e o botão lado a lado espremem os dois.
       Empilhar mantém os dois alvos inteiros e evita rolagem horizontal. */
    .campo {
      flex-wrap: wrap;
    }
    .campo button {
      width: 100%;
      justify-content: center;
    }
  }

  /* Iscas: invisíveis e inalcançáveis, sem sair do DOM (`display:none` faria
     alguns navegadores deixarem de enviá-las, e a isca só funciona se o robô
     conseguir preenchê-la). */
  .iscas {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .mudo {
    margin-top: 14px;
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.48);
  }
  .recibo {
    margin-top: 14px;
    font-size: 14.5px;
    color: #fff;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s, transform 0.4s;
  }
  .recibo.visto {
    opacity: 1;
    transform: none;
  }
  /* O erro se distingue por texto, não só por cor: a mensagem diz o que
     houve, e o símbolo abaixo reforça sem ser a única pista. */
  .recibo.falhou {
    color: #FFC9D1;
    font-weight: 500;
  }
  .recibo.falhou::before {
    content: "Atenção: ";
    font-weight: 600;
  }

  /* prefers-reduced-motion desliga todo movimento desta seção. A Tarefa 5
     traz o kill-switch global do protótipo; este bloco garante que o
     componente já cumpra a regra sozinho, em qualquer página. */
  @media (prefers-reduced-motion: reduce) {
    .assinar,
    .assinar * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
