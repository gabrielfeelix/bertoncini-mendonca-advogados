---
/**
 * Marca: a ilustração vetorial que acompanha cada cena das páginas de área.
 *
 * Por que ilustração própria, e não foto de banco em toda cena: os temas
 * conceituais (LGPD, propriedade intelectual, contrato, compliance) não
 * têm imagem fotográfica honesta. O que existe em banco é o clichê que a
 * pesquisa do projeto marcou como o que todo mundo faz — martelo, balança,
 * gravata apontando para gráfico. Forma geométrica própria diz o mesmo sem
 * mentir e sem parecer com ninguém.
 *
 * As cenas concretas (crime, inteligência artificial, atendimento) usam
 * fotografia, que dá peso onde a ilustração não dá. A página mistura as
 * duas de propósito: ver `[slug].astro`.
 *
 * Vocabulário: as três superfícies do projeto (branco, `--tinta` chapado,
 * `--papel`) e nada mais. Sem degradê — a decisão 2 do plano proíbe.
 * Todas as marcas são desenhadas numa caixa de 200×200 e escalam por
 * `viewBox`, então não há arquivo para otimizar nem requisição a fazer.
 *
 * `aria-hidden`: são ornamento. O que elas ilustram já está escrito ao
 * lado, em texto. Leitor de tela não ganha nada lendo "sete círculos".
 */
interface Props {
  /** Qual marca desenhar. */
  tipo:
    | 'dados'
    | 'marca'
    | 'contrato'
    | 'compliance'
    | 'abertura'
    | 'prova'
    | 'maquina'
    | 'leque'
    | 'conversa'
    | 'pauta'
    | 'sucessao'
    | 'rede';
  /** Classe extra, para o posicionamento vir de quem usa. */
  class?: string;
}

const { tipo, class: classe } = Astro.props;
---

<svg
  class:list={['marca', classe]}
  viewBox="0 0 200 200"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {tipo === 'abertura' && (
    <>
      {/* Rede: nós ligados. O ambiente eletrônico, antes de qualquer tema. */}
      <circle cx="100" cy="100" r="74" stroke="var(--linha)" stroke-width="1.5" />
      <circle cx="100" cy="100" r="44" stroke="var(--linha)" stroke-width="1.5" />
      <path d="M100 26v148M26 100h148M48 48l104 104M152 48L48 152" stroke="var(--linha)" stroke-width="1.5" />
      <circle cx="100" cy="26" r="7" fill="var(--tinta)" />
      <circle cx="174" cy="100" r="7" fill="var(--tinta)" />
      <circle cx="100" cy="174" r="7" fill="var(--tinta)" />
      <circle cx="26" cy="100" r="7" fill="var(--tinta)" />
      <circle cx="152" cy="48" r="5" fill="var(--secundario)" />
      <circle cx="48" cy="152" r="5" fill="var(--secundario)" />
      <circle cx="100" cy="100" r="13" fill="var(--tinta)" />
    </>
  )}

  {tipo === 'conversa' && (
    <>
      {/* Dois balões: a mensagem que chega e a resposta. O de baixo é
          chapado porque é o do escritório — quem responde. Sem reticências
          nem "digitando": a página não promete prazo, e um balão em
          animação sugeriria resposta imediata (ver a nota no topo de
          contato.astro sobre o que a página deliberadamente não diz). */}
      <path
        d="M30 34h96a14 14 0 0 1 14 14v40a14 14 0 0 1-14 14H62l-22 20V102h-10a14 14 0 0 1-14-14V48a14 14 0 0 1 14-14z"
        fill="var(--branco)"
        stroke="var(--linha)"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
      <path d="M46 60h64M46 78h40" stroke="var(--secundario)" stroke-width="2.5" stroke-linecap="round" />
      <path
        d="M170 96h-78a14 14 0 0 0-14 14v40a14 14 0 0 0 14 14h46l22 20v-20h10a14 14 0 0 0 14-14v-40a14 14 0 0 0-14-14z"
        fill="var(--tinta)"
      />
      <path d="M96 122h58M96 140h36" stroke="rgba(255,255,255,0.75)" stroke-width="2.5" stroke-linecap="round" />
    </>
  )}

  {tipo === 'sucessao' && (
    <>
      {/* Patrimônio que passa adiante: um bem no topo e a partilha que
          desce dele. Duas partes definidas e uma ainda em aberto, que é o
          que o planejamento resolve. Marca do card de Planejamento
          Patrimonial e Sucessório, na home.

          A barra horizontal e as três descidas são traços separados, um
          por ramo: a versão anterior desenhava tudo num `path` só com
          cantos arredondados, e o ramo do meio ficava sem descida
          enquanto o da direita parava antes da caixa. A pastilha vermelha
          fica ACIMA da barra, no talo — em cima dela parecia defeito de
          cruzamento. */}
      <rect x="76" y="24" width="48" height="48" rx="12" fill="var(--tinta)" />
      <path d="M100 72v18" stroke="var(--secundario)" stroke-width="3" stroke-linecap="round" />
      <circle cx="100" cy="82" r="9" fill="var(--imperial)" />
      <path d="M40 104h120" stroke="var(--secundario)" stroke-width="3" stroke-linecap="round" />
      <path d="M40 104v22M100 104v22M160 104v22" stroke="var(--secundario)" stroke-width="3" stroke-linecap="round" />
      <rect x="20" y="126" width="40" height="46" rx="11" fill="var(--branco)" stroke="var(--tinta)" stroke-width="3" />
      <rect x="80" y="126" width="40" height="46" rx="11" fill="var(--branco)" stroke="var(--tinta)" stroke-width="3" />
      <rect x="140" y="126" width="40" height="46" rx="11" fill="none" stroke="var(--secundario)" stroke-width="3" stroke-dasharray="7 8" opacity="0.6" />
    </>
  )}

  {tipo === 'rede' && (
    <>
      {/* Nós ligados: o ambiente eletrônico. Marca do card de Direito
          Digital, na home. É a `abertura` das páginas de área redesenhada
          para o tamanho pequeno — menos nós e traço mais grosso, porque a
          80px a versão original virava renda. */}
      <circle cx="100" cy="100" r="66" stroke="var(--linha)" stroke-width="3" fill="none" />
      <path d="M100 34v132M41 67l118 66M159 67L41 133" stroke="var(--linha)" stroke-width="3" />
      <circle cx="100" cy="34" r="11" fill="var(--tinta)" />
      <circle cx="159" cy="133" r="11" fill="var(--tinta)" />
      <circle cx="41" cy="133" r="11" fill="var(--tinta)" />
      <circle cx="41" cy="67" r="8" fill="var(--branco)" stroke="var(--secundario)" stroke-width="3" />
      <circle cx="159" cy="67" r="8" fill="var(--branco)" stroke="var(--secundario)" stroke-width="3" />
      <circle cx="100" cy="166" r="8" fill="var(--branco)" stroke="var(--secundario)" stroke-width="3" />
      <circle cx="100" cy="100" r="15" fill="var(--imperial)" />
    </>
  )}

  {tipo === 'pauta' && (
    <>
      {/* Folhas empilhadas: a de cima escrita, as de trás ainda em branco.
          É a marca do estado vazio de /textos/ — o blog não tem texto
          publicado, e a página precisa parecer pauta em aberto, não erro.

          As de trás são deslocadas E rodadas: só rodar não bastava, o
          giro em torno do centro deixava as três quase sobrepostas e a
          pilha sumia atrás da folha branca da frente. */}
      <rect
        x="60" y="44" width="96" height="122" rx="8"
        fill="var(--papel)" stroke="var(--linha)" stroke-width="2"
        transform="rotate(9 108 105)"
      />
      <rect
        x="52" y="40" width="96" height="122" rx="8"
        fill="var(--papel)" stroke="var(--linha)" stroke-width="2"
        transform="rotate(-5 100 101)"
      />
      <rect
        x="44" y="34" width="96" height="122" rx="8"
        fill="var(--branco)" stroke="var(--tinta)" stroke-width="2.5"
      />
      <path d="M62 64h60M62 84h60M62 104h38" stroke="var(--secundario)" stroke-width="2.5" stroke-linecap="round" />
      <circle cx="70" cy="132" r="8" fill="var(--imperial)" />
    </>
  )}

  {tipo === 'leque' && (
    <>
      {/* Duas lâminas de um mesmo eixo: as duas áreas em que o escritório
          atua. Eram quatro, com duas contornadas para as que faltavam
          definir; as duas "a confirmar" saíram do site a pedido do
          cliente, e uma lâmina vazia passaria a não representar nada.

          Vive sobre o azul chapado da seção de áreas na home, então é
          desenhada em claro. A pastilha pousa no furo central, que é o
          ponto de onde as duas abrem. */}
      <path d="M81.1 85.2 L40.1 53.2 A76.0 76.0 0 0 1 89.4 24.7 L96.7 76.2 A24.0 24.0 0 0 0 81.1 85.2 Z" fill="var(--branco)" />
      <path d="M103.3 76.2 L110.6 24.7 A76.0 76.0 0 0 1 159.9 53.2 L118.9 85.2 A24.0 24.0 0 0 0 103.3 76.2 Z" fill="var(--branco)" />
      <circle cx="100" cy="100" r="12" fill="var(--imperial)" />
    </>
  )}

  {tipo === 'pauta' && (
    <>
      {/* Folhas empilhadas: a de cima escrita, as de trás ainda em branco.
          É a marca do estado vazio de /textos/ — o blog não tem texto
          publicado, e a página precisa parecer pauta em aberto, não erro.

          As de trás são deslocadas E rodadas: só rodar não bastava, o
          giro em torno do centro deixava as três quase sobrepostas e a
          pilha sumia atrás da folha branca da frente. */}
      <rect
        x="60" y="44" width="96" height="122" rx="8"
        fill="var(--papel)" stroke="var(--linha)" stroke-width="2"
        transform="rotate(9 108 105)"
      />
      <rect
        x="52" y="40" width="96" height="122" rx="8"
        fill="var(--papel)" stroke="var(--linha)" stroke-width="2"
        transform="rotate(-5 100 101)"
      />
      <rect
        x="44" y="34" width="96" height="122" rx="8"
        fill="var(--branco)" stroke="var(--tinta)" stroke-width="2.5"
      />
      <path d="M62 64h60M62 84h60M62 104h38" stroke="var(--secundario)" stroke-width="2.5" stroke-linecap="round" />
      <circle cx="70" cy="132" r="8" fill="var(--imperial)" />
    </>
  )}

  {tipo === 'leque' && (
    <>
      {/* Quatro lâminas de um mesmo eixo: as quatro áreas que o escritório
          comporta — duas firmes, chapadas, e duas ainda por definir, só
          contornadas. Vive sobre o azul da seção, então é desenhada em
          claro.

          O leque é meia-volta inteira (de -88° a 88°), e não um arco curto:
          com as lâminas só na parte de cima, a base do arco ficava acima do
          eixo e a pastilha vermelha aparecia solta embaixo, fora do
          desenho. Assim ela pousa no furo central, que é o que ela é — o
          ponto de onde tudo abre. Nada de haste: a primeira versão tinha,
          parecia antena e jogava o peso para baixo. */}
      <path d="M76.0 99.2 L24.0 97.3 A76.0 76.0 0 0 1 41.8 51.1 L81.6 84.6 A24.0 24.0 0 0 0 76.0 99.2 Z" fill="none" stroke="rgba(255,255,255,0.42)" stroke-width="2.5" stroke-linejoin="round" />
      <path d="M83.3 82.7 L47.2 45.3 A76.0 76.0 0 0 1 92.1 24.4 L97.5 76.1 A24.0 24.0 0 0 0 83.3 82.7 Z" fill="var(--branco)" />
      <path d="M102.5 76.1 L107.9 24.4 A76.0 76.0 0 0 1 152.8 45.3 L116.7 82.7 A24.0 24.0 0 0 0 102.5 76.1 Z" fill="var(--branco)" />
      <path d="M118.4 84.6 L158.2 51.1 A76.0 76.0 0 0 1 176.0 97.3 L124.0 99.2 A24.0 24.0 0 0 0 118.4 84.6 Z" fill="none" stroke="rgba(255,255,255,0.42)" stroke-width="2.5" stroke-linejoin="round" />
      <circle cx="100" cy="100" r="12" fill="var(--imperial)" />
    </>
  )}

  {tipo === 'dados' && (
    <>
      {/* Inventário: fileiras de registro, algumas marcadas. O mapeamento. */}
      <rect x="26" y="30" width="148" height="140" rx="10" fill="var(--papel)" />
      <rect x="26" y="30" width="148" height="140" rx="10" stroke="var(--linha)" stroke-width="1.5" />
      <path d="M26 62h148" stroke="var(--linha)" stroke-width="1.5" />
      {[80, 104, 128, 152].map((y, i) => (
        <>
          <rect x="44" y={y - 7} width="14" height="14" rx="4" fill={i < 2 ? 'var(--tinta)' : 'none'} stroke="var(--secundario)" stroke-width="1.5" />
          <path d={`M70 ${y}h${i === 3 ? 58 : 86}`} stroke="var(--secundario)" stroke-width="1.5" stroke-linecap="round" opacity={i < 2 ? '1' : '0.45'} />
        </>
      ))}
      <circle cx="44" cy="46" r="4" fill="var(--imperial)" />
      <path d="M58 46h44" stroke="var(--tinta)" stroke-width="2" stroke-linecap="round" />
    </>
  )}

  {tipo === 'marca' && (
    <>
      {/* Sinete: o registro que dá exclusividade. Círculo dentro de escudo. */}
      <path d="M100 22l62 24v54c0 38-26 66-62 78-36-12-62-40-62-78V46l62-24z" fill="var(--papel)" stroke="var(--linha)" stroke-width="1.5" />
      <circle cx="100" cy="98" r="34" stroke="var(--tinta)" stroke-width="2" />
      <circle cx="100" cy="98" r="20" fill="var(--tinta)" />
      <path d="M100 78v40M80 98h40" stroke="var(--branco)" stroke-width="2.5" stroke-linecap="round" />
      <path d="M66 150h68" stroke="var(--secundario)" stroke-width="1.5" stroke-linecap="round" />
    </>
  )}

  {tipo === 'contrato' && (
    <>
      {/* Duas folhas e o aceite: a prova de que o outro lado concordou. */}
      <rect x="22" y="34" width="104" height="132" rx="8" fill="var(--branco)" stroke="var(--linha)" stroke-width="1.5" />
      <rect x="52" y="20" width="104" height="132" rx="8" fill="var(--papel)" stroke="var(--linha)" stroke-width="1.5" />
      {[52, 72, 92].map((y, i) => (
        <path d={`M72 ${y}h${i === 2 ? 40 : 64}`} stroke="var(--secundario)" stroke-width="1.5" stroke-linecap="round" />
      ))}
      <circle cx="140" cy="128" r="26" fill="var(--tinta)" />
      <path d="M129 128l8 9 15-17" stroke="var(--branco)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}

  {tipo === 'prova' && (
    <>
      {/* Ampulheta e o registro preservado: a prova é o que se perde por
          demora, e é o que sustenta todas as outras etapas. */}
      <rect x="40" y="44" width="96" height="118" rx="9" fill="var(--papel)" stroke="var(--linha)" stroke-width="1.5" />
      {[72, 92, 112, 132].map((y, i) => (
        <path d={`M60 ${y}h${i === 3 ? 34 : 56}`} stroke="var(--secundario)" stroke-width="1.5" stroke-linecap="round" opacity={i > 1 ? '0.4' : '1'} />
      ))}
      <circle cx="142" cy="138" r="30" fill="var(--branco)" stroke="var(--tinta)" stroke-width="2" />
      <path d="M142 122v17l11 7" stroke="var(--tinta)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M56 30h64" stroke="var(--imperial)" stroke-width="2.5" stroke-linecap="round" />
    </>
  )}

  {tipo === 'maquina' && (
    <>
      {/* Entrada, processo opaco e saída — e a pergunta de quem responde
          pelo erro. O losango é a decisão que ainda é humana. */}
      <rect x="58" y="58" width="84" height="84" rx="12" fill="var(--tinta)" />
      <circle cx="100" cy="100" r="17" stroke="var(--branco)" stroke-width="2" opacity="0.55" />
      <circle cx="100" cy="100" r="6" fill="var(--branco)" opacity="0.8" />
      {[[100, 22, 100, 58], [100, 142, 100, 178], [22, 100, 58, 100], [142, 100, 178, 100]].map(([x1, y1, x2, y2]) => (
        <path d={`M${x1} ${y1}L${x2} ${y2}`} stroke="var(--secundario)" stroke-width="1.5" stroke-dasharray="5 6" />
      ))}
      <rect x="86" y="10" width="28" height="14" rx="5" fill="var(--papel)" stroke="var(--linha)" stroke-width="1.5" />
      <rect x="10" y="93" width="28" height="14" rx="5" fill="var(--papel)" stroke="var(--linha)" stroke-width="1.5" />
      <rect x="162" y="93" width="28" height="14" rx="5" fill="var(--papel)" stroke="var(--linha)" stroke-width="1.5" />
      <path d="M100 170l13 13-13 13-13-13z" fill="var(--imperial)" />
    </>
  )}

  {tipo === 'compliance' && (
    <>
      {/* Ciclo: política, controle, resposta, revisão. A rotina que se repete. */}
      <circle cx="100" cy="100" r="66" stroke="var(--linha)" stroke-width="1.5" stroke-dasharray="8 10" />
      <rect x="82" y="16" width="36" height="36" rx="9" fill="var(--tinta)" />
      <rect x="148" y="82" width="36" height="36" rx="9" fill="var(--papel)" stroke="var(--linha)" stroke-width="1.5" />
      <rect x="82" y="148" width="36" height="36" rx="9" fill="var(--papel)" stroke="var(--linha)" stroke-width="1.5" />
      <rect x="16" y="82" width="36" height="36" rx="9" fill="var(--papel)" stroke="var(--linha)" stroke-width="1.5" />
      <path d="M100 74v52M74 100h52" stroke="var(--secundario)" stroke-width="1.5" />
      <circle cx="100" cy="100" r="11" fill="var(--imperial)" />
    </>
  )}
</svg>

<style>
  .marca {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
