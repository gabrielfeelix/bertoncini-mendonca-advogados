---
/**
 * Navbar nova: barra cheia fixa no topo (logo à esquerda, links no meio,
 * WhatsApp à direita). Substitui a navbar em três ilhas flutuantes do
 * protótipo (`.nav`, `.ilha`, `.centro`, `.selo`, `.fala`), revogada pelo
 * cliente por ser "esquisita". Não migra nada do CSS/JS antigo — só o
 * raciocínio de acessibilidade por trás do esconder-ao-rolar, que é o
 * mesmo problema com visual diferente (ver comentários abaixo e no CSS).
 *
 * Comportamento decidido com o cliente: a barra some ao descer a página e
 * volta ao subir. Precisa continuar 100% utilizável sem JavaScript (a
 * barra fica sempre visível nesse caso) e o foco de teclado nunca pode
 * ficar preso numa barra escondida.
 */
import { site, navegacao } from '../lib/site';

interface Props {
  /** href da página atual, para aria-current e destaque visual no menu. */
  paginaAtual?: string;
}

const { paginaAtual } = Astro.props;
---

<header class="barra" id="barra">
  <div class="env barra-env">
    <a class="marca" href="/">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 3v18M5 8h14M8.5 8 5.6 14.4a3.2 3.2 0 0 0 5.8 0L8.5 8ZM15.5 8l-2.9 6.4a3.2 3.2 0 0 0 5.8 0L15.5 8Z"
          stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
      </svg>
      <span class="longo">Bertoncini <span class="amp">&amp;</span> Mendonça</span>
      <span class="curto">B <span class="amp">&amp;</span> M</span>
    </a>

    <nav class="links" aria-label="Principal">
      {navegacao.map((item) => (
        <a
          href={item.href}
          aria-current={paginaAtual === item.href ? 'page' : undefined}
          class:list={{ aqui: paginaAtual === item.href }}
        >
          {item.rotulo}
        </a>
      ))}
    </nav>

    <a
      class="fala"
      href={site.whatsapp.valor}
      target="_blank"
      rel="noopener"
      data-placeholder={site.whatsapp.placeholder ? '1' : undefined}
    >
      <span class="disco" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path
            d="M12 3v18M5 8h14M8.5 8 5.6 14.4a3.2 3.2 0 0 0 5.8 0L8.5 8ZM15.5 8l-2.9 6.4a3.2 3.2 0 0 0 5.8 0L15.5 8Z"
            stroke="#fff" stroke-width="1.3" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="rotulo">WhatsApp</span>
    </a>

    <details class="movel" id="movel">
      <summary class="abre" id="abre" aria-label="Abrir menu">Menu</summary>
      <div class="painel-menu" id="painel-menu">
        {navegacao.map((item) => (
          <a href={item.href} aria-current={paginaAtual === item.href ? 'page' : undefined}>
            {item.rotulo}
          </a>
        ))}
        <a
          href={site.whatsapp.valor}
          target="_blank"
          rel="noopener"
          data-placeholder={site.whatsapp.placeholder ? '1' : undefined}
        >
          WhatsApp
        </a>
      </div>
    </details>
  </div>
</header>

<style>
  /*
    Barra cheia fixa. O esconder-ao-rolar usa a mesma técnica do protótipo
    (`.nav.oculta`, linhas 51-58): opacity + transform, nunca
    visibility:hidden nem display:none. Um elemento visibility:hidden é
    tirado da ordem de Tab pelo navegador — o foco nunca chegaria lá dentro,
    e o :focus-within abaixo jamais dispararia para trazer a barra de volta.
    Com opacity+transform os links continuam alcançáveis por teclado o
    tempo todo; pointer-events:none só impede clique/hover visual enquanto
    oculta.
  */
  .barra {
    position: fixed;
    z-index: 60;
    top: 0;
    left: 0;
    right: 0;
    background: var(--tinta);
    color: #fff;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s;
  }
  .barra.oculta {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }
  /* Se o foco chega em qualquer link da barra escondida, ela reaparece na
     hora — teclado nunca fica preso atrás de uma barra invisível. */
  .barra.oculta:focus-within {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  /* Sem JavaScript a classe .oculta nunca é adicionada (é só JS que a
     alterna, ver script abaixo), então por padrão a barra já fica sempre
     visível e utilizável — progressive enhancement, não é preciso duplicar
     regra nenhuma aqui. */

  .barra-env {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 72px;
    padding-block: 12px;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--serif);
    font-weight: 300;
    font-size: 17px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: inherit;
    min-height: 44px;
  }
  .marca .amp {
    font-style: italic;
    opacity: 0.7;
  }
  .marca .curto {
    display: none;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-inline-start: auto;
  }
  .links a {
    text-decoration: none;
    color: inherit;
    font-size: 16px;
    opacity: 0.82;
    padding: 12px 16px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    transition: opacity 0.2s, background-color 0.2s;
  }
  .links a:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.12);
  }
  .links a[aria-current='page'] {
    opacity: 1;
    background: rgba(255, 255, 255, 0.16);
  }

  .fala {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    font-size: 15px;
    white-space: nowrap;
    padding: 6px 16px 6px 6px;
    min-height: 44px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
  }
  .fala .disco {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--imperial);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  /*
    Menu de celular com <details>/<summary>: widget nativo do HTML, abre e
    fecha sem nenhum JavaScript (o navegador já implementa o toggle, o
    aria-expanded implícito e, na maioria dos navegadores, o fechamento com
    Escape). O script no fim do arquivo só adiciona duas melhorias que o
    <details> não dá de graça: fechar ao clicar num link e mover o foco
    para o primeiro link ao abrir. Nenhuma delas é necessária para o menu
    funcionar — são só refinamentos.
  */
  .movel {
    display: none;
  }
  .abre {
    display: inline-flex;
    align-items: center;
    padding: 12px 16px;
    min-height: 44px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    color: inherit;
    font: inherit;
    font-size: 15px;
    cursor: pointer;
    list-style: none;
  }
  /* remove o marcador triangular padrão do <summary> nos navegadores que o desenham */
  .abre::-webkit-details-marker {
    display: none;
  }
  .movel[open] .abre {
    background: rgba(255, 255, 255, 0.2);
  }

  .painel-menu {
    display: flex;
    flex-direction: column;
    padding: 8px var(--gutter) 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .painel-menu a {
    padding: 15px 4px;
    min-height: 44px;
    display: flex;
    align-items: center;
    text-decoration: none;
    color: #fff;
    font-family: var(--serif);
    font-weight: 300;
    font-size: 19px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .painel-menu a[aria-current='page'] {
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 1080px) {
    .links {
      display: none;
    }
    .movel {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .marca .longo {
      display: none;
    }
    .marca .curto {
      display: inline;
    }
    .fala .rotulo {
      display: none;
    }
    .fala {
      padding: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .barra,
    .barra.oculta {
      transition: none;
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<script>
  // Progressive enhancement: tudo acima já funciona sem este script (barra
  // sempre visível, links sempre clicáveis). Este script só adiciona o
  // comportamento de esconder ao descer / mostrar ao subir, decidido com o
  // cliente, e a abertura do painel de celular.
  const elBarra = document.getElementById('barra');
  const elMovel = document.getElementById('movel');
  const elPainel = document.getElementById('painel-menu');

  if (elBarra instanceof HTMLElement && elMovel instanceof HTMLDetailsElement && elPainel) {
    const barra = elBarra;
    const movel = elMovel;
    const painel = elPainel;
    const calma = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ultimoY = 0;

    function passo() {
      if (calma) return; // não altera nada sob reduced-motion: barra sempre visível.
      const y = window.scrollY;
      const podeEsconder = y > ultimoY && y > 120 && !movel.open;
      barra.classList.toggle('oculta', podeEsconder);
      ultimoY = y;
    }
    passo();
    if (!calma) {
      addEventListener('scroll', passo, { passive: true });
    }

    // Se o foco entra na barra escondida, tira a classe .oculta de vez (o
    // :focus-within do CSS já reexibe na hora; isso evita que a próxima
    // rolagem esconda tudo de novo com o foco lá dentro).
    barra.addEventListener('focusin', () => {
      barra.classList.remove('oculta');
    });

    // Melhorias sobre o comportamento nativo do <details>: focar o
    // primeiro link ao abrir, e fechar o painel ao escolher um link.
    movel.addEventListener('toggle', () => {
      if (movel.open) {
        const primeiroLink = painel.querySelector('a');
        if (primeiroLink instanceof HTMLElement) primeiroLink.focus();
      }
    });

    painel.addEventListener('click', (evento) => {
      if ((evento.target as HTMLElement)?.tagName === 'A') movel.open = false;
    });
  }
</script>
