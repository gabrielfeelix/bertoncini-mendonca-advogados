---
/**
 * Navbar nova: barra cheia fixa no topo (logo à esquerda, links no meio,
 * WhatsApp à direita). Substitui a navbar em três ilhas flutuantes do
 * protótipo (`.nav`, `.ilha`, `.centro`, `.selo`, `.fala`), revogada pelo
 * cliente por ser "esquisita". Não migra nada do CSS/JS antigo — só o
 * raciocínio de acessibilidade por trás do esconder-ao-rolar, que é o
 * mesmo problema com visual diferente (ver comentários abaixo e no CSS).
 *
 * Comportamento decidido com o cliente: a barra some ao descer a página e
 * volta ao subir. Precisa continuar 100% utilizável sem JavaScript (a
 * barra fica sempre visível nesse caso) e o foco de teclado nunca pode
 * ficar preso numa barra escondida.
 */
import { site, navegacao } from '../lib/site';
import Zap from './Zap.astro';
import { listarAreasConfirmadas } from '../lib/areas';

interface Props {
  /** href da página atual, para aria-current e destaque visual no menu. */
  paginaAtual?: string;
}

const { paginaAtual } = Astro.props;

/* As áreas do menu suspenso vêm da coleção: acrescentar uma terceira área
   não exige tocar na navbar. */
const areas = await listarAreasConfirmadas();
---

{/* `data-contraste="externo"` só quando a barra fica SOBRE o hero: ali o
    fundo real é a foto escura, não o branco do <body>, e o verificador de
    contraste não tem como medir isso sozinho. Em página comum a barra é
    opaca e entra na medição normalmente. Ver a nota em tools/verifica.mjs. */}
<header
  class="barra"
  id="barra"
  data-contraste={paginaAtual === '/' ? 'externo' : undefined}
>
  <div class="env barra-env">
    <a class="marca" href="/">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 3v18M5 8h14M8.5 8 5.6 14.4a3.2 3.2 0 0 0 5.8 0L8.5 8ZM15.5 8l-2.9 6.4a3.2 3.2 0 0 0 5.8 0L15.5 8Z"
          stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
      </svg>
      <span class="longo">Bertoncini <span class="amp">&amp;</span> Mendonça</span>
      <span class="curto">B <span class="amp">&amp;</span> M</span>
    </a>

    <nav class="links" aria-label="Principal">
      {navegacao.map((item) =>
        /* O item de áreas abre um menu; os outros são link simples.
           O <a> continua sendo um link de verdade para /areas/ — o menu é
           acréscimo, não substituição. Quem clica direto vai para a lista,
           que é o comportamento que o teclado e o toque precisam ter. */
        'submenu' in item && item.submenu === 'areas' && areas.length > 0 ? (
          <div class="tem-menu">
            <a
              href={item.href}
              aria-current={paginaAtual === item.href ? 'page' : undefined}
              class:list={['gatilho', { aqui: paginaAtual === item.href }]}
              aria-expanded="false"
              aria-controls="menu-areas"
            >
              {item.rotulo}
              <span class="chev" aria-hidden="true">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                  <path d="M2 3.5 5 6.5l3-3" stroke="currentColor" stroke-width="1.4"
                    stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </a>
            <div class="menu" id="menu-areas">
              {areas.map((area) => (
                <a class="item-area" href={`/areas/${area.data.slug}/`}>
                  <b>{area.data.nome}</b>
                  <span>{area.data.resumo}</span>
                </a>
              ))}
              <a class="item-area todas" href={item.href}>
                <b>Ver todas as áreas</b>
              </a>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            aria-current={paginaAtual === item.href ? 'page' : undefined}
            class:list={{ aqui: paginaAtual === item.href }}
          >
            {item.rotulo}
          </a>
        ),
      )}
    </nav>

    <a
      class="fala"
      href={site.whatsapp.valor}
      target="_blank"
      rel="noopener"
      data-placeholder={site.whatsapp.placeholder ? '1' : undefined}
    >
      {/* Glifo do WhatsApp, não a balança da marca: o disco é verde e
          quem bate o olho precisa reconhecer o canal. Desenho em `fill`
          sólido branco sobre a chapa verde — é a forma oficial, e num
          disco de 32px um contorno vira renda. */}
      <span class="disco" aria-hidden="true"><Zap /></span>
      <span class="rotulo">WhatsApp</span>
    </a>

    <details class="movel" id="movel">
      <summary class="abre" id="abre" aria-label="Abrir menu" aria-expanded="false">Menu</summary>
      <div class="painel-menu" id="painel-menu">
        {navegacao.map((item) => (
          <>
            <a href={item.href} aria-current={paginaAtual === item.href ? 'page' : undefined}>
              {item.rotulo}
            </a>
            {/* No celular não há hover: as áreas entram recuadas sob o item,
                sempre visíveis. Um menu suspenso que só abre com mouse
                deixaria o celular sem esse caminho. */}
            {'submenu' in item && item.submenu === 'areas' &&
              areas.map((area) => (
                <a class="sub" href={`/areas/${area.data.slug}/`}>{area.data.nome}</a>
              ))}
          </>
        ))}
        <a
          href={site.whatsapp.valor}
          target="_blank"
          rel="noopener"
          data-placeholder={site.whatsapp.placeholder ? '1' : undefined}
        >
          WhatsApp
        </a>
      </div>
    </details>
  </div>
</header>

<style>
  /*
    Barra cheia fixa. O esconder-ao-rolar usa a mesma técnica do protótipo
    (`.nav.oculta`, linhas 51-58): opacity + transform, nunca
    visibility:hidden nem display:none. Um elemento visibility:hidden é
    tirado da ordem de Tab pelo navegador — o foco nunca chegaria lá dentro,
    e o :focus-within abaixo jamais dispararia para trazer a barra de volta.
    Com opacity+transform os links continuam alcançáveis por teclado o
    tempo todo; pointer-events:none só impede clique/hover visual enquanto
    oculta.
  */
  /*
    A barra é SOBREPOSTA ao conteúdo, não empilhada acima dele.

    Era este o defeito da primeira dobra: a barra tinha fundo `--tinta`
    sólido e o `<main>` reservava 88px para ela, de modo que o hero
    começava abaixo de uma faixa branca. A causa raiz não era a cor — era
    tratar a barra como um bloco acima do conteúdo em vez de algo por
    cima dele.

    Agora ela nasce transparente sobre o hero e só ganha fundo quando a
    página rola (`.barra.pousada`, escrita pelo script abaixo). Sem JS ela
    nasce com fundo, porque aí não há como saber onde a rolagem está e uma
    barra transparente sobre conteúdo claro seria ilegível — o padrão
    seguro é o fundo, e o script o remove quando pode garantir o contexto.
  */
  .barra {
    position: fixed;
    z-index: 60;
    top: 0;
    left: 0;
    right: 0;
    background: var(--tinta);
    color: #fff;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s,
      background-color 0.45s ease;
  }
  /* Com JS, a barra começa transparente em cima do hero... */
  :global(.js) .barra.solta {
    background: transparent;
  }
  /* ...e ganha fundo assim que a página desce. */
  :global(.js) .barra.pousada {
    background: rgba(11, 30, 63, 0.86);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  .barra.oculta {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }
  /* Se o foco chega em qualquer link da barra escondida, ela reaparece na
     hora — teclado nunca fica preso atrás de uma barra invisível. */
  .barra.oculta:focus-within {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  /* Sem JavaScript a classe .oculta nunca é adicionada (é só JS que a
     alterna, ver script abaixo), então por padrão a barra já fica sempre
     visível e utilizável — progressive enhancement, não é preciso duplicar
     regra nenhuma aqui. */

  .barra-env {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 72px;
    padding-block: 12px;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--serif);
    font-weight: 300;
    font-size: 17px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: inherit;
    min-height: 44px;
  }
  .marca .amp {
    font-style: italic;
    opacity: 0.7;
  }
  .marca .curto {
    display: none;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-inline-start: auto;
  }
  .links a {
    text-decoration: none;
    color: inherit;
    font-size: 16px;
    opacity: 0.82;
    padding: 12px 16px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    transition: opacity 0.2s, background-color 0.2s;
  }
  .links a:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.12);
  }
  .links a[aria-current='page'] {
    opacity: 1;
    background: rgba(255, 255, 255, 0.16);
  }

  /*
    ── O menu suspenso das áreas ───────────────────────────────────────

    Pedido do cliente: passar o mouse em "Área de atuação" e aparecerem as
    duas áreas para escolher.

    Abre por `:hover` E por `:focus-within`: só hover deixaria o menu
    inalcançável por teclado. O `<a>` do gatilho continua sendo um link
    real para /areas/ — por isso não é `<button>` e não tem `role="menu"`:
    isto é um conjunto de links de navegação, e em `role="menu"` o leitor
    de tela anunciaria "item de menu" e as setas passariam a ser a única
    forma de percorrer. Tab percorre tudo, que é o certo para links.

    `padding-top` na ponte, não `margin`: com margem existe um vão morto
    entre o link e o menu, e o menu fecha no meio do caminho do cursor.
  */
  .tem-menu {
    position: relative;
  }
  .gatilho {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .chev {
    display: grid;
    place-items: center;
    transition: transform 0.25s;
    opacity: 0.7;
  }
  .tem-menu:hover .chev,
  .tem-menu:focus-within .chev {
    transform: rotate(180deg);
  }

  .menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 5;
    /* A ponte: a faixa transparente que mantém o hover vivo entre o link e
       o painel. Sem ela o menu fecha quando o cursor atravessa o vão. */
    padding-top: 12px;
    width: max-content;
    max-width: min(420px, calc(100vw - 2 * var(--gutter)));
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.22s ease, transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0.22s;
  }
  /*
    `visibility: hidden` é de propósito aqui, ao contrário da barra (ver a
    nota no topo): o menu fechado NÃO deve receber Tab. Sem isso o teclado
    passaria por dois links invisíveis antes de chegar ao próximo item, e o
    :focus-within nunca dispara porque o foco não entra num elemento
    visibility:hidden — exatamente o efeito que se quer para um menu
    fechado, e o oposto do que se quer para a barra.
  */
  .tem-menu:hover .menu,
  .tem-menu:focus-within .menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  /* Fechado à força pelo Escape, mesmo com o cursor ainda em cima. */
  .tem-menu.fechado .menu {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
  }

  .menu .item-area {
    display: grid;
    gap: 2px;
    padding: 13px 16px;
    border-radius: 12px;
    min-height: 44px;
    background: none;
    opacity: 1;
  }
  /* O painel: chapa azul opaca, não translúcida. Sobre o hero em vídeo um
     painel translúcido fica ilegível. */
  .menu {
    --fundo-menu: #0d2348;
  }
  .menu .item-area:first-of-type {
    margin-top: 0;
  }
  .menu > :global(*) {
    position: relative;
  }
  .menu::before {
    content: '';
    position: absolute;
    inset: 12px 0 0;
    background: var(--fundo-menu);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.4);
  }
  .menu .item-area b {
    position: relative;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.3;
  }
  .menu .item-area span {
    position: relative;
    font-size: 14.5px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.62);
    max-width: 42ch;
  }
  .menu .item-area:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  /* "Ver todas" fecha a lista, separada por filete. */
  .menu .item-area.todas {
    margin-top: 4px;
    padding-top: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0 0 12px 12px;
  }
  .menu .item-area.todas b {
    color: rgba(255, 255, 255, 0.78);
    font-weight: 400;
  }

  /* O painel interno precisa de recuo para o ::before não encostar nos
     itens. */
  .menu {
    padding-inline: 8px;
    padding-bottom: 8px;
  }

  .fala {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    font-size: 15px;
    white-space: nowrap;
    padding: 6px 16px 6px 6px;
    min-height: 44px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
  }
  /* Disco verde cheio com o glifo branco: a forma pela qual o WhatsApp é
     reconhecido. O vermelho imperial que morava aqui virou a cor de ação
     do site (setas dos botões) — ver a nota em base.css. */
  .fala .disco {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--whats);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: background-color 0.25s, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .fala:hover .disco {
    background: var(--whats-fundo);
    transform: scale(1.06);
  }

  /*
    Menu de celular com <details>/<summary>: widget nativo do HTML, abre e
    fecha por clique sem nenhum JavaScript (o navegador já implementa o
    toggle). Duas coisas que o <details> NÃO dá de graça, verificadas com
    Playwright real depois que a revisão pegou a suposição errada:
      - aria-expanded: o <summary> não tem papel de botão nativo com esse
        atributo gerenciado pelo navegador. Escrevemos "false" no HTML (sem
        JS, o painel de fato começa fechado, então o valor é correto desde
        o primeiro paint) e o script troca para "true"/"false" a cada toggle.
      - Escape: um <details> comum (sem o atributo experimental `popover`)
        não fecha com Escape em nenhum motor — testado em Chromium. O script
        adiciona o handler.
    Sem JS, o usuário ainda abre e fecha clicando no <summary> — só não tem
    o atalho de teclado nem o aria-expanded dinâmico, o que é aceitável como
    degradação (o elemento continua operável, só perde refinamento).
  */
  .movel {
    display: none;
  }
  .abre {
    display: inline-flex;
    align-items: center;
    padding: 12px 16px;
    min-height: 44px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    color: inherit;
    font: inherit;
    font-size: 15px;
    cursor: pointer;
    list-style: none;
  }
  /* remove o marcador triangular padrão do <summary> nos navegadores que o desenham */
  .abre::-webkit-details-marker {
    display: none;
  }
  .movel[open] .abre {
    background: rgba(255, 255, 255, 0.2);
  }

  .painel-menu {
    display: flex;
    flex-direction: column;
    padding: 8px var(--gutter) 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .painel-menu a {
    padding: 15px 4px;
    min-height: 44px;
    min-width: 44px;
    width: 100%;
    display: flex;
    align-items: center;
    text-decoration: none;
    color: #fff;
    font-family: var(--serif);
    font-weight: 300;
    font-size: 19px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .painel-menu a[aria-current='page'] {
    color: rgba(255, 255, 255, 0.7);
  }
  /* Sub-item de área no celular: recuado, corpo menor, sem serifa — é
     filho do item acima, e a hierarquia precisa se ver sem hover. */
  .painel-menu a.sub {
    padding-left: 18px;
    font-family: var(--sans);
    font-size: 16px;
    color: rgba(255, 255, 255, 0.74);
  }

  @media (max-width: 1080px) {
    .links {
      display: none;
    }
    .movel {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .marca .longo {
      display: none;
    }
    .marca .curto {
      display: inline;
    }
    .fala .rotulo {
      display: none;
    }
    .fala {
      padding: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .barra,
    .barra.oculta {
      transition: none;
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<script>
  // Progressive enhancement: tudo acima já funciona sem este script (barra
  // sempre visível, links sempre clicáveis). Este script só adiciona o
  // comportamento de esconder ao descer / mostrar ao subir, decidido com o
  // cliente, e a abertura do painel de celular.
  const elBarra = document.getElementById('barra');
  const elMovel = document.getElementById('movel');
  const elPainel = document.getElementById('painel-menu');
  const elAbre = document.getElementById('abre');

  if (
    elBarra instanceof HTMLElement &&
    elMovel instanceof HTMLDetailsElement &&
    elPainel &&
    elAbre
  ) {
    const barra = elBarra;
    const movel = elMovel;
    const painel = elPainel;
    const abre = elAbre;
    const calma = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ultimoY = 0;

    /* A barra só pode ficar transparente onde há um hero escuro atrás
       dela. Em página sem hero (políticas, contato, blog), transparente
       significaria texto branco sobre fundo branco. `data-sobreposta` no
       <body> é quem autoriza — ver Base.astro. */
    const podeSoltar = document.body.dataset.sobreposta === '1';

    function pousa() {
      if (!podeSoltar) return;
      /* solta enquanto a primeira dobra ainda domina a tela */
      const emCima = window.scrollY < window.innerHeight * 0.6;
      barra.classList.toggle('solta', emCima);
      barra.classList.toggle('pousada', !emCima);
    }

    function passo() {
      pousa();
      if (calma) return; // não esconde sob reduced-motion: barra sempre visível.
      const y = window.scrollY;
      const podeEsconder = y > ultimoY && y > 120 && !movel.open;
      barra.classList.toggle('oculta', podeEsconder);
      ultimoY = y;
    }
    passo();
    addEventListener('scroll', passo, { passive: true });
    addEventListener('resize', pousa);

    // Se o foco entra na barra escondida, tira a classe .oculta de vez (o
    // :focus-within do CSS já reexibe na hora; isso evita que a próxima
    // rolagem esconda tudo de novo com o foco lá dentro).
    barra.addEventListener('focusin', () => {
      barra.classList.remove('oculta');
    });

    // aria-expanded: o <summary> não gerencia isso sozinho, o navegador não
    // dá esse atributo de graça. Mantém sincronizado com o estado real do
    // <details> a cada toggle (clique, teclado, ou o fechamento por Escape
    // logo abaixo).
    movel.addEventListener('toggle', () => {
      abre.setAttribute('aria-expanded', String(movel.open));
      if (movel.open) {
        const primeiroLink = painel.querySelector('a');
        if (primeiroLink instanceof HTMLElement) primeiroLink.focus();
      }
    });

    painel.addEventListener('click', (evento) => {
      if ((evento.target as HTMLElement)?.tagName === 'A') movel.open = false;
    });

    /*
      ── O menu suspenso das áreas ────────────────────────────────────

      O menu já abre e fecha SEM JavaScript, por :hover e :focus-within no
      CSS. Este script só acrescenta o que CSS não alcança:
        - `aria-expanded` refletindo o estado real (CSS não escreve
          atributo, e um gatilho que diz "false" enquanto o menu está
          aberto mente para o leitor de tela);
        - Escape para fechar, que é o que se espera de qualquer menu.

      A classe `.fechado` existe para o Escape vencer o `:hover`: sem ela,
      fechar com o cursor parado sobre o gatilho não teria efeito nenhum,
      porque o :hover continua valendo. Ela é removida quando o cursor sai
      ou o foco vai para fora, para o menu voltar a funcionar.
    */
    const comMenu = document.querySelectorAll('.tem-menu');
    comMenu.forEach((caixa) => {
      if (!(caixa instanceof HTMLElement)) return;
      const gatilho = caixa.querySelector('.gatilho');
      if (!(gatilho instanceof HTMLElement)) return;

      const anuncia = (aberto: boolean) => {
        gatilho.setAttribute('aria-expanded', String(aberto));
      };
      /* `:has()` não serve para ler o estado aqui: é mais simples perguntar
         ao navegador se o elemento casa os mesmos seletores do CSS. */
      const aberto = () =>
        !caixa.classList.contains('fechado') &&
        (caixa.matches(':hover') || caixa.matches(':focus-within'));

      const sincroniza = () => anuncia(aberto());

      caixa.addEventListener('mouseenter', () => {
        caixa.classList.remove('fechado');
        sincroniza();
      });
      caixa.addEventListener('mouseleave', () => {
        caixa.classList.remove('fechado');
        sincroniza();
      });
      caixa.addEventListener('focusin', () => {
        caixa.classList.remove('fechado');
        sincroniza();
      });
      caixa.addEventListener('focusout', (evento) => {
        /* Só fecha quando o foco sai da caixa DE VERDADE: mover o foco de
           um item do menu para o outro dispara focusout na caixa também. */
        const indo = (evento as FocusEvent).relatedTarget;
        if (indo instanceof Node && caixa.contains(indo)) return;
        caixa.classList.remove('fechado');
        anuncia(false);
      });

      caixa.addEventListener('keydown', (evento) => {
        if ((evento as KeyboardEvent).key !== 'Escape') return;
        if (!aberto()) return;
        caixa.classList.add('fechado');
        anuncia(false);
        /* O foco volta ao gatilho: se estava num item do menu que acabou de
           ficar visibility:hidden, ele iria para o <body>. */
        gatilho.focus();
      });
    });

    // Um <details> comum (sem o atributo `popover`) não fecha com Escape em
    // nenhum motor — confirmado com teste real, a suposição anterior de que
    // "fecha na maioria dos navegadores" estava errada. O handler cobre o
    // foco em qualquer lugar (documento inteiro), inclusive dentro do
    // próprio painel ou no summary, e devolve o foco ao botão que abriu.
    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && movel.open) {
        movel.open = false;
        abre.focus();
      }
    });
  }
</script>
