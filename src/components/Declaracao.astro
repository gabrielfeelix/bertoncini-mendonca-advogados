---
/**
 * A declaração da home (26/10/2026), no padrão da "declaração partida" do
 * portfólio do Gabriel (~/dev/gabriel/portfolio, site/Home.jsx e home.css,
 * primitiva 10 de site/motion.js).
 *
 * Duas frases curtas em display, uma ancorada à esquerda e outra à direita,
 * com um degrau entre elas que deixa dois vazios em diagonal. Cada bloco tem
 * rótulo, frase e nota. As palavras das duas frases acendem em sequência,
 * presas à rolagem: saem de 6% de opacidade, 7px de desfoque e 12px abaixo.
 * A janela de cada palavra é ~2,6 vezes o passo entre elas, então três ou
 * quatro estão sempre em transição, e a leitura parece uma faixa passando
 * pela frase. A contagem é uma só para os dois blocos (cortar no meio fazia o
 * segundo abrir do zero e o par piscava duas vezes).
 *
 * A frase inteira está no HTML desde o início: o scroll só acende. Sem JS, ou
 * com menos movimento pedido, tudo aparece nítido e parado.
 */
const blocos = [
  {
    olho: 'O patrimônio',
    frase: ['Organizamos', 'em', 'vida', 'o', 'que', 'é', '*seu.*'],
    nota: 'Holding, testamento, doação e inventário pensados antes, para que a sucessão não vire disputa entre herdeiros.',
    lado: 'esq',
  },
  {
    olho: 'A presença digital',
    frase: ['E', 'protegemos', 'o', 'que', 'você', '*constrói*', 'na', 'internet.'],
    nota: 'Contratos, marca, dados pessoais e o que fazer quando algo dá errado, para quem vive e trabalha no digital.',
    lado: 'dir',
  },
];
---

<section class="declaracao" aria-label="O que o escritório faz">
  <div class="env par" data-par>
    {blocos.map((b) => (
      <div class:list={['bloco', b.lado]}>
        <p class="olho">{b.olho}</p>
        <p class="frase">
          {b.frase.map((w, k) => (
            <>
              <span class="w">{w.startsWith('*') ? <em>{w.slice(1, -1)}</em> : w}</span>
              {k < b.frase.length - 1 ? ' ' : ''}
            </>
          ))}
        </p>
        <p class="nota" data-nota>{b.nota}</p>
      </div>
    ))}
  </div>
</section>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    void (async () => {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);
      document.querySelectorAll<HTMLElement>('.declaracao [data-par]').forEach((par) => {
        const palavras = [...par.querySelectorAll<HTMLElement>('.w')];
        const total = Math.max(palavras.length, 1);
        const passo = 0.78 / total;
        const janela = 2.6 / total;
        const tl = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: { trigger: par, start: 'top 90%', end: 'bottom 45%', scrub: 0.4 },
        });
        palavras.forEach((w, i) => {
          tl.fromTo(
            w,
            { opacity: 0.06, filter: 'blur(7px)', y: 12 },
            { opacity: 1, filter: 'blur(0px)', y: 0, duration: janela },
            i * passo,
          );
        });
        par.querySelectorAll<HTMLElement>('[data-nota]').forEach((nota) => {
          gsap.from(nota, {
            y: 24,
            autoAlpha: 0,
            duration: 0.9,
            ease: 'power3.out',
            scrollTrigger: { trigger: nota, start: 'top 88%', once: true },
          });
        });
      });
    })();
  }
</script>

<style>
  .declaracao {
    padding-block: clamp(96px, 12vw, 180px);
    background: var(--branco);
  }
  /* Os dois blocos em coluna, um ancorado em cada lado, com 104px de degrau:
     é o respiro que separa "são dois assuntos" de "é um parágrafo quebrado". */
  .par {
    display: flex;
    flex-direction: column;
    gap: 104px;
  }
  .bloco {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 809px;
  }
  .bloco.esq {
    align-self: flex-start;
  }
  .bloco.dir {
    align-self: flex-end;
    text-align: right;
  }
  .bloco.dir .nota {
    margin-left: auto;
  }
  .olho {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2a62ad;
  }
  .frase {
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(40px, 6vw, 104px);
    line-height: 1.02;
    letter-spacing: -0.055em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .frase em {
    font-style: normal;
    color: #2a62ad;
  }
  /* inline-block para a opacidade por palavra não quebrar a quebra de linha */
  .w {
    display: inline-block;
    will-change: opacity, filter, transform;
  }
  .nota {
    max-width: 560px;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.45;
    color: var(--secundario);
    text-wrap: pretty;
  }
  @media (max-width: 760px) {
    .par {
      gap: 64px;
    }
    .bloco.dir {
      text-align: left;
      align-self: flex-start;
    }
    .bloco.dir .nota {
      margin-left: 0;
    }
  }
</style>
