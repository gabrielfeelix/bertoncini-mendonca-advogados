---
/**
 * Sócios: dois retratos em coluna, com a assinatura sobreposta, a OAB e a
 * bio. Migrado do protótipo (CSS linhas 225-250, HTML linhas 601-628).
 *
 * A OAB de cada sócio é exigência do Provimento 205/2021 e vem de
 * `src/lib/site.ts`, onde está marcada como placeholder. Nenhum valor de
 * inscrição é inventado aqui.
 *
 * Marcações para a Tarefa 5: `.sobe` em cada `<article>` e `.revela` na
 * moldura (reveal por clip-path). Sem JS o clip-path nunca é aplicado
 * (a regra só existe sob `.js`), então a foto aparece inteira.
 */
import { site } from '../lib/site';

interface Socio {
  /** Nome, quebrado em duas linhas na assinatura sobreposta. */
  nome: string;
  /** Sobrenome, segunda linha da assinatura. */
  sobrenome: string;
  /** Caminho do retrato em `public/`. */
  foto: string;
  /** Texto alternativo do retrato. */
  alt: string;
  /** Inscrição na OAB. Obrigatória pelo Provimento 205/2021. */
  oab: string;
  /** true quando a inscrição ainda é placeholder. */
  oabPlaceholder?: boolean;
  /** Bio curta. */
  bio: string;
  /** `style` inline do `<img>`, para enquadrar/corrigir cada foto. */
  estiloFoto?: string;
}

interface Props {
  /** Lista de sócios, na ordem. */
  socios?: Socio[];
}

const {
  socios = [
    {
      nome: 'Juscelino',
      sobrenome: 'Bertoncini',
      foto: '/media/socios/juscelino.jpeg',
      alt: 'Retrato de Juscelino Bertoncini',
      oab: site.socios[0].oab.valor,
      oabPlaceholder: site.socios[0].oab.placeholder,
      bio: 'Direito de família e compliance. Monta as regras internas que evitam que o problema chegue ao tribunal.',
    },
    {
      nome: 'Beatriz',
      sobrenome: 'Mendonça',
      foto: '/media/socios/beatriz.jpeg',
      alt: 'Retrato de Beatriz Mendonça',
      oab: site.socios[1].oab.valor,
      oabPlaceholder: site.socios[1].oab.placeholder,
      bio: 'Bio a escrever com ela, depois da conversa que ainda não aconteceu.',
      estiloFoto: 'object-position:50% 26%;filter:brightness(1.22) contrast(.96) saturate(1.06)',
    },
  ],
}: Props = Astro.props;
---

<section class="secao socios" id="socios">
  <div class="env">
    {socios.map((socio) => (
      <article class="par sobe">
        <figure>
          <div class="moldura revela">
            <img src={socio.foto} alt={socio.alt} loading="lazy" style={socio.estiloFoto} />
            <div class="chapa"></div><div class="veu"></div>
            <div class="grao" style="filter:url(#grao)"></div>
            <h3 class="assina">{socio.nome}<br />{socio.sobrenome}</h3>
          </div>
        </figure>
        <p class="oab" data-placeholder={socio.oabPlaceholder ? '1' : undefined}>{socio.oab}</p>
        <p class="bio">{socio.bio}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .socios :global(.env) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 5vw, 80px);
  }
  @media (max-width: 900px) {
    .socios :global(.env) {
      grid-template-columns: 1fr;
      gap: 64px;
    }
  }
  .socios .par:nth-child(2) {
    margin-top: clamp(0px, 9vw, 132px);
  }
  .par figure {
    margin: 0;
    position: relative;
  }
  .par .moldura {
    aspect-ratio: 3/4;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    background: #0b1e3f;
    isolation: isolate;
  }
  .par .moldura img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.7s ease;
  }
  .par .moldura .chapa {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(170deg, rgba(0, 67, 105, 0.16), transparent 52%);
    mix-blend-mode: soft-light;
  }
  .par .moldura .veu {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(to top, rgba(6, 15, 31, 0.92) 2%, rgba(6, 15, 31, 0.62) 22%, rgba(6, 15, 31, 0.12) 46%, transparent 62%);
  }
  /* Grão sobre a foto, que já está escurecida pelo véu azul. */
  .par .moldura .grao {
    position: absolute;
    inset: 0;
    z-index: 4;
    opacity: 0.14;
    pointer-events: none;
  }
  .par:hover .moldura img {
    transform: scale(1.05);
  }

  .par .assina {
    position: absolute;
    z-index: 5;
    left: clamp(20px, 2.6vw, 34px);
    right: clamp(20px, 2.6vw, 34px);
    bottom: clamp(20px, 2.6vw, 32px);
    color: #fff;
    font-family: var(--serif);
    font-weight: 200;
    font-size: clamp(38px, 5.6vw, 74px);
    letter-spacing: -0.035em;
    line-height: 0.92;
    text-shadow: 0 1px 40px rgba(6, 15, 31, 0.6);
  }
  .par .oab {
    margin-top: 22px;
    font-size: 14px;
    color: var(--imperial);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .par .bio {
    margin-top: 12px;
    color: var(--secundario);
    font-size: 16.5px;
    max-width: 36ch;
  }

  /* prefers-reduced-motion desliga todo movimento desta seção. A Tarefa 5
     traz o kill-switch global do protótipo; este bloco garante que o
     componente já cumpra a regra sozinho, em qualquer página. */
  @media (prefers-reduced-motion: reduce) {
    .socios,
    .socios * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
