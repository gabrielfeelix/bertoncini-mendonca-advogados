---
/** Faixa azul de chamada para contato, antes do rodapé. */
import { t, rota, type Idioma } from '../lib/i18n';
interface Props {
  titulo?: string;
  texto?: string;
  href?: string;
  lang?: Idioma;
}
const { lang = 'pt' } = Astro.props;
const tx = t(lang);
const { titulo = tx.chamada.titulo, texto = tx.chamada.texto, href = rota(lang, '/contato/') } = Astro.props;
---

<section class="chamada">
  <div class="container">
    <div>
      <h2 set:html={titulo} />
      <p>{texto}</p>
    </div>
    <a class="botao botao-claro" href={href}>{tx.chamada.botao}</a>
  </div>
</section>
