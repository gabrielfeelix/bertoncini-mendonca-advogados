---
/**
 * Chamada para contato no fim das páginas internas. Entra DENTRO do rodapé
 * (<Chamada slot="rodape" />, slot do Base), como a newsletter na home:
 * fundo, luz e monograma são os do rodapé, e as duas partes leem como uma
 * peça só, sem a emenda que cortava o degradê.
 */
import { t, rota, type Idioma } from '../lib/i18n';
interface Props {
  titulo?: string;
  texto?: string;
  href?: string;
  lang?: Idioma;
}
const { lang = 'pt' } = Astro.props;
const tx = t(lang);
const { titulo = tx.chamada.titulo, texto = tx.chamada.texto, href = rota(lang, '/contato/') } = Astro.props;
---

<section class="chamada">
  <div class="container">
    <div>
      <h2 set:html={titulo} />
      <p>{texto}</p>
    </div>
    <a class="botao botao-claro" href={href}>{tx.chamada.botao}</a>
  </div>
</section>
