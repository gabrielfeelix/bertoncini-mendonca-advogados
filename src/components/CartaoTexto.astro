---
/**
 * Cartão de artigo da lista `/blog/`. Migrado do protótipo: HTML nas
 * linhas 691-737, CSS nas linhas 289-326 (`.texto`, `.texto .capa`,
 * `.texto h4`, `.texto .pe`).
 *
 * Três diferenças em relação ao protótipo, todas por motivo:
 *
 * 1. **A capa passa pelo `<Image>` do Astro.** No protótipo era um `<img>`
 *    solto para um arquivo local de mentira. Aqui a capa é uma URL remota do
 *    Storage do Supabase, e o `<Image>` só a otimiza porque o host está
 *    autorizado em `image.domains` (astro.config.mjs) e porque o artigo traz
 *    `capaLargura` e `capaAltura` do banco. Sem as duas o Astro recusa a
 *    imagem remota, e é por isso que a Tarefa 10 as gravou.
 *
 * 2. **O artigo pode não ter capa.** O schema deixa `capa` opcional, e a
 *    tabela trata capa como tudo-ou-nada. Sem capa, o cartão mostra uma
 *    chapa azul no lugar da imagem, em vez de um buraco branco.
 *
 *    O que NÃO existe mais: a camada de cor (`mix-blend-mode: color`) que
 *    tingia toda foto de azul, e o grão por cima dela. O cliente não quer
 *    tratamento de cor sobre imagem em lugar nenhum do site — a foto sai
 *    com a cor dela. Sobrou uma vinheta bem discreta, e ela existe por
 *    função, não por efeito: o rótulo de categoria é branco e precisa se
 *    sustentar sobre qualquer imagem.
 *
 * 3. **O `<h4>` do protótipo virou o elemento que a prop `nivel` pedir.** Na
 *    lista o cartão vive sob um `<h2>` de seção, então o título dele é um
 *    `<h3>`; o protótipo usava `<h4>` porque a home tinha outra hierarquia.
 *    Pular nível de título quebra a navegação por cabeçalho do leitor de
 *    tela.
 *
 * O cartão inteiro é um `<a>`: funciona clicado e pelo teclado sem uma linha
 * de JavaScript. O movimento de hover é só CSS e some com
 * `prefers-reduced-motion`.
 *
 * `.sobe` faz o cartão entrar com a revelação por rolagem, escalonada entre
 * irmãos: numa grade de seis, eles chegam em cascata em vez de a seção
 * inteira aparecer de uma vez. O atraso vem de `--i`, escrito pelo script.
 */
import { Image } from 'astro:assets';
import { dataLegivel, type Artigo } from '~/lib/artigos';

interface Props {
  artigo: Artigo;
  /** Nível do título do cartão, para não pular degrau na hierarquia. */
  nivel?: 2 | 3;
  /** Tamanhos que o navegador deve considerar ao escolher a capa. */
  sizes?: string;
  /**
   * Cartão grande, na horizontal: foto à esquerda, texto com resumo à
   * direita. É o mais recente no topo da lista do blog.
   */
  grande?: boolean;
  /** Atributos `data-*` para filtro e ordem na lista do blog. */
  dados?: Record<`data-${string}`, string>;
}

const {
  artigo,
  nivel = 3,
  sizes = '(min-width: 1080px) 420px, (min-width: 620px) 45vw, 92vw',
  grande = false,
  dados = {},
} = Astro.props;

const d = artigo.data;
const Titulo = `h${nivel}` as 'h2' | 'h3';
---

{/* Cartão no padrão das notícias da Apple (06/11/2026): foto limpa, sem
    pílula nem vinheta por cima; embaixo, a categoria em azul, o título em
    sans e a data. A peça inteira é o link. */}
<a class:list={['texto', 'sobe', { grande }]} href={`/blog/${artigo.id}/`} {...dados}>
  <div class="capa">
    {
      d.capa && d.capaLargura && d.capaAltura ? (
        <Image
          src={d.capa}
          alt={d.capaAlt ?? ''}
          width={d.capaLargura}
          height={d.capaAltura}
          widths={[400, 640, 900, 1200]}
          sizes={grande ? '(min-width: 1080px) 760px, 92vw' : sizes}
          loading={grande ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="semcapa" aria-hidden="true" />
      )
    }
  </div>

  <div class="corpo">
    <p class="classe">{d.categoria}</p>
    <Titulo class="nome">{d.titulo}</Titulo>
    {grande && <p class="resumo">{d.resumo}</p>}
    {/* Botão visível (06/11/2026): sem ele o cartão não dizia que era
        clicável. É um span, e não um <a>: o cartão inteiro já é o link. */}
    <div class="pe">
      <time datetime={d.publicadoEm.toISOString()}>{dataLegivel(d.publicadoEm)}</time>
      <span class="botao-ler" aria-hidden="true">Ler o texto</span>
    </div>
  </div>
</a>

<style>
  .texto {
    display: flex;
    flex-direction: column;
    min-height: 44px;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(11, 30, 63, 0.06);
    transition: box-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .texto:hover {
    box-shadow:
      0 0 0 1px rgba(11, 30, 63, 0.06),
      0 18px 44px -18px rgba(11, 30, 63, 0.22);
  }

  .capa {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #e6eaef;
  }
  .capa :global(img),
  .capa .semcapa {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .texto:hover .capa :global(img) {
    transform: scale(1.035);
  }

  .corpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2vw, 28px) clamp(20px, 2vw, 28px) clamp(22px, 2.2vw, 30px);
  }
  .classe {
    font-size: 14px;
    font-weight: 500;
    color: #2a62ad;
  }
  .nome {
    margin-top: 8px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(19px, 1.5vw, 22px);
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .resumo {
    margin-top: 12px;
    max-width: 42ch;
    font-size: 17px;
    line-height: 1.5;
    color: #5b6b7f;
  }
  /* A data vai para a base: títulos de uma e de duas linhas deixariam as
     datas desalinhadas entre cartões vizinhos. */
  .pe {
    margin-top: auto;
    padding-top: 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #7a8798;
  }
  .botao-ler {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 16px;
    border-radius: 999px;
    background: #f2f4f7;
    font-size: 14px;
    font-weight: 500;
    color: var(--tinta);
    transition: background-color 0.25s, color 0.25s;
  }
  .texto:hover .botao-ler,
  .texto:focus-visible .botao-ler {
    background: var(--tinta);
    color: #fff;
  }

  /* ── cartão grande, na horizontal ──────────────────────────────── */
  .grande {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  }
  .grande .capa {
    aspect-ratio: auto;
    min-height: 100%;
  }
  .grande .corpo {
    justify-content: center;
    padding: clamp(28px, 4vw, 64px);
  }
  .grande .nome {
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .grande .pe {
    margin-top: 0;
    padding-top: 26px;
    justify-content: flex-start;
    gap: 18px;
  }
  .grande .botao-ler {
    order: -1;
    min-height: 44px;
    padding: 0 22px;
    font-size: 16px;
    background: var(--tinta);
    color: #fff;
  }
  .grande:hover .botao-ler {
    background: #2a62ad;
  }
  @media (max-width: 860px) {
    .grande {
      display: flex;
    }
    .grande .capa {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
  }

  .texto:focus-visible {
    outline: 2px solid #2a62ad;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .texto,
    .texto * {
      transition: none !important;
    }
    .texto:hover .capa :global(img) {
      transform: none;
    }
  }
</style>
