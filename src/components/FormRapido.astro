---
/**
 * Formulário curto do fim dos artigos ("Fale com o escritório").
 *
 * Duas colunas, sem foto de fundo: à esquerda, em azul-noite, quem
 * responde (os dois sócios) e os atalhos de WhatsApp e e-mail; à direita,
 * o formulário em branco, com rótulos acima dos campos como em /contato/.
 * A versão anterior (cartão escuro com foto, título centrado, campos em
 * pílula) ficou parecida demais com a do Martinelli.
 *
 * Mesma rota (/api/contato), mesmas iscas e mesmo envio sem sair da página
 * do formulário completo. Sem JavaScript, a API devolve a pessoa para
 * /contato/, onde o resultado aparece. `assuntoPadrao` chega já escolhido
 * (a categoria do artigo, quando é uma das áreas).
 */
import Icone from './Icone.astro';
import Seletor from './Seletor.astro';
import { CAMPOS_ISCA } from '../lib/antispam';
import { areasDoIdioma } from '../lib/areas';
import { site } from '../lib/site';
import { t } from '../lib/i18n';

interface Props {
  assuntoPadrao?: string;
}
const { assuntoPadrao = '' } = Astro.props;
const c = t('pt').contato;
const areas = await areasDoIdioma('pt');
const ASSUNTOS = [...areas.map((a) => a.data.nome), c.outroAssunto, c.naoSei];
const escolhido = ASSUNTOS.find((a) => a.toLowerCase() === assuntoPadrao.toLowerCase()) ?? '';
---

<section class="fale" aria-labelledby="fale-titulo">
  <div class="fale-cartao">
    <div class="fale-lado">
      <h2 id="fale-titulo">Fale com o <strong>escritório</strong></h2>
      <p>Conte o seu caso com as suas palavras. Respondemos pelo e-mail que você informar.</p>

      <div class="quem">
        <div class="avatares" aria-hidden="true">
          {site.socios.map((s) => <img src={`${s.retrato}-560.jpg`} alt="" width="560" height="840" loading="lazy" />)}
        </div>
        <p>Quem lê é um dos sócios:<br /><strong>{site.socios.map((s) => s.nome).join(' e ')}</strong></p>
      </div>

      <ul class="atalhos">
        <li><a href={site.whatsapp.valor} target="_blank" rel="noopener"><Icone nome="whatsapp" tamanho={18} /><span>WhatsApp {site.telefone.valor}</span></a></li>
        <li><a href={`mailto:${site.email.valor}`}><Icone nome="email" tamanho={18} /><span set:html={site.email.valor.replace('@', '@<wbr>')} /></a></li>
      </ul>
    </div>

    <form class="fale-form form" action="/api/contato" method="post" data-erros={JSON.stringify(c.erros)}>
      <input type="hidden" name="idioma" value="pt" />
      <div class="linha-2">
        <div>
          <label for="fr-nome">{c.nome} *</label>
          <input id="fr-nome" name="nome" type="text" autocomplete="name" required maxlength="120" />
        </div>
        <div>
          <label for="fr-email">{c.email} *</label>
          <input id="fr-email" name="email" type="email" autocomplete="email" required maxlength="254" />
        </div>
      </div>
      <div class="linha-2">
        <div>
          <label for="fr-telefone">{c.telefone}</label>
          <input id="fr-telefone" name="telefone" type="tel" autocomplete="tel" maxlength="40" />
        </div>
        <div>
          <label for="fr-assunto">{c.assunto}</label>
          <select id="fr-assunto" name="assunto" data-seletor>
            <option value="">{c.selecione}</option>
            {ASSUNTOS.map((a) => <option value={a} selected={a === escolhido}>{a}</option>)}
          </select>
        </div>
      </div>
      <div>
        <label for="fr-mensagem">{c.mensagem} *</label>
        <textarea id="fr-mensagem" name="mensagem" required maxlength="5000"></textarea>
      </div>

      <div class="isca" aria-hidden="true">
        {CAMPOS_ISCA.map((campo) => <input type="text" name={campo} tabindex="-1" autocomplete="off" />)}
      </div>

      <Seletor />
      <div class="envio">
        <button type="submit" class="botao">Enviar mensagem</button>
        <p class="nota">
          Enviar não estabelece relação de patrocínio nem substitui uma consulta. Veja a{' '}
          <a href="/politica-de-privacidade/">política de privacidade</a>.
        </p>
      </div>
      <p class="resultado fale-resultado" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<script>
  for (const forma of document.querySelectorAll<HTMLFormElement>('.fale-form')) {
    const resultado = forma.querySelector<HTMLElement>('.fale-resultado');
    const botao = forma.querySelector<HTMLButtonElement>('button[type="submit"]');
    const erros = JSON.parse(forma.dataset.erros ?? '{}') as Record<string, string>;
    if (!resultado || !botao) continue;
    forma.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      botao.disabled = true;
      resultado.hidden = false;
      resultado.classList.remove('falhou');
      resultado.textContent = 'Enviando a mensagem.';
      try {
        const resposta = await fetch('/api/contato', {
          method: 'POST',
          body: new FormData(forma),
          headers: { accept: 'application/json' },
        });
        const dados = (await resposta.json().catch(() => ({}))) as { codigo?: string };
        if (resposta.ok) {
          forma.reset();
          resultado.textContent = 'Recebemos a sua mensagem. A resposta vai para o e-mail que você informou.';
        } else {
          resultado.classList.add('falhou');
          resultado.textContent = erros[dados.codigo ?? ''] ?? erros.envio;
        }
      } catch {
        resultado.classList.add('falhou');
        resultado.textContent = 'Sem conexão no momento. Tente de novo em instantes.';
      } finally {
        botao.disabled = false;
      }
    });
  }
</script>

<style>
  .fale { padding: 32px 20px 88px; }
  .fale-cartao {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    border-radius: 16px; overflow: hidden;
    background: #fff; border: 1px solid var(--linha);
    box-shadow: 0 24px 60px rgba(11, 30, 63, .1);
  }

  /* ---------- Lado azul: quem responde e atalhos ---------- */
  .fale-lado {
    position: relative; overflow: hidden;
    padding: 44px 40px;
    background:
      radial-gradient(120% 80% at 0% 100%, rgba(0, 67, 105, .9) 0%, rgba(0, 67, 105, 0) 60%),
      var(--azul);
    color: rgba(248, 247, 242, .85);
  }
  .fale-lado::after {
    content: ''; position: absolute; right: -60px; bottom: -40px;
    width: 260px; height: 282px; opacity: .06;
    background: url('/media/marca/monograma-creme.svg') center / contain no-repeat;
    pointer-events: none;
  }
  .fale-lado h2 { color: #fff; font-size: 32px; font-weight: 300; line-height: 1.2; margin-bottom: 12px; }
  .fale-lado h2 strong { font-weight: 700; }
  .fale-lado > p { margin-bottom: 28px; }

  .quem { display: flex; align-items: center; gap: 14px; margin-bottom: 28px; }
  .avatares { display: flex; flex: none; }
  .avatares img {
    width: 52px; height: 52px; border-radius: 50%;
    object-fit: cover; object-position: 50% 18%;
    border: 2px solid var(--azul);
  }
  .avatares img + img { margin-left: -14px; }
  .quem p { margin: 0; font-size: 14px; line-height: 1.45; }
  .quem strong { color: #fff; font-weight: 500; }

  .atalhos { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; position: relative; z-index: 1; }
  .atalhos a {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px; border-radius: 10px;
    border: 1px solid rgba(248, 247, 242, .18);
    color: #fff; text-decoration: none; font-size: 15px;
    transition: background-color .15s ease, border-color .15s ease;
  }
  .atalhos a:hover { background: rgba(248, 247, 242, .08); border-color: rgba(248, 247, 242, .4); color: #fff; }
  .atalhos span { overflow-wrap: break-word; min-width: 0; }

  /* ---------- Formulário ---------- */
  .fale-form { padding: 40px 44px; gap: 16px; }
  .fale-form textarea { min-height: 130px; }
  .fale-form input, .fale-form select, .fale-form textarea { border-radius: 6px; }
  .envio { display: flex; align-items: center; gap: 12px 24px; flex-wrap: wrap; }
  .envio .nota { flex: 1 1 260px; margin: 0; font-size: 13px; }
  .fale-resultado { margin: 0; }

  @media (max-width: 900px) {
    .fale-cartao { grid-template-columns: 1fr; }
    .fale-lado { padding: 36px 24px; }
    .fale-form { padding: 32px 24px; }
  }
  @media (max-width: 680px) {
    .fale { padding: 24px 16px 64px; }
    .fale-lado h2 { font-size: 27px; }
  }
</style>
