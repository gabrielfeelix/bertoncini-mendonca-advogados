---
/**
 * Seletor próprio no lugar do dropdown nativo (o do sistema, com o realce
 * azul e a seta padrão, destoava do site).
 *
 * Uso: marque o <select> com `data-seletor` e inclua <Seletor /> uma vez no
 * componente do formulário. Não gera marcação: o script melhora o <select>
 * que já está na página. O nativo continua no formulário, com o mesmo
 * `name` (escondido, mas enviado), então o POST sem JavaScript, o FormData
 * e o `form.reset()` seguem iguais. Sem JavaScript, fica o nativo.
 *
 * Acessibilidade: padrão "select-only combobox" do WAI-ARIA (APG). O foco
 * fica sempre no gatilho; a opção ativa é indicada por
 * aria-activedescendant. O rótulo é o <label for> do próprio <select>.
 */
---

<script>
  const CHEVRON =
    '<svg class="seletor-seta" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>';
  const CHECK =
    '<svg class="seletor-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
  const ALTURA_MAX = 280;
  let contador = 0;

  /* Para a busca por letras: "direito" acha "Direito"; "imovel" acha "Imóvel". */
  const normaliza = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  function melhora(select: HTMLSelectElement) {
    if (select.dataset.seletorPronto) return;
    select.dataset.seletorPronto = '1';
    const base = `seletor-${++contador}`;

    /* Rótulo: aria-labelledby já existente ou o <label> do select (ganha id se não tiver). */
    let rotuloId = select.getAttribute('aria-labelledby') ?? '';
    const rotulo = select.labels?.[0];
    if (!rotuloId && rotulo) {
      if (!rotulo.id) rotulo.id = `${select.id || base}-rotulo`;
      rotuloId = rotulo.id;
    }

    const caixa = document.createElement('div');
    caixa.className = 'seletor';
    const gatilho = document.createElement('div');
    gatilho.className = 'seletor-gatilho';
    gatilho.setAttribute('role', 'combobox');
    gatilho.tabIndex = select.disabled ? -1 : 0;
    gatilho.setAttribute('aria-haspopup', 'listbox');
    gatilho.setAttribute('aria-expanded', 'false');
    gatilho.setAttribute('aria-controls', `${base}-lista`);
    if (rotuloId) gatilho.setAttribute('aria-labelledby', rotuloId);
    if (select.disabled) gatilho.setAttribute('aria-disabled', 'true');
    /* Mesmo raio do nativo: cada formulário arredonda os campos do seu jeito. */
    gatilho.style.borderRadius = getComputedStyle(select).borderRadius;
    const valor = document.createElement('span');
    valor.className = 'seletor-valor';
    gatilho.append(valor);
    gatilho.insertAdjacentHTML('beforeend', CHEVRON);

    const lista = document.createElement('ul');
    lista.className = 'seletor-lista';
    lista.id = `${base}-lista`;
    lista.setAttribute('role', 'listbox');
    lista.tabIndex = -1;
    if (rotuloId) lista.setAttribute('aria-labelledby', rotuloId);
    lista.hidden = true;

    const opcoes = Array.from(select.options).map((op, i) => {
      const li = document.createElement('li');
      li.id = `${base}-op-${i}`;
      li.setAttribute('role', 'option');
      li.className = op.value === '' ? 'seletor-opcao vazia' : 'seletor-opcao';
      li.dataset.indice = String(i);
      const texto = document.createElement('span');
      texto.textContent = op.text;
      li.append(texto);
      li.insertAdjacentHTML('beforeend', CHECK);
      lista.append(li);
      return li;
    });

    /* O nativo fica no formulário, fora da vista e fora do Tab. */
    select.before(caixa);
    caixa.append(select, gatilho, lista);
    select.classList.add('seletor-nativo');
    select.tabIndex = -1;
    select.setAttribute('aria-hidden', 'true');

    let ativo = select.selectedIndex;

    function mostraValor() {
      const i = select.selectedIndex;
      const op = select.options[i];
      valor.textContent = op?.text ?? '';
      gatilho.classList.toggle('vazio', !op || op.value === '');
      opcoes.forEach((li, j) => li.setAttribute('aria-selected', String(j === i)));
    }

    function marcaAtivo(i: number) {
      ativo = Math.max(0, Math.min(opcoes.length - 1, i));
      opcoes.forEach((li, j) => li.classList.toggle('ativo', j === ativo));
      const li = opcoes[ativo];
      if (!li) return;
      gatilho.setAttribute('aria-activedescendant', li.id);
      /* Rola só a lista (scrollIntoView rolaria a página inteira junto). */
      if (li.offsetTop < lista.scrollTop) lista.scrollTop = li.offsetTop - 6;
      else if (li.offsetTop + li.offsetHeight > lista.scrollTop + lista.clientHeight)
        lista.scrollTop = li.offsetTop + li.offsetHeight - lista.clientHeight + 6;
    }

    /* Fixa na tela (position: fixed) para não ser cortada por cartão com
       overflow: hidden; abre para cima quando falta espaço embaixo. */
    function posiciona() {
      const r = gatilho.getBoundingClientRect();
      const altura = Math.min(lista.scrollHeight, ALTURA_MAX);
      const abaixo = window.innerHeight - r.bottom;
      const paraCima = abaixo < altura + 12 && r.top > abaixo;
      lista.classList.toggle('para-cima', paraCima);
      lista.style.left = `${Math.max(8, r.left)}px`;
      lista.style.width = `${Math.min(r.width, window.innerWidth - 16)}px`;
      lista.style.top = paraCima ? '' : `${r.bottom + 6}px`;
      lista.style.bottom = paraCima ? `${window.innerHeight - r.top + 6}px` : '';
    }

    const aberto = () => !lista.hidden;

    function abre(indice = select.selectedIndex) {
      if (aberto() || select.disabled) return;
      lista.hidden = false;
      gatilho.setAttribute('aria-expanded', 'true');
      caixa.classList.add('aberto');
      posiciona();
      marcaAtivo(indice < 0 ? 0 : indice);
      document.addEventListener('pointerdown', foraDaCaixa, true);
      window.addEventListener('scroll', aoRolar, true);
      window.addEventListener('resize', posiciona);
    }

    function fecha() {
      if (!aberto()) return;
      lista.hidden = true;
      gatilho.setAttribute('aria-expanded', 'false');
      gatilho.removeAttribute('aria-activedescendant');
      caixa.classList.remove('aberto');
      document.removeEventListener('pointerdown', foraDaCaixa, true);
      window.removeEventListener('scroll', aoRolar, true);
      window.removeEventListener('resize', posiciona);
    }

    function escolhe(i: number) {
      if (i !== select.selectedIndex) {
        select.selectedIndex = i;
        select.dispatchEvent(new Event('input', { bubbles: true }));
        select.dispatchEvent(new Event('change', { bubbles: true }));
      }
      mostraValor();
    }

    function foraDaCaixa(e: Event) {
      if (!caixa.contains(e.target as Node)) fecha();
    }
    function aoRolar(e: Event) {
      if (e.target !== lista) posiciona();
    }

    /* Busca por letras: o que for digitado em até meio segundo vira um prefixo. */
    let busca = '';
    let relogio = 0;
    function procura(letra: string) {
      window.clearTimeout(relogio);
      relogio = window.setTimeout(() => (busca = ''), 500);
      busca += normaliza(letra);
      /* A mesma letra repetida passa para a próxima opção com ela. */
      const repetida = busca.length > 1 && [...busca].every((l) => l === busca[0]);
      const prefixo = repetida ? busca[0] : busca;
      const inicio = aberto() ? ativo : select.selectedIndex;
      const ordem = [...opcoes.keys()].map((k) => (inicio + (repetida || busca.length === 1 ? 1 : 0) + k) % opcoes.length);
      return ordem.find((k) => normaliza(select.options[k].text).startsWith(prefixo)) ?? -1;
    }

    gatilho.addEventListener('keydown', (e) => {
      if (select.disabled) return;
      const { key, altKey } = e;
      if (!aberto()) {
        if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(key)) abre();
        else if (key === 'Home') abre(0);
        else if (key === 'End') abre(opcoes.length - 1);
        else if (key.length === 1 && !e.ctrlKey && !e.metaKey && !altKey) {
          const k = procura(key);
          abre(k >= 0 ? k : undefined);
        } else return;
        e.preventDefault();
        return;
      }
      switch (key) {
        case 'ArrowDown': marcaAtivo(ativo + 1); break;
        case 'ArrowUp':
          if (altKey) { escolhe(ativo); fecha(); } else marcaAtivo(ativo - 1);
          break;
        case 'Home': marcaAtivo(0); break;
        case 'End': marcaAtivo(opcoes.length - 1); break;
        case 'PageDown': marcaAtivo(ativo + 10); break;
        case 'PageUp': marcaAtivo(ativo - 10); break;
        case 'Enter': escolhe(ativo); fecha(); break;
        case 'Escape': fecha(); break;
        /* Tab fecha sem escolher e deixa o foco seguir. */
        case 'Tab': fecha(); return;
        default:
          /* Espaço no meio de uma busca ("Direito D...") é letra, não confirmação. */
          if (key === ' ' && !busca) { escolhe(ativo); fecha(); break; }
          if (key.length === 1 && !e.ctrlKey && !e.metaKey && !altKey) {
            const k = procura(key);
            if (k >= 0) marcaAtivo(k);
            break;
          }
          return;
      }
      e.preventDefault();
    });

    gatilho.addEventListener('click', () => (aberto() ? fecha() : abre()));
    gatilho.addEventListener('blur', () => fecha());

    /* O foco não sai do gatilho ao tocar na lista (nem no celular). */
    lista.addEventListener('mousedown', (e) => e.preventDefault());
    lista.addEventListener('pointermove', (e) => {
      const li = (e.target as Element).closest<HTMLElement>('[role="option"]');
      if (li) marcaAtivo(Number(li.dataset.indice));
    });
    lista.addEventListener('click', (e) => {
      const li = (e.target as Element).closest<HTMLElement>('[role="option"]');
      if (!li) return;
      /* Evita que um <label> em volta reaja ao clique. */
      e.preventDefault();
      escolhe(Number(li.dataset.indice));
      fecha();
      gatilho.focus();
    });

    /* Clique no <label for> (ou validação do navegador) foca o nativo: passa para o gatilho. */
    select.addEventListener('focus', () => gatilho.focus());
    select.addEventListener('change', mostraValor);
    /* form.reset() não dispara change: relê o valor depois que o reset termina. */
    select.form?.addEventListener('reset', () => window.setTimeout(() => { fecha(); mostraValor(); }, 0));

    mostraValor();
  }

  for (const select of document.querySelectorAll<HTMLSelectElement>('select[data-seletor]')) melhora(select);
</script>

<style is:global>
  .seletor { position: relative; }

  /* Fora da vista, mas no formulário (display: none tiraria a validação de `required`). */
  .seletor > .seletor-nativo {
    position: absolute !important; left: 0; bottom: 0;
    width: 1px !important; height: 1px !important;
    padding: 0 !important; border: 0 !important; margin: 0;
    opacity: 0; pointer-events: none;
  }

  /* Gatilho com a cara dos outros campos do formulário (.form input). */
  .seletor-gatilho {
    display: flex; align-items: center; gap: 10px;
    width: 100%; min-height: 48px;
    font: 16px/1.5 var(--fonte); color: var(--texto);
    padding: 11px 12px 11px 14px;
    border: 1px solid #cfd5dc; border-radius: 4px;
    background: #fff;
    cursor: pointer; user-select: none; -webkit-tap-highlight-color: transparent;
    transition: border-color .15s ease;
  }
  .seletor-gatilho:hover { border-color: var(--azul-claro); }
  .seletor-gatilho:focus, .seletor-gatilho:focus-visible { border-color: var(--azul-medio); outline: 2px solid rgba(0, 67, 105, .2); outline-offset: 0; }
  .seletor.aberto .seletor-gatilho { border-color: var(--azul-medio); }
  .seletor-gatilho[aria-disabled='true'] { cursor: not-allowed; opacity: .6; }
  .seletor-valor { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .seletor-gatilho.vazio .seletor-valor { color: var(--texto-suave); }
  .seletor-seta { flex: none; color: var(--azul-claro); transition: transform .2s ease; }
  .seletor.aberto .seletor-seta { transform: rotate(180deg); color: var(--azul-medio); }

  /* Lista: o mesmo cartão do submenu do topo. */
  .seletor-lista {
    position: fixed; z-index: 45;
    list-style: none; margin: 0; padding: 6px;
    max-height: 280px; overflow-y: auto; overscroll-behavior: contain;
    background: #fff; border-radius: 10px;
    box-shadow: 0 18px 44px rgba(11, 30, 63, .22), 0 2px 6px rgba(11, 30, 63, .08);
    font: 16px/1.4 var(--fonte);
    animation: seletor-abre .15s ease;
  }
  .seletor-lista[hidden] { display: none; }
  .seletor-lista.para-cima { animation-name: seletor-abre-cima; }
  .seletor-opcao {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 10px 14px; border-radius: 6px;
    color: var(--texto); cursor: pointer;
  }
  .seletor-opcao.vazia { color: var(--texto-suave); }
  .seletor-opcao.ativo { background: var(--fundo-cinza); color: var(--azul-medio); }
  /* A opção vazia ("Selecione") nunca aparece como escolhida. */
  .seletor-opcao:not(.vazia)[aria-selected='true'] { font-weight: 500; color: var(--azul); }
  .seletor-check { flex: none; color: var(--azul-medio); visibility: hidden; }
  .seletor-opcao:not(.vazia)[aria-selected='true'] .seletor-check { visibility: visible; }

  @keyframes seletor-abre { from { opacity: 0; transform: translateY(4px); } }
  @keyframes seletor-abre-cima { from { opacity: 0; transform: translateY(-4px); } }
  @media (prefers-reduced-motion: reduce) {
    .seletor-lista, .seletor-seta, .seletor-gatilho { animation: none; transition: none; }
  }
</style>
