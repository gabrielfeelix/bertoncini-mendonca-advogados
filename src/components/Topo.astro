---
/**
 * Cabeçalho da v3: faixa de contato + barra com logo e menu, presos no
 * topo (position: fixed).
 *
 * Nas páginas que abrem com foto (`sobreposto`), o cabeçalho nasce
 * transparente, por cima da imagem, como no site do Martinelli. Ao rolar,
 * ganha o azul-noite da marca (#0B1E3F) e a faixa de contato recolhe.
 * Sem JavaScript ele já nasce azul, para nunca ficar texto branco sobre
 * conteúdo claro.
 *
 * No celular o menu abre por um botão; sem JavaScript a lista aparece
 * aberta, então ninguém fica sem menu.
 */
import { site } from '../lib/site';
import { areasDoIdioma } from '../lib/areas';
import { t, rota, type Idioma } from '../lib/i18n';
import Icone from './Icone.astro';

interface Props {
  /** Endereço em PORTUGUÊS da seção atual (chave do menu), para aria-current. */
  paginaAtual?: string;
  /** true quando a página abre com foto escura e o cabeçalho vai por cima. */
  sobreposto?: boolean;
  lang?: Idioma;
  /** Endereço desta mesma página no outro idioma (seletor PT · EN). */
  alternativa?: string;
}
const { paginaAtual, sobreposto = false, lang = 'pt', alternativa } = Astro.props;
const tx = t(lang);
const areas = await areasDoIdioma(lang);
const ativo = (chave: string) =>
  paginaAtual === chave || (chave !== '/' && paginaAtual?.startsWith(chave)) ? 'page' : undefined;
/* Sem página equivalente (ex.: blog), o seletor leva à home do outro idioma. */
const outro = alternativa ?? (lang === 'pt' ? '/en/' : '/');
---

<div class="topo" data-sobreposto={sobreposto ? '' : undefined}>
  <div class="topbar-env">
    <div class="topbar">
      <div class="container">
        <span>{site.cidade}/{site.estado} · {tx.atendimento}</span>
        <span class="topbar-contato">
          <a href={site.whatsapp.valor} rel="noopener" target="_blank"><Icone nome="whatsapp" />{site.telefone.valor}</a>
          <a href={`mailto:${site.email.valor}`}><Icone nome="email" />{site.email.valor}</a>
          <a href={site.redes.instagram.valor} rel="noopener" target="_blank"><Icone nome="instagram" />Instagram</a>
          <span class="idioma" role="group" aria-label={tx.topo.idiomaAria}>
            {lang === 'pt' ? (
              <><strong aria-current="true" lang="pt-BR">PT</strong><span aria-hidden="true">·</span><a href={outro} lang="en" hreflang="en" aria-label="English version">EN</a></>
            ) : (
              <><a href={outro} lang="pt-BR" hreflang="pt-BR" aria-label="Versão em português">PT</a><span aria-hidden="true">·</span><strong aria-current="true" lang="en">EN</strong></>
            )}
          </span>
        </span>
      </div>
    </div>
  </div>

  <header class="cabecalho">
    <div class="container">
      <a class="logo" href={rota(lang, '/')} aria-label={`${site.nome}, ${tx.topo.inicioAria}`}>
        <img src="/media/marca/lockup-creme.svg" alt={site.nome} width="550" height="196" />
      </a>

      <button class="abre-menu" type="button" aria-expanded="false" aria-controls="menu-principal" hidden>
        <span class="hamburguer" aria-hidden="true"></span>
        {tx.topo.menu}
      </button>

      <nav id="menu-principal" class="menu" aria-label={tx.topo.menuAria}>
        <ul>
          {tx.nav.map((item) => (
            <li class={'submenu' in item ? 'tem-sub' : undefined}>
              <a href={rota(lang, item.chave)} aria-current={ativo(item.chave)}>{item.rotulo}</a>
              {'submenu' in item && (
                <ul class="sub">
                  {areas.map((area) => (
                    <li><a href={area.href}>{area.data.nome}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <a class="botao menu-botao" href={rota(lang, '/contato/')}>{tx.topo.faleConosco}</a>
      </nav>
    </div>
  </header>
</div>

<script>
  const topo = document.querySelector<HTMLElement>('.topo');
  const botao = document.querySelector<HTMLButtonElement>('.abre-menu');
  const menu = document.getElementById('menu-principal');

  if (topo) {
    // Cor própria depois de rolar um pouco.
    const conferir = () => topo.classList.toggle('rolou', window.scrollY > 40);
    conferir();
    window.addEventListener('scroll', conferir, { passive: true });
  }

  if (topo && botao && menu) {
    botao.hidden = false;
    botao.addEventListener('click', () => {
      const aberto = botao.getAttribute('aria-expanded') === 'true';
      botao.setAttribute('aria-expanded', String(!aberto));
      menu.classList.toggle('aberto', !aberto);
      topo.classList.toggle('menu-aberto', !aberto);
    });
  }
</script>

<style>
  .topo {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    background: var(--azul);
    box-shadow: 0 2px 14px rgba(11, 30, 63, .25);
    transition: background-color .3s ease, box-shadow .3s ease;
  }
  /* Transparente só com JS (a classe com-js nasce no <head>) e só no topo. */
  :global(.com-js) .topo[data-sobreposto]:not(.rolou):not(.menu-aberto) {
    background: transparent;
    box-shadow: none;
  }

  /* ---------- Faixa de contato: recolhe ao rolar ---------- */
  .topbar-env { display: grid; grid-template-rows: 1fr; transition: grid-template-rows .3s ease; }
  .topo.rolou .topbar-env { grid-template-rows: 0fr; }
  .topbar { overflow: hidden; min-height: 0; color: rgba(248, 247, 242, .8); font-size: 13px; }
  .topbar .container {
    display: flex; justify-content: space-between; gap: 16px;
    height: var(--altura-topbar); align-items: center;
    border-bottom: 1px solid rgba(248, 247, 242, .14);
  }
  /* Link com a altura da faixa: no celular o alvo de toque é a faixa toda. */
  .topbar a { color: #fff; text-decoration: none; display: inline-flex; align-items: center; gap: 7px; min-height: var(--altura-topbar); }
  .topbar a:hover { text-decoration: underline; color: #fff; }
  .topbar-contato { display: flex; gap: 22px; align-items: center; }
  /* Seletor de idioma: texto discreto, o atual em negrito. */
  .idioma {
    display: inline-flex; gap: 6px; align-items: center;
    padding-left: 18px; border-left: 1px solid rgba(248, 247, 242, .25);
    letter-spacing: .06em;
  }
  .idioma strong { color: #fff; font-weight: 700; }
  .idioma a { color: rgba(248, 247, 242, .7); }
  .idioma a:hover { color: #fff; }

  /* ---------- Barra principal ---------- */
  .cabecalho .container { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: var(--altura-barra); }
  .logo img { height: 60px; width: auto; }

  .menu { display: flex; align-items: center; gap: 28px; }
  .menu > ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .menu > ul > li { position: relative; }
  .menu > ul > li > a {
    position: relative;
    display: block; padding: 30px 12px;
    color: #fff; font-weight: 400; font-size: 16px; text-decoration: none;
  }
  /* Sublinhado logo abaixo do texto, longe da borda da barra (antes ele
     encostava no submenu). Aparece no hover e fica na página atual. */
  .menu > ul > li > a::before {
    content: ''; position: absolute; left: 12px; right: 12px; bottom: 22px;
    height: 2px; border-radius: 2px; background: #f8f7f2;
    transform: scaleX(0); transform-origin: left; transition: transform .2s ease;
  }
  .menu > ul > li > a:hover::before,
  .menu > ul > li > a[aria-current='page']::before { transform: scaleX(1); }
  .tem-sub > a { padding-right: 26px !important; }
  .tem-sub > a::after {
    content: ''; position: absolute; right: 10px; top: 50%;
    width: 6px; height: 6px; margin-top: -5px;
    border-right: 1.6px solid currentColor; border-bottom: 1.6px solid currentColor;
    transform: rotate(45deg); transition: transform .2s ease;
  }
  .tem-sub:hover > a::after, .tem-sub:focus-within > a::after { transform: translateY(3px) rotate(-135deg); }

  /* Submenu: cartão com cantos arredondados e setinha. Sobe 14px por
     cima do respiro do link, para não haver vão entre o item e o cartão
     (o mouse não "cai" no caminho). */
  .sub {
    position: absolute; top: 100%; left: 0; margin-top: -14px;
    min-width: 330px; list-style: none; padding: 8px;
    background: #fff; border-radius: 10px;
    box-shadow: 0 18px 44px rgba(11, 30, 63, .22), 0 2px 6px rgba(11, 30, 63, .08);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity .16s ease, transform .16s ease, visibility 0s linear .16s;
  }
  .sub::before {
    content: ''; position: absolute; top: -6px; left: 28px;
    width: 12px; height: 12px; background: #fff; transform: rotate(45deg); border-radius: 2px;
  }
  .tem-sub:hover .sub, .tem-sub:focus-within .sub {
    opacity: 1; visibility: visible; transform: translateY(0);
    transition: opacity .16s ease, transform .16s ease, visibility 0s;
  }
  .sub li { position: relative; }
  .sub a {
    display: block; padding: 12px 16px; border-radius: 6px;
    color: var(--azul); font-size: 15px; font-weight: 400; text-decoration: none; white-space: nowrap;
  }
  .sub a:hover, .sub a:focus-visible { background: var(--fundo-cinza); color: var(--azul-medio); }
  @media (prefers-reduced-motion: reduce) {
    .sub, .tem-sub:hover .sub, .menu > ul > li > a::before, .tem-sub > a::after { transition: none; }
  }

  /* Botão do menu em creme, o claro da marca. */
  .menu-botao { padding: 10px 20px; background: #f8f7f2; border-color: #f8f7f2; color: var(--azul); }
  .menu-botao:hover { background: #fff; border-color: #fff; color: var(--azul); }

  .abre-menu {
    display: none; align-items: center; gap: 10px;
    background: none; border: 1px solid rgba(248, 247, 242, .4); border-radius: 4px;
    padding: 9px 14px; font: 500 15px var(--fonte); color: #fff; cursor: pointer;
  }
  .hamburguer, .hamburguer::before, .hamburguer::after {
    display: block; width: 18px; height: 2px; background: #fff; position: relative;
  }
  .hamburguer::before, .hamburguer::after { content: ''; position: absolute; left: 0; }
  .hamburguer::before { top: -6px; }
  .hamburguer::after { top: 6px; }

  @media (max-width: 1080px) {
    .topbar .container > span:first-child { display: none; }
    .topbar .container { justify-content: flex-end; }
    .topbar-contato { gap: 14px; }
    .cabecalho .container { flex-wrap: wrap; height: auto; min-height: var(--altura-barra); }
    /* A logo ocupa a altura da barra: ao abrir o menu (que quebra para a
       linha de baixo), a primeira linha não encolhe e a logo não pula. */
    .logo { display: flex; align-items: center; height: var(--altura-barra); }
    .logo img { height: 46px; }
    .abre-menu:not([hidden]) { display: inline-flex; }
    .menu {
      flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 0; padding-bottom: 16px;
      /* dvh: no celular, 100vh conta a tela sem a barra do navegador e o
         fim do menu ficaria inalcançável. */
      max-height: calc(100vh - var(--altura-topo)); max-height: calc(100dvh - var(--altura-topo));
      overflow-y: auto; overscroll-behavior: contain;
    }
    :global(.com-js) .menu:not(.aberto) { display: none; }
    .menu > ul { flex-direction: column; gap: 0; }
    .menu > ul > li > a { padding: 13px 4px; border-bottom: 1px solid rgba(248, 247, 242, .14); }
    .menu > ul > li > a::before { display: none; }
    .menu > ul > li > a[aria-current='page'] { color: #d9d9d9; }
    .tem-sub > a::after { display: none; }
    .sub {
      position: static; margin: 0; padding: 0 0 0 16px; min-width: 0;
      background: transparent; box-shadow: none; border-radius: 0;
      opacity: 1; visibility: visible; transform: none; transition: none;
    }
    .sub::before { display: none; }
    .sub a { padding: 10px 4px; border-radius: 0; white-space: normal; font-weight: 400; color: rgba(248, 247, 242, .85); border-bottom: 1px solid rgba(248, 247, 242, .14); }
    .sub a:hover { background: transparent; color: #fff; }
    .menu-botao { margin-top: 16px; text-align: center; }
  }
  @media (max-width: 560px) {
    .topbar-contato a[href^='mailto:'] { display: none; }
  }
</style>
