---
/**
 * Cabeçalho da v3: faixa de contato + barra com logo e menu, presos no
 * topo (position: fixed).
 *
 * Nas páginas que abrem com foto (`sobreposto`), o cabeçalho nasce
 * transparente, por cima da imagem, como no site do Martinelli. Ao rolar,
 * ganha o azul-noite da marca (#0B1E3F) e a faixa de contato recolhe.
 * Sem JavaScript ele já nasce azul, para nunca ficar texto branco sobre
 * conteúdo claro.
 *
 * No celular o menu abre por um botão; sem JavaScript a lista aparece
 * aberta, então ninguém fica sem menu.
 */
import { site } from '../lib/site';
import { areasDoIdioma } from '../lib/areas';
import { t, rota, type Idioma } from '../lib/i18n';
import Icone from './Icone.astro';

interface Props {
  /** Endereço em PORTUGUÊS da seção atual (chave do menu), para aria-current. */
  paginaAtual?: string;
  /** true quando a página abre com foto escura e o cabeçalho vai por cima. */
  sobreposto?: boolean;
  lang?: Idioma;
  /** Endereço desta mesma página no outro idioma (seletor PT · EN). */
  alternativa?: string;
}
const { paginaAtual, sobreposto = false, lang = 'pt', alternativa } = Astro.props;
const tx = t(lang);
const areas = await areasDoIdioma(lang);
const ativo = (chave: string) =>
  paginaAtual === chave || (chave !== '/' && paginaAtual?.startsWith(chave)) ? 'page' : undefined;
/* Sem página equivalente (ex.: blog), o seletor leva à home do outro idioma. */
const outro = alternativa ?? (lang === 'pt' ? '/en/' : '/');

/* Bandeiras em SVG (emoji de bandeira não aparece no Chrome do Windows).
   Decorativas: o idioma já está no texto e no aria-label do link. */
const BANDEIRA_BR =
  '<svg class="bandeira" viewBox="0 0 20 14" aria-hidden="true" focusable="false"><rect width="20" height="14" rx="2" fill="#009c3b"/><path d="M10 2.1 17.4 7 10 11.9 2.6 7Z" fill="#ffdf00"/><circle cx="10" cy="7" r="3" fill="#002776"/><path d="M7.1 6.4c2-.5 4-.3 5.8.6" stroke="#fff" stroke-width=".55" fill="none"/></svg>';
const BANDEIRA_EUA =
  '<svg class="bandeira" viewBox="0 0 20 14" aria-hidden="true" focusable="false"><clipPath id="bandeira-eua"><rect width="20" height="14" rx="2"/></clipPath><g clip-path="url(#bandeira-eua)"><rect width="20" height="14" fill="#fff"/><path d="M0 0h20v1.08H0zM0 2.15h20v1.08H0zM0 4.3h20v1.08H0zM0 6.46h20v1.08H0zM0 8.62h20v1.08H0zM0 10.77h20v1.08H0zM0 12.92h20V14H0z" fill="#b22234"/><rect width="8.6" height="7.54" fill="#3c3b6e"/><g fill="#fff"><circle cx="1.5" cy="1.4" r=".45"/><circle cx="3.6" cy="1.4" r=".45"/><circle cx="5.7" cy="1.4" r=".45"/><circle cx="7.6" cy="1.4" r=".45"/><circle cx="2.5" cy="2.9" r=".45"/><circle cx="4.6" cy="2.9" r=".45"/><circle cx="6.7" cy="2.9" r=".45"/><circle cx="1.5" cy="4.4" r=".45"/><circle cx="3.6" cy="4.4" r=".45"/><circle cx="5.7" cy="4.4" r=".45"/><circle cx="7.6" cy="4.4" r=".45"/><circle cx="2.5" cy="5.9" r=".45"/><circle cx="4.6" cy="5.9" r=".45"/><circle cx="6.7" cy="5.9" r=".45"/></g></g></svg>';
---

<div class="topo" data-sobreposto={sobreposto ? '' : undefined}>
  <div class="topbar-env">
    <div class="topbar">
      <div class="container">
        {/* No celular a frase vira "Maringá/PR | Online" e os contatos viram só
            ícones (o nome acessível de cada link continua completo). */}
        <span class="topbar-local">
          <span class="so-largo">{site.cidade}/{site.estado} · {tx.atendimento}</span>
          <span class="so-estreito">{site.cidade}/{site.estado}<span class="barra" aria-hidden="true"></span>Online</span>
        </span>
        <span class="topbar-contato">
          <a href={site.whatsapp.valor} rel="noopener" target="_blank" aria-label={`WhatsApp ${site.telefone.valor}`}><Icone nome="whatsapp" /><span class="contato-texto">{site.telefone.valor}</span></a>
          <a href={`mailto:${site.email.valor}`} aria-label={`E-mail ${site.email.valor}`}><Icone nome="email" /><span class="contato-texto">{site.email.valor}</span></a>
          <a href={site.redes.instagram.valor} rel="noopener" target="_blank" aria-label={`Instagram ${site.redes.instagramArroba}`}><Icone nome="instagram" /><span class="contato-texto">Instagram</span></a>
          <span class="idioma" role="group" aria-label={tx.topo.idiomaAria}>
            {lang === 'pt' ? (
              <><strong aria-current="true" lang="pt-BR"><Fragment set:html={BANDEIRA_BR} /><span class="sigla">PT</span></strong><span aria-hidden="true">·</span><a href={outro} lang="en" hreflang="en" aria-label="English version"><Fragment set:html={BANDEIRA_EUA} /><span class="sigla">EN</span></a></>
            ) : (
              <><a href={outro} lang="pt-BR" hreflang="pt-BR" aria-label="Versão em português"><Fragment set:html={BANDEIRA_BR} /><span class="sigla">PT</span></a><span aria-hidden="true">·</span><strong aria-current="true" lang="en"><Fragment set:html={BANDEIRA_EUA} /><span class="sigla">EN</span></strong></>
            )}
          </span>
        </span>
      </div>
    </div>
  </div>

  <header class="cabecalho">
    <div class="container">
      <a class="logo" href={rota(lang, '/')} aria-label={`${site.nome}, ${tx.topo.inicioAria}`}>
        {/* Tela comum: versão com o traço um pouco mais grosso (o logo é fino
            e, com 60px, cada linha fica com ~1px e serrilha). Retina: o original. */}
        <picture>
          <source media="(min-resolution: 2dppx)" srcset="/media/marca/lockup-creme.svg" />
          {/* Celular em tela 1x: engrossamento mais leve; o normal empastava
              as letras pequenas ("ADVOGADOS") com o logo em 50px. */}
          <source media="(max-width: 1080px)" srcset="/media/marca/lockup-creme-tela-pequena.svg" />
          <img src="/media/marca/lockup-creme-tela.svg" alt={site.nome} width="550" height="196" />
        </picture>
      </a>

      <button class="abre-menu" type="button" aria-expanded="false" aria-controls="menu-principal" hidden>
        <span class="hamburguer" aria-hidden="true"></span>
        {tx.topo.menu}
      </button>

      <nav id="menu-principal" class="menu" aria-label={tx.topo.menuAria}>
        <ul>
          {tx.nav.map((item) => (
            <li class={'submenu' in item ? 'tem-sub' : undefined}>
              <a href={rota(lang, item.chave)} aria-current={ativo(item.chave)}>{item.rotulo}</a>
              {'submenu' in item && (
                <ul class="sub">
                  {areas.map((area) => (
                    <li><a href={area.href}>{area.data.nome}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        {/* Contato não fica no menu (07/11/2026): o botão é a entrada para ele. */}
        <a class="botao menu-botao" href={rota(lang, '/contato/')} aria-current={ativo('/contato/')}>{tx.topo.faleConosco}</a>
      </nav>
    </div>
  </header>
</div>

<script>
  const topo = document.querySelector<HTMLElement>('.topo');
  const botao = document.querySelector<HTMLButtonElement>('.abre-menu');
  const menu = document.getElementById('menu-principal');

  if (topo) {
    // Cor própria depois de rolar um pouco.
    const conferir = () => topo.classList.toggle('rolou', window.scrollY > 40);
    conferir();
    window.addEventListener('scroll', conferir, { passive: true });
  }

  if (topo && botao && menu) {
    botao.hidden = false;
    botao.addEventListener('click', () => {
      const aberto = botao.getAttribute('aria-expanded') === 'true';
      botao.setAttribute('aria-expanded', String(!aberto));
      menu.classList.toggle('aberto', !aberto);
      topo.classList.toggle('menu-aberto', !aberto);
    });
  }
</script>

<style>
  .topo {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    background: var(--azul);
    box-shadow: 0 2px 14px rgba(11, 30, 63, .25);
    transition: background-color .3s ease, box-shadow .3s ease;
  }
  /* Luz leve sobre o azul, a mesma do rodapé: brilho petróleo no alto à
     direita e um reflexo azul-acinzentado embaixo à esquerda. Fica numa
     camada própria para entrar com fade junto com o azul. */
  .topo::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(760px 260px at 86% -30%, rgba(0, 67, 105, .62), rgba(0, 67, 105, 0) 72%),
      radial-gradient(560px 220px at 4% 140%, rgba(81, 116, 147, .2), rgba(81, 116, 147, 0) 70%);
    transition: opacity .3s ease;
  }
  /* Transparente só com JS (a classe com-js nasce no <head>) e só no topo. */
  :global(.com-js) .topo[data-sobreposto]:not(.rolou):not(.menu-aberto) {
    background: transparent;
    box-shadow: none;
  }
  :global(.com-js) .topo[data-sobreposto]:not(.rolou):not(.menu-aberto)::before { opacity: 0; }

  /* ---------- Faixa de contato: recolhe ao rolar ---------- */
  .topbar-env { display: grid; grid-template-rows: 1fr; transition: grid-template-rows .3s ease; }
  .topo.rolou .topbar-env { grid-template-rows: 0fr; }
  .topbar { overflow: hidden; min-height: 0; color: rgba(248, 247, 242, .8); font-size: 13px; }
  .topbar .container {
    display: flex; justify-content: space-between; gap: 16px;
    height: var(--altura-topbar); align-items: center;
    border-bottom: 1px solid rgba(248, 247, 242, .14);
  }
  /* Link com a altura da faixa: no celular o alvo de toque é a faixa toda. */
  .topbar a { color: #fff; text-decoration: none; display: inline-flex; align-items: center; gap: 7px; min-height: var(--altura-topbar); }
  .topbar a:hover { text-decoration: underline; color: #fff; }
  .topbar-contato { display: flex; gap: 22px; align-items: center; }
  .so-estreito { display: none; align-items: center; }
  .barra { width: 1px; height: 12px; background: rgba(248, 247, 242, .35); margin: 0 10px; }
  /* Seletor de idioma: texto discreto, o atual em negrito. */
  .idioma {
    display: inline-flex; gap: 6px; align-items: center;
    padding-left: 18px; border-left: 1px solid rgba(248, 247, 242, .25);
    letter-spacing: .06em;
  }
  .idioma strong { color: #fff; font-weight: 700; }
  .idioma strong, .idioma a { display: inline-flex; align-items: center; gap: 6px; }
  .idioma :global(.bandeira) { width: 18px; height: 13px; flex: none; border-radius: 2px; box-shadow: 0 0 0 1px rgba(248, 247, 242, .25); }
  /* O idioma que não está ativo fica com a bandeira um pouco apagada. */
  .idioma a :global(.bandeira) { opacity: .7; transition: opacity .15s ease; }
  .idioma a:hover :global(.bandeira) { opacity: 1; }
  .idioma a { color: rgba(248, 247, 242, .7); }
  .idioma a:hover { color: #fff; }

  /* ---------- Barra principal ---------- */
  .cabecalho .container { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: var(--altura-barra); }
  .logo picture { display: block; }
  .logo img { display: block; height: 60px; width: auto; }

  .menu { display: flex; align-items: center; gap: 28px; }
  .menu > ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .menu > ul > li { position: relative; }
  .menu > ul > li > a {
    position: relative;
    display: block; padding: 30px 12px;
    color: #fff; font-weight: 400; font-size: 16px; text-decoration: none;
  }
  /* Sublinhado logo abaixo do texto, longe da borda da barra (antes ele
     encostava no submenu). Aparece no hover e fica na página atual. */
  .menu > ul > li > a::before {
    content: ''; position: absolute; left: 12px; right: 12px; bottom: 22px;
    height: 2px; border-radius: 2px; background: #f8f7f2;
    transform: scaleX(0); transform-origin: left; transition: transform .2s ease;
  }
  .menu > ul > li > a:hover::before,
  .menu > ul > li > a[aria-current='page']::before { transform: scaleX(1); }
  .tem-sub > a { padding-right: 26px !important; }
  .tem-sub > a::after {
    content: ''; position: absolute; right: 10px; top: 50%;
    width: 6px; height: 6px; margin-top: -5px;
    border-right: 1.6px solid currentColor; border-bottom: 1.6px solid currentColor;
    transform: rotate(45deg); transition: transform .2s ease;
  }
  .tem-sub:hover > a::after, .tem-sub:focus-within > a::after { transform: translateY(3px) rotate(-135deg); }

  /* Submenu: cartão com cantos arredondados e setinha. Sobe 14px por
     cima do respiro do link, para não haver vão entre o item e o cartão
     (o mouse não "cai" no caminho). */
  .sub {
    position: absolute; top: 100%; left: 0; margin-top: -14px;
    min-width: 330px; list-style: none; padding: 8px;
    background: #fff; border-radius: 10px;
    box-shadow: 0 18px 44px rgba(11, 30, 63, .22), 0 2px 6px rgba(11, 30, 63, .08);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity .16s ease, transform .16s ease, visibility 0s linear .16s;
  }
  .sub::before {
    content: ''; position: absolute; top: -6px; left: 28px;
    width: 12px; height: 12px; background: #fff; transform: rotate(45deg); border-radius: 2px;
  }
  .tem-sub:hover .sub, .tem-sub:focus-within .sub {
    opacity: 1; visibility: visible; transform: translateY(0);
    transition: opacity .16s ease, transform .16s ease, visibility 0s;
  }
  .sub li { position: relative; }
  .sub a {
    display: block; padding: 12px 16px; border-radius: 6px;
    color: var(--azul); font-size: 15px; font-weight: 400; text-decoration: none; white-space: nowrap;
  }
  .sub a:hover, .sub a:focus-visible { background: var(--fundo-cinza); color: var(--azul-medio); }
  @keyframes menu-item { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .sub, .tem-sub:hover .sub, .menu > ul > li > a::before, .tem-sub > a::after { transition: none; }
    :global(.com-js) .menu, :global(.com-js) .menu:not(.aberto),
    .hamburguer, .hamburguer::before, .hamburguer::after { transition: none !important; }
    .menu.aberto > ul > li, .menu.aberto > .menu-botao { animation: none; }
  }

  /* Botão do menu em creme, o claro da marca. */
  .menu-botao { padding: 10px 20px; background: #f8f7f2; border-color: #f8f7f2; color: var(--azul); }
  .menu-botao:hover { background: #fff; border-color: #fff; color: var(--azul); }

  .abre-menu {
    display: none; align-items: center; gap: 10px;
    background: none; border: 1px solid rgba(248, 247, 242, .4); border-radius: 4px;
    padding: 9px 14px; font: 500 15px var(--fonte); color: #fff; cursor: pointer;
  }
  .hamburguer, .hamburguer::before, .hamburguer::after {
    display: block; width: 18px; height: 2px; background: #fff; position: relative;
  }
  .hamburguer::before, .hamburguer::after { content: ''; position: absolute; left: 0; }
  .hamburguer::before { top: -6px; }
  .hamburguer::after { top: 6px; }
  /* Aberto: as três linhas viram um X. */
  .hamburguer, .hamburguer::before, .hamburguer::after { transition: transform .35s cubic-bezier(.22, 1, .36, 1), top .2s ease, background-color .2s ease; }
  .topo.menu-aberto .hamburguer { background-color: transparent; }
  .topo.menu-aberto .hamburguer::before { top: 0; transform: rotate(45deg); }
  .topo.menu-aberto .hamburguer::after { top: 0; transform: rotate(-45deg); }

  /* Tela estreita: só as bandeiras (a sigla fica para o leitor de tela);
     a do idioma ativo ganha contorno claro. */
  @media (max-width: 560px) {
    .sigla { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .idioma { gap: 4px; padding-left: 10px; margin-left: 2px !important; }
    .idioma > span[aria-hidden] { display: none; }
    .idioma strong, .idioma a { padding: 6px 4px; }
    .idioma strong :global(.bandeira) { box-shadow: 0 0 0 1.5px #f8f7f2; }
  }
  @media (max-width: 1080px) {
    .so-largo { display: none; }
    .so-estreito { display: inline-flex; }
    .contato-texto { display: none; }
    .topbar-contato { gap: 4px; }
    /* Só ícone: alvo de toque quadrado, com a altura da faixa. */
    .topbar-contato > a { justify-content: center; min-width: 36px; }
    .idioma { margin-left: 8px; }
    /* row-gap 0: o menu fechado quebra para uma segunda linha de altura
       zero, e o vão entre linhas deixava 24px sobrando embaixo da barra. */
    .cabecalho .container { flex-wrap: wrap; height: auto; min-height: var(--altura-barra); row-gap: 0; }
    /* A logo ocupa a altura da barra: ao abrir o menu (que quebra para a
       linha de baixo), a primeira linha não encolhe e a logo não pula. */
    .logo { display: flex; align-items: center; height: var(--altura-barra); }
    .logo img { height: 50px; }
    .abre-menu:not([hidden]) { display: inline-flex; }
    .menu {
      flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 0; padding-bottom: 16px;
      /* dvh: no celular, 100vh conta a tela sem a barra do navegador e o
         fim do menu ficaria inalcançável. */
      max-height: calc(100vh - var(--altura-topo)); max-height: calc(100dvh - var(--altura-topo));
      overflow-y: auto; overscroll-behavior: contain;
    }
    /* Abrir: a lista desce com desaceleração longa e os itens entram em
       sequência; fechar é mais rápido. Sem JS, a lista fica aberta. */
    :global(.com-js) .menu {
      transition: max-height .6s cubic-bezier(.22, 1, .36, 1), opacity .35s ease, padding-bottom .6s cubic-bezier(.22, 1, .36, 1);
    }
    :global(.com-js) .menu:not(.aberto) {
      max-height: 0; opacity: 0; padding-bottom: 0; overflow: hidden; visibility: hidden;
      transition: max-height .3s cubic-bezier(.4, 0, 1, 1), opacity .2s ease, padding-bottom .3s ease, visibility 0s linear .3s;
    }
    .menu.aberto > ul > li, .menu.aberto > .menu-botao { animation: menu-item .55s cubic-bezier(.22, 1, .36, 1) both; }
    .menu.aberto > ul > li:nth-child(1) { animation-delay: .06s; }
    .menu.aberto > ul > li:nth-child(2) { animation-delay: .11s; }
    .menu.aberto > ul > li:nth-child(3) { animation-delay: .16s; }
    .menu.aberto > ul > li:nth-child(4) { animation-delay: .21s; }
    .menu.aberto > ul > li:nth-child(5) { animation-delay: .26s; }
    .menu.aberto > .menu-botao { animation-delay: .3s; }
    /* Menu aberto: a luz do desktop e um segundo brilho petróleo embaixo,
       para a área alta do menu não ficar chapada. */
    .topo.menu-aberto::before {
      background:
        radial-gradient(760px 260px at 86% -30%, rgba(0, 67, 105, .62), rgba(0, 67, 105, 0) 72%),
        radial-gradient(520px 420px at 0% 100%, rgba(0, 67, 105, .5), rgba(0, 67, 105, 0) 70%),
        radial-gradient(420px 300px at 100% 70%, rgba(81, 116, 147, .18), rgba(81, 116, 147, 0) 70%);
    }
    .menu > ul { flex-direction: column; gap: 0; }
    .menu > ul > li > a { padding: 13px 4px; border-bottom: 1px solid rgba(248, 247, 242, .14); }
    .menu > ul > li > a::before { display: none; }
    .menu > ul > li > a[aria-current='page'] { color: #d9d9d9; }
    .tem-sub > a::after { display: none; }
    .sub {
      position: static; margin: 0; padding: 0 0 0 16px; min-width: 0;
      background: transparent; box-shadow: none; border-radius: 0;
      opacity: 1; visibility: visible; transform: none; transition: none;
    }
    .sub::before { display: none; }
    .sub a { padding: 10px 4px; border-radius: 0; white-space: normal; font-weight: 400; color: rgba(248, 247, 242, .85); border-bottom: 1px solid rgba(248, 247, 242, .14); }
    .sub a:hover { background: transparent; color: #fff; }
    .menu-botao { margin-top: 16px; text-align: center; }
  }
</style>
