---
/**
 * Lista das áreas de atuação (v3), nos dois idiomas.
 *
 * Cada área é um bloco largo: foto de um lado, conteúdo do outro,
 * alternando o lado (zigue-zague). "Para quem" e "Serviços" usam o mesmo
 * rótulo pequeno sobre texto comum: nada de caixa com filete lateral, que
 * o cliente leu como cara de texto gerado por IA. Serviços em duas colunas com marca de
 * verificação; "Também atuamos em" fecha a página numa faixa cinza clara
 * (azul encostaria na faixa de chamada, que também é azul).
 * Sem numeração: os sócios pediram para não numerar o que não é
 * sequência (retorno de 06/11/2026).
 */
import Base from '~/layouts/Base.astro';
import BannerPagina from '~/components/BannerPagina.astro';
import Chamada from '~/components/Chamada.astro';
import IconeArea from '~/components/IconeArea.astro';
import TambemAtuamos from '~/components/TambemAtuamos.astro';
import { areasDoIdioma, assuntosDaArea, FOTO_DA_AREA } from '~/lib/areas';
import { t, rota, type Idioma } from '~/lib/i18n';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const tx = t(lang);
const ar = tx.areas;
const areas = await areasDoIdioma(lang);
const contato = rota(lang, '/contato/');
---

<Base
  titulo={ar.titulo}
  descricao={ar.descricao}
  paginaAtual="/areas/"
  lang={lang}
  alternativa={lang === 'pt' ? '/en/practice-areas/' : '/areas/'}
>
  <BannerPagina html={ar.banner} migalhas={[{ rotulo: ar.migalha }]} lang={lang} />

  <section class="secao blocos">
    <div class="container">
      {areas.map((area, i) => {
        const servicos = area.data.servicos.length > 0 ? area.data.servicos : assuntosDaArea(area.data.assuntos).map((a) => a.nome);
        return (
          <article class:list={['bloco', { invertido: i % 2 === 1 }]} id={area.slugPt}>
            <a class="foto" href={area.href} tabindex="-1" aria-hidden="true">
              <img src={FOTO_DA_AREA[area.slugPt]} alt="" width="1600" height="900" loading={i === 0 ? 'eager' : 'lazy'} />
              <span class="selo"><IconeArea slug={area.slugPt} class="selo-icone" /></span>
            </a>

            <div class="conteudo">
              <h2><a href={area.href}>{area.data.nome}</a></h2>
              <p class="resumo">{area.data.resumo}</p>
              {area.data.publicoCurto && (
                <>
                  <h3 class="rotulo">{ar.paraQuem}</h3>
                  <p class="publico">{area.data.publicoCurto}</p>
                </>
              )}

              <h3 class="rotulo">{ar.servicos}</h3>
              <ul class="servicos">
                {servicos.map((s) => (
                  <li>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" /><path d="M6 10.3l2.6 2.5L14 7.4" /></svg>
                    {s}
                  </li>
                ))}
              </ul>

              <div class="acoes">
                <a class="botao" href={area.href}>{ar.conhecaArea}</a>
                <a class="link-seta" href={`${contato}?assunto=${area.slugPt}`}>{ar.faleConosco} <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <TambemAtuamos lang={lang} apoio={ar.tambemApoio} prefixo="oa-lista" />

  <Chamada slot="rodape" lang={lang} />
</Base>

<style>
  .blocos { padding-bottom: 40px; }
  .bloco {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    padding: 24px 0 72px;
    scroll-margin-top: calc(var(--altura-barra) + 24px);
  }
  .bloco + .bloco { padding-top: 72px; border-top: 1px solid var(--linha); }
  .invertido .foto { order: 2; }

  /* ---------- Foto com selo da área ---------- */
  .foto { position: relative; display: block; border-radius: 14px; box-shadow: 0 24px 50px rgba(11, 30, 63, .16); }
  .foto img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; border-radius: 14px; }
  .foto::after {
    content: ''; position: absolute; inset: 0; border-radius: 14px;
    background: linear-gradient(32deg, rgba(0, 67, 105, .45) 0%, rgba(0, 67, 105, 0) 45%);
  }
  .selo {
    position: absolute; left: 24px; bottom: -26px; z-index: 1;
    display: grid; place-items: center;
    width: 76px; height: 76px; border-radius: 50%;
    background: #fff; color: var(--azul-medio);
    box-shadow: 0 10px 24px rgba(11, 30, 63, .18);
  }
  .invertido .selo { left: auto; right: 24px; }
  .selo :global(.selo-icone) { width: 40px; height: 40px; margin: 0; }

  /* ---------- Conteúdo ---------- */
  .conteudo h2 { font-size: 36px; font-weight: 700; letter-spacing: -.01em; margin-bottom: 14px; }
  .conteudo h2 a { color: var(--azul); text-decoration: none; }
  .conteudo h2 a:hover { color: var(--azul-medio); }
  .resumo { font-size: 19px; line-height: 1.6; color: var(--texto); margin-bottom: 18px; }
  .publico { font-size: 16px; color: var(--texto-suave); margin-bottom: 24px; }
  .conteudo .rotulo { font-size: 13px; margin-bottom: 12px; }

  .servicos {
    list-style: none; padding: 0; margin: 0 0 32px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px;
  }
  .servicos li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; line-height: 1.45; }
  .servicos svg { flex: none; width: 18px; height: 18px; margin-top: 1px; }
  .servicos circle { fill: rgba(0, 67, 105, .1); }
  .servicos path { fill: none; stroke: var(--azul-medio); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .acoes { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .link-seta { font-weight: 500; text-decoration: none; color: var(--azul-medio); }
  .link-seta span { display: inline-block; transition: transform .15s ease; }
  .link-seta:hover span { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .link-seta span { transition: none; }
  }
  @media (max-width: 991px) {
    .bloco { grid-template-columns: 1fr; gap: 48px; }
    .invertido .foto { order: 0; }
    .invertido .selo { right: auto; left: 24px; }
  }
  @media (max-width: 680px) {
    .bloco { padding-bottom: 56px; }
    .bloco + .bloco { padding-top: 56px; }
    .conteudo h2 { font-size: 28px; }
    .resumo { font-size: 17px; }
    .servicos { grid-template-columns: 1fr; }
  }
</style>
