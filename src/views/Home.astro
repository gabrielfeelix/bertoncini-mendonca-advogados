---
/**
 * Home (v3), nos dois idiomas. Ordem combinada em 07/11/2026, a partir do
 * retorno dos sócios de 06/11 (docs/RETORNO-2026-11-06.md na branch v2) e
 * da home do Martinelli:
 *
 *   capa em slides → áreas, já com os serviços (retorno, item 2) e
 *   "também atuamos em" (item 3) → sobre nós, com os sócios dentro (sem
 *   seção própria) → onde atendemos (o equivalente honesto das "unidades"
 *   do Martinelli) → publicações (só em português) → perguntas frequentes
 *   em acordeão com abas (item 5) → newsletter mensal (item 7, só em
 *   português, porque os textos são em português).
 */
import Base from '~/layouts/Base.astro';
import HeroSlides from '~/components/HeroSlides.astro';
import TambemAtuamos from '~/components/TambemAtuamos.astro';
import MapaAtendimento from '~/components/MapaAtendimento.astro';
import FeedInstagram from '~/components/FeedInstagram.astro';
import CartaoArtigo from '~/components/CartaoArtigo.astro';
import { CAMPOS_ISCA } from '~/lib/antispam';
import { site } from '~/lib/site';
import { areasDoIdioma, FOTO_DA_AREA } from '~/lib/areas';
import { listarArtigos } from '~/lib/artigos';
import { t, rota, type Idioma } from '~/lib/i18n';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const tx = t(lang);
const h = tx.home;
const areas = await areasDoIdioma(lang);
const artigos = lang === 'pt' ? (await listarArtigos()).slice(0, 3) : [];
const escritorio = rota(lang, '/escritorio/');

/* Abas das perguntas: as quatro primeiras de cada área + atendimento. */
const grupos = [
  ...areas.map((a) => ({
    id: `faq-${a.slugPt}`,
    rotulo: a.data.nome,
    perguntas: a.data.perguntas.slice(0, 4),
    mais: `${a.href}#perguntas`,
  })),
  { id: 'faq-atendimento', rotulo: h.faqAtendimento, perguntas: h.atendimento, mais: undefined as string | undefined },
];
---

<Base titulo={h.titulo} descricao={tx.descricao} paginaAtual="/" lang={lang} alternativa={lang === 'pt' ? '/en/' : '/'}>
  <HeroSlides lang={lang} />

  <!-- Áreas de atuação, com os serviços -->
  <section class="secao">
    <div class="container">
      <div class="titulo-secao">
        <h2 set:html={h.areasTitulo} />
        <p>{h.areasApoio}</p>
      </div>
      {/* As duas áreas principais em painéis de foto (07/11/2026): nome e
          resumo sobre a foto escurecida; os serviços sobem ao passar o mouse
          ou focar (em tela de toque já aparecem). O painel todo é o link. */}
      <div class="paineis">
        {areas.map((area) => (
          <article class="painel">
            <img src={FOTO_DA_AREA[area.slugPt]} alt="" width="1600" height="900" loading="lazy" />
            <div class="painel-texto">
              <h3><a href={area.href}>{area.data.nome}</a></h3>
              <p class="painel-resumo">{area.data.resumo}</p>
              <div class="painel-mais">
                <div>
                  <p class="painel-rotulo">{h.servicos}</p>
                  <ul class="painel-servicos">
                    {area.data.servicos.slice(0, 6).map((s) => <li>{s}</li>)}
                  </ul>
                </div>
              </div>
              <span class="painel-link" aria-hidden="true">{tx.hero.conhecaArea}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <TambemAtuamos lang={lang} apoio={h.tambemApoio} prefixo="oa-home" />

  <!-- Onde atendemos: mapa do Brasil (online no país todo, presencial em Maringá) -->
  <section class="secao onde">
    <div class="container onde-grade">
      <div class="onde-texto">
        <p class="rotulo">{h.ondeRotulo}</p>
        <h2 class="onde-titulo" set:html={h.ondeTitulo} />
        {h.ondeTexto.map((p) => <p>{p}</p>)}
        <dl class="modos">
          <div>
            <dt><span class="modo-linha" aria-hidden="true"></span>{h.ondeOnline}</dt>
            <dd>{h.ondeOnlineTexto}</dd>
          </div>
          <div>
            <dt><span class="modo-ponto" aria-hidden="true"></span>{h.ondePresencial}</dt>
            <dd>{h.ondePresencialTexto}</dd>
          </div>
        </dl>
      </div>
      <MapaAtendimento descricao={h.mapaDescricao} />
    </div>
  </section>

  <!-- Sobre nós, com os sócios dentro -->
  <section class="secao secao-cinza">
    <div class="container duas-colunas">
      <img class="foto-escritorio" src="/media/hero/socios-1600.jpg" alt={h.fotoSocios} width="1600" height="900" loading="lazy" />
      <div>
        <p class="rotulo">{h.sobreRotulo}</p>
        <h2 class="titulo-bloco" set:html={h.sobreTitulo} />
        {h.sobre.slice(0, 2).map((p) => <p>{p}</p>)}
        <ul class="socios-mini">
          {site.socios.map((s, i) => (
            <li>
              <a href={`${escritorio}#${s.nome.split(' ')[0].toLowerCase()}`}>
                <img src={`${s.retrato}-560.jpg`} alt="" width="560" height="840" loading="lazy" />
                <span>
                  <strong>{s.nome}</strong>
                  <span>{tx.socio[i === 1 ? 'a' : 'o']} · {s.oab.valor}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a class="botao botao-contorno" href={escritorio}>{h.conhecaSocios}</a>
      </div>
    </div>
  </section>

  {artigos.length > 0 && (
    <section class="secao">
      <div class="container">
        <div class="titulo-secao">
          <h2>Últimas <strong>Publicações</strong></h2>
        </div>
        <div class="grade grade-3">
          {artigos.map((artigo) => <CartaoArtigo artigo={artigo} />)}
        </div>
        <p class="ver-todas"><a class="botao botao-contorno" href="/conteudos/">Ver todas as publicações</a></p>
      </div>
    </section>
  )}

  <FeedInstagram lang={lang} />

  <!-- Perguntas frequentes, com abas -->
  <section class="secao faq-home" data-faq-abas>
    <div class="container">
      <div class="titulo-secao">
        <h2 set:html={h.faqTitulo} />
      </div>
      <div class="abas" role="tablist" aria-label={h.faqAbasAria} hidden>
        {grupos.map((g, i) => (
          <button type="button" role="tab" id={`aba-${g.id}`} aria-controls={g.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            {g.rotulo}
          </button>
        ))}
      </div>
      {grupos.map((g) => (
        <div class="faq-grupo" id={g.id} role="tabpanel" aria-labelledby={`aba-${g.id}`}>
          <h3 class="faq-grupo-titulo">{g.rotulo}</h3>
          <div class="faq">
            {g.perguntas.map((p) => (
              <details>
                <summary>{p.pergunta}</summary>
                <p>{p.resposta}</p>
              </details>
            ))}
          </div>
          {g.mais && <p class="faq-mais"><a href={g.mais}>{h.faqVerTodas} <span aria-hidden="true">→</span></a></p>}
        </div>
      ))}
    </div>
  </section>

  <!-- Newsletter mensal (só em português: os textos são em português) -->
  {lang === 'pt' && (
    <section class="news" slot="rodape">
      <div class="container news-env">
        <div>
          <h2 set:html={h.newsTitulo} />
          <p>{h.newsTexto}</p>
        </div>
        <form class="news-form" action="/api/newsletter" method="post" data-ok={h.newsOk} data-erros={JSON.stringify(h.newsErros)}>
          <input type="hidden" name="origem" value="/" />
          <label class="sr" for="news-email">{h.newsEmail}</label>
          <div class="news-linha">
            <input id="news-email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder={h.newsEmail} />
            <button type="submit" class="botao">{h.newsBotao}</button>
          </div>
          <div class="isca" aria-hidden="true">
            {CAMPOS_ISCA.map((campo) => <input type="text" name={campo} tabindex="-1" autocomplete="off" />)}
          </div>
          <p class="news-resultado" role="status" aria-live="polite" hidden></p>
          <p class="news-nota">{h.newsNota} <a href={rota(lang, '/politica-de-privacidade/')}>{lang === 'pt' ? 'política de privacidade' : 'privacy policy'}</a>.</p>
        </form>
      </div>
    </section>
  )}
</Base>

<script>
  /* Abas das perguntas (padrão ARIA de tabs). Sem JavaScript as abas ficam
     escondidas e os grupos aparecem empilhados, cada um com o seu título. */
  for (const secao of document.querySelectorAll<HTMLElement>('[data-faq-abas]')) {
    const lista = secao.querySelector<HTMLElement>('[role="tablist"]');
    const abas = [...secao.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paineis = abas.map((a) => document.getElementById(a.getAttribute('aria-controls') ?? ''));
    if (!lista || abas.length < 2) continue;
    lista.hidden = false;
    secao.classList.add('com-abas');
    const ativar = (i: number, foco = false) => {
      abas.forEach((a, k) => {
        a.setAttribute('aria-selected', String(k === i));
        a.tabIndex = k === i ? 0 : -1;
        if (paineis[k]) paineis[k]!.hidden = k !== i;
      });
      if (foco) abas[i].focus();
    };
    abas.forEach((a, i) => {
      a.addEventListener('click', () => ativar(i));
      a.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') ativar((i + 1) % abas.length, true);
        if (e.key === 'ArrowLeft') ativar((i - 1 + abas.length) % abas.length, true);
        if (e.key === 'Home') ativar(0, true);
        if (e.key === 'End') ativar(abas.length - 1, true);
      });
    });
    ativar(0);
  }

  /* Newsletter: envia sem sair da página. Sem JS, a API volta para a home
     com ?envio-newsletter=, e este mesmo script mostra o resultado. */
  for (const forma of document.querySelectorAll<HTMLFormElement>('.news-form')) {
    const resultado = forma.querySelector<HTMLElement>('.news-resultado');
    const botao = forma.querySelector<HTMLButtonElement>('button[type="submit"]');
    const erros = JSON.parse(forma.dataset.erros ?? '{}') as Record<string, string>;
    if (!resultado || !botao) continue;
    const mostrar = (ok: boolean, texto: string) => {
      resultado.hidden = false;
      resultado.classList.toggle('falhou', !ok);
      resultado.textContent = texto;
    };
    const volta = new URLSearchParams(location.search);
    if (volta.get('envio-newsletter') === 'ok') mostrar(true, forma.dataset.ok ?? '');
    if (volta.get('envio-newsletter') === 'erro') mostrar(false, erros[volta.get('motivo-newsletter') ?? ''] ?? erros.envio);
    forma.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      botao.disabled = true;
      try {
        const resposta = await fetch('/api/newsletter', { method: 'POST', body: new FormData(forma), headers: { accept: 'application/json' } });
        const dados = (await resposta.json().catch(() => ({}))) as { codigo?: string };
        if (resposta.ok) { forma.reset(); mostrar(true, forma.dataset.ok ?? ''); }
        else mostrar(false, erros[dados.codigo ?? ''] ?? erros.envio);
      } catch {
        mostrar(false, erros.envio);
      } finally {
        botao.disabled = false;
      }
    });
  }
</script>

<style>
  /* ---------- Áreas: painéis de foto ---------- */
  .paineis { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .painel {
    position: relative; overflow: hidden; border-radius: 8px;
    min-height: 540px; display: flex; align-items: flex-end;
    background: var(--azul); color: #f8f7f2;
  }
  .painel img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform .8s cubic-bezier(.2, .8, .2, 1);
  }
  /* Escurecimento de baixo para cima, na cor da marca: o texto lê sem
     tingir a foto inteira. */
  .painel::before {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(11, 30, 63, 0) 25%, rgba(11, 30, 63, .55) 55%, rgba(11, 30, 63, .94) 100%);
    transition: background-color .4s ease;
  }
  .painel:hover img, .painel:focus-within img { transform: scale(1.04); }
  /* Com os serviços abertos o texto sobe: a foto escurece mais. */
  .painel:hover::before, .painel:focus-within::before { background-color: rgba(11, 30, 63, .35); }
  .painel-texto { position: relative; z-index: 2; padding: 40px; width: 100%; }
  .painel h3 { font-size: 36px; font-weight: 300; line-height: 1.12; letter-spacing: -.015em; margin: 0 0 12px; max-width: 16ch; }
  .painel h3 a { color: #fff; text-decoration: none; }
  /* O link do título cobre o painel inteiro. */
  .painel h3 a::after { content: ''; position: absolute; inset: 0; z-index: 3; }
  .painel h3 a:focus-visible { outline: none; }
  .painel:has(h3 a:focus-visible) { outline: 3px solid var(--azul-claro); outline-offset: 3px; }
  .painel-resumo { font-size: 17px; line-height: 1.6; color: rgba(248, 247, 242, .85); margin: 0 0 4px; max-width: 44ch; }
  /* Serviços: fechados (altura 0) até o hover/foco. */
  .painel-mais { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .45s ease; }
  .painel-mais > div { overflow: hidden; }
  .painel:hover .painel-mais, .painel:focus-within .painel-mais { grid-template-rows: 1fr; }
  .painel-rotulo { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: rgba(248, 247, 242, .65); margin: 22px 0 4px; }
  .painel-servicos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; }
  .painel-servicos li { padding: 8px 0; border-bottom: 1px solid rgba(248, 247, 242, .18); font-size: 14.5px; line-height: 1.4; }
  .painel-link {
    display: inline-block; margin-top: 22px; font-weight: 500; font-size: 15px; color: #fff;
    padding-bottom: 4px; border-bottom: 1px solid rgba(248, 247, 242, .5);
    transition: border-color .2s ease;
  }
  .painel:hover .painel-link { border-bottom-color: #fff; }
  /* Sem mouse (toque), não há hover: os serviços ficam à vista. */
  @media (hover: none) { .painel-mais { grid-template-rows: 1fr; } }

  /* ---------- Sobre nós ---------- */
  .foto-escritorio { border-radius: 14px; box-shadow: 0 24px 50px rgba(11, 30, 63, .16); }
  .titulo-bloco { font-size: 34px; font-weight: 300; }
  .titulo-bloco :global(strong) { font-weight: 700; }
  .socios-mini { list-style: none; padding: 0; margin: 22px 0 26px; display: flex; flex-wrap: wrap; gap: 14px 28px; }
  .socios-mini a { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .socios-mini img { width: 54px; height: 54px; border-radius: 50%; object-fit: cover; object-position: 50% 18%; box-shadow: 0 0 0 2px #fff, 0 0 0 3px var(--linha); }
  .socios-mini span { display: grid; }
  .socios-mini strong { color: var(--azul); font-size: 16px; }
  .socios-mini span span { font-size: 13px; color: var(--texto-suave); }
  .socios-mini a:hover strong { color: var(--azul-medio); text-decoration: underline; }

  /* ---------- Onde atendemos ---------- */
  /* Onde atendemos: texto à esquerda, mapa à direita. */
  .onde-grade { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 72px; align-items: center; }
  .onde-titulo { font-size: 44px; font-weight: 300; line-height: 1.1; letter-spacing: -.015em; margin-bottom: 20px; }
  .onde-titulo :global(strong) { font-weight: 700; }
  .onde-texto > p:not(.rotulo) { font-size: 17px; line-height: 1.7; color: var(--texto-suave); }
  /* Legenda do mapa: duas linhas com filete, sem caixa. */
  .modos { margin: 30px 0 0; border-top: 1px solid var(--linha); }
  .modos div { display: grid; grid-template-columns: 150px 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--linha); }
  .modos dt { display: flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--azul); }
  .modos dd { margin: 0; color: var(--texto); }
  .modo-linha { width: 22px; height: 0; border-top: 1.5px solid var(--azul-medio); opacity: .7; }
  .modo-ponto { width: 11px; height: 11px; border-radius: 50%; background: var(--azul); box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px var(--azul-medio); margin: 0 5px; }

  .ver-todas { text-align: center; margin: 40px 0 0; }

  /* ---------- Perguntas frequentes ---------- */
  .faq-home .container { max-width: 900px; }
  .abas { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin: -12px 0 32px; }
  .abas button {
    padding: 10px 18px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--linha); background: #fff;
    font: 500 15px var(--fonte); color: var(--azul);
    transition: background-color .15s ease, border-color .15s ease, color .15s ease;
  }
  .abas button:hover { border-color: var(--azul-claro); }
  .abas button[aria-selected='true'] { background: var(--azul); border-color: var(--azul); color: #fff; }
  .faq-grupo + .faq-grupo { margin-top: 40px; }
  .com-abas .faq-grupo + .faq-grupo { margin-top: 0; }
  .com-abas .faq-grupo-titulo { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .faq-grupo-titulo { font-size: 20px; margin-bottom: 14px; }
  .faq-mais { margin: 18px 0 0; text-align: right; }
  .faq-mais a { font-weight: 500; text-decoration: none; }
  .faq-mais a:hover { text-decoration: underline; }

  /* ---------- Newsletter ---------- */
  /* Mora dentro do rodapé (slot "rodape" do Base): fundo e monograma são
     os dele, as duas partes leem como uma peça só. */
  .news { position: relative; z-index: 1; color: rgba(248, 247, 242, .82); padding: 72px 0 56px; }
  .news-env { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 48px; align-items: center; position: relative; z-index: 1; }
  .news h2 { color: #fff; font-size: 32px; font-weight: 300; margin-bottom: 8px; }
  .news h2 :global(strong) { font-weight: 700; }
  .news-env > div > p { margin: 0; }
  .news-linha { display: flex; gap: 10px; }
  .news-linha input {
    flex: 1; min-width: 0; font: 16px var(--fonte); padding: 13px 16px;
    border: 1px solid transparent; border-radius: 6px; background: #fff; color: var(--texto);
  }
  .news-linha input:focus { outline: 3px solid rgba(159, 180, 200, .7); outline-offset: 1px; }
  .news-linha .botao { background: #f8f7f2; border-color: #f8f7f2; color: var(--azul); white-space: nowrap; }
  .news-linha .botao:hover { background: #fff; border-color: #fff; color: var(--azul); }
  .news-nota { font-size: 13px; color: rgba(248, 247, 242, .65); margin: 10px 0 0; }
  .news-nota a { color: #fff; }
  .news-resultado { margin: 12px 0 0; padding: 10px 14px; border-radius: 6px; background: rgba(232, 243, 236, .95); color: #1d5b33; }
  .news-resultado.falhou { background: rgba(251, 234, 236, .95); color: #8a1c2b; }
  .isca { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (prefers-reduced-motion: reduce) {
    .painel img, .painel-mais, .abas button { transition: none; }
  }
  @media (max-width: 900px) {
    .onde-grade { grid-template-columns: 1fr; gap: 40px; }
    .news-env { grid-template-columns: 1fr; gap: 24px; }
    .paineis { grid-template-columns: 1fr; }
    .painel { min-height: 480px; }
  }
  @media (max-width: 680px) {
    .titulo-bloco { font-size: 28px; }
    .painel { min-height: 0; }
    .painel-texto { padding: 220px 22px 26px; }
    .painel h3 { font-size: 28px; }
    .painel-servicos { grid-template-columns: 1fr; }
    .modos div { grid-template-columns: 1fr; gap: 4px; }
    .onde-titulo { font-size: 32px; }
    .news-linha { flex-direction: column; }
    .news h2 { font-size: 27px; }
  }
</style>
