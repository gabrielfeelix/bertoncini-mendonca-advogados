---
/**
 * Home (v3), nos dois idiomas. Ordem combinada em 07/11/2026, a partir do
 * retorno dos sócios de 06/11 (docs/RETORNO-2026-11-06.md na branch v2) e
 * da home do Martinelli:
 *
 *   capa em slides → áreas em bento (4×2) → onde
 *   atendemos (o equivalente honesto das "unidades" do Martinelli) →
 *   sobre nós, com os sócios dentro (sem seção própria) → publicações (só
 *   em português) → Instagram → perguntas frequentes → newsletter mensal
 *   (só em português, porque os textos são em português).
 *
 * Ajustes dos sócios de 18/11/2026: cinco áreas com o mesmo peso, sem
 * "Também atuamos em"; perguntas frequentes só as gerais de atendimento
 * (as de cada área ficam na página da área), sem abas.
 */
import Base from '~/layouts/Base.astro';
import HeroSlides from '~/components/HeroSlides.astro';
import MapaAtendimento from '~/components/MapaAtendimento.astro';
import FeedInstagram from '~/components/FeedInstagram.astro';
import CartaoArtigo from '~/components/CartaoArtigo.astro';
import { CAMPOS_ISCA } from '~/lib/antispam';
import { site } from '~/lib/site';
import { areasDoIdioma, FOTO_DA_AREA } from '~/lib/areas';
import { listarArtigos } from '~/lib/artigos';
import { t, rota, type Idioma } from '~/lib/i18n';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const tx = t(lang);
const h = tx.home;
const areas = await areasDoIdioma(lang);
const artigos = lang === 'pt' ? (await listarArtigos()).slice(0, 3) : [];
const escritorio = rota(lang, '/escritorio/');
---

<Base titulo={h.titulo} descricao={tx.descricao} paginaAtual="/" lang={lang} alternativa={lang === 'pt' ? '/en/' : '/'}>
  <HeroSlides lang={lang} />

  <!-- Áreas de atuação, com os serviços -->
  <section class="secao">
    <div class="container">
      <div class="titulo-secao">
        <h2 set:html={h.areasTitulo} />
        <p>{h.areasApoio}</p>
      </div>
      {/* Áreas (18/11/2026): QUATRO VERSÕES EM TESTE, escolhidas por
          ?areas=1..5 (sem parâmetro = 5, a escolhida em 18/11/2026; as outras ficam para a outra sócia opinar). Quando o Gabriel decidir, fica só uma.
          1: mosaico 12×12 com os serviços no hover (primeira proposta);
          2: bento 4×2 com o bloco "Não sabe por onde começar?";
          3: bento 4×2, Planejamento em 3 colunas e Digital alto;
          4: o mesmo da 3, com os serviços entrando no lugar do resumo no hover;
          5: faixa, as cinco lado a lado quase na largura da tela; a do mouse
             se alarga e mostra os serviços, as outras estreitam.
          O bloco todo é o link da área. */}
      <div class="bento" data-bento data-variante="5">
        {areas.map((area) => (
          <article class="painel">
            <img src={FOTO_DA_AREA[area.slugPt]} alt="" width="1600" height="1060" loading="lazy" />
            <div class="painel-texto">
              <h3><a href={area.href}>{area.data.nome}</a></h3>
              <div class="painel-troca">
                <div class="painel-resumo"><p>{area.data.resumo}</p></div>
                <div class="painel-mais">
                  <div>
                    <p class="painel-rotulo">{h.servicos}</p>
                    <ul class="painel-servicos">
                      {area.data.servicos.slice(0, 6).map((s) => <li>{s}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
              <span class="painel-link" aria-hidden="true">{tx.hero.conhecaArea}</span>
            </div>
          </article>
        ))}
        <div class="bento-fale">
          <h3 set:html={h.bentoTitulo} />
          <p>{h.bentoTexto}</p>
          <a class="botao botao-claro" href={rota(lang, '/contato/')}>{h.bentoBotao}</a>
        </div>
      </div>
    </div>
  </section>


  <!-- Onde atendemos: mapa do Brasil (online no país todo, presencial em Maringá) -->
  <section class="secao onde">
    <div class="container onde-grade">
      <div class="onde-texto">
        <p class="rotulo">{h.ondeRotulo}</p>
        <h2 class="onde-titulo" set:html={h.ondeTitulo} />
        {h.ondeTexto.map((p) => <p>{p}</p>)}
        <dl class="modos">
          <div>
            <dt><span class="modo-linha" aria-hidden="true"></span>{h.ondeOnline}</dt>
            <dd>{h.ondeOnlineTexto}</dd>
          </div>
          <div>
            <dt><span class="modo-ponto" aria-hidden="true"></span>{h.ondePresencial}</dt>
            <dd>{h.ondePresencialTexto}</dd>
          </div>
        </dl>
      </div>
      <MapaAtendimento descricao={h.mapaDescricao} />
    </div>
  </section>

  <!-- Sobre nós, com os sócios dentro -->
  <section class="secao secao-cinza">
    <div class="container duas-colunas sobre-grade">
      {/* Estátua da Justiça (18/11/2026), no lugar da foto da placa. */}
      <picture class="sobre-foto">
        <source srcset="/media/novas/sobre-justica.avif" type="image/avif" />
        <source srcset="/media/novas/sobre-justica.webp" type="image/webp" />
        <img class="foto-escritorio" src="/media/novas/sobre-justica.jpg" alt={h.fotoSobre} width="718" height="1080" loading="lazy" />
      </picture>
      <div>
        <p class="rotulo">{h.sobreRotulo}</p>
        <h2 class="titulo-bloco" set:html={h.sobreTitulo} />
        {h.sobre.map((p) => <p>{p}</p>)}
        <ul class="socios-mini">
          {site.socios.map((s, i) => (
            <li>
              <a href={`${escritorio}#${s.nome.split(' ')[0].toLowerCase()}`}>
                <img src={s.rosto} alt="" width="320" height="320" loading="lazy" />
                <span>
                  <strong>{s.nome}</strong>
                  <span>{tx.socio[i === 1 ? 'a' : 'o']} · {s.oab.valor}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a class="botao botao-contorno" href={escritorio}>{h.conhecaSocios}</a>
      </div>
    </div>
  </section>

  {artigos.length > 0 && (
    <section class="secao">
      <div class="container">
        <div class="titulo-secao">
          <h2>Últimas <strong>Publicações</strong></h2>
        </div>
        <div class="grade grade-3">
          {artigos.map((artigo) => <CartaoArtigo artigo={artigo} />)}
        </div>
        <p class="ver-todas"><a class="botao botao-contorno" href="/conteudos/">Ver todas as publicações</a></p>
      </div>
    </section>
  )}

  <FeedInstagram lang={lang} />

  {/* Perguntas frequentes: só as gerais de atendimento, em acordeão
      (18/11/2026). O desenho que era do "Também atuamos em" (faixa
      azul-noite) saiu em 18/11/2026: dentro do rodapé, as perguntas pareciam
      parte dele. Agora é uma seção clara própria, título à esquerda. */}
  <section class="secao faq-home" aria-labelledby="faq-home-titulo">
    <div class="container faq-grade">
      <h2 id="faq-home-titulo" set:html={h.faqTitulo} />
      <div class="faq">
        {h.atendimento.map((p) => (
          <details>
            <summary>{p.pergunta}</summary>
            <p>{p.resposta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter mensal (só em português: os textos são em português) -->
  {lang === 'pt' && (
    <section class="news" slot="rodape">
      <div class="container news-env">
        <div>
          <h2 set:html={h.newsTitulo} />
          <p>{h.newsTexto}</p>
        </div>
        <form class="news-form" action="/api/newsletter" method="post" data-ok={h.newsOk} data-erros={JSON.stringify(h.newsErros)}>
          <input type="hidden" name="origem" value="/" />
          <label class="sr" for="news-email">{h.newsEmail}</label>
          <div class="news-linha">
            <input id="news-email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder={h.newsEmail} />
            <button type="submit" class="botao">{h.newsBotao}</button>
          </div>
          <div class="isca" aria-hidden="true">
            {CAMPOS_ISCA.map((campo) => <input type="text" name={campo} tabindex="-1" autocomplete="off" />)}
          </div>
          <p class="news-resultado" role="status" aria-live="polite" hidden></p>
          <p class="news-nota">{h.newsNota} <a href={rota(lang, '/politica-de-privacidade/')}>{lang === 'pt' ? 'política de privacidade' : 'privacy policy'}</a>.</p>
        </form>
      </div>
    </section>
  )}
</Base>

<script>
  /* Versões das áreas (?areas=1..5). Sem parâmetro = 5, que já vem no HTML. */
  {
    const v = new URLSearchParams(location.search).get('areas');
    if (v && /^[1-5]$/.test(v)) document.querySelector('[data-bento]')?.setAttribute('data-variante', v);
  }
  /* Newsletter: envia sem sair da página. Sem JS, a API volta para a home
     com ?envio-newsletter=, e este mesmo script mostra o resultado. */
  for (const forma of document.querySelectorAll<HTMLFormElement>('.news-form')) {
    const resultado = forma.querySelector<HTMLElement>('.news-resultado');
    const botao = forma.querySelector<HTMLButtonElement>('button[type="submit"]');
    const erros = JSON.parse(forma.dataset.erros ?? '{}') as Record<string, string>;
    if (!resultado || !botao) continue;
    const mostrar = (ok: boolean, texto: string) => {
      resultado.hidden = false;
      resultado.classList.toggle('falhou', !ok);
      resultado.textContent = texto;
    };
    const volta = new URLSearchParams(location.search);
    if (volta.get('envio-newsletter') === 'ok') mostrar(true, forma.dataset.ok ?? '');
    if (volta.get('envio-newsletter') === 'erro') mostrar(false, erros[volta.get('motivo-newsletter') ?? ''] ?? erros.envio);
    forma.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      botao.disabled = true;
      try {
        const resposta = await fetch('/api/newsletter', { method: 'POST', body: new FormData(forma), headers: { accept: 'application/json' } });
        const dados = (await resposta.json().catch(() => ({}))) as { codigo?: string };
        if (resposta.ok) { forma.reset(); mostrar(true, forma.dataset.ok ?? ''); }
        else mostrar(false, erros[dados.codigo ?? ''] ?? erros.envio);
      } catch {
        mostrar(false, erros.envio);
      } finally {
        botao.disabled = false;
      }
    });
  }
</script>

<style>
  /* ---------- Áreas (quatro versões em teste, ver o comentário no HTML) ---------- */
  /* Base comum. Celular: um por linha. Tablet: duas colunas. */
  .bento { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .painel, .bento-fale { border-radius: 10px; min-height: 300px; }
  .painel {
    position: relative; overflow: hidden; display: flex; align-items: flex-end;
    background: var(--azul); color: #f8f7f2;
    /* Contexto próprio: foto e escurecimento ficam ATRÁS do texto com
       z-index negativo, e o texto não precisa de posição. Assim o ::after
       do link mede pelo card inteiro (antes media só o bloco de texto, e
       só ele era clicável). */
    isolation: isolate;
  }
  .painel img {
    position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover;
    transition: transform .8s cubic-bezier(.2, .8, .2, 1);
  }
  /* Escurecimento de baixo para cima, na cor da marca. */
  .painel::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(11, 30, 63, 0) 20%, rgba(11, 30, 63, .55) 55%, rgba(11, 30, 63, .94) 100%);
    transition: background-color .4s ease;
  }
  .painel:hover img, .painel:focus-within img { transform: scale(1.04); }
  .painel-texto { padding: 28px; width: 100%; }
  .painel h3 { font-size: 26px; font-weight: 300; line-height: 1.15; letter-spacing: -.01em; margin: 0 0 10px; max-width: 18ch; }
  .painel h3 a { color: #fff; text-decoration: none; }
  /* O link do título cobre o bloco inteiro. */
  .painel h3 a::after { content: ''; position: absolute; inset: 0; z-index: 3; }
  .painel h3 a:focus-visible { outline: none; }
  .painel:has(h3 a:focus-visible) { outline: 3px solid var(--azul-claro); outline-offset: 3px; }
  .painel-resumo p { font-size: 15px; line-height: 1.55; color: rgba(248, 247, 242, .86); margin: 0; max-width: 44ch; }
  .painel-link {
    display: inline-block; margin-top: 16px; font-weight: 500; font-size: 15px; color: #fff;
    padding-bottom: 4px; border-bottom: 1px solid rgba(248, 247, 242, .5); transition: border-color .2s ease;
  }
  .painel:hover .painel-link { border-bottom-color: #fff; }
  .bento > .painel:nth-child(-n+2) h3 { font-size: 34px; }
  /* Serviços e bloco "Fale": só nas versões que usam. */
  .painel-mais, .bento-fale { display: none; }

  /* Versões 1 e 4: resumo e serviços trocam de lugar no hover/foco. */
  .bento:is([data-variante="1"], [data-variante="4"]) .painel-resumo,
  .bento:is([data-variante="1"], [data-variante="4"]) .painel-mais { display: grid; transition: grid-template-rows .45s ease, opacity .3s ease; }
  .bento:is([data-variante="1"], [data-variante="4"]) .painel-resumo { grid-template-rows: 1fr; }
  .bento:is([data-variante="1"], [data-variante="4"]) .painel-mais { grid-template-rows: 0fr; opacity: 0; }
  .painel-resumo > *, .painel-mais > div { overflow: hidden; min-height: 0; }
  .bento:is([data-variante="1"], [data-variante="4"]) .painel:is(:hover, :focus-within) .painel-mais { grid-template-rows: 1fr; opacity: 1; }
  .bento:is([data-variante="1"], [data-variante="4"]) .painel:is(:hover, :focus-within) .painel-resumo { grid-template-rows: 0fr; opacity: 0; }
  .bento:is([data-variante="1"], [data-variante="4"]) .painel:is(:hover, :focus-within)::before { background-color: rgba(11, 30, 63, .35); }
  .painel-rotulo { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: rgba(248, 247, 242, .65); margin: 4px 0 4px; }
  .painel-servicos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; column-gap: 24px; }
  .painel-servicos li { padding: 6px 0; border-bottom: 1px solid rgba(248, 247, 242, .18); font-size: 14px; line-height: 1.35; }
  /* Versão 4: nos blocos pequenos cabem quatro serviços; o resto está na página. */
  .bento[data-variante="4"] > .painel:nth-child(n+3) .painel-servicos li:nth-child(n+5) { display: none; }
  @media (min-width: 992px) {
    .bento[data-variante="4"] > .painel:nth-child(1) .painel-servicos { grid-template-columns: 1fr 1fr 1fr; }
  }
  /* Sem mouse (toque): resumo e serviços ficam à vista. */
  @media (hover: none) {
    .bento:is([data-variante="1"], [data-variante="4"]) .painel-mais { grid-template-rows: 1fr; opacity: 1; }
    .bento:is([data-variante="1"], [data-variante="4"]) .painel:is(:hover, :focus-within) .painel-resumo { grid-template-rows: 1fr; opacity: 1; }
    .painel-rotulo { margin-top: 16px; }
  }

  /* Versão 2: bloco de texto "Não sabe por onde começar?". */
  .bento[data-variante="2"] .bento-fale {
    position: relative; overflow: hidden; padding: 28px;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 12px;
    background: var(--azul-medio); color: rgba(248, 247, 242, .86);
  }
  .bento-fale::before {
    content: ''; position: absolute; top: -24px; right: -28px; width: 150px; height: 163px;
    background: url('/media/marca/monograma-creme.svg') no-repeat center / contain; opacity: .16;
  }
  .bento-fale > * { position: relative; }
  .bento-fale h3 { color: #fff; font-size: 26px; font-weight: 300; line-height: 1.15; margin: 0; }
  .bento-fale h3 :global(strong) { font-weight: 700; }
  .bento-fale p { margin: 0; font-size: 15px; line-height: 1.55; }
  .bento-fale .botao { align-self: flex-start; margin-top: 6px; }

  @media (min-width: 681px) {
    .bento { grid-template-columns: 1fr 1fr; }
    .bento > .painel:nth-child(1), .bento-fale { grid-column: 1 / -1; }
  }

  @media (min-width: 992px) {
    /* Versões 3 e 4 (padrão): Planejamento em 3 colunas, Digital alto.
       Planejamento (3 colunas)          | Digital
       Civil | Empresarial | Imobiliário | Digital */
    .bento { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(2, 320px); }
    .painel, .bento-fale { min-height: 0; }
    .bento > .painel:nth-child(1) { grid-column: 1 / 4; grid-row: 1; }
    .bento > .painel:nth-child(2) { grid-column: 4; grid-row: 1 / 3; }
    .bento > .painel:nth-child(3) { grid-column: 1; grid-row: 2; }
    .bento > .painel:nth-child(4) { grid-column: 2; grid-row: 2; }
    .bento > .painel:nth-child(5) { grid-column: 3; grid-row: 2; }
    /* Versão 4: blocos um pouco mais altos, para os serviços caberem. */
    .bento[data-variante="4"] { grid-template-rows: repeat(2, 340px); }

    /* Versão 2: Planejamento em 2 colunas e o bloco "Fale" na casa que sobra. */
    .bento[data-variante="2"] > .painel:nth-child(1) { grid-column: 1 / 3; }
    .bento[data-variante="2"] > .painel:nth-child(3) { grid-column: 3; grid-row: 1; }
    .bento[data-variante="2"] > .painel:nth-child(4) { grid-column: 1; grid-row: 2; }
    .bento[data-variante="2"] > .painel:nth-child(5) { grid-column: 2; grid-row: 2; }
    .bento[data-variante="2"] .bento-fale { grid-column: 3; grid-row: 2; }

    /* Versão 5: faixa horizontal, quase na largura toda da tela.
       Revisão de 18/11/2026 (estava com atraso e cortando texto): só a
       largura anima (0,6s, sem atraso). Resumo e serviços ficam na MESMA
       célula da grade e só trocam por opacidade, sem animar altura, então
       o texto não pula. Nada de largura fixa no texto. */
    .bento[data-variante="5"] {
      display: flex; gap: 12px; height: 580px;
      width: min(calc(100vw - 64px), 1760px);
      position: relative; left: 50%; transform: translateX(-50%);
    }
    .bento[data-variante="5"] > .painel { flex: 1 1 0; min-width: 0; transition: flex-grow .6s cubic-bezier(.4, 0, .2, 1); }
    .bento[data-variante="5"] > .painel:is(:hover, :focus-within) { flex-grow: 1.8; }
    .bento[data-variante="5"] > .painel h3 { font-size: 28px; }
    /* Texto travado na largura do card ENCOLHIDO (18/11/2026): com o card
       estreitando, o título e o resumo quebravam de linha a cada quadro da
       animação. A largura sai da faixa (container query): (faixa − 4 vãos)
       ÷ (4 cards × 1 + 1 aberto × 1,8) − padding. Assim nada quebra de
       linha enquanto um card estica; só a foto e o fundo mudam. */
    .bento[data-variante="5"] { container-type: inline-size; }
    .bento[data-variante="5"] > .painel :is(h3, .painel-resumo p) {
      width: calc((100cqi - 48px) / 5.8 - 56px); max-width: none;
    }
    .bento[data-variante="5"] .painel img { transition: transform 1s cubic-bezier(.4, 0, .2, 1); }
    .bento[data-variante="5"] .painel:is(:hover, :focus-within) img { transform: scale(1.03); }
    .bento[data-variante="5"] .painel-troca { display: grid; grid-template-columns: minmax(0, 1fr); }
    .bento[data-variante="5"] .painel-troca > * { grid-area: 1 / 1; align-self: end; }
    /* Troca com subida: o resumo sai subindo e some; os serviços entram de
       baixo, item por item (50 ms entre eles). Só transform e opacidade. */
    .bento[data-variante="5"] .painel-resumo { display: block; transition: opacity .3s ease, transform .45s cubic-bezier(.4, 0, .2, 1); }
    .bento[data-variante="5"] .painel:is(:hover, :focus-within) .painel-resumo { opacity: 0; transform: translateY(-10px); }
    .bento[data-variante="5"] .painel-mais { display: block; visibility: hidden; transition: visibility 0s .35s; }
    .bento[data-variante="5"] .painel:is(:hover, :focus-within) .painel-mais { visibility: visible; transition: visibility 0s; }
    .bento[data-variante="5"] .painel-mais :is(.painel-rotulo, li) {
      opacity: 0; transform: translateY(12px);
      transition: opacity .25s ease, transform .25s ease;
    }
    .bento[data-variante="5"] .painel:is(:hover, :focus-within) .painel-mais :is(.painel-rotulo, li) {
      opacity: 1; transform: none;
      transition: opacity .4s ease var(--atraso, .1s), transform .5s cubic-bezier(.16, 1, .3, 1) var(--atraso, .1s);
    }
    .bento[data-variante="5"] .painel-servicos li:nth-child(1) { --atraso: .15s; }
    .bento[data-variante="5"] .painel-servicos li:nth-child(2) { --atraso: .2s; }
    .bento[data-variante="5"] .painel-servicos li:nth-child(3) { --atraso: .25s; }
    .bento[data-variante="5"] .painel-servicos li:nth-child(4) { --atraso: .3s; }
    /* Quatro serviços, uma coluna: a lista fica com altura parecida com a do
       resumo (as duas dividem o mesmo espaço), sem vão sob o título. Os
       demais estão na página da área. */
    .bento[data-variante="5"] .painel-servicos { min-width: 300px; grid-template-columns: 1fr; }
    .bento[data-variante="5"] .painel-servicos li:nth-child(n+5) { display: none; }
    .bento[data-variante="5"] .painel-servicos li { padding: 5px 0; }
    .bento[data-variante="5"] .painel-rotulo { margin-top: 0; }

    /* Versão 1: mosaico 12×12, dois altos à esquerda e três largos à direita. */
