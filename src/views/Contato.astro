---
/**
 * Contato (v3), nos dois idiomas: formulário à esquerda, canais à direita.
 *
 * O formulário é o de sempre, ligado a /api/contato. Funciona sem
 * JavaScript (POST normal, volta por 303 com ?envio-contato=) e, com
 * JavaScript, envia sem sair da página. O campo oculto `idioma` faz a API
 * devolver quem está sem JS para a página do idioma certo; com JS, a
 * mensagem de erro vem do `codigo` da resposta, traduzida aqui.
 *
 * As páginas que usam esta view são renderizadas a cada pedido
 * (prerender = false), porque a mensagem de resultado precisa existir no
 * HTML de quem volta do 303.
 *
 * WhatsApp (18/11/2026, reunião do Gabriel): com JavaScript, ao enviar, a
 * página abre também o WhatsApp do escritório com a mensagem montada a
 * partir do que a pessoa preencheu, mesmo se a API falhar. A janela abre
 * na própria ação do envio, para o navegador não bloquear; se bloquear, o
 * resultado traz o link "Abrir o WhatsApp". Sem JavaScript, só a API.
 * O botão continua "Enviar mensagem": sem JavaScript não há WhatsApp, e o
 * texto de apoio avisa do WhatsApp.
 */
import Base from '~/layouts/Base.astro';
import BannerPagina from '~/components/BannerPagina.astro';
import Icone from '~/components/Icone.astro';
import Seletor from '~/components/Seletor.astro';
import { CAMPOS_ISCA } from '~/lib/antispam';
import { site } from '~/lib/site';
import { areasDoIdioma } from '~/lib/areas';
import { t, rota, type Idioma } from '~/lib/i18n';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const tx = t(lang);
const c = tx.contato;

const envio = Astro.url.searchParams.get('envio-contato');
const motivo = Astro.url.searchParams.get('motivo-contato');
const mensagemErro = c.erros[motivo ?? ''] ?? c.erros.envio;

const valores = { nome: '', email: '', telefone: '', cidade: '', assunto: '', perfil: '', conheceu: '', mensagem: '', newsletter: '' };

const areas = await areasDoIdioma(lang);
const ASSUNTOS = [...areas.map((a) => a.data.nome), c.outroAssunto, c.naoSei];

/* A página da área manda ?assunto=<slug em português>: quem vem de lá chega com o assunto escolhido. */
const areaDoLink = areas.find((a) => a.slugPt === Astro.url.searchParams.get('assunto'));
if (areaDoLink) valores.assunto = areaDoLink.data.nome;

/* Sem JavaScript, quem erra volta com o que digitou (a API devolve em v-<campo>). */
if (envio === 'erro') {
  for (const campo of Object.keys(valores) as (keyof typeof valores)[]) {
    valores[campo] = Astro.url.searchParams.get(`v-${campo}`) ?? '';
  }
}
/* Mapa ?assunto= → opção, para o navegador marcar o assunto quando a página
   chega pré-gerada (prévia em /v3), onde o servidor não lê a URL. */
const mapaAssuntos = Object.fromEntries(areas.map((a) => [a.slugPt, a.data.nome]));

/* Base do link do WhatsApp (sem o texto padrão) e os rótulos da mensagem montada. */
const whatsBase = site.whatsapp.valor.split('?')[0];
const rotulosZap = {
  ...c.zap,
  assunto: c.assunto,
  perfil: c.perfil,
  telefone: c.telefone,
  cidade: c.cidade,
  email: c.email,
  mensagem: c.mensagem,
};
const houveCorte = envio === 'erro' && Astro.url.searchParams.get('corte-contato') === '1';
const campoComErro =
  motivo === 'email' ? 'email' : motivo === 'faltando' ? (valores.nome ? 'mensagem' : 'nome') : null;
const erroEm = (campo: string) =>
  campoComErro === campo ? ({ 'aria-invalid': 'true', 'aria-describedby': 'resultado-contato' } as const) : {};
---

<Base
  titulo={c.titulo}
  descricao={c.descricao}
  paginaAtual="/contato/"
  lang={lang}
  alternativa={lang === 'pt' ? '/en/contact/' : '/contato/'}
>
  <BannerPagina html={c.banner} foto="/media/novas/contato-lateral.jpg" migalhas={[{ rotulo: c.migalha }]} lang={lang} />

  <section class="secao">
    <div class="container com-lateral">
      <div>
        <h2>{c.h2}</h2>
        <p>{c.apoio}</p>

        <p
          id="resultado-contato"
          class:list={['resultado', { falhou: envio === 'erro' }]}
          role="status"
          aria-live="polite"
          tabindex="-1"
          hidden={envio !== 'ok' && envio !== 'erro'}
        >
          {envio === 'ok' ? c.ok : envio === 'erro' ? mensagemErro : ''}
        </p>
        {houveCorte && (
          <p class="resultado falhou"><strong>{c.atencao}</strong> {c.corte}</p>
        )}

        <form
          class="form"
          action="/api/contato"
          method="post"
          data-ok={c.ok}
          data-enviando={c.enviando}
          data-sem-conexao={c.semConexao}
          data-erros={JSON.stringify(c.erros)}
          data-whats={whatsBase}
          data-zap={JSON.stringify(rotulosZap)}
          data-ok-whats={c.okWhats}
          data-whats-bloqueado={c.whatsBloqueado}
          data-whats-falhou={c.whatsFalhou}
          data-abrir-whats={c.abrirWhats}
        >
          <input type="hidden" name="idioma" value={lang} />
          <div class="linha-2">
            <div>
              <label for="nome">{c.nome} *</label>
              <input id="nome" name="nome" type="text" autocomplete="name" required maxlength="120" value={valores.nome} {...erroEm('nome')} />
            </div>
            <div>
              <label for="telefone">{c.telefone}</label>
              <input id="telefone" name="telefone" type="tel" autocomplete="tel" maxlength="40" value={valores.telefone} />
            </div>
          </div>
          {/* Cidade (18/11/2026): a política de privacidade lista "cidade" entre
              os dados do formulário; o campo faltava. Opcional. */}
          <div class="linha-2">
            <div>
              <label for="email">{c.email} *</label>
              <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" value={valores.email} {...erroEm('email')} />
            </div>
            <div>
              <label for="cidade">{c.cidade}</label>
              <input id="cidade" name="cidade" type="text" autocomplete="address-level2" maxlength="80" value={valores.cidade} />
            </div>
          </div>
          <div class="linha-2">
            <div>
              <label for="assunto">{c.assunto}</label>
              <select id="assunto" name="assunto" data-seletor data-mapa={JSON.stringify(mapaAssuntos)}>
                <option value="">{c.selecione}</option>
                {ASSUNTOS.map((a) => <option value={a} selected={valores.assunto === a}>{a}</option>)}
              </select>
            </div>
            <div>
              <label for="perfil">{c.perfil}</label>
              <select id="perfil" name="perfil" data-seletor>
                <option value="">{c.selecione}</option>
                {c.perfis.map((o) => <option value={o} selected={valores.perfil === o}>{o}</option>)}
              </select>
            </div>
          </div>
          <div>
            <label for="mensagem">{c.mensagem} *</label>
            <textarea id="mensagem" name="mensagem" required maxlength="5000" {...erroEm('mensagem')}>{valores.mensagem}</textarea>
          </div>
          <div>
            <label for="conheceu">{c.conheceu}</label>
            <select id="conheceu" name="conheceu" data-seletor>
              <option value="">{c.selecione}</option>
              {c.origens.map((o) => <option value={o} selected={valores.conheceu === o}>{o}</option>)}
            </select>
          </div>

          <div class="isca" aria-hidden="true">
            {CAMPOS_ISCA.map((campo) => <input type="text" name={campo} tabindex="-1" autocomplete="off" />)}
          </div>

          <Seletor />
          {/* Caixa opcional, desmarcada (Política de Cookies dos sócios,
              18/11/2026). Só em português: a newsletter é só em português. */}
          {lang === 'pt' && (
            <label class="caixa">
              <input type="checkbox" name="newsletter" value="1" checked={valores.newsletter === '1'} />
              <span>{c.newsletter}</span>
            </label>
          )}
          <div><button type="submit" class="botao">{c.enviar}</button></div>
          <p class="nota">
            {c.nota} <a href={rota(lang, '/politica-de-privacidade/')}>{c.notaLink}</a>. {c.notaPatrocinio}
          </p>
        </form>
      </div>

      <aside class="lateral">
        <div class="widget">
          <h2>{c.canais}</h2>
          <ul class="canais">
            <li>
              <span class="canal-icone"><Icone nome="whatsapp" tamanho={18} /></span>
              <div>
                <strong>{c.fone}</strong>
                <a href={`tel:${site.telefoneE164.valor}`}>{site.telefone.valor}</a>
                <a href={site.whatsapp.valor} rel="noopener" target="_blank">{c.whats}</a>
              </div>
            </li>
            <li>
              <span class="canal-icone"><Icone nome="email" tamanho={18} /></span>
              <div>
                <strong>{c.email}</strong>
                <a class="email" href={`mailto:${site.email.valor}`}>{site.email.valor}</a>
              </div>
            </li>
            <li>
              <span class="canal-icone"><Icone nome="instagram" tamanho={18} /></span>
              <div>
                <strong>{c.instagram}</strong>
                <a href={site.redes.instagram.valor} rel="noopener" target="_blank">{site.redes.instagramArroba}</a>
              </div>
            </li>
          </ul>
          <dl class="dados">
            <dt>{c.horarioRotulo}</dt>
            <dd>{tx.horario}</dd>
            <dt>{c.atendimentoRotulo}</dt>
            <dd>{tx.atendimento} {tx.presencialEm} {site.cidade}/{site.estado}</dd>
          </dl>
        </div>
        <div class="widget golpe">
          <h2>{lang === 'en' ? 'Fake-lawyer scam' : 'Golpe do falso advogado'}</h2>
          <p>
            {lang === 'en'
              ? 'Scammers use the names of law firms and lawyers to ask for payment of fees, costs or the "release" of court funds. We only contact you through the channels above, and we never ask for payment from any other number, profile or link sent by third parties. If you receive such a message in our name, do not pay and check with us first.'
              : 'Há golpistas usando o nome de escritórios e de advogados para pedir pagamento de custas, taxas ou "liberação" de valores de processo. Nós só falamos com você pelos canais acima, e não pedimos pagamento por outro número, perfil ou link enviado por terceiros. Se receber uma mensagem assim em nosso nome, não pague e confirme conosco antes.'}
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  /* Assunto vindo do link (?assunto=): se o servidor não marcou (página
     pré-gerada), marca aqui e avisa o seletor próprio pelo evento change. */
  const campoAssunto = document.querySelector<HTMLSelectElement>('select[name="assunto"][data-mapa]');
  const pedido = new URLSearchParams(location.search).get('assunto');
  if (campoAssunto && pedido && !campoAssunto.value) {
    const mapa = JSON.parse(campoAssunto.dataset.mapa ?? '{}') as Record<string, string>;
    if (mapa[pedido]) {
      campoAssunto.value = mapa[pedido];
      campoAssunto.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }
</script>

<script>
  /* Melhoria progressiva: com JS o envio acontece sem sair da página. */
  const forma = document.querySelector<HTMLFormElement>('form[action="/api/contato"]');
  const resultado = document.getElementById('resultado-contato');
  const botao = forma?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (forma && resultado && botao) {
    const textos = forma.dataset;
    const erros = JSON.parse(textos.erros ?? '{}') as Record<string, string>;
    const zap = JSON.parse(textos.zap ?? '{}') as Record<string, string>;

    /* Mensagem do WhatsApp: saudação pela hora local, nome e os campos
       preenchidos, um por linha. Campo vazio não entra. */
    const montarZap = (dados: FormData) => {
      const campo = (nome: string) => String(dados.get(nome) ?? '').trim();
      const hora = new Date().getHours();
      const saudacao = hora < 12 ? zap.bomDia : hora < 18 ? zap.boaTarde : zap.boaNoite;
      const linhas = [`${saudacao} ${zap.meuNome} ${campo('nome')}.`];
      for (const nome of ['assunto', 'perfil', 'cidade', 'telefone', 'email', 'mensagem']) {
        const valor = campo(nome);
        if (valor) linhas.push(`${zap[nome]}: ${valor}`);
      }
      return `${textos.whats}?text=${encodeURIComponent(linhas.join('\n'))}`;
    };

    /* Resultado com o link do WhatsApp no fim (janela bloqueada ou API fora). */
    const mostrarComLink = (texto: string, link: string) => {
      resultado.textContent = `${texto} `;
      const a = document.createElement('a');
      a.href = link;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = textos.abrirWhats ?? '';
      resultado.append(a);
    };

    forma.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      const dados = new FormData(forma);
      const linkZap = montarZap(dados);
      /* Abre já, ainda dentro do evento de envio: depois do fetch o
         navegador trataria como janela não pedida e bloquearia. */
      /* Sem o 'noopener' nas opções: com ele o retorno é sempre null e não
         daria para saber se o navegador bloqueou. O opener é cortado logo depois. */
      const janela = window.open(linkZap, '_blank');
      if (janela) janela.opener = null;
      const abriu = janela !== null;
      botao.disabled = true;
      resultado.hidden = false;
      resultado.classList.remove('falhou');
      resultado.textContent = textos.enviando ?? '';
      try {
        const resposta = await fetch('/api/contato', {
          method: 'POST',
          body: dados,
          headers: { accept: 'application/json' },
        });
        const corpo = (await resposta.json().catch(() => ({}))) as { codigo?: string };
        if (resposta.ok) {
          forma.reset();
          if (abriu) resultado.textContent = textos.okWhats ?? '';
          else mostrarComLink(textos.whatsBloqueado ?? '', linkZap);
        } else {
          resultado.classList.add('falhou');
          mostrarComLink(`${erros[corpo.codigo ?? ''] ?? erros.envio} ${textos.whatsFalhou ?? ''}`, linkZap);
        }
      } catch {
        resultado.classList.add('falhou');
        mostrarComLink(`${textos.semConexao ?? ''} ${textos.whatsFalhou ?? ''}`, linkZap);
      } finally {
        botao.disabled = false;
        resultado.focus();
      }
    });
  }
</script>

<style>
  /* Lateral mais larga (18/11/2026): o e-mail cabe numa linha só, sem
     separar "contato" de "@bertoncinimendonca.adv.br". */
  .secao > .com-lateral { grid-template-columns: minmax(0, 1fr) 400px; }
  .canais .email { white-space: nowrap; }
  .caixa { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; font-weight: 400; line-height: 1.5; color: var(--texto); cursor: pointer; }
  .caixa input { flex: none; width: 18px; height: 18px; margin: 3px 0 0; accent-color: var(--azul); }
  .resultado :global(a) { font-weight: 500; }
  @media (max-width: 991px) { .secao > .com-lateral { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 420px) { .canais .email { font-size: 14px; } .widget { padding: 22px 18px; } }
  .canais { list-style: none; padding: 0; margin: 0 0 18px; display: grid; gap: 16px; }
  .canais li { display: flex; gap: 12px; align-items: flex-start; border: 0 !important; }
  .canais div { display: grid; gap: 2px; font-size: 15px; }
  .canais strong { color: var(--azul); }
  .canais a { padding: 0 !important; color: var(--azul-medio) !important; overflow-wrap: break-word; }
  .canais a:hover { text-decoration: underline; }
  .canal-icone {
    display: grid; place-items: center; flex: none;
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--azul); color: #fff;
  }
  .dados { margin: 0; font-size: 15px; padding-top: 14px; border-top: 1px solid var(--linha); }
  .dados dt { font-weight: 700; color: var(--azul); margin-top: 12px; }
  .dados dt:first-child { margin-top: 0; }
  .dados dd { margin: 2px 0 0; }
  .resultado { margin-bottom: 18px; }
  .golpe p { font-size: 14px; line-height: 1.6; margin: 0; color: var(--texto-suave); }
</style>
