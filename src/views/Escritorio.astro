---
/**
 * O escritório (v3), nos dois idiomas: quem somos, missão e valores, e o
 * perfil dos sócios. Missão e valores são texto dos sócios (briefing q3.1
 * e q3.2); formação, do briefing (q1.7a e q1.7b). Sem história e sem
 * números, e sem dividir os sócios por área (retorno de 06/11/2026).
 */
import Base from '~/layouts/Base.astro';
import BannerPagina from '~/components/BannerPagina.astro';
import Chamada from '~/components/Chamada.astro';
import { site } from '~/lib/site';
import { areasDoIdioma } from '~/lib/areas';
import { t, type Idioma } from '~/lib/i18n';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const tx = t(lang);
const e = tx.escritorio;
const areas = await areasDoIdioma(lang);
const outras = tx.outrasAreas;

const perfis = site.socios.map((socio, i) => ({
  socio,
  ancora: socio.nome.split(' ')[0].toLowerCase(),
  cargo: tx.socio[i === 1 ? 'a' : 'o'],
  bio: e.bios[i],
  formacao: e.formacoes[i],
}));
---

<Base
  titulo={e.titulo}
  descricao={e.descricao}
  paginaAtual="/escritorio/"
  lang={lang}
  alternativa={lang === 'pt' ? '/en/firm/' : '/escritorio/'}
>
  <BannerPagina
    html={e.banner}
    apoio={e.missao}
    foto="/media/hero/socios-1600.jpg"
    posicao="80% 12%"
    posicaoCelular="80% 0%"
    alto
    migalhas={[{ rotulo: e.migalha }]}
    lang={lang}
  />

  <section class="secao">
    <div class="container duas-colunas">
      <div>
        <p class="rotulo">{e.rotulo}</p>
        <h2 class="titulo-bloco">{site.nome}</h2>
        <p>
          {e.intro}{' '}
          {areas.map((a, i) => (
            <>{i > 0 && ` ${e.e} `}<a href={a.href}>{a.data.nome}</a></>
          ))}.
        </p>
        <p>
          {e.tambem} {outras.slice(0, -1).join(', ').toLowerCase()} {e.e} {outras.at(-1)?.toLowerCase()}.
        </p>
        <p>{tx.atendimento}, {tx.presencialEm} {site.cidade}/{site.estado}.</p>
      </div>
      {/* Painel da marca, como a pasta do manual de identidade: azul-noite,
          monograma grande quase transparente e o logo em creme. Fica até
          chegar uma foto própria do escritório. */}
      <div class="painel-marca" aria-hidden="true">
        <img class="pm-mono" src="/media/marca/monograma-creme.svg" alt="" width="254" height="276" />
        <img class="pm-logo" src="/media/marca/lockup-creme.svg" alt="" width="550" height="196" />
      </div>
    </div>
  </section>

  {/* Missão e valores (07/11/2026): a missão como declaração, em letra
      grande e fina, e os três valores em colunas abertas, sem caixa. */}
  <section class="secao missao-secao">
    {/* Personalidade (07/11/2026), no espírito do "Também atuamos em": faixa
        azul-noite em diagonal, luz petróleo desfocada e o monograma vazando. */}
    <span class="missao-arte" aria-hidden="true"></span>
    <span class="missao-luz" aria-hidden="true"></span>
    <div class="container">
      <div class="missao-bloco">
        <p class="rotulo" set:html={e.missaoTitulo.replace(/<[^>]+>/g, '')} />
        <p class="missao-frase">{e.missao}</p>
      </div>
      <div class="valores">
        {e.valores.map((v) => (
          <div class="valor">
            <h3>{v.nome}</h3>
            <p>{v.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Como atuamos: os seis valores de atuação (briefing q3.2), título à
      esquerda e a lista em duas colunas com filete. */}
  <section class="secao">
    <div class="container atuacao-grade">
      <div class="atuacao-cabeca">
        <h2 class="atuacao-titulo">{e.atuacaoTitulo}</h2>
        <p>{e.atuacaoApoio}</p>
      </div>
      <dl class="atuacao">
        {e.valoresAtuacao.map((v) => (
          <div>
            <dt>{v.nome}</dt>
            <dd>{v.texto}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="secao secao-cinza">
    <div class="container">
      <div class="titulo-secao">
        <h2 set:html={e.sociosTitulo} />
      </div>
      <div class="perfis">
        {perfis.map((p) => (
          <article class="perfil" id={p.ancora}>
            <img src={`${p.socio.retrato}-840.jpg`} alt={`${tx.socio.retrato} ${p.socio.nome}.`} width="840" height="1260" loading="lazy" />
            <div>
              <p class="rotulo">{p.cargo}</p>
              <h3>{p.socio.nome}</h3>
              <p class="oab">{p.socio.oab.valor}</p>
              <p>{p.bio}</p>
              <h4>{e.formacao}</h4>
              <ul>{p.formacao.map((item) => <li>{item}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* "O que não aceitamos" (briefing q3.5): a posição do escritório fecha a
      página, dentro do rodapé azul-noite (slot do Base), com a diagonal no
      topo e um filete antes da chamada, como o "Também atuamos em" em /areas/. */}
  <section slot="rodape" class="recusa-faixa antes-do-rodape" aria-labelledby="recusa-titulo">
    <div class="container">
      <p class="recusa-rotulo" id="recusa-titulo">{e.recusaRotulo.replace(/\.$/, '')}</p>
      <p class="recusa-frase">{e.recusa}</p>
    </div>
  </section>

  <Chamada slot="rodape" lang={lang} />
</Base>

<style>
  .titulo-bloco { font-size: 30px; }
  .painel-marca {
    position: relative; overflow: hidden;
    display: grid; place-items: center;
    aspect-ratio: 16 / 11; border-radius: 14px;
    background:
      radial-gradient(120% 90% at 100% 100%, rgba(81, 116, 147, .35) 0%, rgba(81, 116, 147, 0) 60%),
      linear-gradient(135deg, #0b1e3f 0%, #0f2a4f 55%, #004369 100%);
    box-shadow: 0 24px 50px rgba(11, 30, 63, .18);
  }
  .pm-mono { position: absolute; right: -8%; top: 50%; height: 150%; width: auto; transform: translateY(-50%); opacity: .08; }
  .pm-logo { position: relative; width: 58%; height: auto; }

  .perfis { display: grid; gap: 48px; max-width: 980px; margin: 0 auto; }
  .perfil { display: grid; grid-template-columns: 300px 1fr; gap: 40px; align-items: start; scroll-margin-top: calc(var(--altura-barra) + 24px); }
  .perfil + .perfil { padding-top: 48px; border-top: 1px solid var(--linha); }
  .perfil img { border-radius: 6px; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; box-shadow: var(--sombra); }
  .perfil h3 { font-size: 26px; margin-bottom: 4px; }
  .perfil h4 { font-size: 16px; margin: 22px 0 8px; }
  .oab { color: var(--texto-suave); }

  @media (max-width: 680px) {
    .perfil { grid-template-columns: 1fr; gap: 24px; }
    .perfil img { max-width: 320px; }
    .titulo-bloco { font-size: 26px; }
  }
  /* ---------- Missão e valores: faixa azul-noite em diagonal ---------- */
  .missao-secao {
    position: relative; overflow: hidden;
    background: var(--azul); color: #f8f7f2;
    padding: 168px 0 176px;
    --corte: 64px;
    clip-path: polygon(0 var(--corte), 100% 0, 100% calc(100% - var(--corte)), 0 100%);
  }
  .missao-arte {
    position: absolute; left: -120px; top: 50%; transform: translateY(-50%);
    width: 600px; aspect-ratio: 254 / 276; background: #f8f7f2; opacity: .05; pointer-events: none;
    -webkit-mask: url('/media/marca/monograma-creme.svg') center / contain no-repeat;
    mask: url('/media/marca/monograma-creme.svg') center / contain no-repeat;
  }
  .missao-luz {
    position: absolute; right: -260px; bottom: -320px; width: 860px; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgba(10, 98, 150, .7) 0%, rgba(0, 67, 105, .4) 38%, rgba(0, 67, 105, 0) 70%);
    filter: blur(70px); pointer-events: none;
  }
  .missao-secao .container { position: relative; }
  .missao-bloco { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 40px; align-items: baseline; margin-bottom: 80px; }
  .missao-bloco .rotulo { margin: 0; color: #9fb6cc; display: flex; align-items: center; gap: 12px; }
  .missao-bloco .rotulo::before { content: ''; width: 28px; height: 1px; background: #9fb6cc; }
  .missao-frase { margin: 0; font-size: 44px; font-weight: 300; line-height: 1.22; letter-spacing: -.015em; color: #fff; }
  /* Alinhados à coluna da frase (3fr | 9fr com 40px de vão); a coluna do
     meio desce um pouco, quebrando a grade. */
  .valores { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-left: calc((100% - 40px) * 3 / 12 + 40px); }
  .valor { position: relative; padding-top: 24px; border-top: 1px solid rgba(248, 247, 242, .18); }
  .valor::before { content: ''; position: absolute; left: 0; top: -1px; width: 36px; height: 2px; background: #5b9bc8; }
  .valor:nth-child(2) { transform: translateY(36px); }
  .valor h3 { font-size: 24px; font-weight: 700; margin: 0 0 10px; color: #fff; }
  .valor p { margin: 0; font-size: 16px; line-height: 1.65; color: rgba(248, 247, 242, .72); }

  /* ---------- Como atuamos ---------- */
  .atuacao-grade { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 56px; align-items: start; }
  .atuacao-titulo { font-size: 40px; font-weight: 300; line-height: 1.1; letter-spacing: -.015em; margin: 0 0 16px; }
  .atuacao-cabeca p { margin: 0; font-size: 17px; line-height: 1.65; color: var(--texto-suave); max-width: 32ch; }
  .atuacao { display: grid; grid-template-columns: 1fr 1fr; gap: 0 40px; margin: 0; }
  .atuacao div { padding: 20px 0; border-top: 1px solid var(--linha); }
  .atuacao dt { font-size: 17px; font-weight: 700; color: var(--azul); margin-bottom: 6px; }
  .atuacao dd { margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-suave); }

  /* ---------- O que não aceitamos (dentro do rodapé) ---------- */
  .recusa-faixa { position: relative; z-index: 1; padding: 150px 0 88px; color: #f8f7f2; }
  .recusa-rotulo { margin: 0 0 18px; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #9fb6cc; }
  .recusa-frase { margin: 0; max-width: 24ch; font-size: 46px; font-weight: 300; line-height: 1.15; letter-spacing: -.02em; color: #fff; }

  @media (max-width: 991px) {
    .missao-bloco, .atuacao-grade { grid-template-columns: 1fr; gap: 16px; }
    .missao-secao { padding: 120px 0 128px; --corte: 40px; }
    .missao-frase { font-size: 32px; }
    .valores { margin-left: 0; }
    .missao-luz { width: 600px; right: -260px; bottom: -260px; }
    .atuacao-grade { gap: 32px; }
    .recusa-faixa { padding: 112px 0 64px; }
    .recusa-frase { font-size: 36px; }
  }
  @media (max-width: 680px) {
    .missao-secao { padding: 88px 0 96px; --corte: 28px; }
    .valor:nth-child(2) { transform: none; }
    .missao-arte { width: 360px; left: -140px; top: 0; transform: none; }
    .missao-bloco { margin-bottom: 44px; }
    .missao-frase { font-size: 26px; }
    .valores, .atuacao { grid-template-columns: 1fr; gap: 0; }
    .valor { padding: 18px 0 22px; }
    .atuacao-titulo { font-size: 32px; }
    .recusa-faixa { padding: 84px 0 52px; }
    .recusa-frase { font-size: 28px; }
  }
</style>
